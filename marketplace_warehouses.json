  "ozon": [
    "\u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433_\u0420\u0424\u0426_\u041d\u041e\u0412\u042b\u0419 \u2014 \u0433. \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433, \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f \u041b\u043e\u0433\u043e\u043f\u0430\u0440\u043a \u041a\u043e\u043b\u044c\u0446\u043e\u0432\u0441\u043a\u0438\u0439, \u0441\u0442\u0440. 15",
