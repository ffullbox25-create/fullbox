    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u0432\u0430 \u2014 \u0414\u043e\u0440\u043e\u0433\u043e\u043c\u0438\u043b\u043e\u0432\u043e \u2014 \u041c\u043e\u0441\u043a\u0432\u0430, \u0411\u0435\u0440\u0435\u0436\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043d\u0430\u0431\u0435\u0440\u0435\u0436\u043d\u0430\u044f, \u0434. 20, \u0441\u0442\u0440. 9",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u0432\u0430 \u2014 \u0422\u0435\u043a\u0441\u0442\u0438\u043b\u044c\u0449\u0438\u043a\u0438 \u2014 \u041c\u043e\u0441\u043a\u0432\u0430, \u0443\u043b. \u0410\u0440\u0442\u044e\u0445\u0438\u043d\u043e\u0439, \u0434. 8/10",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u0432\u0430 \u2014 \u0426\u0430\u0440\u0438\u0446\u044b\u043d\u043e \u2014 \u041c\u043e\u0441\u043a\u0432\u0430, \u0443\u043b. \u041f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0430\u044f, \u0434. 12\u0410",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u0432\u0430 \u2014 \u042e\u0436\u043d\u044b\u0435 \u0432\u043e\u0440\u043e\u0442\u0430 \u2014 \u041c\u043e\u0441\u043a\u0432\u0430, \u041c\u041a\u0410\u0414, 19-\u0439 \u043a\u0438\u043b\u043e\u043c\u0435\u0442\u0440, \u0432\u043b. 20, \u0441\u0442\u0440. 1",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 + \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u2014 \u0421\u043e\u0444\u044c\u0438\u043d\u043e \u2014 \u0421\u043e\u0444\u044c\u0438\u043d\u043e-1: \u041c\u041e, \u0420\u0430\u043c\u0435\u043d\u0441\u043a\u0438\u0439 \u0433. \u043e., \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0442\u0435\u0445\u043d\u043e\u043f\u0430\u0440\u043a \u0421\u043e\u0444\u044c\u0438\u043d\u043e, \u0441\u0442\u0440. 3/1; \u0421\u043e\u0444\u044c\u0438\u043d\u043e-2: \u0442\u043e\u0442 \u0436\u0435 \u0442\u0435\u0445\u043d\u043e\u043f\u0430\u0440\u043a, \u0441\u0442\u0440. 2/1; \u0421\u043e\u0444\u044c\u0438\u043d\u043e-\u041a\u0413\u0422 \u0438 \u0421\u043e\u0444\u044c\u0438\u043d\u043e \u2014 \u0442\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 2: \u041c\u041e, \u0420\u0430\u043c\u0435\u043d\u0441\u043a\u0438\u0439 \u0433. \u043e., \u0421\u041f \u0421\u043e\u0444\u044c\u0438\u043d\u0441\u043a\u043e\u0435, \u0442\u0435\u0445\u043d\u043e\u043f\u0430\u0440\u043a \u0421\u043e\u0444\u044c\u0438\u043d\u043e, \u043a\u0432\u0430\u0440\u0442\u0430\u043b 4/218, \u0441\u0442\u0440. 4",
    "\u0412\u043e\u0437\u0432\u0440\u0430\u0442\u043d\u044b\u0439 \u00b7 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u2014 \u0414\u043e\u043c\u043e\u0434\u0435\u0434\u043e\u0432\u043e \u2014 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0433. \u0414\u043e\u043c\u043e\u0434\u0435\u0434\u043e\u0432\u043e, \u043c\u043a\u0440. \u0411\u0435\u043b\u044b\u0435 \u0421\u0442\u043e\u043b\u0431\u044b, \u0432\u043b. \u0421\u043a\u043b\u0430\u0434\u044b 104, \u0441\u0442\u0440. 6/1",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u2014 \u0411\u0443\u0433\u0440\u044b \u2014 \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u0412\u0441\u0435\u0432\u043e\u043b\u043e\u0436\u0441\u043a\u0438\u0439 \u0440\u0430\u0439\u043e\u043d, \u0411\u0443\u0433\u0440\u043e\u0432\u0441\u043a\u043e\u0435 \u0421\u041f, \u041a\u0410\u0414, 23-\u0439 \u043a\u043c, \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435 \u043a\u043e\u043b\u044c\u0446\u043e, \u0434. 3",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u00b7 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433 \u2014 \u041f\u0430\u0440\u0433\u043e\u043b\u043e\u0432\u043e \u2014 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u043f\u043e\u0441. \u041f\u0430\u0440\u0433\u043e\u043b\u043e\u0432\u043e, \u0443\u043b. \u041f\u043e\u0434\u0433\u043e\u0440\u043d\u0430\u044f, \u0434. 61, \u0441\u0442\u0440. 1, \u043a\u043e\u0440\u043f. 5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433 \u2014 \u0422\u0440\u043e\u0438\u0446\u043a\u0438\u0439 \u2014 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u0443\u043b. \u0417\u0430\u043f\u043e\u0440\u043e\u0436\u0441\u043a\u0430\u044f, \u0434. 12, \u0441\u0442\u0440. 1, \u043a\u043e\u0440\u043f. 1",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u00b7 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433 \u2014 \u0428\u0443\u0448\u0430\u0440\u044b \u2014 \u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, \u043f\u043e\u0441. \u0428\u0443\u0448\u0430\u0440\u044b, \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, \u0434. 161, \u043a\u043e\u0440\u043f. 13, \u0441\u0442\u0440. 1",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0410\u0441\u0442\u0440\u0430\u0445\u0430\u043d\u044c \u2014 \u0410\u0441\u0442\u0440\u0430\u0445\u0430\u043d\u044c, 1-\u0439 \u043f\u0440\u043e\u0435\u0437\u0434 \u0420\u043e\u0436\u0434\u0435\u0441\u0442\u0432\u0435\u043d\u0441\u043a\u043e\u0433\u043e, \u0441\u0442\u0440. 8",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0411\u0430\u0440\u043d\u0430\u0443\u043b \u2014 \u0411\u0430\u0440\u043d\u0430\u0443\u043b, \u0443\u043b. \u0427\u0435\u0440\u043d\u044b\u0448\u0435\u0432\u0441\u043a\u043e\u0433\u043e, \u0434. 293\u0411",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434 \u2014 \u0411\u0435\u043b\u0433\u043e\u0440\u043e\u0434, \u0443\u043b. \u041c\u0438\u0447\u0443\u0440\u0438\u043d\u0430, \u0434. 104",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0411\u0440\u044f\u043d\u0441\u043a \u2014 \u0411\u0440\u044f\u043d\u0441\u043a, \u0443\u043b. 22 \u0441\u044a\u0435\u0437\u0434\u0430 \u041a\u041f\u0421\u0421, \u0441\u0442\u0440. 136\u0413, \u0441\u043a\u043b\u0430\u0434 \u2116 5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440 \u2014 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440, \u0443\u043b. \u041a\u0443\u0439\u0431\u044b\u0448\u0435\u0432\u0430, \u0434. 28\u0415",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434 \u2014 \u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434, \u0443\u043b. \u0417\u0435\u043c\u043b\u044f\u0447\u043a\u0438, \u0434. 94",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0412\u043e\u0440\u043e\u043d\u0435\u0436 \u2014 \u0412\u043e\u0440\u043e\u043d\u0435\u0436\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0410\u0439\u0434\u0430\u0440\u043e\u0432\u0441\u043a\u043e\u0435 \u0421\u041f, 2-\u044f \u041f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u0430\u044f \u0437\u043e\u043d\u0430, \u0434. 27",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u00b7 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433 (\u043e\u0431\u044b\u0447\u043d\u044b\u0439) \u2014 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433, \u0421\u0435\u0440\u043e\u0432\u0441\u043a\u0438\u0439 \u0442\u0440\u0430\u043a\u0442, 11-\u0439 \u043a\u043c, \u0434. 3",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433 (\u0442\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439) \u2014 \u0415\u043a\u0430\u0442\u0435\u0440\u0438\u043d\u0431\u0443\u0440\u0433, \u0421\u0435\u0440\u043e\u0432\u0441\u043a\u0438\u0439 \u0442\u0440\u0430\u043a\u0442, 11-\u0439 \u043a\u043c, \u0434. 3",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0418\u0432\u0430\u043d\u043e\u0432\u043e \u2014 \u0418\u0432\u0430\u043d\u043e\u0432\u043e, \u0443\u043b. \u0421\u0442\u0430\u043d\u043a\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u0435\u0439, \u0434. 5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0418\u0436\u0435\u0432\u0441\u043a \u2014 \u0418\u0436\u0435\u0432\u0441\u043a, \u0443\u043b. \u041f\u043e\u0439\u043c\u0430, \u0434. 105",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0430\u0437\u0430\u043d\u044c \u2014 \u0420\u0435\u0441\u043f. \u0422\u0430\u0442\u0430\u0440\u0441\u0442\u0430\u043d, \u041b\u0430\u0438\u0448\u0435\u0432\u0441\u043a\u0438\u0439 \u0440-\u043d, \u0441. \u0421\u0442\u043e\u043b\u0431\u0438\u0449\u0435, \u0443\u043b. \u041f\u043e\u0447\u0442\u043e\u0432\u0430\u044f, \u0434. 1",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0430\u043b\u0443\u0433\u0430 \u2014 \u041a\u0430\u043b\u0443\u0433\u0430, \u0443\u043b. \u0414\u0430\u043b\u044c\u043d\u044f\u044f, \u0434. 17",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0435\u043c\u0435\u0440\u043e\u0432\u043e \u2014 \u041a\u0435\u043c\u0435\u0440\u043e\u0432\u043e, \u0443\u043b. \u0422\u0435\u0440\u0435\u0448\u043a\u043e\u0432\u043e\u0439, \u0434. 41/11",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0438\u0440\u043e\u0432 \u2014 \u041a\u0438\u0440\u043e\u0432, \u0443\u043b. \u041f\u0430\u0432\u043b\u0430 \u041a\u043e\u0440\u0447\u0430\u0433\u0438\u043d\u0430, \u0434. 225/3",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0440\u0430\u0441\u043d\u043e\u0434\u0430\u0440 \u2014 \u041a\u0440\u0430\u0441\u043d\u043e\u0434\u0430\u0440, \u0445\u0443\u0442\u043e\u0440 \u041e\u043a\u0442\u044f\u0431\u0440\u044c\u0441\u043a\u0438\u0439, \u0443\u043b. \u041f\u043e\u0434\u0441\u043e\u043b\u043d\u0435\u0447\u043d\u0430\u044f, \u0434. 44",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0440\u0430\u0441\u043d\u043e\u044f\u0440\u0441\u043a \u2014 \u041a\u0440\u0430\u0441\u043d\u043e\u044f\u0440\u0441\u043a, \u0443\u043b. \u041f\u0440\u043e\u043c\u044b\u0441\u043b\u043e\u0432\u0430\u044f, \u0434. 41\u0410",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041a\u0443\u0440\u0441\u043a \u2014 \u041a\u0443\u0440\u0441\u043a, \u043f\u0440-\u0442 \u041b\u0435\u043d\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u041a\u043e\u043c\u0441\u043e\u043c\u043e\u043b\u0430, \u0434. 49",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041b\u0438\u043f\u0435\u0446\u043a \u2014 \u041b\u0438\u043f\u0435\u0446\u043a, \u0443\u043b. \u0411\u0430\u0437\u0430\u0440\u043d\u0430\u044f, \u0441\u0442\u0440. 3\u041a",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041c\u0443\u0440\u043e\u043c \u2014 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0433. \u041c\u0443\u0440\u043e\u043c, \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, \u0434. 9",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041d\u0430\u0431\u0435\u0440\u0435\u0436\u043d\u044b\u0435 \u0427\u0435\u043b\u043d\u044b \u2014 \u041d\u0430\u0431\u0435\u0440\u0435\u0436\u043d\u044b\u0435 \u0427\u0435\u043b\u043d\u044b, \u0443\u043b. \u041c\u0430\u0448\u0438\u043d\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f, \u0434. 39",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041d\u0438\u0436\u043d\u0438\u0439 \u041d\u043e\u0432\u0433\u043e\u0440\u043e\u0434 \u2014 \u041d\u0438\u0436\u0435\u0433\u043e\u0440\u043e\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0433. \u041a\u0441\u0442\u043e\u0432\u043e, \u0443\u043b. \u041e\u0441\u0442\u0440\u043e\u0432\u0441\u043a\u043e\u0433\u043e, \u0434. 19",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a \u2014 \u041d\u043e\u0432\u043e\u0440\u043e\u0441\u0441\u0438\u0439\u0441\u043a, \u041c\u044b\u0441\u0445\u0430\u043a\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, \u0434. 57\u0410",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a \u2014 \u041d\u043e\u0432\u043e\u0441\u0438\u0431\u0438\u0440\u0441\u043a, \u0410\u0440\u0445\u043e\u043d\u0441\u043a\u0438\u0439 \u043f\u0435\u0440., \u0434. 2\u0410, \u043a. 6",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041e\u043c\u0441\u043a \u2014 \u041e\u043c\u0441\u043a, \u0443\u043b. 22 \u0414\u0435\u043a\u0430\u0431\u0440\u044f, \u0434. 108\u0410",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041f\u0435\u043d\u0437\u0430 \u2014 \u041f\u0435\u043d\u0437\u0430, \u0443\u043b. \u0417\u0435\u043b\u0435\u043d\u043e\u0434\u043e\u043b\u044c\u0441\u043a\u0430\u044f, \u0434. 56\u0414",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041f\u0435\u0440\u043c\u044c \u2014 \u041f\u0435\u0440\u043c\u044c, \u0443\u043b. \u0413\u0435\u0440\u043e\u0435\u0432 \u0425\u0430\u0441\u0430\u043d\u0430, \u0434. 98",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u041f\u044f\u0442\u0438\u0433\u043e\u0440\u0441\u043a \u2014 \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c\u0441\u043a\u0438\u0439 \u043a\u0440\u0430\u0439, \u0433. \u043e. \u041f\u044f\u0442\u0438\u0433\u043e\u0440\u0441\u043a, \u043f\u043e\u0441. \u0413\u043e\u0440\u044f\u0447\u0435\u0432\u043e\u0434\u0441\u043a\u0438\u0439, \u0443\u043b. \u042f\u0441\u043d\u0430\u044f, \u0434. 21\u04412",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u00b7 \u0420\u043e\u0441\u0442\u043e\u0432-\u043d\u0430-\u0414\u043e\u043d\u0443 (\u043e\u0431\u044b\u0447\u043d\u044b\u0439) \u2014 \u0420\u043e\u0441\u0442\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0410\u043a\u0441\u0430\u0439\u0441\u043a\u0438\u0439 \u0440-\u043d, \u0445\u0443\u0442\u043e\u0440 \u041b\u0435\u043d\u0438\u043d\u0430, \u0443\u043b. \u041b\u043e\u0433\u043e\u043f\u0430\u0440\u043a, \u0434. 5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0420\u043e\u0441\u0442\u043e\u0432-\u043d\u0430-\u0414\u043e\u043d\u0443 (\u0442\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439) \u2014 \u0420\u043e\u0441\u0442\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0410\u043a\u0441\u0430\u0439\u0441\u043a\u0438\u0439 \u0440-\u043d, \u0445\u0443\u0442\u043e\u0440 \u041b\u0435\u043d\u0438\u043d\u0430, \u0443\u043b. \u041b\u043e\u0433\u043e\u043f\u0430\u0440\u043a, \u0434. 5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0420\u044f\u0437\u0430\u043d\u044c \u2014 \u0420\u044f\u0437\u0430\u043d\u044c, \u0443\u043b. \u0427\u043a\u0430\u043b\u043e\u0432\u0430, \u0434. 36\u0412",
    "\u041e\u0431\u044b\u0447\u043d\u044b\u0439 \u00b7 \u0421\u0430\u043c\u0430\u0440\u0430 (\u043e\u0431\u044b\u0447\u043d\u044b\u0439) \u2014 \u0421\u0430\u043c\u0430\u0440\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0412\u043e\u043b\u0436\u0441\u043a\u0438\u0439 \u0440-\u043d, \u0441. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043a\u0430, \u0443\u043b. \u0418\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f, \u0434. 2\u0410/5, \u0441\u043a\u043b\u0430\u0434 8",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u0430\u043c\u0430\u0440\u0430 (\u0442\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439) \u2014 \u0421\u0430\u043c\u0430\u0440\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0412\u043e\u043b\u0436\u0441\u043a\u0438\u0439 \u0440-\u043d, \u0441. \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043a\u0430, \u0443\u043b. \u0418\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043b\u044c\u043d\u0430\u044f, \u0434. 2\u0410/5",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u0430\u0440\u0430\u0442\u043e\u0432 \u2014 \u0421\u0430\u0440\u0430\u0442\u043e\u0432, \u0443\u043b. \u0410\u0432\u0442\u043e\u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0442\u043e\u0432\u0441\u043a\u0430\u044f, \u0434. 12, \u0441\u0442\u0440. 3",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u0435\u0440\u043f\u0443\u0445\u043e\u0432 \u2014 \u041c\u043e\u0441\u043a\u043e\u0432\u0441\u043a\u0430\u044f \u043e\u0431\u043b., \u0433. \u0421\u0435\u0440\u043f\u0443\u0445\u043e\u0432, \u0448. \u0421\u0435\u0432\u0435\u0440\u043d\u043e\u0435, \u0434. 14",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a \u2014 \u0421\u043c\u043e\u043b\u0435\u043d\u0441\u043a, \u041a\u0440\u0430\u0441\u043d\u0438\u043d\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, \u0434. 27",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u043e\u0447\u0438 \u2014 \u0421\u043e\u0447\u0438, \u0412\u0438\u043d\u043e\u0433\u0440\u0430\u0434\u043d\u044b\u0439 \u043f\u0435\u0440., \u0434. 15",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u043e\u0447\u0438 \u2014 \u041b\u0430\u0437\u0430\u0440\u0435\u0432\u0441\u043a\u043e\u0435 \u2014 \u0421\u043e\u0447\u0438, \u0436/\u0440 \u041b\u0430\u0437\u0430\u0440\u0435\u0432\u0441\u043a\u043e\u0435, \u043f\u0435\u0440. \u041f\u0430\u0432\u043b\u043e\u0432\u0430, \u0434. 6",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c \u2014 \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c, \u0421\u0442\u0430\u0440\u043e\u043c\u0430\u0440\u044c\u0435\u0432\u0441\u043a\u043e\u0435 \u0448\u043e\u0441\u0441\u0435, \u0434. 13, \u0441\u0442\u0440. 2",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0422\u0432\u0435\u0440\u044c \u2014 \u0422\u0432\u0435\u0440\u044c, \u0443\u043b. \u0411\u043e\u0447\u043a\u0438\u043d\u0430, \u0434. 17",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0422\u043e\u043c\u0441\u043a \u2014 \u0422\u043e\u043c\u0441\u043a, \u0443\u043b. \u041c\u043e\u043a\u0440\u0443\u0448\u0438\u043d\u0430, \u0434. 9, \u0441\u0442\u0440. 21",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0422\u0443\u043b\u0430 \u2014 \u0422\u0443\u043b\u0430, \u0443\u043b. \u0429\u0435\u0433\u043b\u043e\u0432\u0441\u043a\u0430\u044f \u0437\u0430\u0441\u0435\u043a\u0430, \u0434. 31, \u0442\u0435\u0445\u043d\u043e\u043f\u0430\u0440\u043a \u00ab\u0422\u0435\u0445\u043d\u043e\u043f\u0430\u0440\u043a \u0422\u0443\u043b\u0430\u00bb",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0423\u043b\u044c\u044f\u043d\u043e\u0432\u0441\u043a \u2014 \u0423\u043b\u044c\u044f\u043d\u043e\u0432\u0441\u043a, \u0443\u043b. \u041c\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f, \u0434. 1, \u0441\u0442\u0440. 4",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0423\u0444\u0430 \u2014 \u0423\u0444\u0430, \u0443\u043b. \u041c\u0435\u043d\u0434\u0435\u043b\u0435\u0435\u0432\u0430, \u0434. 134\u0415",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0427\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u044b \u2014 \u0427\u0435\u0431\u043e\u043a\u0441\u0430\u0440\u044b, \u0413\u0430\u0440\u0430\u0436\u043d\u044b\u0439 \u043f\u0440\u043e\u0435\u0437\u0434, \u0434. 3, \u0441\u0442\u0440. 1",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u0427\u0435\u043b\u044f\u0431\u0438\u043d\u0441\u043a \u2014 \u0427\u0435\u043b\u044f\u0431\u0438\u043d\u0441\u043a, \u0443\u043b. \u041c\u043e\u043d\u0442\u0430\u0436\u043d\u0438\u043a\u043e\u0432, \u0434. 16",
    "\u0422\u0440\u0430\u043d\u0437\u0438\u0442\u043d\u044b\u0439 \u00b7 \u042f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044c \u2014 \u042f\u0440\u043e\u0441\u043b\u0430\u0432\u043b\u044c, \u0443\u043b. \u041e\u0441\u0442\u0430\u0448\u0438\u043d\u0441\u043a\u0430\u044f, \u0434. 8"
  ],
