def _task_count_label(count: int) -> str:
    count = int(count or 0)
    mod10 = count % 10
    mod100 = count % 100
    if mod10 == 1 and mod100 != 11:
        suffix = "задание"
    elif mod10 in {2, 3, 4} and mod100 not in {12, 13, 14}:
