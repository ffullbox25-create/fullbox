            "pick_mode": (payload.get("pick_mode") or "full"),
            "move_mode": move_mode,
            "requested_qty": _as_int(payload.get("requested_qty")),
            "picked_qty": _as_int(payload.get("picked_qty")),
            "requested_sku": str(payload.get("requested_sku") or "").strip(),
