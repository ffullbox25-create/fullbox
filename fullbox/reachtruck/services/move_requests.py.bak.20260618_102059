def _row_is_available_reachtruck_source(row) -> bool:
    zone = _normalize_zone_code(str(_row_value(row, "zone", "") or _row_value(row, "zone_code", "") or ""))
    if zone == "PR":
        return False
    state = str(
        _row_value(row, "warehouse_state_code", "")
        or _row_value(row, "state", "")
        or ""
    ).strip().lower()
    if state in {
        "placed_in_receiving",
        "putaway_planned",
        "putaway_in_progress",
        "moving_to_storage",
    }:
        return False
    if _as_int(_row_value(row, "active_operation_id", 0)) > 0:
        return False
    return True


