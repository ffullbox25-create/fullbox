[Unit]
Description=Fullbox FBS marketplace order and status sync
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/opt/fullbox/fullbox
EnvironmentFile=/opt/fullbox/.env
Environment=DJANGO_SETTINGS_MODULE=fullbox.settings
ExecStart=/bin/sh -c 'exec 9>/tmp/fullbox-heavy-sync.lock; /usr/bin/flock -n 9 || exit 0; exec /opt/fullbox/.venv/bin/python /opt/fullbox/fullbox/manage.py sync_fbs_marketplaces --limit 250'
Nice=5
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal

