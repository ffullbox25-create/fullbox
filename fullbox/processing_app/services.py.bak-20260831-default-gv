                    )
            marking_qs = MarkingCode.objects.filter(
                order_type="processing",
                order_id=order_id,
                printed_at__isnull=False,
            )
            if agency:
                marking_qs = marking_qs.filter(agency=agency)
            marking_rows = marking_qs.values("sku_code", "barcode", "size").annotate(count=Count("id"))
            for item in marking_rows:
                barcode_key = (
                    str(item.get("barcode") or "").strip(),
                    str(item.get("size") or "").strip().lower(),
                )
                sku_key = (
                    str(item.get("sku_code") or "").strip().lower(),
                    str(item.get("size") or "").strip().lower(),
                )
                count_value = int(item.get("count") or 0)
                if barcode_key[0]:
                    marking_barcode_map[barcode_key] = max(marking_barcode_map.get(barcode_key, 0), count_value)
                if sku_key[0]:
                    marking_sku_map[sku_key] = max(marking_sku_map.get(sku_key, 0), count_value)

        entries_qs = OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing").order_by("created_at")
        if agency:
            entries_qs = entries_qs.filter(agency=agency)
        entries = list(entries_qs)
        placement_map: dict[tuple[str, str], dict[str, int]] = {}
        placement_entry = next(
            (
                entry
                for entry in reversed(entries)
                if (entry.payload or {}).get("act") == "placement"
            ),
            None,
        )
        placement_payload = placement_entry.payload or {} if placement_entry else {}
        placement_items = placement_payload.get("act_items") or []
        placement_boxes = placement_payload.get("act_boxes") or []
        placement_pallets = placement_payload.get("act_pallets") or []
        placement_box_items_by_code: dict[str, list[dict]] = {}
        placement_box_codes_by_key: dict[tuple[str, str], set[str]] = {}
        placement_box_codes_total: set[str] = set()
        if isinstance(placement_boxes, list):
            for box in placement_boxes:
                if not isinstance(box, dict):
                    continue
                box_code = str(box.get("code") or "").strip()
                if not box_code:
                    continue
                placement_box_codes_total.add(box_code)
                box_items = box.get("items") or []
                placement_box_items_by_code[box_code] = box_items if isinstance(box_items, list) else []
                for item in placement_box_items_by_code[box_code]:
                    if not isinstance(item, dict):
                        continue
                    sku_key = str(item.get("sku_code") or item.get("sku") or "").strip().lower()
                    size_key = str(item.get("size") or "").strip().lower()
                    if not sku_key:
                        continue
                    placement_box_codes_by_key.setdefault((sku_key, size_key), set()).add(box_code)
        placement_pallet_codes_by_key: dict[tuple[str, str], set[str]] = {}
        placement_pallet_codes_total: set[str] = set()
        if isinstance(placement_pallets, list):
            for pallet in placement_pallets:
                if not isinstance(pallet, dict):
                    continue
                pallet_code = str(pallet.get("code") or "").strip()
                if not pallet_code:
                    continue
                placement_pallet_codes_total.add(pallet_code)
                direct_items = pallet.get("items") or []
                if isinstance(direct_items, list) and direct_items:
                    source_items = direct_items
                else:
                    source_items = []
                    for box_code in pallet.get("boxes") or []:
                        code = str(box_code or "").strip()
                        if not code:
                            continue
                        source_items.extend(placement_box_items_by_code.get(code, []))
                for item in source_items:
                    if not isinstance(item, dict):
                        continue
                    sku_key = str(item.get("sku_code") or item.get("sku") or "").strip().lower()
                    size_key = str(item.get("size") or "").strip().lower()
                    if not sku_key:
                        continue
                    qty = metric_or_zero(item.get("qty") or item.get("actual_qty"))
                    if qty <= 0:
                        continue
                    placement_pallet_codes_by_key.setdefault((sku_key, size_key), set()).add(pallet_code)
        if isinstance(placement_items, list):
            for item in placement_items:
                if not isinstance(item, dict):
                    continue
                sku_key = str(item.get("sku_code") or item.get("sku") or "").strip().lower()
                size_key = str(item.get("size") or "").strip().lower()
                if not sku_key:
                    continue
                row = placement_map.setdefault((sku_key, size_key), {"qty": 0, "boxes": 0, "pallets": 0})
                row["qty"] += metric_or_zero(item.get("actual_qty") or item.get("qty"))
                row["boxes"] += metric_or_zero(item.get("box_qty"))
                row["pallets"] += metric_or_zero(item.get("pallet_qty"))
        for key, codes in placement_box_codes_by_key.items():
            row = placement_map.setdefault(key, {"qty": 0, "boxes": 0, "pallets": 0})
            if codes:
                row["boxes"] = len(codes)
        for key, codes in placement_pallet_codes_by_key.items():
            row = placement_map.setdefault(key, {"qty": 0, "boxes": 0, "pallets": 0})
            if codes:
                row["pallets"] = len(codes)

        for row in results_rows:
            if not isinstance(row, dict):
                continue
            article_key = str(row.get("article") or "").strip().lower()
            size_key = str(row.get("size") or "").strip().lower()
            barcode_key = (str(row.get("barcode") or "").strip(), size_key)
            sku_key = (article_key, size_key)
            auto_printed = max(
                job_barcode_map.get(barcode_key, 0),
                job_sku_map.get(sku_key, 0),
                marking_barcode_map.get(barcode_key, 0),
                marking_sku_map.get(sku_key, 0),
            )
            placement_data = placement_map.get(sku_key, {"qty": 0, "boxes": 0, "pallets": 0})
            auto_unboxed = int(placement_data.get("qty") or 0)
            auto_shipped = auto_unboxed
            labels_printed_value = metric_or_none(row.get("labels_printed"))
            labels_unboxed_value = metric_or_none(row.get("labels_unboxed"))
            shipped_value = metric_or_none(row.get("shipped_qty"))
            row["labels_printed"] = labels_printed_value if labels_printed_value is not None else auto_printed
            row["labels_unboxed"] = labels_unboxed_value if labels_unboxed_value is not None else auto_unboxed
            row["shipped_qty"] = shipped_value if shipped_value is not None else auto_shipped
            row["boxes_count"] = int(placement_data.get("boxes") or 0)
            row["pallets_count"] = int(placement_data.get("pallets") or 0)

        received_by_key: dict[tuple[str, str], int] = {}
        processed_by_key: dict[tuple[str, str], int] = {}
        processed_declared_by_key: dict[tuple[str, str], bool] = {}
        barcode_by_key: dict[tuple[str, str], str] = {}
        size_label_by_key: dict[tuple[str, str], str] = {}
        for row in results_rows:
            if not isinstance(row, dict):
                continue
            article_key = str(row.get("article") or "").strip().lower()
            size_key = str(row.get("size") or "").strip().lower()
            if not article_key:
                continue
            key = (article_key, size_key)
            received_by_key[key] = received_by_key.get(key, 0) + metric_or_zero(row.get("received"))
            processed_value = metric_or_none(row.get("processed"))
            if processed_value is not None:
                processed_by_key[key] = processed_by_key.get(key, 0) + processed_value
                processed_declared_by_key[key] = True
            barcode_value = str(row.get("barcode") or "").strip()
            if barcode_value and key not in barcode_by_key:
                barcode_by_key[key] = barcode_value
            size_label = str(row.get("size") or "").strip()
            if size_label and key not in size_label_by_key:
                size_label_by_key[key] = size_label

        marking_qty_map = processing_views._processing_marking_qty_by_label_key(payload)
        marking_each_qty = marking_qty_map.get(processing_views.PROCESSING_CZ_LABEL_KEY, 0)
        label_summary_rows: list[dict] = []
        for key in sorted(received_by_key.keys()):
            article_key, size_key = key
            barcode_value = barcode_by_key.get(key, "-")
            processed_qty = (
                processed_by_key.get(key, 0)
                if processed_declared_by_key.get(key)
                else received_by_key.get(key, 0)
            )
            for option in processing_views.PROCESSING_MARKING_LABELS:
                label_key = option["label_key"]
                multiplier = marking_qty_map.get(label_key, 0)
                template = cls._resolve_processing_label_template(label_key, processing_template_bindings)
                printed_no_cz = job_sku_label_map.get((label_key, article_key, size_key), 0)
                if barcode_value and barcode_value != "-":
                    printed_no_cz = max(
                        printed_no_cz,
                        job_barcode_label_map.get((label_key, barcode_value, size_key), 0),
                    )
                required_no_cz = processed_qty * multiplier
                if multiplier > 0 or printed_no_cz > 0:
                    label_summary_rows.append(
                        {
                            "article": article_key,
                            "size": size_label_by_key.get(key) or size_key or "-",
                            "barcode": barcode_value or "-",
                            "label_key": label_key,
                            "template_key": template.get("key") or label_key,
                            "layout_key": template.get("layout_key") or label_key,
                            "label_type": option["label_type"],
                            "multiplier": multiplier,
                            "required_qty": required_no_cz,
                            "printed_qty": printed_no_cz,
                        }
                    )
            printed_cz = marking_sku_map.get(key, 0)
            if barcode_value and barcode_value != "-":
                printed_cz = max(printed_cz, marking_barcode_map.get((barcode_value, size_key), 0))
            required_cz = processed_qty * (marking_each_qty or 0)
            if (marking_each_qty or 0) > 0 or printed_cz > 0:
                template = cls._resolve_processing_label_template(
                    processing_views.PROCESSING_CZ_LABEL_KEY,
                    processing_template_bindings,
                )
                label_summary_rows.append(
                    {
                        "article": article_key,
                        "size": size_label_by_key.get(key) or size_key or "-",
                        "barcode": barcode_value or "-",
                        "label_key": processing_views.PROCESSING_CZ_LABEL_KEY,
                        "template_key": template.get("key") or processing_views.PROCESSING_CZ_LABEL_KEY,
                        "layout_key": template.get("layout_key") or processing_views.PROCESSING_CZ_LABEL_KEY,
                        "label_type": processing_views.PROCESSING_CZ_LABEL_TYPE,
                        "multiplier": marking_each_qty or 0,
                        "required_qty": required_cz,
                        "printed_qty": printed_cz,
                    }
                )

        label_summary_exact_map: dict[tuple[str, str, str], list[dict]] = {}
        label_summary_key_map: dict[tuple[str, str], list[dict]] = {}
        for item in label_summary_rows:
            article_key = str(item.get("article") or "").strip().lower()
            size_key = str(item.get("size") or "").strip().lower()
            barcode_key = str(item.get("barcode") or "").strip()
            label_key = str(item.get("label_key") or "").strip() or "item"
            mode = "cz" if label_key == processing_views.PROCESSING_CZ_LABEL_KEY else "no-cz"
            normalized_item = {
                "mode": mode,
                "label_key": label_key,
                "template_key": str(item.get("template_key") or "").strip() or label_key,
                "layout_key": str(item.get("layout_key") or "").strip() or label_key,
                "label_type": str(item.get("label_type") or "").strip() or "58/40",
                "multiplier": int(item.get("multiplier") or 0),
                "required_qty": int(item.get("required_qty") or 0),
                "printed_qty": int(item.get("printed_qty") or 0),
                "barcode": barcode_key or "-",
                "size": str(item.get("size") or "").strip() or "-",
            }
            exact_key = (article_key, size_key, barcode_key)
            label_summary_exact_map.setdefault(exact_key, []).append(normalized_item)
            label_summary_key_map.setdefault((article_key, size_key), []).append(normalized_item)
        for key, items in label_summary_exact_map.items():
            label_summary_exact_map[key] = sorted(
                items,
                key=lambda value: (0 if value.get("mode") == "no-cz" else 1, value.get("label_type") or ""),
            )
        for key, items in label_summary_key_map.items():
            label_summary_key_map[key] = sorted(
                items,
                key=lambda value: (0 if value.get("mode") == "no-cz" else 1, value.get("label_type") or ""),
            )

        article_change_results_visible = False
        article_change_template = cls._resolve_processing_label_template("item", processing_template_bindings)

        placement_summary_rows: list[dict] = []
        placement_keys = set(received_by_key.keys()) | set(placement_map.keys())
        for key in sorted(placement_keys):
            article_key, size_key = key
            barcode_value = barcode_by_key.get(key, "-")
            placement_data = placement_map.get(key, {"qty": 0, "boxes": 0, "pallets": 0})
            placement_summary_rows.append(
                {
                    "article": article_key,
                    "size": size_label_by_key.get(key) or size_key or "-",
                    "barcode": barcode_value or "-",
                    "qty": int(placement_data.get("qty") or 0),
                    "boxes": int(placement_data.get("boxes") or 0),
                    "pallets": int(placement_data.get("pallets") or 0),
                }
            )
        placement_total_boxes = len(placement_box_codes_total)
        placement_total_pallets = len(placement_pallet_codes_total)
        if placement_total_boxes <= 0:
            placement_total_boxes = sum(int((item or {}).get("boxes") or 0) for item in placement_summary_rows)
        if placement_total_pallets <= 0:
            placement_total_pallets = sum(int((item or {}).get("pallets") or 0) for item in placement_summary_rows)
        for row in results_rows:
            if not isinstance(row, dict):
                continue
            article_key = str(row.get("article") or "").strip().lower()
            size_key = str(row.get("size") or "").strip().lower()
            barcode_key = str(row.get("barcode") or "").strip()
            row_print_items = label_summary_exact_map.get((article_key, size_key, barcode_key), [])
            if not row_print_items:
                row_print_items = label_summary_key_map.get((article_key, size_key), [])
            row["print_items"] = [dict(item) for item in row_print_items]
            if article_change_active:
                new_article = str(row.get("result_article") or row.get("article") or "").strip()
                if new_article:
                    source_article = str(row.get("source_article") or "").strip()
                    processed_qty = processing_views._parse_qty_value(row.get("processed")) or 0
                    new_article_key = new_article.lower()
                    printed_qty = job_sku_label_map.get(("item", new_article_key, size_key), 0)
                    if barcode_key and barcode_key != "-":
                        printed_qty = max(
                            printed_qty,
                            job_barcode_label_map.get(("item", barcode_key, size_key), 0),
                        )
                    row["article_change_article"] = new_article
                    row["article_change_source_article"] = source_article
                    row["article_change_print_items"] = [
                        {
                            "mode": "no-cz",
                            "label_key": "item",
                            "template_key": article_change_template.get("key") or "item",
                            "layout_key": article_change_template.get("layout_key") or "item",
                            "label_type": "58/40",
                            "multiplier": 1,
                            "required_qty": processed_qty,
                            "printed_qty": printed_qty,
                            "barcode": barcode_key or "-",
                            "size": str(row.get("size") or "").strip() or "-",
                        }
                    ]
                    article_change_results_visible = True

        has_direction_distribution = False
        has_defect_values = False
        has_label_values = False
        has_tag_values = False
        for row in results_rows:
            if not isinstance(row, dict):
                continue
            if (processing_views._parse_qty_value(row.get("defect")) or 0) > 0 or (
                processing_views._parse_qty_value(row.get("shortage")) or 0
            ) > 0:
                has_defect_values = True
            if (processing_views._parse_qty_value(row.get("labels_printed")) or 0) > 0 or (
                processing_views._parse_qty_value(row.get("labels_unboxed")) or 0
            ) > 0:
                has_label_values = True
            if (processing_views._parse_qty_value(row.get("tags_replaced")) or 0) > 0:
                has_tag_values = True
        result_requirements = processing_views._processing_result_requirements(
            payload,
            has_direction_distribution=has_direction_distribution,
        )
        quality_required = bool(result_requirements.get("quality"))
        labels_required = bool(result_requirements.get("labels"))
        tags_required = bool(result_requirements.get("tags"))

        ctx["processing_params"] = processing_params
        if processing_set_summary["active"]:
            for row in results_rows:
                if not isinstance(row, dict):
                    continue
                row["result_sku_id"] = str(row.get("result_sku_id") or result_sku_id_value or "").strip()
                row["set_output_selected_barcode"] = (
                    str(row.get("barcode") or "").strip()
                    if finished_identity_active
                    else ""
                )
        ctx["results_rows"] = results_rows
        ctx["label_summary_rows"] = label_summary_rows
        ctx["placement_summary_rows"] = placement_summary_rows
        ctx["placement_total_boxes"] = max(0, int(placement_total_boxes or 0))
        ctx["placement_total_pallets"] = max(0, int(placement_total_pallets or 0))
        ctx["results_quality_required"] = quality_required
        ctx["results_labels_required"] = labels_required
        ctx["results_shipping_required"] = True
        ctx["results_tags_required"] = tags_required
        ctx["results_quality_visible"] = bool(quality_required or has_defect_values)
        ctx["results_labels_visible"] = bool(labels_required or has_label_values or label_summary_rows)
        ctx["results_article_change_visible"] = bool(article_change_results_visible)
        ctx["results_shipping_visible"] = True
        ctx["results_tags_visible"] = bool(tags_required or has_tag_values)
        ctx["result_tags_owner"] = str(payload.get("tag_owner") or "").strip()
        ctx["direction_tables"] = direction_tables
        ctx["has_direction_distribution"] = has_direction_distribution
        accounting_packers = cls._processing_card_performers(
            order_id=str(order_id or ""),
            card_id=str(card_id_value or ""),
            payload=payload,
        )
        ctx["accounting_packers"] = accounting_packers
        ctx["accounting_performers_label"] = ", ".join(
            performer["name"] for performer in accounting_packers if performer.get("name")
        )
        ctx["accounting_processed_qty"] = sum(
            metric_or_zero(row.get("processed"))
            for row in results_rows
            if isinstance(row, dict)
        )
        ctx["accounting_operation_rows"] = [
            {
                "label": str(row.get("label") or "").strip(),
                "value": str(row.get("value") or "").strip(),
            }
            for row in processing_params
            if str(row.get("label") or "").strip()
        ]
        print_report_rows: list[dict] = []
        if order_id and card_id_value:
            for row in (
                ProcessingPrintJob.objects.filter(
                    order_id=str(order_id),
                    card_id=str(card_id_value),
                    status=ProcessingPrintJob.STATUS_PRINTED,
                )
                .values("requested_by")
                .annotate(copies=Sum("copies_count"))
                .order_by("requested_by")
            ):
                recipient = str(row.get("requested_by") or "").strip()
                if recipient.startswith("packer:"):
                    recipient = recipient.split(":", 2)[-1].strip()
                else:
                    recipient = "Не указано (печать до введения учета)"
                print_report_rows.append(
                    {
                        "recipient": recipient or "Не указано",
                        "copies": int(row.get("copies") or 0),
                    }
                )
        ctx["accounting_print_rows"] = print_report_rows
        ctx["accounting_print_total"] = sum(row["copies"] for row in print_report_rows)
        ctx["accounting_recorded_by"] = (
            str(selected_card.get("processing_recorded_by") or "").strip()
            if isinstance(selected_card, dict)
            else ""
        )
        ctx["processing_processed_fact_missing"] = bool(results_rows) and any(
            metric_or_none(row.get("processed")) is None
            for row in results_rows
            if isinstance(row, dict)
        )
        ctx["can_edit_results"] = bool(
            role
            in {
                "processing_head",
                "head_manager",
                "director",
                "admin",
            }
            and (
                not ctx["processing_data_confirmation_locked"]
                or ctx["processing_processed_fact_missing"]
            )
        )
        fact_edit_block_reason = cls._processing_card_fact_edit_block_reason(
            payload=payload,
            entries=entries,
            card_id=card_id_value,
        )
        ctx["processing_fact_edit_notice"] = str(request.GET.get("fact_edit") or "").strip()
        ctx["processing_fact_edit_block_reason"] = fact_edit_block_reason
        ctx["can_edit_processing_fact"] = bool(
            role in {"processing_head", "head_manager", "director", "admin"}
            and ctx["card_processed"]
            and not fact_edit_block_reason
        )
        fact_edits = payload.get(cls.PROCESSING_RESULT_EDITS_KEY) or []
        if not isinstance(fact_edits, list):
            fact_edits = []
        ctx["processing_fact_last_edit"] = next(
            (
                dict(item)
                for item in reversed(fact_edits)
                if isinstance(item, dict)
                and str(item.get("card_id") or "").strip().casefold()
                == str(card_id_value or "").strip().casefold()
            ),
            {},
        )
        return ctx

    @classmethod
    def processing_card_print_progress(
        cls,
        *,
        order_id: str,
        card_id: str,
        request,
        payload: dict,
        agency,
    ) -> ProcessingJsonResult:
        processing_views = cls._views()
        ctx = cls.build_processing_card_page_context(
            order_id=order_id,
            card_id=card_id,
            request=request,
            payload=payload,
            agency=agency,
        )
        summary_rows: list[dict] = []
        label_totals: dict[str, int] = {}
        for button in ctx.get("label_print_buttons") or []:
            if not isinstance(button, dict):
                continue
            label_key = str(button.get("label_key") or "").strip()
            if not label_key:
                continue
            label_totals[label_key] = int(button.get("printed_total") or 0)
        for row in ctx.get("results_rows") or []:
            if not isinstance(row, dict):
                continue
            barcode_value = str(row.get("barcode") or "").strip()
            size_value = str(row.get("size") or "").strip()
            row_print_items = list(row.get("print_items") or []) + list(row.get("article_change_print_items") or [])
            for item in row_print_items:
                if not isinstance(item, dict):
                    continue
                label_key = str(item.get("label_key") or "").strip() or "item"
                mode = str(item.get("mode") or "").strip() or (
                    "cz" if label_key == processing_views.PROCESSING_CZ_LABEL_KEY else "no-cz"
                )
                summary_rows.append(
                    {
                        "mode": mode,
                        "label_key": label_key,
                        "template_key": str(item.get("template_key") or "").strip() or label_key,
                        "barcode": barcode_value,
                        "size": size_value,
                        "printed_qty": int(item.get("printed_qty") or 0),
                        "required_qty": int(item.get("required_qty") or 0),
                    }
                )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "order_id": str(order_id or "").strip(),
                "card_id": str(card_id or "").strip(),
                "label_totals": label_totals,
                "summary_rows": summary_rows,
            },
        )

    @classmethod
    def build_processing_technical_card_page_context(
        cls,
        *,
        ctx: dict,
        order_id: str,
        card_id: str,
        request,
        payload: dict,
    ) -> dict:
        processing_views = cls._views()
        article_param = str(request.GET.get("article") or "").strip()
        card_context = ctx.get("card") or {}
        payload = processing_views._processing_payload_for_card_params(
            payload,
            card_id=str(card_id or "").strip(),
            article=str(
                card_context.get("source_article")
                or card_context.get("article")
                or article_param
                or ""
            ).strip(),
        )
        technical_card = dict(card_context)
        agency = getattr(request, "_processing_card_agency", None)
        sku = None
        sku_photo_url = ""
        sku_article = str(
            card_context.get("source_article")
            or article_param
            or card_context.get("article")
            or ""
        ).strip()
        if agency and sku_article:
            from sku.models import SKU

            sku = (
                SKU.objects.filter(
                    agency=agency,
                    sku_code=sku_article,
                    deleted=False,
                )
                .select_related("agency", "color_ref")
                .prefetch_related("photos")
                .first()
            )
            if sku:
                sku_photo = next(iter(sku.photos.all()), None)
                sku_photo_url = str(
                    getattr(sku_photo, "url", "")
                    or sku.img
                    or ""
                ).strip()
                if not str(technical_card.get("product_name") or "").strip():
                    technical_card["product_name"] = str(sku.name or "").strip()
                if not str(technical_card.get("photo_url") or "").strip():
                    technical_card["photo_url"] = sku_photo_url
        card_params: dict[str, str] = {}
        if article_param:
            card_params["article"] = article_param
        return_url = str(ctx.get("return_url") or "").strip()
        if return_url:
            card_params["return"] = return_url
        card_url = f"/orders/processing/{order_id}/card/{card_id or 'card'}/"
        if card_params:
            card_url = f"{card_url}?{urlencode(card_params)}"

        def raw_value(key: str) -> str:
            return str(payload.get(key) or "").strip()

        def sku_value(*values) -> str:
            for value in values:
                text = str(value or "").strip()
                if text:
                    return text
            return ""

        def is_yes(value) -> bool:
            text = str(value or "").strip().lower()
            return text in {"да", "yes", "true", "1", "file", "set", "comment", "РґР°"}

        def contains_keyword(value, keywords: tuple[str, ...]) -> bool:
            text = str(value or "").strip().lower()
            if not text:
                return False
            return any(keyword in text for keyword in keywords)

        def has_payload_value(key: str) -> bool:
            if key not in payload:
                return False
            value = payload.get(key)
            if value is None:
                return False
            if isinstance(value, bool):
                return value
            if isinstance(value, (list, tuple, set, dict)):
                return len(value) > 0
            if isinstance(value, (int, float)):
                return value != 0
            if isinstance(value, str):
                text = value.strip()
                if not text:
                    return False
                if text in {"0", "0.0", "-", "РЅРµС‚", "no", "false"}:
                    return False
                return True
            return True

        marking_sizes = processing_views._processing_marking_sizes_from_payload(payload)
        size_codes = {processing_views._normalize_marking_size_code(item) for item in marking_sizes}
        marking_qty_map = processing_views._processing_marking_qty_by_label_key(payload)

        insert_types = payload.get("insert_types") or []
        if isinstance(insert_types, str):
            insert_types = [insert_types] if insert_types else []
        insert_other = raw_value("insert_other")
        if insert_other:
            insert_types = list(insert_types) + [insert_other]

        tech = {
            "supplier": raw_value("supplier") or raw_value("warehouse_receiving") or sku_value(
                getattr(agency, "short_name", ""),
                getattr(agency, "agn_name", ""),
                getattr(agency, "fio_agn", ""),
            ),
            "brand": raw_value("brand") or sku_value(getattr(sku, "brand", "")),
            "subject": raw_value("subject") or sku_value(
                getattr(sku, "tovar_category", ""),
                getattr(sku, "vid_tovar", ""),
                getattr(sku, "type_tovar", ""),
            ),
            "article": technical_card.get("article") or raw_value("article") or sku_article,
            "wb_article": raw_value("wb_article"),
            "order_no": raw_value("order_no"),
            "purchase_1c_no": raw_value("purchase_1c_no"),
            "purchase_1c_date": raw_value("purchase_1c_date"),
            "color": raw_value("color") or sku_value(
                getattr(sku, "color", ""),
                getattr(getattr(sku, "color_ref", None), "name", ""),
            ),
            "composition": raw_value("composition") or sku_value(getattr(sku, "composition", "")),
            "gender": raw_value("gender") or sku_value(getattr(sku, "gender", "")),
            "season": raw_value("season") or sku_value(getattr(sku, "season", "")),
            "size_count": len(ctx.get("card_rows") or []),
            "measure_weight": raw_value("measure_weight"),
            "measure_width": raw_value("measure_width"),
            "measure_height": raw_value("measure_height"),
            "measure_depth": raw_value("measure_depth"),
            "defect_percent": raw_value("defect_percent"),
            "defect_qty": raw_value("defect_qty"),
            "trim_threads_qty": raw_value("trim_threads_qty"),
            "tape_qty": raw_value("tape_qty"),
            "remove_tag_qty": raw_value("remove_tag_qty"),
            "attach_tag_qty": raw_value("attach_tag_qty"),
            "marking_5840_qty": raw_value("marking_5840_qty"),
            "marking_5860_qty": raw_value("marking_5860_qty"),
            "marking_75120_qty": raw_value("marking_75120_qty"),
            "marking_5840_each_qty": raw_value("marking_5840_each_qty"),
            "marking_info": raw_value("marking_info"),
            "set_qty": raw_value("set_qty"),
            "insert_qty": raw_value("insert_qty"),
            "insert_types_text": ", ".join([str(item).strip() for item in insert_types if str(item).strip()]),
            "bubble_wrap_type": raw_value("bubble_wrap_type"),
            "bubble_wrap_size": raw_value("bubble_wrap_size"),
            "bubble_wrap_qty": raw_value("bubble_wrap_qty"),
            "bubble_wrap_supply": raw_value("bubble_wrap_supply"),
            "bag_replace_type": raw_value("bag_replace_type"),
            "bag_replace_size": raw_value("bag_replace_size"),
            "bag_replace_qty": raw_value("bag_replace_qty"),
            "bag_replace_supply": raw_value("bag_replace_supply"),
            "box_replace_type": raw_value("box_replace_type"),
            "box_replace_size": raw_value("box_replace_size"),
            "box_replace_qty": raw_value("box_replace_qty"),
            "box_replace_supply": raw_value("box_replace_supply"),
            "shrink_wrap_type": raw_value("shrink_wrap_type"),
            "shrink_wrap_size": raw_value("shrink_wrap_size"),
            "shrink_wrap_qty": raw_value("shrink_wrap_qty"),
            "invoice_no": raw_value("invoice_no"),
            "invoice_date": raw_value("invoice_date"),
            "payment_date": raw_value("payment_date"),
            "wholesale_places_qty": raw_value("wholesale_places_qty"),
            "project_manager": raw_value("project_manager"),
            "warehouse_receiving": raw_value("warehouse_receiving"),
            "warehouse_packing": raw_value("warehouse_packing"),
            "warehouse_unpacking": raw_value("warehouse_unpacking"),
            "responsible_name": raw_value("responsible_name"),
            "start_date": raw_value("start_date"),
            "end_date": raw_value("end_date"),
            "receive_date": raw_value("receive_date"),
            "accountant": raw_value("accountant"),
            "archive_date": raw_value("archive_date"),
        }
        tech_checks = {
            "measure_yes": is_yes(payload.get("measure_needed")),
            "measure_no": not is_yes(payload.get("measure_needed")),
            "remove_tag_yes": is_yes(payload.get("remove_tag")),
            "remove_tag_no": not is_yes(payload.get("remove_tag")),
            "attach_tag_yes": is_yes(payload.get("attach_tag")),
            "attach_tag_no": not is_yes(payload.get("attach_tag")),
            "marking_30_20": "30X20" in size_codes,
            "marking_58_40": "58X40" in size_codes,
            "marking_58_60": "58X60" in size_codes,
            "marking_75_120": "75X120" in size_codes,
            "set_yes": is_yes(payload.get("set_build")),
            "set_no": not is_yes(payload.get("set_build")),
            "pull_from_bag": is_yes(payload.get("pull_from_bag")),
            "insert_yes": is_yes(payload.get("insert_needed")),
            "insert_no": not is_yes(payload.get("insert_needed")),
            "bubble_wrap_yes": is_yes(payload.get("bubble_wrap_needed")),
            "bubble_wrap_no": not is_yes(payload.get("bubble_wrap_needed")),
            "bag_replace_yes": is_yes(payload.get("bag_replace_needed")),
            "bag_replace_no": not is_yes(payload.get("bag_replace_needed")),
            "box_replace_yes": is_yes(payload.get("box_replace_needed")),
            "box_replace_no": not is_yes(payload.get("box_replace_needed")),
            "shrink_wrap_yes": is_yes(payload.get("shrink_wrap_needed")),
            "shrink_wrap_no": not is_yes(payload.get("shrink_wrap_needed")),
        }
        defect_percent_raw = processing_views.re.sub(r"[^0-9.,]", "", raw_value("defect_percent")).replace(",", ".")
        defect_key = ""
        if defect_percent_raw:
            try:
                defect_value = int(float(defect_percent_raw))
                if defect_value in {0, 10, 20, 100}:
                    defect_key = str(defect_value)
            except (TypeError, ValueError):
                defect_key = ""
        tech_checks["defect_0"] = defect_key == "0"
        tech_checks["defect_10"] = defect_key == "10"
        tech_checks["defect_20"] = defect_key == "20"
        tech_checks["defect_100"] = defect_key == "100"

        tech_checks["marking_sticker_1"] = False
        tech_checks["marking_sticker_2"] = False
        tech_checks["marking_sticker_3"] = False
        for option in processing_views.PROCESSING_MARKING_LABELS:
            label_key = option["label_key"]
            qty_value = marking_qty_map.get(label_key, 0)
            field_suffix = option["size_code"].lower()
            tech_checks[f"marking_{field_suffix}_1"] = qty_value == 1
            tech_checks[f"marking_{field_suffix}_2"] = qty_value == 2
            tech_checks[f"marking_{field_suffix}_3"] = qty_value == 3
            tech_checks["marking_sticker_1"] = tech_checks["marking_sticker_1"] or qty_value == 1
            tech_checks["marking_sticker_2"] = tech_checks["marking_sticker_2"] or qty_value == 2
            tech_checks["marking_sticker_3"] = tech_checks["marking_sticker_3"] or qty_value == 3
        tech_checks["marking_cz"] = bool(raw_value("marking_5840_each_qty"))
        tech_checks["marking_info"] = bool(raw_value("marking_info"))
        tech_checks["marking_block_visible"] = (
            tech_checks["marking_sticker_1"]
            or tech_checks["marking_sticker_2"]
            or tech_checks["marking_sticker_3"]
            or tech_checks["marking_cz"]
            or tech_checks["marking_info"]
            or bool(size_codes)
        )
        tech_checks["bubble_wrap_supply_client"] = contains_keyword(
            payload.get("bubble_wrap_supply"), ("клиент", "РєР»РёРµРЅС‚", "client")
        )
        tech_checks["bubble_wrap_supply_fullbox"] = contains_keyword(
            payload.get("bubble_wrap_supply"), ("фулл", "С„СѓР»", "full")
        )
        tech_checks["bag_replace_supply_client"] = contains_keyword(
            payload.get("bag_replace_supply"), ("клиент", "РєР»РёРµРЅС‚", "client")
        )
        tech_checks["bag_replace_supply_fullbox"] = contains_keyword(
            payload.get("bag_replace_supply"), ("фулл", "С„СѓР»", "full")
        )
        tech_checks["box_replace_supply_client"] = contains_keyword(
            payload.get("box_replace_supply"), ("клиент", "РєР»РёРµРЅС‚", "client")
        )
        tech_checks["box_replace_supply_fullbox"] = contains_keyword(
            payload.get("box_replace_supply"), ("фулл", "С„СѓР»", "full")
        )
        tech_checks["set_block_visible"] = any(has_payload_value(key) for key in ("set_build", "set_qty", "pull_from_bag"))
        article_change_pairs = []
        for card in payload.get("cards") or []:
            if not isinstance(card, dict):
                continue
            source = str(card.get("article") or card.get("sku") or "").strip()
            for row in card.get("rows") or []:
                if not isinstance(row, dict):
                    continue
                result = str(row.get("result_article") or card.get("result_article") or "").strip()
                row_source = str(row.get("article") or row.get("sku") or source).strip()
                if result and result != row_source:
                    article_change_pairs.append(f"{row_source} → {result}")
                elif result:
                    article_change_pairs.append(result)
        if not article_change_pairs and str(payload.get("article_change_needed") or "").strip():
            article_change_pairs.append(str(payload.get("article_change_needed") or "").strip())
        # unique preserve order
        seen_pairs = set()
        article_change_text_parts = []
        for pair in article_change_pairs:
            if pair in seen_pairs:
                continue
            seen_pairs.add(pair)
            article_change_text_parts.append(pair)
        tech["article_change_text"] = "; ".join(article_change_text_parts)
        tech_checks["article_change_yes"] = bool(article_change_text_parts)
        tech_checks["article_change_no"] = not bool(article_change_text_parts)
        tech_checks["article_change_block_visible"] = bool(article_change_text_parts) or has_payload_value("article_change_needed")
        tech_checks["insert_block_visible"] = any(
            has_payload_value(key) for key in ("insert_needed", "insert_types", "insert_other", "insert_qty")
        )
        tech_checks["bubble_wrap_block_visible"] = any(
            has_payload_value(key)
            for key in ("bubble_wrap_needed", "bubble_wrap_type", "bubble_wrap_size", "bubble_wrap_qty", "bubble_wrap_supply")
        )
        tech_checks["bag_replace_block_visible"] = any(
            has_payload_value(key)
            for key in ("bag_replace_needed", "bag_replace_type", "bag_replace_size", "bag_replace_qty", "bag_replace_supply")
        )
        tech_checks["box_replace_block_visible"] = any(
            has_payload_value(key)
            for key in ("box_replace_needed", "box_replace_type", "box_replace_size", "box_replace_qty", "box_replace_supply")
        )
        tech_checks["shrink_wrap_block_visible"] = any(
            has_payload_value(key)
            for key in ("shrink_wrap_needed", "shrink_wrap_type", "shrink_wrap_size", "shrink_wrap_qty")
        )
        table_rows = []
        for index, row in enumerate([row for row in (ctx.get("card_rows") or []) if isinstance(row, dict)]):
            table_rows.append(
                {
                    "number": str(index + 1),
                    "size": str(row.get("size") or "").strip() or "-",
                    "barcode": str(row.get("barcode") or "").strip() or "-",
                }
            )
        return {
            "card_page_url": card_url,
            "card": technical_card,
            "tech": tech,
            "tech_checks": tech_checks,
            "tech_table_rows": table_rows,
        }

    @classmethod
    def build_processing_label_print_page_context(
        cls,
        *,
        ctx: dict,
        order_id: str,
        card_id: str,
        request,
        payload: dict,
        agency,
    ) -> dict:
        processing_views = cls._views()
        card_context = ctx.get("card") or {}
        payload = processing_views._processing_payload_for_card_params(
            payload,
            card_id=str(card_id or "").strip(),
            article=str(
                card_context.get("source_article")
                or card_context.get("article")
                or request.GET.get("article")
                or ""
            ).strip(),
        )
        label_base: dict = {}
        try:
            label_base = json.loads(ctx.get("label_base_json") or "{}")
        except (TypeError, ValueError, json.JSONDecodeError):
            label_base = {}
        card_rows = ctx.get("card_rows") or []
        barcodes = [str(row.get("barcode") or "").strip() for row in card_rows if isinstance(row, dict)]
        barcodes = [value for value in barcodes if value]
        codes_map: dict[tuple[str, str], list[str]] = {}
        if order_id and barcodes:
            base_qs = MarkingCode.objects.filter(
                order_type="processing",
                used_at__isnull=True,
                printed_at__isnull=True,
                barcode__in=barcodes,
            )
            if agency:
                base_qs = base_qs.filter(agency=agency)
            reserved_qs = base_qs.filter(order_id=order_id).order_by("created_at")
            free_qs = base_qs.filter(processing_views.Q(order_id__isnull=True) | processing_views.Q(order_id="")).order_by(
                "created_at"
            )
            codes_qs = list(reserved_qs.values("barcode", "size", "code")) + list(free_qs.values("barcode", "size", "code"))
            for entry in codes_qs:
                barcode = str(entry.get("barcode") or "").strip()
                if not barcode:
                    continue
                size_key = str(entry.get("size") or "").strip().lower()
                code = str(entry.get("code") or "").strip()
                if not code:
                    continue
                codes_map.setdefault((barcode, size_key), []).append(code)

        marking_qty_map = processing_views._processing_marking_qty_by_label_key(payload)
        processing_template_bindings = load_processing_param_template_bindings()
        no_cz_total_multiplier = sum(
            marking_qty_map.get(option["label_key"], 0)
            for option in processing_views.PROCESSING_MARKING_LABELS
        )
        multiplier_cz = marking_qty_map.get(processing_views.PROCESSING_CZ_LABEL_KEY, 0)
        for row in card_rows:
            if not isinstance(row, dict):
                continue
            barcode = str(row.get("barcode") or "").strip()
            size_key = str(row.get("size") or "").strip().lower()
            qty_value = processing_views._parse_qty_value(row.get("qty"))
            base_qty = qty_value if qty_value is not None else 0
            row["qty_value"] = base_qty
            print_qtys = {
                option["label_key"]: base_qty * marking_qty_map.get(option["label_key"], 0)
                for option in processing_views.PROCESSING_MARKING_LABELS
            }
            print_qtys[processing_views.PROCESSING_CZ_LABEL_KEY] = base_qty * multiplier_cz
            row["print_qtys"] = print_qtys
            row["print_qtys_json"] = json.dumps(print_qtys, ensure_ascii=True)
            row["print_qty_no_cz"] = base_qty * no_cz_total_multiplier
            row["print_qty_cz"] = base_qty * multiplier_cz
            codes = codes_map.get((barcode, size_key)) or codes_map.get((barcode, "")) or [] if barcode else []
            row["cz_codes"] = codes
            row["cz_codes_json"] = json.dumps(codes, ensure_ascii=True)

        default_row = None
        for row in card_rows:
            if isinstance(row, dict) and row.get("barcode"):
                default_row = row
                break
        if default_row is None and card_rows:
            default_row = card_rows[0] if isinstance(card_rows[0], dict) else {}
        if default_row is None:
            default_row = {}
        default_size = str(default_row.get("size") or "").strip()
        default_barcode = str(default_row.get("barcode") or "").strip()
        default_cz = ""
        if isinstance(default_row, dict):
            cz_codes = default_row.get("cz_codes") or []
            if cz_codes:
                default_cz = str(cz_codes[0] or "").strip()

        label_sample = {
            "article": label_base.get("article") or "",
            "name": label_base.get("name") or "",
            "size": default_size,
            "brand": label_base.get("brand") or "",
            "subject": label_base.get("subject") or "",
            "color": label_base.get("color") or "",
            "composition": label_base.get("composition") or "",
            "supplier": label_base.get("supplier") or "",
            "country": label_base.get("country") or "",
            "barcode_extra": label_base.get("barcode_extra") or "",
            "cz_code": default_cz,
        }
        allowed_label_keys = {
            option["label_key"]
            for option in processing_views.PROCESSING_MARKING_LABELS
            if marking_qty_map.get(option["label_key"], 0) > 0
        }
        if not allowed_label_keys:
            allowed_label_keys.add("item")
        if marking_qty_map.get(processing_views.PROCESSING_CZ_LABEL_KEY, 0) > 0:
            allowed_label_keys.add(processing_views.PROCESSING_CZ_LABEL_KEY)
        label_sizes = []
        ordered_label_keys = [option["label_key"] for option in processing_views.PROCESSING_MARKING_LABELS]
        ordered_label_keys.append(processing_views.PROCESSING_CZ_LABEL_KEY)
        for label_key in ordered_label_keys:
            if label_key not in allowed_label_keys:
                continue
            template = cls._resolve_processing_label_template(label_key, processing_template_bindings)
            label_sizes.append(
                {
                    "key": label_key,
                    "processing_param_key": processing_views._processing_param_key_for_label_key(label_key),
                    "template_key": template.get("key") or label_key,
                    "layout_key": template.get("layout_key") or label_key,
                    "width_mm": template.get("width_mm", 58),
                    "height_mm": template.get("height_mm", 40),
                    "preview_scale": template.get("preview_scale", 1),
                    "title": template.get("title") or label_key,
                    "button_title": template.get("button_title") or label_key,
                    "preview_title": template.get("preview_title") or label_key,
                    "description": template.get("description") or "",
                    "mode": template.get("mode") or ("cz" if label_key == processing_views.PROCESSING_CZ_LABEL_KEY else "no-cz"),
                }
            )

        agent_status = processing_views.load_print_agent_status()
        agent_name = str(agent_status.get("agent") or "").strip() or "РЅРµРёР·РІРµСЃС‚РЅРѕ"
        last_seen_raw = agent_status.get("last_seen")
        last_seen_text = "РЅРµС‚ РґР°РЅРЅС‹С…"
        is_online = False
        if last_seen_raw:
            try:
                last_seen = processing_views.datetime.fromisoformat(str(last_seen_raw))
                if timezone.is_naive(last_seen):
                    last_seen = timezone.make_aware(last_seen)
                last_seen_text = timezone.localtime(last_seen).strftime("%d.%m.%Y %H:%M:%S")
                is_online = (timezone.now() - last_seen) <= processing_views.timedelta(seconds=20)
            except (TypeError, ValueError):
                last_seen_text = str(last_seen_raw)

        queue_counts = cls._print_queue_counts_for_agent(agent_name=agent_name)
        pending_count = queue_counts["pending"]
        printing_count = queue_counts["printing"]
        failed_count = queue_counts["failed"]
        last_job = cls._scoped_print_jobs_qs(agent_name=agent_name).order_by("-updated_at").first()
        last_error = ""
        last_job_time = ""
        if last_job:
            last_job_time = timezone.localtime(last_job.updated_at).strftime("%d.%m.%Y %H:%M:%S")
            if last_job.status == ProcessingPrintJob.STATUS_FAILED:
                last_error = last_job.error or "РѕС€РёР±РєР° Р±РµР· РѕРїРёСЃР°РЅРёСЏ"
        paused = bool(agent_status.get("paused"))
        if paused:
            print_status = "РџРµС‡Р°С‚СЊ РѕСЃС‚Р°РЅРѕРІР»РµРЅР°"
        elif pending_count:
            print_status = f"Р’ РѕС‡РµСЂРµРґРё: {pending_count}"
            if not is_online:
                print_status = f"{print_status} (Р°РіРµРЅС‚ РЅРµ Р°РєС‚РёРІРµРЅ)"
        elif last_job and last_job.status == ProcessingPrintJob.STATUS_FAILED:
            print_status = "РћС€РёР±РєР° РїРµС‡Р°С‚Рё"
        elif last_job and last_job.status == ProcessingPrintJob.STATUS_PRINTING:
            print_status = "РџРµС‡Р°С‚СЊ РІС‹РїРѕР»РЅСЏРµС‚СЃСЏ"
        else:
            print_status = "Р“РѕС‚РѕРІ Рє РїРµС‡Р°С‚Рё"
        agent_line = f"{agent_name} В· {last_seen_text}" if last_seen_text else agent_name

        article_param = str(request.GET.get("article") or "").strip()
        card_context = ctx.get("card") or {}
        card_article = card_context.get("article") or ""
        card_path_id = card_id or card_article or ""
        processing_card_url = f"/orders/processing/{order_id}/card/{card_path_id}/"
        if article_param:
            processing_card_url = f"{processing_card_url}?{urlencode({'article': article_param})}"
        label_settings_url = f"/labels/settings/?{urlencode({'return': request.get_full_path()})}"

        return {
            "label_sample": label_sample,
            "label_sample_barcode": default_barcode,
            "label_rows": card_rows,
            "label_sizes": label_sizes,
            "label_settings_url": label_settings_url,
            "label_settings_save_url": label_settings_url,
            "print_status_line": print_status,
            "print_agent_line": agent_line,
            "print_last_error": last_error,
            "print_last_job_time": last_job_time,
            "print_queue_pending": pending_count,
            "print_queue_printing": printing_count,
            "print_queue_failed": failed_count,
            "print_paused": paused,
            "processing_card_url": processing_card_url,
            "article_change_active": cls._processing_article_change_requested(payload),
            "article_change_source_article": str(
                card_context.get("source_article") or ""
            ).strip(),
            "article_change_target_article": str(
                card_context.get("result_article")
                or card_context.get("article")
                or ""
            ).strip(),
        }

    @classmethod
    def handle_processing_card_action(
        cls,
        *,
        order_id: str,
        request,
        action: str,
    ) -> ProcessingCardActionResult:
        entries = list(
            OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            .select_related("agency")
            .order_by("created_at")
        )
        if not entries:
            return ProcessingCardActionResult(status="missing_order", redirect_to="/orders/")
        latest = entries[-1]
        card_id = str(request.POST.get("card_id") or "").strip()
        redirect_to = cls._processing_card_redirect_target(request)
        role = get_request_role(request)
        processing_views = cls._views()
        payload = dict(processing_views._processing_work_payload_from_entries(entries))

        if action == "edit_processing_fact":
            if role not in {"processing_head", "head_manager", "director", "admin"}:
                return ProcessingCardActionResult(status="forbidden", redirect_to=redirect_to)
            reason = str(request.POST.get("fact_edit_reason") or "").strip()
            if len(reason) < 3:
                return ProcessingCardActionResult(
                    status="reason_required",
                    redirect_to=cls._processing_card_fact_edit_redirect(request, "reason_required"),
                )
            block_reason = cls._processing_card_fact_edit_block_reason(
                payload=payload,
                entries=entries,
                card_id=card_id,
            )
            if block_reason:
                return ProcessingCardActionResult(
                    status="blocked",
                    redirect_to=cls._processing_card_fact_edit_redirect(request, "blocked"),
                )

            card_key = str(card_id or "").strip().casefold()
            all_results = payload.get("processing_results") or []
            if not isinstance(all_results, list):
                all_results = []
            card_results = [
                row
                for row in all_results
                if isinstance(row, dict)
                and str(row.get("card_id") or "").strip().casefold() == card_key
            ]
            indexes = request.POST.getlist("fact_row_index[]")
            line_keys = request.POST.getlist("fact_line_key[]")
            processed_values = request.POST.getlist("fact_processed[]")
            defect_values = request.POST.getlist("fact_defect[]")
            shortage_values = request.POST.getlist("fact_shortage[]")
            row_count = len(card_results)
            if not row_count or any(
                len(values) != row_count
                for values in (
                    indexes,
                    line_keys,
                    processed_values,
                    defect_values,
                    shortage_values,
                )
            ):
                return ProcessingCardActionResult(
                    status="invalid_fact",
                    redirect_to=cls._processing_card_fact_edit_redirect(request, "invalid"),
                )

            parsed_rows: list[tuple[dict, int, int, int]] = []
            used_indexes: set[int] = set()
            for offset in range(row_count):
                try:
                    posted_index = int(str(indexes[offset] or "").strip())
                except (TypeError, ValueError):
                    posted_index = -1
                posted_line_key = str(line_keys[offset] or "").strip().casefold()
                row_index = -1
                if posted_line_key:
                    matching_indexes = [
                        index
                        for index, row in enumerate(card_results)
                        if index not in used_indexes
                        and str(row.get("line_key") or "").strip().casefold() == posted_line_key
                    ]
                    if len(matching_indexes) == 1:
                        row_index = matching_indexes[0]
                elif 0 <= posted_index < row_count:
                    row_index = posted_index
                if row_index < 0 or row_index >= row_count or row_index in used_indexes:
                    return ProcessingCardActionResult(
                        status="invalid_fact",
                        redirect_to=cls._processing_card_fact_edit_redirect(request, "invalid"),
                    )
                target = card_results[row_index]
                stored_line_key = str(target.get("line_key") or "").strip().casefold()
                if posted_line_key != stored_line_key:
                    return ProcessingCardActionResult(
                        status="invalid_fact",
                        redirect_to=cls._processing_card_fact_edit_redirect(request, "invalid"),
                    )
                metric_values = []
                for raw_value in (
                    processed_values[offset],
                    defect_values[offset],
                    shortage_values[offset],
                ):
                    value = processing_views._parse_qty_value(raw_value)
                    if value is None or value < 0:
                        return ProcessingCardActionResult(
                            status="invalid_fact",
                            redirect_to=cls._processing_card_fact_edit_redirect(request, "invalid"),
                        )
                    metric_values.append(value)
                used_indexes.add(row_index)
                parsed_rows.append((target, *metric_values))

            changed_rows: list[dict] = []
            for target, processed_qty, defect_qty, shortage_qty in parsed_rows:
                before = {
                    "processed": str(target.get("processed") or "0"),
                    "defect": str(target.get("defect") or "0"),
                    "shortage": str(target.get("shortage") or "0"),
                }
                after = {
                    "processed": str(processed_qty),
                    "defect": str(defect_qty),
                    "shortage": str(shortage_qty),
                }
                if before == after:
                    continue
                previous_processed = processing_views._parse_qty_value(target.get("processed"))
                previous_tags_replaced = processing_views._parse_qty_value(target.get("tags_replaced"))
                target.update(after)
                if previous_tags_replaced is None or previous_tags_replaced == previous_processed:
                    target["tags_replaced"] = str(processed_qty)
                changed_rows.append(
                    {
                        "line_key": str(target.get("line_key") or ""),
                        "article": str(target.get("article") or ""),
                        "size": str(target.get("size") or ""),
                        "received": str(target.get("received") or ""),
                        "before": before,
                        "after": after,
                    }
                )

            if not changed_rows:
                return ProcessingCardActionResult(
                    status="unchanged",
                    redirect_to=cls._processing_card_fact_edit_redirect(request, "unchanged"),
                )

            edited_at = timezone.localtime().isoformat()
            edited_by = cls._processing_actor_label(request)
            edit_entry = {
                "card_id": card_id,
                "edited_at": edited_at,
                "edited_by": edited_by,
                "reason": reason[:500],
                "rows": changed_rows,
            }
            edit_history = payload.get(cls.PROCESSING_RESULT_EDITS_KEY) or []
            if not isinstance(edit_history, list):
                edit_history = []
            edit_history = [item for item in edit_history if isinstance(item, dict)]
            edit_history.append(edit_entry)
            payload[cls.PROCESSING_RESULT_EDITS_KEY] = edit_history
            payload["processing_results"] = all_results
            payload["processing_results_updated_at"] = edited_at

            confirmation = cls._processing_card_data_confirmation(payload, card_id)
            if confirmation:
                confirmation.update(
                    {
                        "fact_edited_at": edited_at,
                        "fact_edited_by": edited_by,
                        "fact_edit_reason": reason[:500],
                    }
                )
                cls._set_processing_card_data_confirmation(
                    payload,
                    card_id=card_id,
                    confirmation=confirmation,
                )
            selected_card = cls._find_processing_card(payload, card_id=card_id, article="")
            if isinstance(selected_card, dict):
                selected_card["processing_fact_edited_at"] = edited_at
                selected_card["processing_fact_edited_by"] = edited_by

            log_order_action(
                "update",
                order_id=order_id,
                order_type="processing",
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency if latest else None,
                description=f"Исправлен факт обработки карточки {card_id}. Причина: {reason[:500]}",
                payload=payload,
            )
            return ProcessingCardActionResult(
                status="saved",
                redirect_to=cls._processing_card_fact_edit_redirect(request, "saved"),
            )

        if action == "cancel_processing_param":
            if role not in {"processing_head", "head_manager", "director", "admin"}:
                return ProcessingCardActionResult(status="forbidden", redirect_to=redirect_to)
            label = str(request.POST.get("manual_param_label") or "").strip()
            normalized_label = processing_views._normalize_processing_param_label(label)
            if not normalized_label:
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            selected_card = cls._find_processing_card(payload, card_id=card_id, article="")
            selected_card_id = (
                processing_views._processing_card_id(selected_card)
                if isinstance(selected_card, dict)
                else card_id
            )
            selected_card_key = str(selected_card_id or card_id or "").strip().casefold()
            existing_card_items = processing_views._processing_card_manual_param_items(payload)
            remaining_card_items = []
            card_param_removed = False
            for item in existing_card_items:
                item_card_key = str(item.get("card_id") or "").strip().casefold()
                item_label = processing_views._normalize_processing_param_label(item.get("label"))
                if selected_card_key and item_card_key == selected_card_key and item_label == normalized_label:
                    card_param_removed = True
                    continue
                remaining_card_items.append(item)
            if card_param_removed:
                payload[processing_views.PROCESSING_CARD_EXTRA_PARAMS_KEY] = remaining_card_items
                log_order_action(
                    "update",
                    order_id=order_id,
                    order_type="processing",
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency if latest else None,
                    description=f"Удалён параметр обработки товара: {label}",
                    payload=payload,
                )
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            existing_items = processing_views._processing_manual_params_from_payload(payload)
            remaining_items = [
                {
                    "label": item.get("label") or "",
                    "value": item.get("value") or "",
                    "added_by": item.get("added_by") or "",
                    "added_at": item.get("added_at") or "",
                }
                for item in existing_items
                if processing_views._normalize_processing_param_label(item.get("label")) != normalized_label
            ]
            if len(remaining_items) == len(existing_items):
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            processing_views._clear_processing_param_from_payload(payload, label, card_id=card_id)
            payload[processing_views.PROCESSING_HEAD_EXTRA_PARAMS_KEY] = remaining_items
            log_order_action(
                "update",
                order_id=order_id,
                order_type="processing",
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency if latest else None,
                description=f"Удалён параметр обработки: {label}",
                payload=payload,
            )
            return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())

        if action == "add_processing_param":
            if role not in {"processing_head", "head_manager", "director", "admin"}:
                return ProcessingCardActionResult(status="forbidden", redirect_to=redirect_to)
            label = str(request.POST.get("manual_param_label") or "").strip()
            value = str(request.POST.get("manual_param_value") or "").strip()
            if not label:
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            selected_card = cls._find_processing_card(payload, card_id=card_id, article="")
            selected_card_id = (
                processing_views._processing_card_id(selected_card)
                if isinstance(selected_card, dict)
                else card_id
            )
            selected_article = (
                str(selected_card.get("article") or selected_card.get("sku") or "").strip()
                if isinstance(selected_card, dict)
                else ""
            )
            if not selected_card_id:
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            allowed_labels = {
                cls._normalize_processing_match_text(item)
                for item in processing_views._available_processing_param_labels(
                    payload,
                    card_id=selected_card_id,
                    article=selected_article,
                )
            }
            if cls._normalize_processing_match_text(label) not in allowed_labels:
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            sized_package_labels = {
                cls._normalize_processing_match_text("Упаковка в курьерский пакет"),
                cls._normalize_processing_match_text("Упаковка в пакет зип лок"),
            }
            if cls._normalize_processing_match_text(label) in sized_package_labels:
                package_size = str(request.POST.get("manual_param_size") or "").strip()
                package_qty_raw = str(request.POST.get("manual_param_qty") or "").strip()
                try:
                    package_qty = int(package_qty_raw)
                except (TypeError, ValueError):
                    package_qty = 0
                if not package_size or package_qty <= 0:
                    return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
                value = f"Размер: {package_size}; Кол-во: {package_qty}"
            if not value:
                return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
            article_change_label = "Изменение артикула товара"
            article_change_active = (
                cls._normalize_processing_match_text(label)
                == cls._normalize_processing_match_text(article_change_label)
            )
            target_name = ""
            target_barcode = ""
            target_barcodes: list[dict[str, str]] = []
            if article_change_active:
                from sku.models import SKU

                target_sku = (
                    SKU.objects.filter(agency=latest.agency, deleted=False, sku_code=value)
                    .prefetch_related("barcodes")
                    .first()
                )
                if not target_sku:
                    return ProcessingCardActionResult(status="ok", redirect_to=request.get_full_path())
                value = str(target_sku.sku_code or "").strip()
                target_name = str(target_sku.name or "").strip()
                for barcode in target_sku.barcodes.all():
                    barcode_value = str(barcode.value or "").strip()
                    if not barcode_value:
                        continue
                    target_barcodes.append(
                        {
                            "value": barcode_value,
                            "size": str(barcode.size or "").strip(),
                            "primary": "1" if barcode.is_primary else "",
                        }
                    )
                    if barcode.is_primary and not target_barcode:
                        target_barcode = barcode_value
                if not target_barcode and target_barcodes:
                    target_barcode = target_barcodes[0]["value"]
                if not target_barcode:
                    target_barcode = str(getattr(target_sku, "code", "") or "").strip()

                def barcode_for_size(size_value) -> str:
                    size_key = str(size_value or "").strip().casefold()
                    if size_key:
                        for item in target_barcodes:
                            if str(item.get("size") or "").strip().casefold() == size_key:
                                return str(item.get("value") or "").strip()
                    return target_barcode

                def apply_article_change(card: dict) -> None:
                    card["result_article"] = value
                    if target_name:
                        card["result_product_name"] = target_name
                    if target_barcode:
                        card["result_barcode"] = target_barcode
                    rows = card.get("rows") or []
                    if not isinstance(rows, list):
                        return
                    for row in rows:
                        if not isinstance(row, dict):
                            continue
                        row["result_article"] = value
                        if target_name:
                            row["result_product_name"] = target_name
                        row_barcode = barcode_for_size(row.get("size") or row.get("size_value") or row.get("size_no"))
                        if row_barcode:
                            row["result_barcode"] = row_barcode

                cards = payload.get("cards") or []
                if isinstance(cards, list):
                    card_candidates = [card for card in cards if isinstance(card, dict)]
                    matched = False
                    for card in card_candidates:
                        current_card_id = str(
                            card.get("id") or card.get("card_id") or card.get("article") or ""
                        ).strip()
                        current_article = str(card.get("article") or card.get("sku") or "").strip()
                        if card_id and card_id not in {current_card_id, current_article}:
                            continue
                        apply_article_change(card)
                        matched = True
                    if not matched and len(card_candidates) == 1:
                        apply_article_change(card_candidates[0])
            actor_label = ""
            if request.user.is_authenticated:
                actor_label = (
                    getattr(request.user, "get_full_name", lambda: "")()
