    @classmethod
    def _processing_card_fact_edit_block_reason(
        cls,
        *,
        payload: dict,
        entries,
        card_id: str,
    ) -> str:
        processing_views = cls._views()
        selected_card = cls._find_processing_card(payload, card_id=card_id, article="")
        if not isinstance(selected_card, dict):
            return "Товарная карточка не найдена."

        selected_id = processing_views._processing_card_id(selected_card) or str(card_id or "").strip()
        selected_key = selected_id.casefold()
        processed_cards, placed_cards = processing_views._processing_card_sets(payload)
        processed_keys = {str(value or "").strip().casefold() for value in processed_cards}
        placed_keys = {str(value or "").strip().casefold() for value in placed_cards}
        if not (
            selected_key in processed_keys
            or selected_card.get("processed_at")
            or selected_card.get("processed_done")
        ):
            return "Факт обработки ещё не зафиксирован."
        if (
            selected_key in placed_keys
            or selected_card.get("placed_at")
            or selected_card.get("placed_done")
        ):
            return "Товар уже размещён в короба. Исправление выполняется через складскую корректировку."
        if processing_views._flow_closed_from_entries(list(entries or [])):
            return "Размещение по заявке уже завершено."

        quality_review = payload.get("quality_review") or {}
        if isinstance(quality_review, dict) and str(quality_review.get("status") or "").strip().casefold() == "approved":
            return "Контроль качества уже подтверждён. Исправление выполняется через складскую корректировку."
        warehouse_commit = payload.get(cls.PROCESSING_WAREHOUSE_COMMIT_KEY) or {}
        if isinstance(warehouse_commit, dict) and str(warehouse_commit.get("status") or "").strip().casefold() == "approved":
            return "Складской результат уже проведён. Исправление выполняется через складскую корректировку."

        card_results = [
            row
            for row in (payload.get("processing_results") or [])
            if isinstance(row, dict)
            and str(row.get("card_id") or "").strip().casefold() == selected_key
        ]
        if not card_results:
            return "Сохранённый факт обработки не найден."

        placement_entry = processing_views._processing_placement_entry(list(entries or []))
        placement_payload = placement_entry.payload or {} if placement_entry else {}
        placement_items: list[dict] = []
        for item in placement_payload.get("act_items") or []:
            if isinstance(item, dict):
                placement_items.append(item)
        for box in placement_payload.get("act_boxes") or []:
            if not isinstance(box, dict):
                continue
            for item in box.get("items") or []:
                if isinstance(item, dict):
                    placement_items.append(item)

        if placement_items:
            cards = [card for card in (payload.get("cards") or []) if isinstance(card, dict)]
            card_articles = {
                str(value or "").strip().casefold()
                for value in (
                    selected_card.get("article"),
                    selected_card.get("result_article"),
                    *(row.get("article") for row in card_results),
                    *(row.get("source_article") for row in card_results),
                )
                if str(value or "").strip()
            }
            card_sizes = {
                str(row.get("size") or "").strip().casefold()
                for row in card_results
                if str(row.get("size") or "").strip()
            }
            for item in placement_items:
                qty = processing_views._parse_qty_value(item.get("qty"))
                if qty is None:
                    qty = processing_views._parse_qty_value(item.get("actual_qty"))
                if not qty or qty <= 0:
                    continue
                item_card_id = str(item.get("card_id") or "").strip().casefold()
                item_article = str(item.get("sku_code") or item.get("sku") or item.get("article") or "").strip().casefold()
                item_size = str(item.get("size") or "").strip().casefold()
                belongs_to_card = bool(item_card_id and item_card_id == selected_key)
                if not belongs_to_card and item_article in card_articles:
                    belongs_to_card = not card_sizes or not item_size or item_size in card_sizes
                if not belongs_to_card and len(cards) == 1:
                    belongs_to_card = True
                if belongs_to_card:
                    return "Товар уже начали размещать в короба. Сначала нужна складская корректировка."
        return ""

