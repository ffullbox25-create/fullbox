    @staticmethod
    def _processing_release_actor_label(user) -> str:
        if not user or not getattr(user, "is_authenticated", False):
            return "Сотрудник"
        employee = Employee.objects.filter(user=user, is_active=True).only("full_name").first()
        if employee and str(employee.full_name or "").strip():
            return str(employee.full_name).strip()
        full_name = user.get_full_name().strip() if hasattr(user, "get_full_name") else ""
        return full_name or str(getattr(user, "username", "") or user)

    @classmethod
    def _processing_pallet_releases_from_entries(cls, entries) -> dict[str, dict]:
        releases: dict[str, dict] = {}
        for entry in entries or []:
            payload = entry.payload if isinstance(entry.payload, dict) else {}
            if str(payload.get("event") or "").strip() != cls.PROCESSING_PALLET_RELEASE_EVENT:
                continue
            pallet_code = str(payload.get("pallet_code") or "").strip()
            if pallet_code:
                releases[pallet_code.casefold()] = dict(payload)
        return releases

    @classmethod
    def processing_pallet_release_statuses(cls, *, order_id: str, entries=None) -> dict[str, dict]:
        source_entries = entries
        if source_entries is None:
            source_entries = (
                OrderAuditEntry.objects.filter(
                    order_type="processing",
                    order_id=str(order_id or "").strip(),
                )
                .only("payload")
                .order_by("created_at", "id")
            )
        result: dict[str, dict] = {}
        for payload in cls._processing_pallet_releases_from_entries(source_entries).values():
            pallet_code = str(payload.get("pallet_code") or "").strip()
            if not pallet_code:
                continue
            result[pallet_code] = {
                "status": "released",
                "label": "Размещение на складе разрешено",
                "released_at": str(payload.get("released_at") or "").strip(),
                "released_by": str(payload.get("released_by") or "").strip(),
                "qty": cls._positive_int(payload.get("qty")),
            }
        return result

    @staticmethod
    def _processing_release_item_signature(item: dict) -> tuple:
        source = item if isinstance(item, dict) else {}
        raw_marking_codes = source.get("marking_codes") or []
        if not isinstance(raw_marking_codes, list):
            raw_marking_codes = [raw_marking_codes]
        marking_codes = []
        for value in raw_marking_codes:
            if isinstance(value, dict):
                value = value.get("code")
            normalized = str(value or "").strip()
            if normalized:
                marking_codes.append(normalized)
        single_marking_code = str(source.get("marking_code") or "").strip()
        if single_marking_code:
            marking_codes.append(single_marking_code)
        try:
            qty = max(int(source.get("qty") or 0), 0)
        except (TypeError, ValueError):
            qty = 0
        return (
            str(source.get("sku_code") or source.get("sku") or "").strip().casefold(),
            str(source.get("barcode") or "").strip(),
            str(source.get("name") or "").strip().casefold(),
            str(source.get("size") or "").strip().casefold(),
            str(source.get("goods_type") or "").strip().casefold(),
            str(source.get("condition") or "").strip().casefold(),
            tuple(sorted(set(marking_codes))),
            qty,
        )

    @classmethod
    def _processing_expected_barcode_totals(cls, *, entries, agency_id: int | None) -> dict[str, int]:
        processing_views = cls._views()
        payload = processing_views._processing_work_payload_from_entries(entries)
        ready_cards = processing_views._processing_flow_ready_cards(payload)
        fallback_items = processing_views._processing_receiving_items(
            payload,
            agency_id,
            ready_cards if ready_cards else None,
        )
        fact_items = cls._processing_fact_items_by_barcode(
            payload=payload,
            card_ids=ready_cards if ready_cards else None,
            fallback_items=fallback_items,
        )
        totals: dict[str, int] = {}
        for item in fact_items:
            if not isinstance(item, dict):
                continue
            barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
            qty = cls._positive_int(item.get("actual_qty") or item.get("qty"))
            if barcode and qty > 0:
                totals[barcode] = totals.get(barcode, 0) + qty
        return totals

    @classmethod
    def _processing_release_barcode_totals(cls, items) -> dict[str, int]:
        totals: dict[str, int] = {}
        for item in items or []:
            if not isinstance(item, dict):
                continue
            barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
            qty = cls._positive_int(item.get("qty"))
            if barcode and qty > 0:
                totals[barcode] = totals.get(barcode, 0) + qty
        return totals

    @staticmethod
    def _processing_release_location_signature(container: dict) -> tuple[str, str, str, str, str]:
        source = container if isinstance(container, dict) else {}
        raw_location = source.get("location")
        if isinstance(raw_location, dict):
            location = raw_location
        elif isinstance(raw_location, str):
            location = {"zone": raw_location}
        else:
            location = {}
        return (
            str(location.get("zone") or "OBR").strip().upper(),
            str(location.get("row") or "").strip(),
            str(location.get("section") or "").strip(),
            str(location.get("tier") or "").strip(),
            str(location.get("cell") or "").strip(),
        )

    @classmethod
    def _processing_pallet_signature(
        cls,
        flow_state: dict | None,
        pallet_code: str,
        *,
        include_location: bool = False,
    ) -> str:
        state = flow_state if isinstance(flow_state, dict) else {}
        normalized_code = str(pallet_code or "").strip().casefold()
        if not normalized_code:
            return ""
        pallets = state.get("pallets") if isinstance(state.get("pallets"), list) else []
        pallet = next(
            (
                row
                for row in pallets
                if isinstance(row, dict)
                and str(row.get("code") or "").strip().casefold() == normalized_code
            ),
            None,
        )
        if not pallet:
            return ""
        boxes = state.get("boxes") if isinstance(state.get("boxes"), list) else []
        boxes_by_code = {
            str(box.get("code") or "").strip().casefold(): box
            for box in boxes
            if isinstance(box, dict) and str(box.get("code") or "").strip()
        }
        pallet_box_codes = [
            str(raw_box_code or "").strip().casefold()
            for raw_box_code in (pallet.get("boxes") or [])
            if str(raw_box_code or "").strip()
        ]
        direct_pallet_direction = str(
            pallet.get("direction") or pallet.get("direction_name") or ""
        ).strip().casefold()
        inferred_pallet_direction = next(
            (
                str(
                    (boxes_by_code.get(box_code) or {}).get("direction")
                    or (boxes_by_code.get(box_code) or {}).get("direction_name")
                    or ""
                ).strip().casefold()
                for box_code in pallet_box_codes
                if str(
                    (boxes_by_code.get(box_code) or {}).get("direction")
                    or (boxes_by_code.get(box_code) or {}).get("direction_name")
                    or ""
                ).strip()
            ),
            "",
        )
        effective_pallet_direction = direct_pallet_direction or inferred_pallet_direction
        box_signatures = []
        for box_code in pallet_box_codes:
            box = boxes_by_code.get(box_code) or {}
            box_direction = str(
                box.get("direction") or box.get("direction_name") or ""
            ).strip().casefold() or effective_pallet_direction
            metrics = tuple(
                cls._positive_int(box.get(field))
                for field in WarehouseWritePathService.BOX_CHARACTERISTIC_FIELDS
            )
            box_signatures.append(
                (
                    box_code,
                    bool(box.get("sealed")),
                    box_direction,
                    metrics,
                    tuple(sorted(cls._processing_release_item_signature(item) for item in (box.get("items") or []))),
                )
            )
        signature_parts = [
            normalized_code,
            bool(pallet.get("sealed")),
            effective_pallet_direction,
        ]
        if include_location:
            signature_parts.append(cls._processing_release_location_signature(pallet))
        signature_parts.extend(
            (
                tuple(
                    sorted(
                        cls._processing_release_item_signature(item)
                        for item in (pallet.get("items") or [])
                    )
                ),
                tuple(sorted(box_signatures)),
            )
        )
        signature = tuple(signature_parts)
        raw = json.dumps(signature, ensure_ascii=False, separators=(",", ":"))
        return hashlib.sha256(raw.encode("utf-8")).hexdigest()

    @classmethod
    def _processing_release_signature_matches(
        cls,
        *,
        release: dict,
        flow_state: dict,
        pallet_code: str,
    ) -> bool:
        expected_signature = str(release.get("pallet_signature") or "").strip()
        if not expected_signature:
            return True
        signature_version = cls._positive_int(release.get("pallet_signature_version"))
        current_signature = cls._processing_pallet_signature(
            flow_state,
            pallet_code,
            include_location=signature_version < cls.PROCESSING_PALLET_SIGNATURE_VERSION,
        )
        return current_signature == expected_signature

    @classmethod
    def _processing_flow_state_from_locked_rows(cls, *, entries, sessions) -> dict:
        processing_views = cls._views()
        if sessions:
            boxes, pallets = processing_views._merge_flow_sessions(list(sessions))
            boxes, pallets = processing_views._dedupe_pallet_box_links(boxes, pallets)
            return {"boxes": boxes, "pallets": pallets}
        for entry in reversed(entries or []):
            payload = entry.payload if isinstance(entry.payload, dict) else {}
            if not payload.get("flow_closed"):
                continue
            flow_state = payload.get("flow_state") if isinstance(payload.get("flow_state"), dict) else {}
            if flow_state.get("boxes") or flow_state.get("pallets"):
                return {
                    "boxes": list(flow_state.get("boxes") or []),
                    "pallets": list(flow_state.get("pallets") or []),
                }
            return {
                "boxes": list(payload.get("act_boxes") or []),
                "pallets": list(payload.get("act_pallets") or []),
            }
        return {"boxes": [], "pallets": []}

    @classmethod
    def _released_processing_pallet_changes(cls, *, entries, flow_state: dict) -> list[str]:
        changed: list[str] = []
        for release in cls._processing_pallet_releases_from_entries(entries).values():
            pallet_code = str(release.get("pallet_code") or "").strip()
            if not pallet_code:
                continue
            if not cls._processing_release_signature_matches(
                release=release,
                flow_state=flow_state,
                pallet_code=pallet_code,
            ):
                changed.append(pallet_code)
        return changed

    @classmethod
    def _processing_pallet_payload(cls, *, flow_state: dict, pallet_code: str) -> dict:
        code_key = str(pallet_code or "").strip().casefold()
        pallets = flow_state.get("pallets") if isinstance(flow_state.get("pallets"), list) else []
        pallet = next(
            (
                row
                for row in pallets
                if isinstance(row, dict)
                and str(row.get("code") or "").strip().casefold() == code_key
            ),
            None,
        )
        if not pallet:
            return {}
        box_keys = {
            str(code or "").strip().casefold()
            for code in (pallet.get("boxes") or [])
            if str(code or "").strip()
        }
        boxes = [
            box
            for box in (flow_state.get("boxes") or [])
            if isinstance(box, dict)
            and str(box.get("code") or "").strip().casefold() in box_keys
        ]
        return {
            "act_boxes": boxes,
            "act_pallets": [pallet],
            "goods_type": str(pallet.get("goods_type") or "").strip(),
        }

    @classmethod
    def _materialize_processing_pallets_locked(
        cls,
        *,
        order_id: str,
        agency,
        entries,
        flow_state: dict,
        user=None,
        pallet_codes=None,
        release_source: str = "pallet_acceptance",
        validate_input_capacity: bool = True,
    ) -> dict:
        order_key = str(order_id or "").strip()
        requested_keys = {
            str(code or "").strip().casefold()
            for code in (pallet_codes or [])
            if str(code or "").strip()
        }
        releases = cls._processing_pallet_releases_from_entries(entries)
        pallets = flow_state.get("pallets") if isinstance(flow_state.get("pallets"), list) else []
        selected = [
            pallet
            for pallet in pallets
            if isinstance(pallet, dict)
            and str(pallet.get("code") or "").strip()
            and (
                not requested_keys
                or str(pallet.get("code") or "").strip().casefold() in requested_keys
            )
        ]
        if not selected:
            return {"status": "missing_pallet", "created": 0}

        new_pallets: list[dict] = []
        payloads_by_code: dict[str, dict] = {}
        signatures_by_code: dict[str, str] = {}
        qty_by_code: dict[str, int] = {}
        barcode_totals_by_code: dict[str, dict[str, int]] = {}
        for pallet in selected:
            code = str(pallet.get("code") or "").strip()
            code_key = code.casefold()
            signature = cls._processing_pallet_signature(flow_state, code)
            previous = releases.get(code_key)
            if previous:
                if not cls._processing_release_signature_matches(
                    release=previous,
                    flow_state=flow_state,
                    pallet_code=code,
                ):
                    return {"status": "released_pallet_changed", "pallet_code": code, "created": 0}
                continue
            if not bool(pallet.get("sealed")):
                return {"status": "pallet_open", "pallet_code": code, "created": 0}
            pallet_payload = cls._processing_pallet_payload(flow_state=flow_state, pallet_code=code)
            boxes = pallet_payload.get("act_boxes") or []
            declared_box_keys = {
                str(box_code or "").strip().casefold()
                for box_code in (pallet.get("boxes") or [])
                if str(box_code or "").strip()
            }
            actual_box_keys = {
                str(box.get("code") or "").strip().casefold()
                for box in boxes
                if isinstance(box, dict) and str(box.get("code") or "").strip()
            }
            if actual_box_keys != declared_box_keys:
                return {"status": "missing_box", "pallet_code": code, "created": 0}
            if any(not bool(box.get("sealed")) for box in boxes if isinstance(box, dict)):
                return {"status": "box_open", "pallet_code": code, "created": 0}
            items = WarehouseWritePathService._receiving_items_from_placement_payload(
                order_id=order_key,
                placement_payload=pallet_payload,
            )
            qty = sum(cls._positive_int(item.get("qty")) for item in items if isinstance(item, dict))
            if qty <= 0:
                return {"status": "empty_pallet", "pallet_code": code, "created": 0}
            new_pallets.append(pallet)
            payloads_by_code[code_key] = pallet_payload
            signatures_by_code[code_key] = signature
            qty_by_code[code_key] = qty
            barcode_totals_by_code[code_key] = cls._processing_release_barcode_totals(items)

        if not new_pallets:
            first_code = str(selected[0].get("code") or "").strip() if selected else ""
            previous = releases.get(first_code.casefold(), {})
            return {
                "status": "already_released",
                "pallet_code": first_code,
                "created": 0,
                "qty": cls._positive_int(previous.get("qty")),
                "released_at": str(previous.get("released_at") or "").strip(),
                "released_by": str(previous.get("released_by") or "").strip(),
                "snapshot_ids": list(previous.get("snapshot_ids") or []),
            }

        new_qty = sum(qty_by_code.values())
        if validate_input_capacity:
            expected_barcode_totals = cls._processing_expected_barcode_totals(
                entries=entries,
                agency_id=getattr(agency, "id", None),
            )
            released_barcode_totals: dict[str, int] = {}
            for release in releases.values():
                for row in release.get("barcode_totals") or []:
                    if not isinstance(row, dict):
                        continue
                    barcode = cls._normalize_processing_stock_barcode(row.get("barcode"))
                    qty = cls._positive_int(row.get("qty"))
                    if barcode and qty > 0:
                        released_barcode_totals[barcode] = released_barcode_totals.get(barcode, 0) + qty
            requested_barcode_totals: dict[str, int] = {}
            for totals in barcode_totals_by_code.values():
                for barcode, qty in totals.items():
                    requested_barcode_totals[barcode] = requested_barcode_totals.get(barcode, 0) + qty
            if (
                not expected_barcode_totals
                or sum(requested_barcode_totals.values()) != new_qty
                or any(
                    released_barcode_totals.get(barcode, 0) + qty
                    > expected_barcode_totals.get(barcode, 0)
                    for barcode, qty in requested_barcode_totals.items()
                )
            ):
                return {
                    "status": "output_fact_mismatch",
                    "created": 0,
                    "expected_barcode_totals": expected_barcode_totals,
                    "released_barcode_totals": released_barcode_totals,
                    "requested_barcode_totals": requested_barcode_totals,
                }
            released_qty = sum(cls._positive_int(payload.get("qty")) for payload in releases.values())
            input_qty = int(
                WarehouseStockSnapshot.objects.select_for_update(of=("self",))
                .filter(
                    agency=agency,
                    source_context_type="processing",
                    source_context_id=order_key,
                    zone_code="OBR",
                    warehouse_state_code__in=[
                        WarehouseStateCode.IN_PROCESSING_ZONE.value,
                        WarehouseStateCode.PROCESSING_IN_PROGRESS.value,
                    ],
                    is_archived=False,
                    qty__gt=0,
                )
                .aggregate(total=Sum("qty"))["total"]
                or 0
            )
            if released_qty + new_qty > input_qty:
                return {
                    "status": "input_capacity_exceeded",
                    "created": 0,
                    "input_qty": input_qty,
                    "released_qty": released_qty,
                    "requested_qty": new_qty,
                }

        combined_boxes: list[dict] = []
        combined_pallets: list[dict] = []
        combined_items: list[dict] = []
        seen_boxes: set[str] = set()
        for pallet in new_pallets:
            code = str(pallet.get("code") or "").strip()
            pallet_payload = payloads_by_code[code.casefold()]
            combined_pallets.extend(pallet_payload.get("act_pallets") or [])
            for box in pallet_payload.get("act_boxes") or []:
                box_code = str(box.get("code") or "").strip().casefold()
                if box_code and box_code not in seen_boxes:
                    seen_boxes.add(box_code)
                    combined_boxes.append(box)
            combined_items.extend(
                WarehouseWritePathService._receiving_items_from_placement_payload(
                    order_id=order_key,
                    placement_payload=pallet_payload,
                )
            )

        actor = user if getattr(user, "is_authenticated", False) else None
        placement_result = WarehouseWritePathService.create_receiving_placement(
            agency=agency,
            order_id=order_key,
            items=combined_items,
            performed_by=actor,
            source_document_type="processing_pallet_release",
            source_document_id=order_key,
            stock_context_type="processing",
            respect_item_location=True,
            warehouse_state_code=WarehouseStateCode.PLACED_AFTER_PROCESSING.value,
        )
        WarehouseWritePathService.sync_box_characteristics(
            agency=agency,
            order_id=order_key,
            order_type="processing",
            boxes=combined_boxes,
            performed_by=actor,
        )
        snapshot_rows = list(
            WarehouseStockSnapshot.objects.select_related("container", "parent_container")
            .filter(id__in=placement_result.snapshot_ids)
            .order_by("id")
        )
        snapshot_ids_by_pallet: dict[str, list[int]] = {}
        for snapshot in snapshot_rows:
            pallet_code = str(
                getattr(snapshot.parent_container, "container_code", "")
                or (
                    getattr(snapshot.container, "container_code", "")
                    if snapshot.container and snapshot.container.container_type == WarehouseContainer.TYPE_PALLET
                    else ""
                )
                or ""
            ).strip()
            if pallet_code:
                snapshot_ids_by_pallet.setdefault(pallet_code.casefold(), []).append(int(snapshot.id))

        released_at = timezone.localtime().isoformat()
        released_by = cls._processing_release_actor_label(user)
        released_by_role = ""
        if actor is not None:
            released_by_role = str(
                Employee.objects.filter(user=actor, is_active=True)
                .values_list("role", flat=True)
                .first()
                or ""
            ).strip()
        audit_rows = []
        for pallet in new_pallets:
            code = str(pallet.get("code") or "").strip()
            code_key = code.casefold()
            audit_rows.append(
                OrderAuditEntry(
                    order_id=order_key,
                    order_type="processing",
                    action="update",
                    agency=agency,
                    user=actor,
                    description=f"Размещение палеты {code} на складе разрешено",
                    payload={
                        "event": cls.PROCESSING_PALLET_RELEASE_EVENT,
                        "pallet_code": code,
                        "pallet_signature": signatures_by_code[code_key],
                        "pallet_signature_version": cls.PROCESSING_PALLET_SIGNATURE_VERSION,
                        "pallet_location_at_release": {
                            "zone": cls._processing_release_location_signature(pallet)[0],
                            "row": cls._processing_release_location_signature(pallet)[1],
                            "section": cls._processing_release_location_signature(pallet)[2],
                            "tier": cls._processing_release_location_signature(pallet)[3],
                            "cell": cls._processing_release_location_signature(pallet)[4],
                        },
                        "qty": qty_by_code[code_key],
                        "barcode_totals": [
                            {"barcode": barcode, "qty": qty}
                            for barcode, qty in sorted(barcode_totals_by_code[code_key].items())
                        ],
                        "released_at": released_at,
                        "released_by": released_by,
                        "released_by_role": released_by_role,
                        "release_source": release_source,
                        "warehouse_state_code": WarehouseStateCode.PLACED_AFTER_PROCESSING.value,
                        "snapshot_ids": snapshot_ids_by_pallet.get(code_key, []),
                    },
                )
            )
        OrderAuditEntry.objects.bulk_create(audit_rows, batch_size=500)
        first_code = str(new_pallets[0].get("code") or "").strip()
        return {
            "status": "released",
            "pallet_code": first_code,
            "created": len(new_pallets),
            "qty": new_qty,
            "released_at": released_at,
            "released_by": released_by,
            "snapshot_ids": list(placement_result.snapshot_ids),
        }

    @classmethod
    @transaction.atomic
    def release_processing_flow_pallet_to_shipping(
        cls,
        *,
        order_id: str,
        pallet_code: str,
        user=None,
    ) -> dict:
        order_key = str(order_id or "").strip()
        code = str(pallet_code or "").strip()
        if not order_key or not code:
            return {"status": "missing_pallet"}
        actor_role = ""
        actor_employee = None
        if user is not None and getattr(user, "is_authenticated", False):
            actor_employee = Employee.objects.filter(user=user, is_active=True).first()
            actor_role = str(getattr(actor_employee, "role", "") or "").strip()
        if actor_role not in cls.PROCESSING_PALLET_RELEASE_ROLES:
            return {"status": "forbidden"}
        if actor_role == "processing_worker" and (
            not actor_employee
            or not Task.objects.filter(
                route=f"/orders/processing/{order_key}/flow/",
                assigned_to=actor_employee,
            ).exclude(status="done").exists()
        ):
            return {"status": "forbidden"}
        entries = list(
            OrderAuditEntry.objects.select_for_update(of=("self",))
            .filter(order_type="processing", order_id=order_key)
            .select_related("agency")
            .order_by("created_at", "id")
        )
        if not entries or not entries[-1].agency:
            return {"status": "missing_order"}
        sessions = list(
            ProcessingFlowSession.objects.select_for_update(of=("self",))
            .filter(
                order_id=order_key,
                order_type="processing",
                status=ProcessingFlowSession.STATUS_OPEN,
            )
            .order_by("id")
        )
        flow_state = cls._processing_flow_state_from_locked_rows(entries=entries, sessions=sessions)
        return cls._materialize_processing_pallets_locked(
            order_id=order_key,
            agency=entries[-1].agency,
            entries=entries,
            flow_state=flow_state,
            user=user,
            pallet_codes=[code],
            release_source="pallet_acceptance",
            validate_input_capacity=True,
        )

    @staticmethod
    def _set_task_status(queryset, status: str) -> int:
        updated = 0
        for task in queryset.exclude(status=status):
            task.status = status
            task.save(update_fields=["status", "updated_at"])
            updated += 1
        return updated

    @staticmethod
    def _views():
        from . import views as processing_views

        return processing_views

    @staticmethod
    def _positive_int(value) -> int:
        try:
            return max(0, int(str(value or "0").strip()))
        except (TypeError, ValueError):
            return 0

    @classmethod
    def _processing_work_assignments(cls, payload: dict | None) -> list[dict]:
        raw_rows = (payload or {}).get(cls.PROCESSING_WORK_ASSIGNMENTS_KEY) or []
        if not isinstance(raw_rows, list):
            return []
        return [dict(row) for row in raw_rows if isinstance(row, dict)]

    @classmethod
    def _processing_operation_options(cls, payload: dict | None) -> list[dict]:
        processing_views = cls._views()
        options = []
        seen_keys = set()
        for index, row in enumerate(processing_views._processing_params_from_payload(payload or {})):
            if not isinstance(row, dict):
                continue
            label = processing_views._repair_mojibake_text(row.get("label") or "").strip()
            value = processing_views._repair_mojibake_text(
                row.get("display_value") or row.get("value") or ""
            ).strip()
            if not label or not value or value in {"-", "Нет", "0"}:
                continue
            key = str(row.get("key") or row.get("name") or f"operation_{index}").strip()[:128]
            if not key or key in seen_keys:
                continue
            seen_keys.add(key)
            options.append({"key": key, "label": label[:255]})
        return options or [{"key": "technical_card", "label": "Операции по техкарте"}]

    @classmethod
    def _processing_act_payload(
        cls,
        *,
        order_id: str,
        payload: dict,
        placement_payload: dict,
        status: str,
    ) -> dict:
        processing_views = cls._views()
        quantity_summary = processing_views._processing_quantity_summary(
            payload,
            placement_payload,
        )
        boxes = [
            row
            for row in (placement_payload.get("act_boxes") or [])
            if isinstance(row, dict) and str(row.get("code") or "").strip()
        ]
        pallets = [
            row
            for row in (placement_payload.get("act_pallets") or [])
            if isinstance(row, dict) and str(row.get("code") or "").strip()
        ]
        completed_assignments = [
            row
            for row in cls._processing_work_assignments(payload)
            if str(row.get("status") or "").strip().lower() == "completed"
        ]
        service_rows = []
        for row in completed_assignments:
            service_rows.append(
                {
                    "assignment_id": str(row.get("id") or "").strip(),
                    "card_id": str(row.get("card_id") or "").strip(),
                    "operation_key": str(row.get("operation_key") or "").strip(),
                    "operation_label": str(row.get("operation_label") or "Операция обработки").strip(),
                    "performer_id": cls._positive_int(row.get("assignee_id")),
                    "performer_name": str(row.get("assignee_name") or "").strip(),
                    "planned_qty": cls._positive_int(row.get("planned_qty")),
                    "actual_qty": cls._positive_int(row.get("actual_qty")),
                    "completed_at": str(row.get("completed_at") or "").strip(),
                    "comment": str(row.get("comment") or "").strip(),
                }
            )
        box_assignments = [
            dict(row)
            for row in ((payload or {}).get(cls.PROCESSING_BOX_ASSIGNMENTS_KEY) or [])
            if isinstance(row, dict)
        ]
        existing = payload.get(cls.PROCESSING_ACT_KEY)
        existing = dict(existing) if isinstance(existing, dict) else {}
        return {
            **existing,
            "version": 1,
            "order_id": str(order_id),
            "status": status,
            "declared_qty": int(quantity_summary.get("declared_qty") or 0),
            "processed_qty": int(quantity_summary.get("processed_qty") or 0),
            "boxed_qty": int(quantity_summary.get("boxed_qty") or 0),
            "boxes_count": len(boxes),
            "pallets_count": len(pallets),
            "items": [
                dict(row)
                for row in (placement_payload.get("act_items") or [])
                if isinstance(row, dict)
            ],
            "services": service_rows,
            "box_assignments": box_assignments,
            "discrepancy_items": [
                dict(row)
                for row in (placement_payload.get("discrepancy_items") or payload.get("discrepancy_items") or [])
                if isinstance(row, dict)
            ],
        }

    @classmethod
    def _strip_keep_source_boxes_empty_drafts(
        cls,
        boxes_data: list[dict],
        pallets_data: list[dict],
        expected_source_box_codes: set[str],
    ) -> tuple[list[dict], list[dict]]:
        """Ignore the empty box/pallet draft created after the last pallet is closed."""
        expected_codes = {
            str(code or "").strip().casefold()
            for code in expected_source_box_codes
            if str(code or "").strip()
        }
        removable_box_codes: set[str] = set()
        retained_boxes: list[dict] = []
        for box in boxes_data:
            if not isinstance(box, dict):
                continue
            box_code = str(box.get("code") or "").strip()
            box_key = box_code.casefold()
            if box_key in expected_codes:
                retained_boxes.append(box)
                continue
            has_items = any(
                isinstance(item, dict) and cls._positive_int(item.get("qty")) > 0
                for item in (box.get("items") or [])
            )
            if box_code and not has_items and not bool(box.get("sealed")):
                removable_box_codes.add(box_key)
                continue
            retained_boxes.append(box)

        if not removable_box_codes:
            return retained_boxes, [
                pallet for pallet in pallets_data if isinstance(pallet, dict)
            ]

        retained_pallets: list[dict] = []
        for pallet in pallets_data:
            if not isinstance(pallet, dict):
                continue
            cleaned_box_codes = [
                str(code or "").strip()
                for code in (pallet.get("boxes") or [])
                if str(code or "").strip().casefold() not in removable_box_codes
            ]
            cleaned_pallet = {**pallet, "boxes": cleaned_box_codes}
            has_items = any(
                isinstance(item, dict) and cls._positive_int(item.get("qty")) > 0
                for item in (pallet.get("items") or [])
            )
            if not cleaned_box_codes and not has_items and not bool(pallet.get("sealed")):
                continue
            retained_pallets.append(cleaned_pallet)
        return retained_boxes, retained_pallets

    @classmethod
    def _align_keep_source_fact_goods_types(
        cls,
        fact_items: list[dict],
        actual_totals: dict[tuple[str, str], dict],
    ) -> list[dict]:
        """Use the verified source-box goods type when the processing fact omitted it."""
        actual_types_by_barcode: dict[str, set[str]] = {}
        for identity, totals in actual_totals.items():
            if not isinstance(identity, tuple) or len(identity) != 2:
                continue
            barcode = cls._normalize_processing_stock_barcode(identity[0])
            goods_type = str(identity[1] or "").strip().lower()
            if not barcode or not goods_type or cls._positive_int(totals.get("total")) <= 0:
                continue
            actual_types_by_barcode.setdefault(barcode, set()).add(goods_type)

        aligned_items: list[dict] = []
        for raw_item in fact_items:
            if not isinstance(raw_item, dict):
                continue
            item = dict(raw_item)
            condition = str(item.get("condition") or "").strip().lower()
            expected_goods_type = StockAvailabilityService.normalize_goods_type(
                item.get("goods_type") or ""
            )
            if condition != "defect" and not expected_goods_type:
                barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
                actual_types = actual_types_by_barcode.get(barcode) or set()
                if len(actual_types) == 1:
                    item["goods_type"] = next(iter(actual_types))
            aligned_items.append(item)
        return aligned_items

    @classmethod
    def _keep_source_boxes_plan(
        cls,
        *,
        order_id: str,
        entries,
        payload: dict | None = None,
        allow_closed: bool = False,
        lock_snapshots: bool = False,
    ) -> dict:
        """Build a verified palletization plan from the boxes already in stock."""
        processing_views = cls._views()
        order_key = str(order_id or "").strip()
        latest = entries[-1] if entries else None
        if not order_key or not latest or not latest.agency:
            return {"ok": False, "error": "Не найден клиент заявки."}
        source_payload = dict(
            payload
            if isinstance(payload, dict)
            else processing_views._processing_work_payload_from_entries(entries)
        )
        if processing_views._flow_closed_from_entries(entries) and not allow_closed:
            return {"ok": False, "error": "Размещение по заявке уже завершено."}
        if not allow_closed and not processing_views.ProcessingFlowView()._can_complete(entries):
            return {
                "ok": False,
                "error": "Сначала завершите обработку всех товарных карт и зафиксируйте факт.",
            }

        set_plan = processing_views._processing_expected_output_plan(source_payload)
        if int(set_plan.get("set_multiplier") or 1) > 1:
            return {
                "ok": False,
                "error": "Для сборки наборов состав товара меняется — исходные короба оставить нельзя.",
            }

        selected_box_codes: list[str] = []
        selected_seen: set[str] = set()

        def add_box_codes(raw_codes) -> None:
            if isinstance(raw_codes, str):
                values = raw_codes.split(",")
            elif isinstance(raw_codes, (list, tuple, set)):
                values = raw_codes
            else:
                values = []
            for raw_code in values:
                code = str(raw_code or "").strip()
                folded = code.casefold()
                if code and folded not in selected_seen:
                    selected_seen.add(folded)
                    selected_box_codes.append(code)

        for row in source_payload.get("stock_rows") or []:
            if not isinstance(row, dict):
                continue
            add_box_codes(row.get("box_codes") or row.get("source_box_codes"))
            add_box_codes(row.get("box_code"))
        for card in source_payload.get("cards") or []:
            if not isinstance(card, dict):
                continue
            for row in card.get("rows") or []:
                if not isinstance(row, dict):
                    continue
                add_box_codes(row.get("box_codes") or row.get("source_box_codes"))
                add_box_codes(row.get("box_code"))
        if not selected_box_codes:
            return {
                "ok": False,
                "error": "В заявке не зафиксированы исходные короба товара.",
            }

        ready_cards = processing_views._processing_flow_ready_cards(source_payload)
        act_items = processing_views._processing_receiving_items(
            source_payload,
            latest.agency_id,
            ready_cards if ready_cards else None,
        )
        if not act_items:
            return {"ok": False, "error": "Не найден подтвержденный результат обработки."}
        expected_items = cls._processing_fact_items_by_barcode(
            payload=source_payload,
            card_ids=ready_cards if ready_cards else None,
            fallback_items=act_items,
        )

        def identity(*, sku_code, size, barcode) -> tuple[str, str, str]:
            return (
                str(sku_code or "").strip().casefold(),
                str(size or "").strip().casefold(),
                cls._normalize_processing_stock_barcode(barcode),
            )

        expected_totals: dict[tuple[str, str, str], int] = {}
        for item in expected_items:
            if not isinstance(item, dict):
                continue
            key = identity(
                sku_code=item.get("sku_code") or item.get("sku"),
                size=item.get("size"),
                barcode=item.get("barcode"),
            )
            qty = processing_views._parse_qty_value(item.get("actual_qty")) or 0
            if not key[0] or not key[2] or qty <= 0:
                return {
                    "ok": False,
                    "error": "В результате обработки не определены артикул, ШК или количество.",
                }
            expected_totals[key] = expected_totals.get(key, 0) + qty

        snapshot_qs = (
            WarehouseStockSnapshot.objects.select_related("container", "active_operation")
            .filter(
                agency=latest.agency,
                is_archived=False,
                qty__gt=0,
            )
            .filter(
                Q(container_code__in=selected_box_codes)
                | Q(container__container_code__in=selected_box_codes)
            )
            .order_by("container_code", "id")
        )
        if lock_snapshots:
            snapshot_qs = snapshot_qs.select_for_update(of=("self",))
        snapshots = list(snapshot_qs)
        snapshots_by_box: dict[str, list] = {code: [] for code in selected_box_codes}
        selected_code_by_folded = {code.casefold(): code for code in selected_box_codes}
        source_totals: dict[tuple[str, str, str], int] = {}
        for snapshot in snapshots:
            code = str(
                snapshot.container_code
                or getattr(snapshot.container, "container_code", "")
                or ""
            ).strip()
            canonical_code = selected_code_by_folded.get(code.casefold())
            if not canonical_code:
                continue
            if (
                bool(snapshot.is_in_vehicle)
                or bool(str(snapshot.current_trip_id or "").strip())
                or int(snapshot.shipping_reserved_qty or 0) > 0
                or str(snapshot.zone_code or "").strip().upper() == "OTG"
                or str(snapshot.warehouse_state_code or "").strip().lower()
                in {"ready_for_loading", "loaded", "shipped"}
            ):
                return {
                    "ok": False,
                    "error": f"Короб {canonical_code} уже участвует в отгрузке.",
                }
            active_operation = snapshot.active_operation
            if active_operation and (
                str(active_operation.context_type or "").strip().lower() != "processing"
                or str(active_operation.context_id or "").strip() != order_key
            ):
                return {
                    "ok": False,
                    "error": f"По коробу {canonical_code} выполняется другая складская операция.",
                }
            snapshots_by_box[canonical_code].append(snapshot)
            key = identity(
                sku_code=snapshot.sku_code,
                size=snapshot.size,
                barcode=snapshot.barcode,
            )
            source_totals[key] = source_totals.get(key, 0) + int(snapshot.qty or 0)

        missing_boxes = [code for code, rows in snapshots_by_box.items() if not rows]
        if missing_boxes:
            return {
                "ok": False,
                "error": "Не найдены в складском учете исходные короба: " + ", ".join(missing_boxes),
            }
        if source_totals != expected_totals:
            return {
                "ok": False,
                "error": (
                    "Состав, ШК или количество после обработки отличаются от исходных коробов. "
                    "Используйте обычное формирование коробов."
                ),
            }

        boxes: list[dict] = []
        for box_code in selected_box_codes:
            grouped: dict[tuple[str, str, str, str, str], dict] = {}
            for snapshot in snapshots_by_box[box_code]:
                key = (
                    str(snapshot.sku_code or "").strip(),
                    str(snapshot.name or "").strip(),
                    str(snapshot.size or "").strip(),
                    str(snapshot.barcode or "").strip(),
                    str(snapshot.goods_type or "").strip(),
                )
                item = grouped.setdefault(
                    key,
                    {
                        "sku_code": key[0],
                        "sku": key[0],
                        "name": key[1],
                        "size": key[2],
                        "barcode": key[3],
                        "goods_type": key[4],
                        "qty": 0,
                        "marking_codes": [],
                    },
                )
                item["qty"] += int(snapshot.qty or 0)
                marking_code = str(snapshot.marking_code or "").strip()
                if marking_code and marking_code not in item["marking_codes"]:
                    item["marking_codes"].append(marking_code)
            items = list(grouped.values())
            total_qty = sum(int(item.get("qty") or 0) for item in items)
            marking_count = sum(len(item.get("marking_codes") or []) for item in items)
            if marking_count not in {0, total_qty}:
                return {
                    "ok": False,
                    "error": f"В коробе {box_code} неполные данные ЧЗ — требуется обычная раскоробовка.",
                }
            for item in items:
                if not item.get("marking_codes"):
                    item.pop("marking_codes", None)
            boxes.append(
                {
                    "code": box_code,
                    "items": items,
                    "sealed": True,
                    "goods_type": str(items[0].get("goods_type") or "") if items else "",
                    "marking_mode": cls.MARKING_MODE_WITH_CZ if marking_count else cls.MARKING_MODE_WITHOUT_CZ,
                }
            )
        return {
            "ok": True,
            "boxes": boxes,
            "box_codes": selected_box_codes,
            "box_count": len(boxes),
            "qty": sum(sum(int(item.get("qty") or 0) for item in box["items"]) for box in boxes),
        }

    @classmethod
    def enable_keep_source_boxes(
        cls,
        *,
        order_id: str,
        entries,
        request,
    ) -> ProcessingKeepSourceBoxesResult:
        processing_views = cls._views()
        role = get_request_role(request)
        if role not in {"processing_head", "head_manager", "director", "admin"}:
            return ProcessingKeepSourceBoxesResult(status="forbidden", error_message="Доступ запрещен.")
        order_key = str(order_id or "").strip()
        latest = entries[-1] if entries else None
        payload = processing_views._processing_work_payload_from_entries(entries)
        plan = cls._keep_source_boxes_plan(
            order_id=order_key,
            entries=entries,
            payload=payload,
        )
        if not plan.get("ok"):
            return ProcessingKeepSourceBoxesResult(
                status="not_allowed",
                error_message=str(plan.get("error") or "Режим недоступен."),
            )
        if not latest or not latest.agency:
            return ProcessingKeepSourceBoxesResult(status="not_allowed", error_message="Не найден клиент заявки.")

        actor = get_request_employee(request)
        user = request.user if request.user.is_authenticated else None
        actor_label = cls._processing_actor_label(request)
        with transaction.atomic():
            open_sessions = list(
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    order_id=order_key,
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("-updated_at", "-id")
            )
            session = next(
                (item for item in open_sessions if user and item.user_id == user.id),
                None,
            )
            if session is None:
                session = ProcessingFlowSession.objects.create(
                    order_id=order_key,
                    order_type="processing",
                    agent_id="",
                    user=user,
                    employee=actor,
                    flow_state={},
                    status=ProcessingFlowSession.STATUS_OPEN,
                    last_seen=timezone.localtime(),
                )
            reusable_pallet_code = ""
            reusable_fixed_order = 1
            for candidate_session in [session, *open_sessions]:
                candidate_state = candidate_session.flow_state if isinstance(candidate_session.flow_state, dict) else {}
                for pallet in candidate_state.get("pallets") or []:
                    if not isinstance(pallet, dict):
                        continue
                    code = str(pallet.get("code") or "").strip()
                    if code:
                        reusable_pallet_code = code
                        reusable_fixed_order = max(int(pallet.get("fixed_order") or 1), 1)
                        break
                if reusable_pallet_code:
                    break
            pallet_code = reusable_pallet_code or issue_pallet_code(
                agency=latest.agency,
                goods_type=str(payload.get("goods_type") or ""),
                order_type="processing",
                order_id=order_key,
            )["code"]
            owner = {
                "owner_agent_id": str(session.agent_id or ""),
                "owner_user_id": str(user.id) if user else "",
                "owner_user_label": actor_label,
            }
            boxes = [{**box, **owner} for box in plan["boxes"]]
            flow_state = {
                "boxes": boxes,
                "pallets": [
                    {
                        "code": pallet_code,
                        "boxes": list(plan["box_codes"]),
                        "items": [],
                        "sealed": False,
                        "fixed_order": reusable_fixed_order,
                        "location": {"zone": "OBR", "row": "", "section": "", "tier": "", "cell": ""},
                        **owner,
                    }
                ],
                "activeBox": "",
                "activePallet": pallet_code,
            }
            for other in open_sessions:
                if other.pk == session.pk:
                    continue
                other.status = ProcessingFlowSession.STATUS_CLOSED
                other.last_seen = timezone.localtime()
                other.save(update_fields=["status", "last_seen", "updated_at"])
            session.user = user
            session.employee = actor
            session.flow_state = flow_state
            session.status = ProcessingFlowSession.STATUS_OPEN
            session.last_seen = timezone.localtime()
            session.save(
                update_fields=["user", "employee", "flow_state", "status", "last_seen", "updated_at"]
            )
            mode_payload = {
                cls.PROCESSING_PACKAGING_MODE_KEY: cls.PROCESSING_PACKAGING_MODE_KEEP_SOURCE_BOXES,
                cls.PROCESSING_KEEP_SOURCE_BOXES_KEY: {
                    "status": "active",
                    "enabled_at": timezone.localtime().isoformat(),
                    "enabled_by": actor_label,
                    "source_box_codes": list(plan["box_codes"]),
                    "source_box_count": int(plan["box_count"]),
                    "source_qty": int(plan["qty"]),
                    "pallet_code": pallet_code,
                },
            }
            log_order_action(
                "update",
                order_id=order_key,
                order_type="processing",
                user=user,
                agency=latest.agency,
                description="Выбран режим: оставить товар в исходных коробах",
                payload=mode_payload,
            )
            cls._set_task_status(
                Task.objects.filter(route=processing_views._processing_packaging_task_route(order_key)),
                "done",
            )
        return ProcessingKeepSourceBoxesResult(
            status="enabled",
            box_count=int(plan["box_count"]),
            pallet_code=pallet_code,
        )

    @classmethod
    def _commit_processing_result_after_head_approval(
        cls,
        *,
        order_id: str,
        payload: dict,
        entries,
        request,
        role: str,
    ) -> tuple[bool, str]:
        processing_views = cls._views()
        commit_state = payload.get(cls.PROCESSING_WAREHOUSE_COMMIT_KEY)
        commit_state = dict(commit_state) if isinstance(commit_state, dict) else {}
        if str(commit_state.get("status") or "").strip().lower() == "approved":
            return True, ""
        latest = entries[-1] if entries else None
        if not latest or not latest.agency:
            return False, "Не найден клиент заявки для складской фиксации."
        finish_checks = processing_views._processing_finish_checks(str(order_id), payload, list(entries))
        placement_payload = finish_checks.get("placement_payload") or {}
        if not finish_checks.get("placement_closed") or not placement_payload:
            return False, "Сначала завершите формирование коробов и палет."
        quantity_summary = finish_checks.get("quantity_summary") or {}
        expected_output_qty = int(
            quantity_summary.get("boxed_qty")
            or quantity_summary.get("processed_qty")
            or 0
        )
        set_output_plan = processing_views._processing_expected_output_plan(payload)
        if int(set_output_plan.get("set_multiplier") or 1) > 1:
            if set_output_plan.get("remainders"):
                return False, (
                    "Количество исходного товара не делится на коэффициент набора."
                )
            expected_output_qty = int(set_output_plan.get("source_qty_total") or 0)
        discrepancy_status = str(payload.get("discrepancy_status") or "").strip().lower()
        approved_discrepancy = bool(
            role == "processing_head"
            and discrepancy_status in {"approved_pending_warehouse", "approved"}
        )
        keep_source_boxes_mode = (
            str(payload.get(cls.PROCESSING_PACKAGING_MODE_KEY) or "").strip().lower()
            == cls.PROCESSING_PACKAGING_MODE_KEEP_SOURCE_BOXES
        )
        keep_source_boxes_plan: dict = {}
        consumed_input_qty = 0
        surplus_qty = 0
        try:
            with transaction.atomic():
                current_entries = list(
                    OrderAuditEntry.objects.select_for_update(of=("self",))
                    .filter(order_id=str(order_id), order_type="processing")
                    .select_related("agency")
                    .order_by("created_at", "id")
                )
                processing_operation = None
                if keep_source_boxes_mode:
                    keep_source_boxes_plan = cls._keep_source_boxes_plan(
                        order_id=str(order_id),
                        entries=current_entries,
                        payload=payload,
                        allow_closed=True,
                        lock_snapshots=True,
                    )
                    if not keep_source_boxes_plan.get("ok"):
                        return False, str(
                            keep_source_boxes_plan.get("error")
                            or "Не удалось повторно проверить исходные короба."
                        )
                    expected_box_codes = {
                        str(code or "").strip().casefold()
                        for code in (keep_source_boxes_plan.get("box_codes") or [])
                        if str(code or "").strip()
                    }
                    placement_box_codes = {
                        str(box.get("code") or "").strip().casefold()
                        for box in (placement_payload.get("act_boxes") or [])
                        if isinstance(box, dict) and str(box.get("code") or "").strip()
                    }
                    pallet_box_codes = {
                        str(code or "").strip().casefold()
                        for pallet in (placement_payload.get("act_pallets") or [])
                        if isinstance(pallet, dict)
                        for code in (pallet.get("boxes") or [])
                        if str(code or "").strip()
                    }
                    if (
                        not expected_box_codes
                        or placement_box_codes != expected_box_codes
                        or pallet_box_codes != expected_box_codes
                    ):
                        return False, "Исходные короба изменились или не полностью поставлены на палету."
                    consumed_input_qty = int(keep_source_boxes_plan.get("qty") or 0)
                    if consumed_input_qty != expected_output_qty:
                        return False, (
                            "Количество товара в исходных коробах не совпадает с результатом обработки."
                        )
                else:
                    processing_operation = WarehouseWritePathService.consume_processing_input(
                        agency=latest.agency,
                        order_id=str(order_id),
                        performed_by=request.user if request.user.is_authenticated else None,
                        performed_by_role=role,
                        expected_output_qty=expected_output_qty,
                        allow_obr_remainder=bool(
                            role == "processing_head"
                            and int(quantity_summary.get("declared_qty") or 0) > expected_output_qty
                        ),
                        allow_output_surplus=approved_discrepancy,
                    )
                    consumed_input_qty = int(getattr(processing_operation, "done_qty", 0) or 0)
                placement_flow_state = {
                    "boxes": list(placement_payload.get("act_boxes") or []),
                    "pallets": list(placement_payload.get("act_pallets") or []),
                }
                release_result = cls._materialize_processing_pallets_locked(
                    order_id=str(order_id),
                    agency=latest.agency,
                    entries=current_entries,
                    flow_state=placement_flow_state,
                    user=request.user if request.user.is_authenticated else None,
                    release_source="final_quality_approval",
                    validate_input_capacity=False,
                )
                if release_result.get("status") not in {"released", "already_released"}:
                    raise ValueError(
                        "Не удалось опубликовать результат обработки по палетам: "
                        f"{release_result.get('status') or 'unknown_error'}."
                    )
                surplus_qty = max(expected_output_qty - consumed_input_qty, 0)
                if surplus_qty:
                    output_snapshot = (
                        WarehouseStockSnapshot.objects.filter(
                            agency=latest.agency,
                            source_context_type="processing",
                            source_context_id=str(order_id),
                            warehouse_state_code=WarehouseStateCode.PLACED_AFTER_PROCESSING.value,
                            is_archived=False,
                            qty__gt=0,
                        )
                        .select_related("location")
                        .order_by("id")
                        .first()
                    )
                    WarehouseEvent.objects.create(
                        agency=latest.agency,
                        event_type=WarehouseEventType.STOCK_CORRECTED.value,
                        stock_context_type="processing",
                        stock_context_id=str(order_id),
                        operation=processing_operation,
                        source_document_type="processing_discrepancy_approval",
                        source_document_id=str(order_id),
                        to_location=getattr(output_snapshot, "location", None),
                        to_zone_code=str(getattr(output_snapshot, "zone_code", "") or "OBR"),
                        qty=surplus_qty,
                        performed_by=request.user if request.user.is_authenticated else None,
                        performed_by_role=role,
                        occurred_at=timezone.now(),
                        payload={
                            "correction_kind": "approved_processing_surplus",
                            "input_qty": consumed_input_qty,
                            "output_qty": expected_output_qty,
                            "surplus_qty": surplus_qty,
                            "discrepancy_items": payload.get("discrepancy_items") or [],
                        },
                    )
                processing_views._sync_processing_obr_remainder_task(
                    order_id,
                    latest.agency,
                    request,
                    planned_qty=int(quantity_summary.get("declared_qty") or 0),
                    processed_qty=int(
                        quantity_summary.get("boxed_qty")
                        or quantity_summary.get("processed_qty")
                        or 0
                    ),
                )
        except ValueError as exc:
            return False, processing_views._repair_mojibake_text(str(exc))
        now_iso = timezone.localtime().isoformat()
        payload[cls.PROCESSING_WAREHOUSE_COMMIT_KEY] = {
            **commit_state,
            "status": "approved",
            "approved_at": now_iso,
            "approved_by": cls._processing_actor_label(request),
            "approved_by_role": role,
            "expected_output_qty": expected_output_qty,
            "consumed_input_qty": consumed_input_qty,
            "surplus_qty": surplus_qty,
            "input_validation": (
                "source_boxes_verified" if keep_source_boxes_mode else "obr_scan"
            ),
            "source_box_codes": list(keep_source_boxes_plan.get("box_codes") or []),
        }
        if keep_source_boxes_mode:
            remaining_discrepancies = [
                row
                for row in (payload.get("discrepancy_items") or [])
                if not (
                    isinstance(row, dict)
                    and str(row.get("discrepancy_type") or "").strip().lower()
                    == "processing_stock_balance"
                )
            ]
            if remaining_discrepancies:
                payload["discrepancy_items"] = remaining_discrepancies
            else:
                for key in (
                    "processing_stock_discrepancy",
                    "discrepancy_detected",
                    "discrepancy_items",
                    "discrepancy_act_label",
                    "discrepancy_act_created_at",
                    "discrepancy_status",
                ):
                    payload.pop(key, None)
        payload[cls.PROCESSING_ACT_KEY] = {
            **cls._processing_act_payload(
                order_id=str(order_id),
                payload=payload,
                placement_payload=placement_payload,
                status="confirmed",
            ),
            "head_confirmed_at": now_iso,
            "head_confirmed_by": cls._processing_actor_label(request),
            "confirmation_policy": "quality_control",
            "manager_response": "not_required",
            "client_response": "read_only",
            "confirmed_at": now_iso,
            "confirmed_by": cls._processing_actor_label(request),
        }
        return True, ""

    @staticmethod
    def processing_warehouse_cancel_request_payload(entries) -> dict:
        for entry in reversed(entries or []):
            payload = dict(entry.payload or {})
            action = str(entry.action or "").strip().lower()
            status = str(payload.get("status") or "").strip().lower()
            if action == "warehouse_cancel_request" or status == "warehouse_cancel_requested":
                return payload
            if action in {"warehouse_cancel_rejected", "warehouse_cancel_approved"}:
                return {}
            if status in {"cancelled", "canceled", "done", "completed", "closed"}:
                return {}
        return {}

    @staticmethod
    def requires_processing_warehouse_cancel_confirmation(payload: dict | None) -> bool:
        return bool(
            not processing_is_cancelled(payload)
            and not processing_is_done(payload)
            and processing_stage_at_least(payload, PROCESSING_STAGE_MANAGER_APPROVED)
        )

    @classmethod
    def _ensure_processing_warehouse_cancel_review_task(
        cls,
        *,
        order_id: str,
        agency,
        user=None,
        reason: str = "",
    ) -> bool:
        reviewer = (
            Employee.objects.filter(role="processing_head", is_active=True)
            .order_by("full_name")
            .first()
        )
        if reviewer is None:
            return False
        route = f"/orders/processing/{order_id}/"
        title = f"Подтвердите отмену обработки №{order_id}"
        client_name = (
            getattr(agency, "agn_name", None)
            or getattr(agency, "inn", None)
            or getattr(agency, "id", "")
        )
        description = f"Клиент: {client_name}"
        if str(reason or "").strip():
            description += f"\nПричина отмены: {str(reason).strip()}"
        task = (
            Task.objects.filter(route=route, assigned_to=reviewer, title=title)
