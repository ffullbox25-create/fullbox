    @classmethod
    def inspect_processing_box_marking_mode(cls, box: dict | None) -> dict:
        processing_views = cls._views()
        source = box if isinstance(box, dict) else {}
        raw_mode = str(source.get("marking_mode") or "").strip().lower()
        items = source.get("items") or []
        if not isinstance(items, list):
            items = []

        total_qty = 0
        marking_codes: list[str] = []
        item_mismatch = False
        for item in items:
            if not isinstance(item, dict):
                continue
            qty = processing_views._parse_qty_value(item.get("qty")) or 0
            if qty <= 0:
                continue
            total_qty += qty
            raw_codes = item.get("marking_codes") or []
            if not isinstance(raw_codes, list):
                raw_codes = [raw_codes]
            item_codes: list[str] = []
            for raw_code in raw_codes:
                if isinstance(raw_code, dict):
                    raw_code = raw_code.get("code")
                code = processing_views._normalize_marking_code(raw_code or "")
                if code:
                    item_codes.append(marking_code_identity(code))
            marking_codes.extend(item_codes)
            if item_codes and (len(item_codes) != len(set(item_codes)) or len(set(item_codes)) != qty):
                item_mismatch = True

        unique_marking_codes = set(marking_codes)
        if raw_mode and raw_mode not in cls.MARKING_MODE_VALUES:
            return {
                "ok": False,
                "status": "invalid_mode",
                "mode": raw_mode,
                "qty": total_qty,
                "marking_count": len(unique_marking_codes),
            }

        inferred_mode = raw_mode
        if not inferred_mode and total_qty > 0:
            inferred_mode = (
                cls.MARKING_MODE_WITH_CZ
                if unique_marking_codes
                else cls.MARKING_MODE_WITHOUT_CZ
            )

        if total_qty <= 0:
            valid = not unique_marking_codes
        elif inferred_mode == cls.MARKING_MODE_WITH_CZ:
            valid = (
                not item_mismatch
                and len(marking_codes) == len(unique_marking_codes)
                and len(unique_marking_codes) == total_qty
            )
        elif inferred_mode == cls.MARKING_MODE_WITHOUT_CZ:
            valid = not unique_marking_codes
        else:
            valid = False

        return {
            "ok": valid,
            "status": "ok" if valid else "marking_mode_conflict",
            "mode": inferred_mode,
            "qty": total_qty,
            "marking_count": len(unique_marking_codes),
        }

    @classmethod
    def apply_processing_box_marking_mode(cls, box: dict | None) -> dict:
        result = cls.inspect_processing_box_marking_mode(box)
        if result["ok"] and result["mode"] and isinstance(box, dict):
            box["marking_mode"] = result["mode"]
        return result

    @classmethod
    def validate_processing_flow_box_modes(cls, boxes: list | None) -> dict:
        seen_markings: dict[str, str] = {}
        for box in boxes or []:
            if not isinstance(box, dict):
                continue
            result = cls.apply_processing_box_marking_mode(box)
            if not result["ok"]:
                return {
                    **result,
                    "box_code": str(box.get("code") or "").strip(),
                }
            box_code = str(box.get("code") or "").strip()
            for item in box.get("items") or []:
                if not isinstance(item, dict):
                    continue
                raw_codes = item.get("marking_codes") or []
                if not isinstance(raw_codes, list):
                    raw_codes = [raw_codes]
                for raw_code in raw_codes:
                    if isinstance(raw_code, dict):
                        raw_code = raw_code.get("code")
                    identity = marking_code_identity(raw_code or "")
                    if not identity:
                        continue
                    original_box = seen_markings.get(identity)
                    if original_box and original_box != box_code:
                        return {
                            "ok": False,
                            "status": "duplicate_marking_code",
                            "mode": result.get("mode") or "",
                            "box_code": box_code,
                            "original_box_code": original_box,
                        }
                    seen_markings[identity] = box_code
        return {"ok": True, "status": "ok", "box_code": ""}

    @classmethod
    def processing_box_cancellation_history(
        cls,
        *,
        order_id: str,
        entries=None,
    ) -> list[dict]:
        source_entries = entries
        if source_entries is None:
            source_entries = (
                OrderAuditEntry.objects.filter(
                    order_id=str(order_id),
                    order_type="processing",
                )
                .select_related("user")
                .order_by("created_at", "id")
            )
        history = []
        for entry in source_entries or []:
            payload = entry.payload if isinstance(entry.payload, dict) else {}
            cancellation = payload.get("processing_box_cancellation")
            if not isinstance(cancellation, dict):
                continue
            box_code = str(cancellation.get("box_code") or "").strip()
            if not box_code:
                continue
            record = dict(cancellation)
            record["box_code"] = box_code
            record["audit_entry_id"] = entry.id
            if not record.get("canceled_at") and entry.created_at:
                record["canceled_at"] = entry.created_at.isoformat()
            canceled_at = parse_datetime(str(record.get("canceled_at") or ""))
            if canceled_at:
                if timezone.is_naive(canceled_at):
                    canceled_at = timezone.make_aware(
                        canceled_at,
                        timezone.get_current_timezone(),
                    )
                record["canceled_at_display"] = timezone.localtime(
                    canceled_at
                ).strftime("%d.%m.%Y %H:%M")
            else:
                record["canceled_at_display"] = str(
                    record.get("canceled_at") or ""
                )
            if not record.get("canceled_by") and entry.user:
                record["canceled_by"] = (
                    entry.user.get_full_name()
                    or entry.user.username
                    or str(entry.user_id)
                )
            history.append(record)
        return history

    @classmethod
    def canceled_processing_box_codes(
        cls,
        *,
        order_id: str,
        entries=None,
    ) -> set[str]:
        return {
            str(item.get("box_code") or "").strip()
            for item in cls.processing_box_cancellation_history(
                order_id=str(order_id),
                entries=entries,
            )
            if str(item.get("box_code") or "").strip()
        }

    @classmethod
    def is_processing_box_canceled(
        cls,
        *,
        order_id: str,
        box_code: str,
        entries=None,
    ) -> bool:
        normalized_box_code = str(box_code or "").strip()
        return bool(
            normalized_box_code
            and normalized_box_code
            in cls.canceled_processing_box_codes(
                order_id=str(order_id),
                entries=entries,
            )
        )

    @classmethod
    def strip_canceled_processing_boxes_from_flow_state(
        cls,
        flow_state: dict | None,
        canceled_box_codes: set[str] | None,
    ) -> tuple[dict, dict]:
        source = flow_state if isinstance(flow_state, dict) else {}
        canceled_codes = {
            str(code or "").strip()
            for code in (canceled_box_codes or set())
            if str(code or "").strip()
        }
        boxes = []
        removed_box_codes: list[str] = []
        removed_qty = 0
        for raw_box in source.get("boxes") or []:
            if not isinstance(raw_box, dict):
                continue
            box = dict(raw_box)
            box_code = str(box.get("code") or "").strip()
            if not box_code:
                continue
            box["code"] = box_code
            if box_code in canceled_codes:
                removed_box_codes.append(box_code)
                removed_qty += cls._views()._flow_box_items_count(box)
                continue
            boxes.append(box)

        remaining_box_codes = {
            str(box.get("code") or "").strip()
            for box in boxes
            if isinstance(box, dict) and str(box.get("code") or "").strip()
        }
        pallets = []
        removed_pallet_links = 0
        for raw_pallet in source.get("pallets") or []:
            if not isinstance(raw_pallet, dict):
                continue
            pallet = dict(raw_pallet)
            pallet_code = str(pallet.get("code") or "").strip()
            if not pallet_code:
                continue
            pallet["code"] = pallet_code
            raw_links = [
                str(code or "").strip()
                for code in (pallet.get("boxes") or [])
                if str(code or "").strip()
            ]
            pallet["boxes"] = [
                code
                for code in raw_links
                if code in remaining_box_codes and code not in canceled_codes
            ]
            removed_pallet_links += len(raw_links) - len(pallet["boxes"])
            pallets.append(pallet)

        active_box = str(source.get("activeBox") or "").strip()
        active_pallet = str(source.get("activePallet") or "").strip()
        active_box_cleared = bool(
            active_box
            and (
                active_box in canceled_codes
                or active_box not in remaining_box_codes
            )
        )
        if active_box_cleared:
            active_box = ""
        cleaned_state = {
            "boxes": boxes,
            "pallets": pallets,
            "activeBox": active_box,
            "activePallet": active_pallet,
        }
        details = {
            "changed": bool(
                removed_box_codes
                or removed_pallet_links
                or active_box_cleared
            ),
            "removed_box_codes": sorted(set(removed_box_codes)),
            "removed_qty": removed_qty,
            "removed_pallet_links": removed_pallet_links,
        }
        return cleaned_state, details

    @classmethod
    def purge_canceled_processing_boxes_from_open_sessions(
        cls,
        *,
        order_id: str,
        entries=None,
    ) -> dict:
        canceled_box_codes = cls.canceled_processing_box_codes(
            order_id=str(order_id),
            entries=entries,
        )
        result = {
            "canceled_box_codes": sorted(canceled_box_codes),
            "changed_session_ids": [],
            "removed_box_codes": [],
            "removed_qty": 0,
        }
        if not canceled_box_codes:
            return result

        processing_views = cls._views()
        with transaction.atomic():
            sessions = list(
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    order_id=str(order_id),
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("id")
            )
            removed_codes: set[str] = set()
            for session in sessions:
                cleaned_state, details = (
                    cls.strip_canceled_processing_boxes_from_flow_state(
                        session.flow_state,
                        canceled_box_codes,
                    )
                )
                if not details["changed"]:
                    continue
                cleaned_state = processing_views._sanitize_flow_state_for_session(
                    cleaned_state,
                    session,
                )
                session.flow_state = cleaned_state
                session.save(update_fields=["flow_state", "updated_at"])
                result["changed_session_ids"].append(session.id)
                removed_codes.update(details["removed_box_codes"])
                result["removed_qty"] += details["removed_qty"]
            result["removed_box_codes"] = sorted(removed_codes)
        return result

    @staticmethod
    def normalize_gtin14(value: str | None) -> str:
        digits = re.sub(r"\D", "", str(value or ""))
        if len(digits) not in {8, 12, 13, 14}:
            return ""
        return digits.zfill(14)

    @staticmethod
    def is_valid_gtin14(value: str | None) -> bool:
        gtin = str(value or "").strip()
        if len(gtin) != 14 or not gtin.isdigit():
            return False
        checksum_total = 0
        for index, digit in enumerate(gtin[:-1]):
            checksum_total += int(digit) * (3 if index % 2 == 0 else 1)
        expected_check_digit = (10 - checksum_total % 10) % 10
        return expected_check_digit == int(gtin[-1])

    @classmethod
    def build_processing_flow_integrity(
        cls,
        *,
        order_id: str,
        flow_state: dict | None,
        include_database: bool = True,
    ) -> dict:
        processing_views = cls._views()
        source = flow_state if isinstance(flow_state, dict) else {}
        boxes = [
            box
            for box in (source.get("boxes") or [])
            if isinstance(box, dict) and str(box.get("code") or "").strip()
        ]
        flow_total_qty = 0
        flow_with_cz_qty = 0
        flow_without_cz_qty = 0
        flow_codes_by_box: dict[str, set[str]] = {}
        raw_flow_codes: set[str] = set()
        flow_code_boxes: dict[str, set[str]] = {}
        invalid_box_codes: list[str] = []

        for box in boxes:
            box_code = str(box.get("code") or "").strip()
            marking_validation = cls.inspect_processing_box_marking_mode(box)
            box_qty = marking_validation["qty"]
            flow_total_qty += box_qty
            if marking_validation["mode"] == cls.MARKING_MODE_WITH_CZ:
                flow_with_cz_qty += box_qty
            else:
                flow_without_cz_qty += box_qty
            if not marking_validation["ok"]:
                invalid_box_codes.append(box_code)
            box_codes: set[str] = set()
            for item in box.get("items") or []:
                if not isinstance(item, dict):
                    continue
                raw_marking_codes = item.get("marking_codes") or []
                if not isinstance(raw_marking_codes, list):
                    raw_marking_codes = [raw_marking_codes]
                for raw_marking in raw_marking_codes:
                    if isinstance(raw_marking, dict):
                        raw_marking = raw_marking.get("code")
                    raw_value = str(raw_marking or "").strip()
                    normalized_code = processing_views._normalize_marking_code(
                        raw_value
                    )
                    if not normalized_code:
                        continue
                    raw_flow_codes.add(raw_value)
                    box_codes.add(normalized_code)
                    flow_code_boxes.setdefault(normalized_code, set()).add(box_code)
            flow_codes_by_box[box_code] = box_codes

        flow_codes = set(flow_code_boxes)
        flow_summary = {
            "source": "processing_flow_sessions",
            "flow_total_qty": flow_total_qty,
            "flow_with_cz_qty": flow_with_cz_qty,
            "flow_without_cz_qty": flow_without_cz_qty,
            "flow_marking_count": len(flow_codes),
            "duplicate_flow_count": len(
                {
                    code
                    for code, box_codes in flow_code_boxes.items()
                    if len(box_codes) > 1
                }
            ),
            "marking_qty_gap": flow_with_cz_qty - len(flow_codes),
            "invalid_box_codes": sorted(set(invalid_box_codes)),
            "database_checked": include_database,
        }
        if not include_database:
            return flow_summary

        lookup_codes = set(raw_flow_codes)
        for raw_code in list(raw_flow_codes):
            normalized_code = processing_views._normalize_marking_code(raw_code)
            if normalized_code:
                lookup_codes.add(normalized_code)
                if "\x1d" in normalized_code:
                    lookup_codes.add(normalized_code.replace("\x1d", "_x001D_"))
        db_rows = list(
            MarkingCode.objects.filter(used_at__isnull=False)
            .filter(
                Q(order_type="processing", order_id=str(order_id))
                | Q(code__in=lookup_codes)
            )
            .only("id", "code", "order_type", "order_id", "box_barcode")
        )
        db_order_codes: set[str] = set()
        db_backing_codes: set[str] = set()
        db_code_boxes: dict[str, set[str]] = {}
        db_order_raw_count = 0
        for row in db_rows:
            normalized_code = processing_views._normalize_marking_code(row.code or "")
            if not normalized_code:
                continue
            is_order_row = (
                row.order_type == "processing"
                and str(row.order_id or "") == str(order_id)
            )
            if is_order_row:
                db_order_raw_count += 1
                db_order_codes.add(normalized_code)
            if is_order_row or normalized_code in flow_codes:
                db_backing_codes.add(normalized_code)
                db_box_code = str(row.box_barcode or "").strip()
                if db_box_code:
                    db_code_boxes.setdefault(normalized_code, set()).add(
                        db_box_code
                    )

        db_only_codes = db_order_codes - flow_codes
        flow_only_codes = flow_codes - db_backing_codes
        duplicate_flow_codes = {
            code
            for code, box_codes in flow_code_boxes.items()
            if len(box_codes) > 1
        }
        per_box_discrepancies = []
        all_box_codes = sorted(
            {
                *flow_codes_by_box.keys(),
                *(
                    box_code
                    for box_codes in db_code_boxes.values()
                    for box_code in box_codes
                ),
            }
        )
        for box_code in all_box_codes:
            flow_box_codes = flow_codes_by_box.get(box_code, set())
            db_box_codes = {
                code
                for code, box_codes in db_code_boxes.items()
                if box_code in box_codes
            }
            if flow_box_codes == db_box_codes:
                continue
            per_box_discrepancies.append(
                {
                    "box_code": box_code,
                    "flow_marking_count": len(flow_box_codes),
                    "db_marking_count": len(db_box_codes),
                }
            )

        marking_qty_gap = flow_with_cz_qty - len(flow_codes)
        db_normalized_duplicate_count = max(
            db_order_raw_count - len(db_order_codes),
            0,
        )
        in_sync = not any(
            (
                db_only_codes,
                flow_only_codes,
                duplicate_flow_codes,
                invalid_box_codes,
                per_box_discrepancies,
                marking_qty_gap,
                db_normalized_duplicate_count,
            )
        )
        return {
            **flow_summary,
            "db_used_marking_count": len(db_order_codes),
            "db_backed_flow_count": len(flow_codes & db_backing_codes),
            "db_only_count": len(db_only_codes),
            "flow_only_count": len(flow_only_codes),
            "duplicate_flow_count": len(duplicate_flow_codes),
            "db_normalized_duplicate_count": db_normalized_duplicate_count,
            "marking_qty_gap": marking_qty_gap,
            "invalid_box_codes": sorted(set(invalid_box_codes)),
            "box_discrepancies": per_box_discrepancies[:20],
            "in_sync": in_sync,
        }

    @staticmethod
    def _label_templates_json_map() -> dict[str, dict]:
        templates: dict[str, dict] = {}
        for item in LABEL_TEMPLATES:
            key = str(item.get("key") or "").strip()
            if not key:
                continue
            templates[key] = {
                "width_mm": item.get("width_mm", 58),
                "height_mm": item.get("height_mm", 40),
                "preview_scale": item.get("preview_scale", 1),
                "layout_key": item.get("layout_key") or key,
                "mode": item.get("mode") or "no-cz",
            }
        return templates

    @classmethod
    def _resolve_processing_label_template(cls, label_key: str, bindings: dict | None = None) -> dict:
        normalized_label_key = str(label_key or "").strip()
        template_key = resolve_processing_param_template_key(normalized_label_key, bindings)
        template = get_label_template(template_key)
        if template:
            return template
        fallback_key = normalized_label_key or "item"
        fallback_template = get_label_template(fallback_key)
        if fallback_template:
            return fallback_template
        return {
            "key": fallback_key,
            "size_key": fallback_key,
            "layout_key": "item_cz" if fallback_key == "item_cz" else "item",
            "mode": "cz" if fallback_key == "item_cz" else "no-cz",
            "width_mm": 58,
            "height_mm": 40,
            "preview_scale": 2.1,
        }

    @staticmethod
    def _processing_home_status_label(
        status_value: str | None,
        fallback_label: str | None = None,
    ) -> str:
        if fallback_label:
            return fallback_label
        value = str(status_value or "").strip().lower()
        if value == "draft":
            return "Черновик"
        if value in {"sent_unconfirmed", "send", "submitted"}:
            return "Ждет подтверждения"
        return "Подготовка заявки" if not value else value

    @staticmethod
    def _barcodes_from_rows(rows) -> list[str]:
        values: list[str] = []
        if not isinstance(rows, list):
            return values
        for row in rows:
            if not isinstance(row, dict):
                continue
            barcode_value = str(row.get("barcode") or row.get("barcode_value") or "").strip()
            if barcode_value:
                values.append(barcode_value)
        return values

    @staticmethod
    def _parse_json_list(raw_value) -> list[str]:
        if isinstance(raw_value, list):
            return [str(item).strip() for item in raw_value if str(item or "").strip()]
        text = str(raw_value or "").strip()
        if not text:
            return []
        try:
            parsed = json.loads(text)
        except (TypeError, ValueError, json.JSONDecodeError):
            return []
        if not isinstance(parsed, list):
            return []
        return [str(item).strip() for item in parsed if str(item or "").strip()]

    @staticmethod
    def _normalize_goods_type_token(value) -> str:
        return StockAvailabilityService.normalize_goods_type(value)

    @classmethod
    def _build_processing_home_transient_payload(cls, *, request) -> dict:
        if getattr(request, "method", "").upper() != "POST":
            return {}

        payload: dict = {}
        for key in request.POST.keys():
            if key in {"csrfmiddlewaretoken", "cards_json"}:
                continue
            if key.endswith("[]"):
                payload[key] = request.POST.getlist(key)
            else:
                payload[key] = request.POST.get(key)

        cards_json = str(request.POST.get("cards_json") or "").strip()
        if cards_json:
            try:
                parsed_cards = json.loads(cards_json)
            except json.JSONDecodeError:
                parsed_cards = []
            if isinstance(parsed_cards, list):
                payload["cards"] = parsed_cards

        if not payload.get("cards"):
            stock_rows = []
            articles = request.POST.getlist("stock_article[]")
            sizes = request.POST.getlist("stock_size[]")
            barcodes = request.POST.getlist("stock_barcode[]")
            qty_values = request.POST.getlist("stock_qty[]")
            result_articles = request.POST.getlist("stock_result_article[]")
            result_names = request.POST.getlist("stock_result_product_name[]")
            result_barcodes = request.POST.getlist("stock_result_barcode[]")
            row_count = max(
                len(articles),
                len(sizes),
                len(barcodes),
                len(qty_values),
                len(result_articles),
                len(result_names),
                len(result_barcodes),
            )
            for idx in range(row_count):
                row = {
                    "article": articles[idx] if idx < len(articles) else "",
                    "size": sizes[idx] if idx < len(sizes) else "",
                    "barcode": barcodes[idx] if idx < len(barcodes) else "",
                    "qty": qty_values[idx] if idx < len(qty_values) else "",
                    "result_article": result_articles[idx] if idx < len(result_articles) else "",
                    "result_product_name": result_names[idx] if idx < len(result_names) else "",
                    "result_barcode": result_barcodes[idx] if idx < len(result_barcodes) else "",
                }
                if any(str(value or "").strip() for value in row.values()):
                    stock_rows.append(row)
            if stock_rows:
                payload["stock_rows"] = stock_rows

        return payload

