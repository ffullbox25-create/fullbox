    @classmethod
    def _collect_processing_card_results(
        cls,
        request,
        *,
        card_id: str,
        agency=None,
    ) -> tuple[list[dict], bool]:
        processed_field_present = "result_processed[]" in request.POST
        articles = request.POST.getlist("result_article[]")
        source_articles = request.POST.getlist("result_source_article[]")
        product_names = request.POST.getlist("result_product_name[]")
        barcodes = request.POST.getlist("result_barcode[]")
        catalog_barcodes = request.POST.getlist("result_catalog_barcode[]")
        sizes = request.POST.getlist("result_size[]")
        destinations = request.POST.getlist("result_destination[]")
        line_keys = request.POST.getlist("result_line_key[]")
        received_list = request.POST.getlist("result_received[]")
        processed_list = request.POST.getlist("result_processed[]")
        defect_list = request.POST.getlist("result_defect[]")
        shortage_list = request.POST.getlist("result_shortage[]")
        labels_printed_list = request.POST.getlist("result_labels_printed[]")
        labels_unboxed_list = request.POST.getlist("result_labels_unboxed[]")
        shipped_list = request.POST.getlist("result_shipped_qty[]")
        tags_replaced_list = request.POST.getlist("result_tags_replaced[]")
        total_rows = max(
            len(articles),
            len(source_articles),
            len(product_names),
            len(barcodes),
            len(catalog_barcodes),
            len(sizes),
            len(destinations),
            len(line_keys),
            len(received_list),
            len(processed_list),
            len(defect_list),
            len(shortage_list),
            len(labels_printed_list),
            len(labels_unboxed_list),
            len(shipped_list),
            len(tags_replaced_list),
        )
        if total_rows <= 0 or not processed_field_present:
            return [], False
        catalog_choice_map = {}
        catalog_values = {
            str(value or "").strip()
            for value in catalog_barcodes
            if str(value or "").strip()
        }
        if agency and catalog_values:
            from sku.models import SKUBarcode

            catalog_choice_map = {
                str(item.value or "").strip(): item
                for item in SKUBarcode.objects.select_related("sku").filter(
                    value__in=catalog_values,
                    sku__agency=agency,
                    sku__deleted=False,
                )
            }
        results: list[dict] = []
        for idx in range(total_rows):
            article = articles[idx].strip() if idx < len(articles) else ""
            product_name = product_names[idx].strip() if idx < len(product_names) else ""
            barcode = barcodes[idx].strip() if idx < len(barcodes) else ""
            result_sku_id = ""
            catalog_value = catalog_barcodes[idx].strip() if idx < len(catalog_barcodes) else ""
            catalog_choice = catalog_choice_map.get(catalog_value)
            if catalog_choice is not None:
                target_sku = catalog_choice.sku
                result_sku_id = str(target_sku.id)
                article = str(target_sku.sku_code or "").strip()
                product_name = str(target_sku.name or "").strip()
                barcode = str(catalog_choice.value or "").strip()
            size = sizes[idx].strip() if idx < len(sizes) else ""
            destination = destinations[idx].strip() if idx < len(destinations) else ""
            if not any((article, size, destination)):
                continue
            shipped_value = shipped_list[idx].strip() if idx < len(shipped_list) else ""
            labels_unboxed_value = labels_unboxed_list[idx].strip() if idx < len(labels_unboxed_list) else ""
            if not labels_unboxed_value:
                labels_unboxed_value = shipped_value
            processed_value = processed_list[idx].strip() if idx < len(processed_list) else ""
            tags_replaced_value = tags_replaced_list[idx].strip() if idx < len(tags_replaced_list) else ""
            if not tags_replaced_value:
                tags_replaced_value = processed_value
            results.append(
                {
                    "card_id": card_id,
                    "article": article,
                    "result_sku_id": result_sku_id,
                    "source_article": source_articles[idx].strip() if idx < len(source_articles) else "",
                    "product_name": product_name,
                    "barcode": barcode,
                    "size": size,
                    "destination": destination,
                    "line_key": line_keys[idx].strip() if idx < len(line_keys) else "",
                    "received": received_list[idx].strip() if idx < len(received_list) else "",
                    "processed": processed_value,
                    "defect": defect_list[idx].strip() if idx < len(defect_list) else "",
                    "shortage": shortage_list[idx].strip() if idx < len(shortage_list) else "",
                    "labels_printed": labels_printed_list[idx].strip() if idx < len(labels_printed_list) else "",
                    "labels_unboxed": labels_unboxed_value,
                    "shipped_qty": shipped_value,
                    "tags_replaced": tags_replaced_value,
                }
            )
        return results, True

