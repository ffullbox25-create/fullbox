                .select_related("assigned_to")
                .order_by("-created_at")
            )
            seen = set()
            for task in packing_tasks:
                assignee = task.assigned_to
                if not assignee:
                    continue
                label = assignee.full_name or str(assignee)
                if label in seen:
                    continue
                seen.add(label)
                packers.append(label)
