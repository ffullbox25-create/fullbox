    @classmethod
    def remove_processing_flow_box_marking(
        cls,
        *,
        order_id: str,
        request,
        payload: dict | None = None,
    ) -> ProcessingJsonResult:
        processing_views = cls._views()
        if (
            get_request_role(request) != "processing_worker"
            or not processing_views._processing_flow_has_write_access(request, str(order_id or ""))
        ):
            return ProcessingJsonResult(
                status="forbidden",
                http_status=403,
                payload={"ok": False, "error": "processing_assignment_required"},
            )
        data = payload if isinstance(payload, dict) else processing_views._parse_json_body(request)
        if data is None:
            return ProcessingJsonResult(
                status="invalid_json",
                http_status=400,
                payload={"ok": False, "error": "invalid_json"},
            )
        if not isinstance(data, dict):
            data = {}
        box_code = str(data.get("box_code") or data.get("box_barcode") or "").strip()
        sku_code = str(data.get("sku_code") or data.get("sku") or "").strip()
        size = str(data.get("size") or "").strip()
        marking_code = processing_views._normalize_marking_code(
            data.get("marking_code") or data.get("code") or data.get("cz_code") or ""
        )
        agent_id = str(data.get("agent_id") or data.get("agentId") or "").strip()
        if not box_code:
            return ProcessingJsonResult(
                status="missing_box",
                http_status=400,
                payload={"ok": False, "error": "missing_box"},
            )
        if not marking_code and not sku_code:
            return ProcessingJsonResult(
                status="missing_marking",
                http_status=400,
                payload={"ok": False, "error": "missing_marking"},
            )

        entries = list(
            OrderAuditEntry.objects.filter(order_id=str(order_id), order_type="processing")
            .select_related("agency")
            .order_by("created_at", "id")
        )
        if not entries:
            return ProcessingJsonResult(
                status="missing_order",
                http_status=404,
                payload={"ok": False, "error": "missing_order"},
            )
        if processing_views._flow_closed_from_entries(entries):
            return ProcessingJsonResult(
                status="flow_closed",
                http_status=409,
                payload={"ok": False, "error": "flow_closed"},
            )

        session = processing_views._flow_session_for_request(
            str(order_id),
            agent_id,
            request,
            create=False,
        )
        if not session:
            return ProcessingJsonResult(
                status="missing_session",
                http_status=409,
                payload={"ok": False, "error": "missing_session"},
            )

        now = timezone.localtime()
        with transaction.atomic():
            locked_entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=str(order_id), order_type="processing")
                .order_by("created_at", "id")
            )
            locked_session = (
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    pk=session.pk,
                    order_id=str(order_id),
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .first()
            )
            if not locked_session:
                return ProcessingJsonResult(
                    status="missing_session",
                    http_status=409,
                    payload={"ok": False, "error": "missing_session"},
                )
            flow_state = processing_views._sanitize_flow_state_for_session(
                locked_session.flow_state,
                locked_session,
            )
            released_pallet_keys = set(
                cls._processing_pallet_releases_from_entries(locked_entries)
            )
            released_container = next(
                (
                    str(pallet.get("code") or "").strip()
                    for pallet in (flow_state.get("pallets") or [])
                    if isinstance(pallet, dict)
                    and str(pallet.get("code") or "").strip().casefold()
                    in released_pallet_keys
                    and box_code
                    in {
                        str(code or "").strip()
                        for code in (pallet.get("boxes") or [])
                        if str(code or "").strip()
                    }
                ),
                "",
            )
            if released_container:
                return ProcessingJsonResult(
                    status="released_pallet_locked",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": "released_pallet_locked",
                        "pallet_code": released_container,
                        "message": "Состав принятой для отгрузки палеты изменять нельзя.",
                    },
                )
            boxes = flow_state.get("boxes") or []
            box = next(
                (
                    item
                    for item in boxes
                    if isinstance(item, dict) and str(item.get("code") or "").strip() == box_code
                ),
                None,
            )
            if not box:
                return ProcessingJsonResult(
                    status="missing_box",
                    http_status=404,
                    payload={"ok": False, "error": "missing_box"},
                )
            if box.get("sealed"):
                return ProcessingJsonResult(
                    status="sealed_box",
                    http_status=409,
                    payload={"ok": False, "error": "sealed_box"},
                )
            items = box.get("items") if isinstance(box.get("items"), list) else []
            target_item_index = -1
            target_code_index = -1
            target_codes: list[tuple[object, str]] = []
            normalized_sku = sku_code.casefold()
            normalized_size = size.casefold()
            for item_index, item in enumerate(items):
                if not isinstance(item, dict):
                    continue
                item_sku = str(item.get("sku_code") or item.get("sku") or "").strip()
                item_size = str(item.get("size") or "").strip()
                if normalized_sku and item_sku.casefold() != normalized_sku:
                    continue
                if normalized_size and item_size.casefold() != normalized_size:
                    continue
                raw_codes = item.get("marking_codes") or []
                if not isinstance(raw_codes, list):
                    raw_codes = [raw_codes]
                item_codes: list[tuple[object, str]] = []
                for raw_code in raw_codes:
                    value = raw_code.get("code") if isinstance(raw_code, dict) else raw_code
                    normalized_code = processing_views._normalize_marking_code(value or "")
                    if normalized_code:
                        item_codes.append((raw_code, normalized_code))
                if not item_codes:
                    continue
                if marking_code:
                    for code_index, (_raw_code, normalized_code) in enumerate(item_codes):
                        if normalized_code == marking_code:
                            target_item_index = item_index
                            target_code_index = code_index
                            target_codes = item_codes
                            break
                    if target_item_index >= 0:
                        break
                else:
                    marking_code = item_codes[-1][1]
                    target_item_index = item_index
                    target_code_index = len(item_codes) - 1
                    target_codes = item_codes
                    break
            if target_item_index < 0 or target_code_index < 0 or not marking_code:
                return ProcessingJsonResult(
                    status="missing_marking",
                    http_status=404,
                    payload={"ok": False, "error": "missing_marking"},
                )

            code_variants = {marking_code}
            if "\x1d" in marking_code:
                code_variants.add(marking_code.replace("\x1d", "_x001D_"))
            marking_row = (
                MarkingCode.objects.select_for_update()
                .filter(
                    code__in=list(code_variants),
                    order_type="processing",
                    order_id=str(order_id),
                )
                .order_by("id")
                .first()
            )
            if not marking_row:
                return ProcessingJsonResult(
                    status="missing_marking",
                    http_status=404,
                    payload={"ok": False, "error": "missing_marking"},
                )
            marking_box_code = str(marking_row.box_barcode or "").strip()
            if marking_box_code and marking_box_code != box_code:
                return ProcessingJsonResult(
                    status="other_box",
                    http_status=409,
                    payload={"ok": False, "error": "other_box"},
                )

            target_item = items[target_item_index]
            remaining_codes = [
                normalized_code
                for code_index, (_raw_code, normalized_code) in enumerate(target_codes)
                if code_index != target_code_index
            ]
            remaining_codes = list(dict.fromkeys(remaining_codes))
            if remaining_codes:
                target_item["marking_codes"] = remaining_codes
                target_item["qty"] = len(remaining_codes)
            else:
                box["items"] = [
                    item
                    for item_index, item in enumerate(items)
                    if item_index != target_item_index
                ]
            for field in WarehouseWritePathService.BOX_CHARACTERISTIC_FIELDS:
                box.pop(field, None)
            marking_row.box_barcode = ""
            marking_row.used_at = None
            marking_row.used_by = None
            marking_row.save(update_fields=["box_barcode", "used_at", "used_by"])
            flow_state["boxes"] = boxes
            flow_state["activeBox"] = box_code
            flow_state = processing_views._sanitize_flow_state_for_session(
                flow_state,
                locked_session,
            )
            locked_session.flow_state = flow_state
            locked_session.last_seen = now
            locked_session.save(update_fields=["flow_state", "last_seen", "updated_at"])

        flow_integrity = cls.build_processing_flow_integrity(
            order_id=str(order_id),
            flow_state=flow_state,
            include_database=True,
        )
        log_staff_overaction(
            "update",
            user=request.user if request.user.is_authenticated else None,
            agency=entries[-1].agency,
            description=f"Processing marking removed from box {box_code} (order {order_id})",
            snapshot={
                "action": "remove_processing_flow_marking",
                "order_type": "processing",
                "order_id": str(order_id),
                "box_code": box_code,
                "sku_code": sku_code,
                "size": size,
                "marking_code": marking_row.code,
                "marking_code_id": marking_row.id,
                "session_id": locked_session.id,
                "removed_at": now.isoformat(),
            },
        )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "box_code": box_code,
                "marking_code_id": marking_row.id,
                "flow_state": flow_state,
                "flow_integrity": flow_integrity,
            },
        )

    @classmethod
    def cancel_processing_flow_box(
        cls,
        *,
        order_id: str,
        request,
    ) -> ProcessingJsonResult:
        processing_views = cls._views()
        role = get_request_role(request)
        if role not in {"processing_head", "head_manager"}:
            return ProcessingJsonResult(
                status="forbidden",
                http_status=403,
                payload={
                    "ok": False,
                    "error": "forbidden",
                    "message": "Отменить короб может только начальник склада или руководитель обработки.",
                },
            )
        data = processing_views._parse_json_body(request)
        if data is None:
            return ProcessingJsonResult(
                status="invalid_json",
                http_status=400,
                payload={"ok": False, "error": "invalid_json"},
            )
        box_code = str(data.get("box_code") or "").strip()
        reason = str(data.get("reason") or "").strip()
        if not box_code:
            return ProcessingJsonResult(
                status="missing_box",
                http_status=400,
                payload={"ok": False, "error": "missing_box", "message": "Короб не указан."},
            )
        if len(reason) < 3:
            return ProcessingJsonResult(
                status="reason_required",
                http_status=400,
                payload={
                    "ok": False,
                    "error": "reason_required",
                    "message": "Укажите причину отмены короба.",
                },
            )
        reason = reason[:500]
        entries = list(
            OrderAuditEntry.objects.filter(
                order_id=str(order_id),
                order_type="processing",
            )
            .select_related("agency", "user")
            .order_by("created_at", "id")
        )
        if not entries:
            return ProcessingJsonResult(
                status="missing_order",
                http_status=404,
                payload={"ok": False, "error": "missing_order", "message": "Заявка не найдена."},
            )
        if processing_views._flow_closed_from_entries(entries):
            return ProcessingJsonResult(
                status="flow_closed",
                http_status=409,
                payload={
                    "ok": False,
                    "error": "flow_closed",
                    "message": "Размещение уже завершено. Отмена короба заблокирована.",
                },
            )
        existing_history = cls.processing_box_cancellation_history(
            order_id=str(order_id),
            entries=entries,
        )
        existing_cancellation = next(
            (
                item
                for item in reversed(existing_history)
                if str(item.get("box_code") or "").strip() == box_code
            ),
            None,
        )
        if existing_cancellation:
            return ProcessingJsonResult(
                status="already_canceled",
                http_status=200,
                payload={
                    "ok": True,
                    "already_canceled": True,
                    "box_code": box_code,
                    "released_marking_count": int(
                        existing_cancellation.get("released_marking_count") or 0
                    ),
                    "message": f"Короб {box_code} уже отменён.",
                },
            )

        latest = entries[-1]
        agency = latest.agency
        canceled_at = timezone.localtime().isoformat()
        employee = get_request_employee(request)
        canceled_by = (
            getattr(employee, "full_name", "")
            or request.user.get_full_name()
            or request.user.username
            or str(request.user.id)
        )

        with transaction.atomic():
            locked_sessions = list(
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    order_id=str(order_id),
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("id")
            )
            matched_boxes = []
            session_states = {}
            pallet_codes = set()
            for session in locked_sessions:
                state = processing_views._sanitize_flow_state_for_session(
                    session.flow_state,
                    session,
                )
                session_states[session.id] = state
                for box in state.get("boxes") or []:
                    if (
                        isinstance(box, dict)
                        and str(box.get("code") or "").strip() == box_code
                    ):
                        matched_boxes.append((session, box))
                for pallet in state.get("pallets") or []:
                    if not isinstance(pallet, dict):
                        continue
                    pallet_box_codes = {
                        str(code or "").strip()
                        for code in (pallet.get("boxes") or [])
                        if str(code or "").strip()
                    }
                    if box_code in pallet_box_codes:
                        pallet_codes.add(str(pallet.get("code") or "").strip())
            if not matched_boxes:
                latest_history = cls.processing_box_cancellation_history(
                    order_id=str(order_id),
                )
                latest_cancellation = next(
                    (
                        item
                        for item in reversed(latest_history)
                        if str(item.get("box_code") or "").strip() == box_code
                    ),
                    None,
                )
                if latest_cancellation:
                    return ProcessingJsonResult(
                        status="already_canceled",
                        http_status=200,
                        payload={
                            "ok": True,
                            "already_canceled": True,
                            "box_code": box_code,
                            "released_marking_count": int(
                                latest_cancellation.get(
                                    "released_marking_count"
                                )
                                or 0
                            ),
                            "message": f"Короб {box_code} уже отменён.",
                        },
                    )
                return ProcessingJsonResult(
                    status="missing_box",
                    http_status=404,
                    payload={
                        "ok": False,
                        "error": "missing_box",
                        "message": "Короб не найден в активном размещении.",
                    },
                )

            target_box = max(
                (box for _session, box in matched_boxes),
                key=lambda box: processing_views._flow_box_items_count(box),
            )
            box_snapshot = json.loads(json.dumps(target_box, ensure_ascii=False))
            canceled_qty = processing_views._flow_box_items_count(target_box)
            flow_marking_codes = []
            for _session, matched_box in matched_boxes:
                for item in matched_box.get("items") or []:
                    if not isinstance(item, dict):
                        continue
                    raw_codes = item.get("marking_codes") or []
                    if not isinstance(raw_codes, list):
                        raw_codes = [raw_codes]
                    for raw_code in raw_codes:
                        if isinstance(raw_code, dict):
                            raw_code = raw_code.get("code")
                        marking_code = processing_views._normalize_marking_code(raw_code or "")
                        if marking_code and marking_code not in flow_marking_codes:
                            flow_marking_codes.append(marking_code)

            container = None
            if agency:
                container = (
                    WarehouseContainer.objects.select_for_update()
                    .filter(
                        agency=agency,
                        container_code=box_code,
                    )
                    .first()
                )
                if WarehouseStockSnapshot.objects.filter(
                    agency=agency,
                    container_code=box_code,
                ).exists():
                    return ProcessingJsonResult(
                        status="warehouse_started",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": "warehouse_started",
                            "message": (
                                "Короб уже отражён в складских остатках. "
                                "Безопасная отмена заблокирована."
                            ),
                        },
                    )
                if container and WarehouseOperationTask.objects.filter(
                    container=container,
                ).exists():
                    return ProcessingJsonResult(
                        status="warehouse_started",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": "warehouse_started",
                            "message": (
                                "По коробу уже создано складское перемещение. "
                                "Безопасная отмена заблокирована."
                            ),
                        },
                    )

            flow_marking_code_variants = set(flow_marking_codes)
            flow_marking_code_variants.update(
                code.replace("\x1d", "_x001D_")
                for code in flow_marking_codes
                if "\x1d" in code
            )
            marking_filter = Q(box_barcode=box_code)
            if flow_marking_code_variants:
                marking_filter |= Q(code__in=list(flow_marking_code_variants))
            marking_rows = list(
                MarkingCode.objects.select_for_update()
                .filter(
                    marking_filter,
                    order_type="processing",
                    order_id=str(order_id),
                )
                .order_by("id")
            )
            marking_snapshot = [
                {
                    "id": row.id,
                    "code": row.code,
                    "sku_code": row.sku_code,
                    "size": row.size,
                    "barcode": row.barcode,
                    "used_at": row.used_at.isoformat() if row.used_at else "",
                    "used_by_id": row.used_by_id,
                }
                for row in marking_rows
            ]
            released_marking_count = sum(1 for row in marking_rows if row.used_at)
            for row in marking_rows:
                row.box_barcode = ""
                row.used_at = None
                row.used_by = None
            if marking_rows:
                MarkingCode.objects.bulk_update(
                    marking_rows,
                    ["box_barcode", "used_at", "used_by"],
                )

            affected_session_ids = []
            for session in locked_sessions:
                state = session_states[session.id]
                had_box = any(
                    isinstance(box, dict)
                    and str(box.get("code") or "").strip() == box_code
                    for box in (state.get("boxes") or [])
                )
                if not had_box:
                    continue
                affected_session_ids.append(session.id)
                state["boxes"] = [
                    box
                    for box in (state.get("boxes") or [])
                    if not (
                        isinstance(box, dict)
                        and str(box.get("code") or "").strip() == box_code
                    )
                ]
                for pallet in state.get("pallets") or []:
                    if not isinstance(pallet, dict):
                        continue
                    pallet["boxes"] = [
                        str(code or "").strip()
                        for code in (pallet.get("boxes") or [])
                        if str(code or "").strip() and str(code or "").strip() != box_code
                    ]
                if str(state.get("activeBox") or "").strip() == box_code:
                    state["activeBox"] = ""
                session.flow_state = processing_views._sanitize_flow_state_for_session(
                    state,
                    session,
                )
                session.last_seen = timezone.localtime()
                session.save(
                    update_fields=["flow_state", "last_seen", "updated_at"]
                )

            container_snapshot = {}
            if container:
                container_snapshot = {
                    "id": container.id,
                    "status": container.status,
                    "parent_container_id": container.parent_container_id,
                    "source_context_type": container.source_context_type,
                    "source_context_id": container.source_context_id,
                }
                container.status = WarehouseContainer.STATUS_ARCHIVED
                container.parent_container = None
                container.save(
                    update_fields=["status", "parent_container", "updated_at"]
                )

            cancellation_snapshot = {
                "action": "cancel_processing_box",
                "order_type": "processing",
                "order_id": str(order_id),
                "box_code": box_code,
                "reason": reason,
                "canceled_at": canceled_at,
                "canceled_by": canceled_by,
                "canceled_by_user_id": request.user.id,
                "canceled_by_role": role,
                "canceled_qty": canceled_qty,
                "flow_marking_count": len(flow_marking_codes),
                "flow_marking_codes": flow_marking_codes,
                "released_marking_count": released_marking_count,
                "released_marking_rows": marking_snapshot,
                "affected_session_ids": affected_session_ids,
                "pallet_codes": sorted(code for code in pallet_codes if code),
                "box_snapshot": box_snapshot,
                "container_snapshot": container_snapshot,
            }
            cancellation_entry = OrderAuditEntry.objects.create(
                order_id=str(order_id),
                order_type="processing",
                action="update",
                agency=agency,
                user=request.user if request.user.is_authenticated else None,
                description=f"Отменён короб {box_code}: {reason}",
                payload={"processing_box_cancellation": cancellation_snapshot},
            )
            log_staff_overaction(
                "update",
                user=request.user if request.user.is_authenticated else None,
                agency=agency,
                description=f"Безопасная отмена короба {box_code} (заявка {order_id})",
                snapshot={
                    **cancellation_snapshot,
                    "order_audit_entry_id": cancellation_entry.id,
                },
            )

        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "box_code": box_code,
                "canceled_qty": canceled_qty,
                "released_marking_count": released_marking_count,
                "cancellation_id": cancellation_entry.id,
                "message": (
                    f"Короб {box_code} отменён. "
                    f"Освобождено ЧЗ: {released_marking_count}."
                ),
            },
        )

    @classmethod
    def _processing_fact_items_by_barcode(
        cls,
        *,
        payload: dict,
        card_ids=None,
        fallback_items=None,
    ) -> list[dict]:
        """Return the confirmed processing fact grouped only by product barcode."""
        processing_views = cls._views()
        payload = payload if isinstance(payload, dict) else {}
        allowed_card_ids = {
            str(value or "").strip().casefold()
            for value in (card_ids or set())
            if str(value or "").strip()
        }
        allowed_articles: set[str] = set()
        cards = [card for card in (payload.get("cards") or []) if isinstance(card, dict)]
        for card in cards:
            card_id = processing_views._processing_card_id(card).casefold()
            if allowed_card_ids and card_id not in allowed_card_ids:
                continue
            for value in (
                card.get("article"),
                card.get("sku"),
                card.get("result_article"),
            ):
                normalized = str(value or "").strip().casefold()
                if normalized:
                    allowed_articles.add(normalized)
            for row in card.get("rows") or []:
                if not isinstance(row, dict):
                    continue
                for value in (
                    row.get("article"),
                    row.get("sku"),
                    row.get("sku_code"),
                    row.get("result_article"),
                ):
                    normalized = str(value or "").strip().casefold()
                    if normalized:
                        allowed_articles.add(normalized)

        grouped: dict[tuple[str, str], dict] = {}

        def canonical_goods_type(value) -> str:
            normalized = StockAvailabilityService.normalize_goods_type(value)
            return {
                "оптовый": "op",
                "готовый": "gv",
                "брак": "br",
                "возврат": "vz",
                "возврат с отгрузки": "votg",
                "расходный": "rh",
                "не обработанный": "no",
            }.get(normalized, normalized)

        default_goods_type = canonical_goods_type(payload.get("goods_type") or "")

        def add_row(
            row: dict,
            qty: int,
            card: dict | None = None,
            *,
            goods_type_override: str = "",
            defect: bool = False,
        ) -> None:
            if qty <= 0:
                return
            card = card if isinstance(card, dict) else {}
            barcode = cls._normalize_processing_stock_barcode(
                row.get("result_barcode")
                or card.get("result_barcode")
                or row.get("barcode")
            )
            sku_code = str(
                row.get("result_article")
                or card.get("result_article")
                or row.get("article")
                or row.get("sku_code")
                or row.get("sku")
                or card.get("article")
                or card.get("sku")
                or ""
            ).strip()
            size = str(row.get("size") or "").strip()
            name = str(
                row.get("result_product_name")
                or card.get("result_product_name")
                or row.get("product_name")
                or row.get("name")
                or card.get("product_name")
                or card.get("name")
                or ""
            ).strip()
            goods_type = canonical_goods_type(
                goods_type_override
                or row.get("goods_type")
                or card.get("goods_type")
                or default_goods_type
                or ""
            )
            if defect:
                goods_type = "br"
                if name and not name.casefold().endswith("(брак)"):
                    name = f"{name} (Брак)"
            identity = barcode or f"__missing__:{sku_code.casefold()}:{size.casefold()}"
            key = (identity, goods_type)
            target = grouped.setdefault(
                key,
                {
                    "sku_code": sku_code,
                    "name": name,
                    "size": size,
                    "barcode": barcode,
                    "actual_qty": 0,
                    "goods_type": goods_type,
                    "condition": "defect" if defect else "good",
                    "condition_label": "Брак · без ЧЗ" if defect else "Годный товар",
                    "requires_marking": False if defect else None,
                },
            )
            target["actual_qty"] += qty

        result_rows_added = False
        processing_results = payload.get("processing_results") or []
        if isinstance(processing_results, list):
            for row in processing_results:
                if not isinstance(row, dict):
                    continue
                row_card_id = str(row.get("card_id") or "").strip().casefold()
                row_article = str(
                    row.get("result_article")
                    or row.get("article")
                    or row.get("sku_code")
                    or row.get("sku")
                    or ""
                ).strip().casefold()
                if allowed_card_ids:
                    if row_card_id:
                        if row_card_id not in allowed_card_ids:
                            continue
                    elif not row_article or row_article not in allowed_articles:
                        continue
                processed_qty = processing_views._parse_qty_value(row.get("processed")) or 0
                shipped_qty = processing_views._parse_qty_value(row.get("shipped_qty")) or 0
                qty = max(processed_qty - shipped_qty, 0)
                if qty > 0:
                    add_row(row, qty)
                    result_rows_added = True
                defect_qty = processing_views._parse_qty_value(row.get("defect")) or 0
                if defect_qty > 0:
                    add_row(
                        row,
                        defect_qty,
                        goods_type_override="br",
                        defect=True,
                    )
                    result_rows_added = True

        if not result_rows_added:
            for card in cards:
                card_id = processing_views._processing_card_id(card).casefold()
                if allowed_card_ids and card_id not in allowed_card_ids:
                    continue
                for row in card.get("rows") or []:
                    if not isinstance(row, dict):
                        continue
                    qty = processing_views._parse_qty_value(row.get("qty")) or 0
                    add_row(row, qty, card)

        if not grouped:
            for item in fallback_items or []:
                if not isinstance(item, dict):
                    continue
                qty = processing_views._parse_qty_value(item.get("actual_qty")) or 0
                add_row(item, qty)
        return list(grouped.values())

    @classmethod
    def mark_processing_card_not_received(
        cls,
        *,
        order_id: str,
        entries,
        request,
        card_id: str,
    ) -> ProcessingCardNotReceivedResult:
        """Close an untouched card as a full shortage without deleting its audit trail."""
        processing_views = cls._views()
        role = get_request_role(request)
        if role not in {"processing_head", "head_manager", "director", "admin"}:
            return ProcessingCardNotReceivedResult(status="forbidden")
        if not entries:
            return ProcessingCardNotReceivedResult(
                status="missing_order",
                error_message="Заявка не найдена.",
            )
        if processing_views._flow_closed_from_entries(entries):
            return ProcessingCardNotReceivedResult(
                status="closed",
                error_message="Размещение по заявке уже завершено.",
            )

        payload = dict(processing_views._processing_work_payload_from_entries(entries))
        selected_card = cls._find_processing_card(payload, card_id=card_id, article="")
        if not isinstance(selected_card, dict):
            return ProcessingCardNotReceivedResult(
                status="missing_card",
                error_message="Товарная позиция не найдена в заявке.",
            )
        selected_card_id = processing_views._processing_card_id(selected_card)
        selected_key = str(selected_card_id or card_id or "").strip().casefold()
        if not selected_key:
            return ProcessingCardNotReceivedResult(
                status="missing_card",
                error_message="Не удалось определить товарную позицию.",
            )
        if selected_card.get("not_received"):
            return ProcessingCardNotReceivedResult(status="ok")

        processed_cards, placed_cards = processing_views._processing_card_sets(payload)
        processed_keys = {str(value or "").strip().casefold() for value in processed_cards}
        placed_keys = {str(value or "").strip().casefold() for value in placed_cards}
        if selected_key in placed_keys or selected_card.get("placed_at") or selected_card.get("placed_done"):
            return ProcessingCardNotReceivedResult(
                status="has_movement",
                error_message="Позиция уже размещалась в короба. Отметить её как не поступившую нельзя.",
            )
        if selected_key in processed_keys or selected_card.get("processed_at") or selected_card.get("processed_done"):
            return ProcessingCardNotReceivedResult(
                status="already_processed",
                error_message="По позиции уже завершена обработка.",
            )

        existing_results = [
            row
            for row in (payload.get("processing_results") or [])
            if isinstance(row, dict)
            and str(row.get("card_id") or "").strip().casefold() == selected_key
        ]
        movement_fields = (
            "processed",
            "defect",
            "shipped_qty",
            "labels_printed",
            "labels_unboxed",
            "tags_replaced",
        )
        if any(
            (processing_views._parse_qty_value(row.get(field_name)) or 0) > 0
            for row in existing_results
            for field_name in movement_fields
        ):
            return ProcessingCardNotReceivedResult(
                status="has_movement",
                error_message=(
                    "По позиции уже внесён фактический результат. "
                    "Сначала исправьте факт в карточке обработки."
                ),
            )

        assignments = cls._processing_work_assignments(payload)
        for assignment in assignments:
            if str(assignment.get("card_id") or "").strip().casefold() != selected_key:
                continue
            if cls._positive_int(assignment.get("actual_qty")) > 0:
                return ProcessingCardNotReceivedResult(
                    status="has_movement",
                    error_message="По позиции уже подтверждена работа упаковщицы.",
                )

        source_rows = [row for row in (selected_card.get("rows") or []) if isinstance(row, dict)]
        result_rows: list[dict] = []
        total_shortage = 0
        for index, row in enumerate(source_rows):
            planned_qty = (
                processing_views._parse_qty_value(row.get("qty"))
                or processing_views._parse_qty_value(row.get("recount_qty"))
                or processing_views._parse_qty_value(row.get("processing_qty"))
                or 0
            )
            if planned_qty <= 0:
                continue
            article = processing_views._processing_result_article(row, selected_card)
            product_name = processing_views._processing_result_product_name(row, selected_card)
            barcode = processing_views._processing_result_barcode(row, selected_card)
            size = str(row.get("size") or "").strip()
            total_shortage += planned_qty
            result_rows.append(
                {
                    "card_id": selected_card_id,
                    "article": article,
                    "source_article": str(
                        row.get("source_article")
                        or selected_card.get("article")
                        or article
                        or ""
                    ).strip(),
                    "product_name": product_name,
                    "barcode": barcode,
                    "size": size,
                    "destination": "-",
                    "line_key": "|".join(
                        [
                            "not-received",
                            selected_key,
                            str(index),
                            str(article or "").strip().casefold(),
                            size.casefold(),
                            str(barcode or "").strip().casefold(),
                        ]
                    ),
                    "planned_qty": str(planned_qty),
                    "received": "0",
                    "processed": "0",
                    "defect": "0",
                    "shortage": str(planned_qty),
                    "labels_printed": "0",
                    "labels_unboxed": "0",
                    "shipped_qty": "0",
                    "tags_replaced": "0",
                    "not_received": True,
                }
            )
        if total_shortage <= 0 or not result_rows:
            return ProcessingCardNotReceivedResult(
                status="missing_quantity",
                error_message="В товарной позиции не найдено заявленное количество.",
            )

        now_iso = timezone.localtime().isoformat()
        actor_name = cls._processing_actor_label(request)
        payload["processing_results"] = cls._merge_processing_card_results(payload, result_rows)
        payload["processing_results_updated_at"] = now_iso
        selected_card.update(
            {
                "not_received": True,
                "not_received_qty": total_shortage,
                "not_received_at": now_iso,
                "not_received_by": actor_name,
                "not_received_reason": "Товар не поступил в зону обработки",
                "processed_at": now_iso,
                "processed_done": True,
                "processing_recorded_by": actor_name,
            }
        )
        selected_card.pop("processed_by", None)
        current_processed_cards = [
            str(value or "").strip()
            for value in (payload.get("processed_cards") or [])
            if str(value or "").strip()
        ]
        if selected_card_id not in current_processed_cards:
            current_processed_cards.append(selected_card_id)
        payload["processed_cards"] = current_processed_cards

        for assignment in assignments:
            if str(assignment.get("card_id") or "").strip().casefold() != selected_key:
                continue
            assignment["status"] = "cancelled"
            assignment["cancelled_at"] = now_iso
            assignment["cancelled_by"] = actor_name
            assignment["cancel_reason"] = "Товар не поступил в обработку"
        if assignments:
            payload[cls.PROCESSING_WORK_ASSIGNMENTS_KEY] = assignments

        subzones = payload.get("processing_card_subzones")
        if isinstance(subzones, dict):
            payload["processing_card_subzones"] = {
                key: value
                for key, value in subzones.items()
                if str(key or "").strip().casefold() != selected_key
            }

        latest = entries[-1]
        log_order_action(
            "update",
            order_id=str(order_id),
            order_type="processing",
            user=request.user if request.user.is_authenticated else None,
            agency=latest.agency if latest else None,
            description=(
                f"Товарная позиция {selected_card.get('article') or selected_card_id} "
                f"отмечена как не поступившая в обработку: {total_shortage} шт."
            ),
            payload=payload,
        )
        cls._complete_processing_card_task(order_id=str(order_id), card_id=selected_card_id)
        cls._dispatch_pending_processing_packaging_if_ready(order_id=str(order_id))
        return ProcessingCardNotReceivedResult(status="ok")

    @classmethod
    @transaction.atomic
    def complete_processing_flow(
        cls,
        *,
        order_id: str,
        entries,
        request,
        normalize_flow_state,
        items_from_placement_act,
        can_start: bool,
        can_finish_with_mismatch: bool,
        can_reassign_boxes: bool,
        order_type: str = "processing",
    ) -> ProcessingFlowCompletionResult:
        processing_views = cls._views()
        if not processing_views._processing_flow_has_write_access(request, str(order_id or "")):
            return ProcessingFlowCompletionResult(
                status="error",
                error_code="processing_assignment_required",
            )
        if not can_start:
            return ProcessingFlowCompletionResult(status="error", error_code="cannot_start")

        status_entry = processing_views._current_status_entry(entries)
        latest = entries[-1]
        base_payload = dict(processing_views._processing_work_payload_from_entries(entries))
        if not base_payload:
            base_payload = dict((status_entry.payload or latest.payload or {}))
        if not processing_stage_transition_allowed(base_payload, PROCESSING_STAGE_UNBOXING_COMPLETED):
            return ProcessingFlowCompletionResult(
                status="error",
                error_code="invalid_stage_transition",
            )
        processed_cards, placed_cards = processing_views._processing_card_sets(base_payload)
        ready_cards = processing_views._processing_flow_ready_cards(base_payload)
        act_items = processing_views._processing_receiving_items(
            base_payload,
            latest.agency_id,
            ready_cards if ready_cards else None,
        )
        if not act_items:
            act_items = items_from_placement_act(entries)
        if not act_items:
            return ProcessingFlowCompletionResult(status="error", error_code="no_act_items")
        barcode_items = cls._processing_fact_items_by_barcode(
            payload=base_payload,
            card_ids=ready_cards if ready_cards else None,
            fallback_items=act_items,
        )
        if not barcode_items:
            return ProcessingFlowCompletionResult(status="error", error_code="no_act_items")
        if any(not cls._normalize_processing_stock_barcode(item.get("barcode")) for item in barcode_items):
            return ProcessingFlowCompletionResult(status="error", error_code="missing_item_barcode")

        set_output_plan = processing_views._processing_expected_output_plan(
            base_payload,
            card_ids=ready_cards if ready_cards else None,
        )
        set_plan_mismatch_rows: list[dict] = []
        if int(set_output_plan.get("set_multiplier") or 1) > 1:
            if set_output_plan.get("remainders"):
                return ProcessingFlowCompletionResult(
                    status="error",
                    error_code="set_source_remainder",
                )
            planned_qty = dict(set_output_plan.get("expected_qty") or {})
            processed_qty: dict[tuple[str, str], int] = {}
            processed_names: dict[tuple[str, str], str] = {}
            for item in act_items:
                if not isinstance(item, dict):
                    continue
                sku_code = str(item.get("sku_code") or item.get("sku") or "").strip()
                if not sku_code:
                    continue
                size = str(item.get("size") or "").strip()
                key = (sku_code.casefold(), size.casefold())
                qty = processing_views._parse_qty_value(item.get("actual_qty")) or 0
                processed_qty[key] = processed_qty.get(key, 0) + max(qty, 0)
                processed_names.setdefault(key, str(item.get("name") or "").strip())
            for key in sorted(set(planned_qty) | set(processed_qty)):
                expected_qty = int(planned_qty.get(key) or 0)
                factual_qty = int(processed_qty.get(key) or 0)
                if factual_qty == expected_qty:
                    continue
                set_plan_mismatch_rows.append(
                    {
                        "sku_code": key[0],
                        "name": processed_names.get(key, ""),
                        "size": key[1],
                        "expected_qty": expected_qty,
                        "factual_qty": factual_qty,
                        "delta_qty": factual_qty - expected_qty,
                    }
                )

        boxes_raw = request.POST.get("boxes_json") or "[]"
        pallets_raw = request.POST.get("pallets_json") or "[]"
        try:
            boxes_data = json.loads(boxes_raw)
            pallets_data = json.loads(pallets_raw)
        except json.JSONDecodeError:
            return ProcessingFlowCompletionResult(status="error", error_code="invalid_json")
        if not isinstance(boxes_data, list):
            boxes_data = []
        if not isinstance(pallets_data, list):
            pallets_data = []
        canceled_box_codes = cls.canceled_processing_box_codes(
            order_id=str(order_id),
            entries=entries,
        )
        cleaned_submitted_state, _ = (
            cls.strip_canceled_processing_boxes_from_flow_state(
                {"boxes": boxes_data, "pallets": pallets_data},
                canceled_box_codes,
            )
        )
        boxes_data = cleaned_submitted_state["boxes"]
        pallets_data = cleaned_submitted_state["pallets"]
        submitted_box_directions: dict[str, str] = {}
        for raw_box in boxes_data:
            if not isinstance(raw_box, dict):
                continue
            raw_code = str(raw_box.get("code") or "").strip()
            if not raw_code:
                continue
            raw_direction = str(raw_box.get("direction") or raw_box.get("direction_name") or "").strip()
            if raw_direction:
                submitted_box_directions[raw_code] = raw_direction
        submitted_pallet_directions: dict[str, str] = {}
        for raw_pallet in pallets_data:
            if not isinstance(raw_pallet, dict):
                continue
            raw_code = str(raw_pallet.get("code") or "").strip()
            if not raw_code:
                continue
            raw_direction = str(raw_pallet.get("direction") or raw_pallet.get("direction_name") or "").strip()
            if raw_direction:
                submitted_pallet_directions[raw_code] = raw_direction

        release_entries_qs = OrderAuditEntry.objects.filter(
            order_id=str(order_id),
            order_type="processing",
        ).order_by("created_at", "id")
        if transaction.get_connection().in_atomic_block:
            release_entries_qs = release_entries_qs.select_for_update(of=("self",))
        release_entries = list(release_entries_qs)
        cls.purge_canceled_processing_boxes_from_open_sessions(
            order_id=str(order_id),
            entries=release_entries,
        )
        session_queryset = ProcessingFlowSession.objects.filter(
            order_id=order_id,
            order_type="processing",
            status=ProcessingFlowSession.STATUS_OPEN,
        )
        if transaction.get_connection().in_atomic_block:
            session_queryset = session_queryset.select_for_update()
        sessions = list(session_queryset)
        canceled_box_codes = cls.canceled_processing_box_codes(
            order_id=str(order_id),
        )
        merged_boxes = []
        merged_pallets = []
        if sessions:
            merged_boxes, merged_pallets = processing_views._merge_flow_sessions(sessions)
            boxes_data = processing_views._merge_flow_values_by_code(merged_boxes, boxes_data)
            pallets_data = processing_views._merge_flow_values_by_code(merged_pallets, pallets_data)
        cleaned_merged_state, _ = cls.strip_canceled_processing_boxes_from_flow_state(
            {"boxes": boxes_data, "pallets": pallets_data},
            canceled_box_codes,
        )
        boxes_data = cleaned_merged_state["boxes"]
        pallets_data = cleaned_merged_state["pallets"]
        boxes_data, pallets_data = processing_views._dedupe_pallet_box_links(boxes_data, pallets_data)
        released_changes = cls._released_processing_pallet_changes(
            entries=release_entries,
            flow_state={"boxes": boxes_data, "pallets": pallets_data},
        )
        if released_changes:
            return ProcessingFlowCompletionResult(
                status="error",
                error_code="released_pallet_locked",
            )
        released_pallet_keys = set(
            cls._processing_pallet_releases_from_entries(release_entries)
        )
        keep_source_boxes_mode = (
            str(base_payload.get(cls.PROCESSING_PACKAGING_MODE_KEY) or "").strip().lower()
            == cls.PROCESSING_PACKAGING_MODE_KEEP_SOURCE_BOXES
        )
        if keep_source_boxes_mode:
            keep_details = base_payload.get(cls.PROCESSING_KEEP_SOURCE_BOXES_KEY)
            keep_details = dict(keep_details) if isinstance(keep_details, dict) else {}
            expected_source_box_codes = {
                str(code or "").strip().casefold()
                for code in (keep_details.get("source_box_codes") or [])
                if str(code or "").strip()
            }
            boxes_data, pallets_data = cls._strip_keep_source_boxes_empty_drafts(
                boxes_data,
                pallets_data,
                expected_source_box_codes,
            )
            submitted_source_box_codes = {
                str(box.get("code") or "").strip().casefold()
                for box in boxes_data
                if isinstance(box, dict) and str(box.get("code") or "").strip()
            }
            if (
                not expected_source_box_codes
                or submitted_source_box_codes != expected_source_box_codes
            ):
                return ProcessingFlowCompletionResult(
                    status="error",
                    error_code="source_boxes_changed",
                )
        marking_validation = cls.validate_processing_flow_box_modes(boxes_data)
        if not marking_validation["ok"]:
            return ProcessingFlowCompletionResult(
                status="error",
                error_code="marking_mode_conflict",
            )

        if processing_views._state_has_open_box_with_items({"boxes": boxes_data}):
            return ProcessingFlowCompletionResult(status="error", error_code="open_boxes")

        def normalize_items(raw_items):
            items = []
            for raw in raw_items or []:
                if not isinstance(raw, dict):
                    continue
                qty = processing_views._parse_qty_value(raw.get("qty")) or 0
                if qty <= 0:
                    continue
                sku_code = (raw.get("sku_code") or raw.get("sku") or "").strip()
                name = (raw.get("name") or "").strip()
                size = (raw.get("size") or "").strip()
                if not (sku_code or name or size):
                    continue
                normalized_item = {
                    "sku_code": sku_code,
                    "sku": sku_code,
                    "name": name,
                    "size": size,
                    "qty": qty,
                    "barcode": str(raw.get("barcode") or "").strip(),
                    "goods_type": str(raw.get("goods_type") or "").strip(),
                    "condition": str(raw.get("condition") or "").strip(),
                    "condition_label": str(raw.get("condition_label") or "").strip(),
                    "marking_code": str(raw.get("marking_code") or raw.get("cz_code") or "").strip(),
                }
                raw_marking_codes = raw.get("marking_codes") or []
                if not isinstance(raw_marking_codes, list):
                    raw_marking_codes = [raw_marking_codes]
                marking_codes = []
                for raw_marking in raw_marking_codes:
                    if isinstance(raw_marking, dict):
                        raw_marking = raw_marking.get("code")
                    marking_code = processing_views._normalize_marking_code(raw_marking or "")
                    if marking_code and marking_code not in marking_codes:
                        marking_codes.append(marking_code)
                if normalized_item["marking_code"] and normalized_item["marking_code"] not in marking_codes:
                    marking_codes.append(normalized_item["marking_code"])
                if marking_codes:
                    normalized_item["marking_codes"] = marking_codes
                items.append(normalized_item)
            return items

        cleaned_boxes = []
        seen_box_codes = set()
        for idx, box in enumerate(boxes_data):
            if not isinstance(box, dict):
                continue
            items = normalize_items(box.get("items") or [])
            if not items:
                continue
            code = str(box.get("code") or "").strip() or f"BOX-{idx + 1}"
            if code in seen_box_codes:
                code = f"{code}-{idx + 1}"
            seen_box_codes.add(code)
            owner_agent_id = str(box.get("owner_agent_id") or "").strip()
            owner_user_id = box.get("owner_user_id") or ""
            owner_user_label = str(box.get("owner_user_label") or "").strip()
            fixed_label = str(box.get("fixed_label") or "").strip()
            direction_name = str(box.get("direction") or box.get("direction_name") or "").strip()
            if not direction_name:
                direction_name = submitted_box_directions.get(code, "")
            cleaned_box = {
                "code": code,
                "items": items,
                "sealed": True,
                "fixed_label": fixed_label,
                "direction": direction_name,
                "owner_agent_id": owner_agent_id,
                "owner_user_id": owner_user_id,
                "owner_user_label": owner_user_label,
            }
            marking_mode = str(box.get("marking_mode") or "").strip().lower()
            if marking_mode in cls.MARKING_MODE_VALUES:
                cleaned_box["marking_mode"] = marking_mode
            cleaned_box.update(WarehouseWritePathService.normalize_box_characteristics(box))
            cleaned_boxes.append(cleaned_box)

        def container_owner_key(container):
            if not isinstance(container, dict):
                return None
            owner_user_id = str(container.get("owner_user_id") or "").strip()
            if owner_user_id:
                return ("user", owner_user_id)
            owner_user_label = str(container.get("owner_user_label") or "").strip().casefold()
            if owner_user_label:
                return ("label", owner_user_label)
            owner_agent_id = str(container.get("owner_agent_id") or "").strip()
            if owner_agent_id:
                return ("agent", owner_agent_id)
            return None

        if cleaned_boxes:
            cleaned_box_by_code = {box["code"]: box for box in cleaned_boxes}
            raw_pallet_valid_boxes = set()
            empty_pallet_candidates = []
            for pallet in pallets_data:
                if not isinstance(pallet, dict):
                    continue
                pallet_code = str(pallet.get("code") or "").strip()
                if not pallet_code:
                    continue
                pallet_boxes = [
                    str(box_code).strip()
                    for box_code in (pallet.get("boxes") or [])
                    if str(box_code or "").strip()
                ]
                valid_boxes = [box_code for box_code in pallet_boxes if box_code in cleaned_box_by_code]
                if valid_boxes:
                    raw_pallet_valid_boxes.update(valid_boxes)
                    continue
                if normalize_items(pallet.get("items") or []):
                    continue
                empty_pallet_candidates.append(pallet)
            if not raw_pallet_valid_boxes and empty_pallet_candidates:
                remaining_boxes = list(cleaned_boxes)
                for pallet in empty_pallet_candidates:
                    pallet_owner_key = container_owner_key(pallet)
                    if pallet_owner_key:
                        boxes_for_pallet = [
                            box for box in remaining_boxes if container_owner_key(box) == pallet_owner_key
                        ]
                    elif len(empty_pallet_candidates) == 1:
                        boxes_for_pallet = [
                            box for box in remaining_boxes if container_owner_key(box) is None
                        ]
                    else:
                        boxes_for_pallet = []
                    if not boxes_for_pallet:
                        continue
                    existing_boxes = [
                        str(box_code).strip()
                        for box_code in (pallet.get("boxes") or [])
                        if str(box_code or "").strip()
                    ]
                    assigned_box_codes = [box["code"] for box in boxes_for_pallet]
                    pallet["boxes"] = existing_boxes + assigned_box_codes
                    assigned_box_code_set = set(assigned_box_codes)
                    remaining_boxes = [
                        box for box in remaining_boxes if box["code"] not in assigned_box_code_set
                    ]
                    if not remaining_boxes:
                        break

        cleaned_pallets = []
        seen_pallet_codes = set()
        for idx, pallet in enumerate(pallets_data):
            if not isinstance(pallet, dict):
                continue
            code = str(pallet.get("code") or "").strip() or f"PALLET-{idx + 1}"
            if code in seen_pallet_codes:
                code = f"{code}-{idx + 1}"
            seen_pallet_codes.add(code)
            boxes = [
                str(box_code).strip()
                for box_code in (pallet.get("boxes") or [])
                if str(box_code or "").strip()
            ]
            boxes = [box_code for box_code in boxes if box_code in seen_box_codes]
            items = normalize_items(pallet.get("items") or [])
            if not boxes and not items:
                continue
            location = pallet.get("location")
            if isinstance(location, dict):
                location = dict(location)
            elif isinstance(location, str):
                location = {"zone": location}
            else:
                location = {}
            if code.casefold() not in released_pallet_keys:
                location["zone"] = "OBR"
            owner_agent_id = str(pallet.get("owner_agent_id") or "").strip()
            owner_user_id = pallet.get("owner_user_id") or ""
            owner_user_label = processing_views._resolve_actor_label(
                pallet.get("owner_user_label"),
                owner_agent_id,
                owner_user_id,
                unknown="",
            )
            closed_by_agent_id = str(pallet.get("closed_by_agent_id") or "").strip()
            closed_by_user_id = pallet.get("closed_by_user_id") or ""
            closed_by_user_label = processing_views._resolve_actor_label(
                pallet.get("closed_by_user_label"),
                closed_by_agent_id,
                closed_by_user_id,
                unknown="",
            )
            if not closed_by_user_label:
                closed_by_user_label = processing_views._resolve_actor_label(
                    owner_user_label,
                    owner_agent_id,
                    owner_user_id,
                    unknown="",
                )
            direction_name = str(pallet.get("direction") or pallet.get("direction_name") or "").strip()
            if not direction_name:
                direction_name = submitted_pallet_directions.get(code, "")
            cleaned_pallets.append(
                {
                    "code": code,
                    "boxes": boxes,
                    "items": items,
                    "sealed": True,
                    "direction": direction_name,
                    "location": location,
                    "owner_agent_id": owner_agent_id,
                    "owner_user_id": owner_user_id,
                    "owner_user_label": owner_user_label,
                    "closed_by_agent_id": closed_by_agent_id,
                    "closed_by_user_id": closed_by_user_id,
                    "closed_by_user_label": closed_by_user_label,
                }
            )
        box_direction_by_code = {
            str(entry.get("code") or "").strip(): str(entry.get("direction") or "").strip()
            for entry in cleaned_boxes
            if isinstance(entry, dict) and str(entry.get("code") or "").strip()
        }
        for pallet in cleaned_pallets:
            if not isinstance(pallet, dict):
                continue
            pallet_direction = str(pallet.get("direction") or "").strip()
            if not pallet_direction:
                for box_code in pallet.get("boxes") or []:
                    box_direction = box_direction_by_code.get(str(box_code or "").strip(), "")
                    if box_direction:
                        pallet_direction = box_direction
                        break
                if pallet_direction:
                    pallet["direction"] = pallet_direction
            if not pallet_direction:
                continue
            for box_code in pallet.get("boxes") or []:
                code = str(box_code or "").strip()
                if not code:
                    continue
                if not box_direction_by_code.get(code):
                    box_direction_by_code[code] = pallet_direction
        for entry in cleaned_boxes:
            if not isinstance(entry, dict):
                continue
            code = str(entry.get("code") or "").strip()
            if not code:
                continue
            if not str(entry.get("direction") or "").strip() and box_direction_by_code.get(code):
                entry["direction"] = box_direction_by_code.get(code, "")

        if not cleaned_boxes:
            return ProcessingFlowCompletionResult(status="error", error_code="no_boxes")
        if not cleaned_pallets:
            return ProcessingFlowCompletionResult(status="error", error_code="no_pallets")
        if not can_reassign_boxes:
            tracked_box_codes = {
                str(box.get("code") or "").strip()
                for box in cleaned_boxes
                if str(box.get("code") or "").strip()
            }
            if processing_views._has_box_reassignment_between_pallets(merged_pallets, cleaned_pallets, tracked_box_codes):
                return ProcessingFlowCompletionResult(status="error", error_code="box_move_head_only")
        box_label_map = processing_views._build_box_label_map(cleaned_boxes)
        for box in cleaned_boxes:
            if not isinstance(box, dict):
                continue
            box_code = str(box.get("code") or "").strip()
            if not box_code:
                continue
            if not str(box.get("fixed_label") or "").strip():
                box["fixed_label"] = box_label_map.get(box_code, "")

        agent_id = (request.POST.get("agent_id") or "").strip()
        if agent_id:
            session = processing_views._flow_session_for_request(order_id, agent_id, request, create=True)
            if session:
                flow_state = normalize_flow_state(cleaned_boxes, cleaned_pallets, "", "")
                session.flow_state = flow_state
                session.last_seen = timezone.localtime()
                session.status = ProcessingFlowSession.STATUS_OPEN
                session.save(update_fields=["flow_state", "last_seen", "status", "updated_at"])

        pallet_box_codes = set()
        for pallet in cleaned_pallets:
            for box_code in pallet.get("boxes") or []:
                if box_code:
                    pallet_box_codes.add(box_code)
        unassigned_boxes = [box for box in cleaned_boxes if box["code"] not in pallet_box_codes]
        if unassigned_boxes:
            return ProcessingFlowCompletionResult(status="error", error_code="unassigned_boxes")

        totals_by_product_state: dict[tuple[str, str], dict] = {}

        def canonical_output_goods_type(value) -> str:
            normalized = StockAvailabilityService.normalize_goods_type(value)
            return {
                "оптовый": "op",
                "готовый": "gv",
                "брак": "br",
                "возврат": "vz",
                "возврат с отгрузки": "votg",
                "расходный": "rh",
                "не обработанный": "no",
            }.get(normalized, normalized)

        default_output_goods_type = canonical_output_goods_type(
            base_payload.get("goods_type") or ""
        )

        def _ensure_total_entry(store, key):
            return store.setdefault(
                key,
                {
                    "total": 0,
                    "box_codes": set(),
                    "pallet_codes": set(),
                },
            )

        def _item_barcode(item) -> str:
            return cls._normalize_processing_stock_barcode(item.get("barcode"))

        def _item_goods_type(item) -> str:
            condition = str(item.get("condition") or "").strip().lower()
            if condition == "defect":
                return "br"
            return canonical_output_goods_type(
                item.get("goods_type") or default_output_goods_type or ""
            )

        def _item_identity(item) -> tuple[str, str]:
            return _item_barcode(item), _item_goods_type(item)

        def _add_total_qty(item, qty: int):
            if qty <= 0:
                return True
            barcode = _item_barcode(item)
            if not barcode:
                return False
            _ensure_total_entry(totals_by_product_state, _item_identity(item))["total"] += qty
            return True

        def _add_container_code(item, container_field: str, code: str):
            code_value = str(code or "").strip()
            if not code_value:
                return True
            barcode = _item_barcode(item)
            if not barcode:
                return False
            _ensure_total_entry(totals_by_product_state, _item_identity(item))[container_field].add(code_value)
            return True

        box_items_by_code: dict[str, list[dict]] = {}
        missing_actual_barcode = False
        for box in cleaned_boxes:
            box_code = str(box.get("code") or "").strip()
            box_items = box.get("items") or []
            if box_code:
                box_items_by_code[box_code] = box_items if isinstance(box_items, list) else []
            for item in box.get("items") or []:
                qty = processing_views._parse_qty_value(item.get("qty")) or 0
                if qty <= 0:
                    continue
                if not _add_total_qty(item, qty):
                    missing_actual_barcode = True
                    continue
                _add_container_code(item, "box_codes", box_code)
        for pallet in cleaned_pallets:
            pallet_code = str(pallet.get("code") or "").strip()
            pallet_items = pallet.get("items") or []
            has_direct_items = bool(isinstance(pallet_items, list) and pallet_items)
            if has_direct_items:
                for item in pallet_items:
                    qty = processing_views._parse_qty_value(item.get("qty")) or 0
                    if qty <= 0:
                        continue
                    if not _add_total_qty(item, qty):
                        missing_actual_barcode = True
                        continue
                    _add_container_code(item, "pallet_codes", pallet_code)
                continue
            for box_code in pallet.get("boxes") or []:
                code = str(box_code or "").strip()
                if not code:
                    continue
                for item in box_items_by_code.get(code, []):
                    qty = processing_views._parse_qty_value(item.get("qty")) or 0
                    if qty <= 0:
                        continue
                    _add_container_code(item, "pallet_codes", pallet_code)

        if missing_actual_barcode:
            return ProcessingFlowCompletionResult(status="error", error_code="missing_item_barcode")

        if keep_source_boxes_mode:
            barcode_items = cls._align_keep_source_fact_goods_types(
                barcode_items,
                totals_by_product_state,
            )

        has_qty_mismatch = bool(set_plan_mismatch_rows)
        placement_items = []
        mismatch_rows = list(set_plan_mismatch_rows)
        expected_product_states = {_item_identity(item) for item in barcode_items}
        if any(
            int(entry.get("total") or 0) > 0 and identity not in expected_product_states
            for identity, entry in totals_by_product_state.items()
        ):
            return ProcessingFlowCompletionResult(status="error", error_code="barcode_mismatch")
        for item in barcode_items:
            barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
            goods_type = _item_goods_type(item)
            entry = totals_by_product_state.get((barcode, goods_type)) or {
                "total": 0,
                "box_codes": set(),
                "pallet_codes": set(),
            }
            expected_qty = processing_views._parse_qty_value(item.get("actual_qty")) or 0
            factual_qty = int(entry.get("total") or 0)
            box_count = len(entry.get("box_codes") or ())
            pallet_count = len(entry.get("pallet_codes") or ())
            if factual_qty != expected_qty:
                has_qty_mismatch = True
                mismatch_rows.append(
                    {
                        "sku_code": str(item.get("sku_code") or item.get("sku") or "").strip(),
                        "name": str(item.get("name") or "").strip(),
                        "size": str(item.get("size") or "").strip(),
                        "barcode": barcode,
                        "goods_type": goods_type,
                        "expected_qty": expected_qty,
                        "factual_qty": factual_qty,
                        "delta_qty": factual_qty - expected_qty,
                        "discrepancy_type": "processing_output_quantity",
                    }
                )
            accepted_qty = factual_qty
            placement_item = {
                "sku_code": item.get("sku_code"),
                "name": item.get("name"),
                "size": item.get("size"),
                "barcode": barcode,
                "goods_type": goods_type,
                "condition": item.get("condition") or ("defect" if goods_type == "br" else "good"),
                "condition_label": item.get("condition_label") or ("Брак · без ЧЗ" if goods_type == "br" else "Годный товар"),
                "actual_qty": accepted_qty,
                "box_qty": box_count,
                "pallet_qty": pallet_count,
            }
            if factual_qty != expected_qty:
                placement_item["expected_qty"] = expected_qty
                placement_item["factual_qty"] = factual_qty
            placement_items.append(placement_item)
        marking_boxes_by_code: dict[str, dict] = {}
        marking_qs = MarkingCode.objects.filter(
            order_type="processing",
            order_id=order_id,
            used_at__isnull=False,
        )
        missing_marking_boxes = False
        unknown_marking_boxes = False
        for row in marking_qs.values("code", "sku_code", "size", "barcode", "box_barcode"):
            box_code = str(row.get("box_barcode") or "").strip()
            if not box_code:
                missing_marking_boxes = True
                continue
            box_label = box_label_map.get(box_code)
            if not box_label:
                unknown_marking_boxes = True
                continue
            code = processing_views._normalize_marking_code(row.get("code") or "")
            if not code:
                continue
            marking_boxes_by_code[code] = {
                "code": code,
                "sku_code": str(row.get("sku_code") or "").strip(),
                "size": str(row.get("size") or "").strip(),
                "barcode": str(row.get("barcode") or "").strip(),
                "box_barcode": box_code,
                "box_label": box_label,
            }

        flow_marking_refs = []
        for box in cleaned_boxes:
            box_code = str(box.get("code") or "").strip()
            for item in box.get("items") or []:
                if not isinstance(item, dict):
                    continue
                raw_marking_codes = item.get("marking_codes") or []
                if not isinstance(raw_marking_codes, list):
                    raw_marking_codes = [raw_marking_codes]
                for raw_marking in raw_marking_codes:
                    if isinstance(raw_marking, dict):
                        raw_marking = raw_marking.get("code")
                    code = processing_views._normalize_marking_code(raw_marking or "")
                    if not code:
                        continue
                    flow_marking_refs.append(
                        {
                            "code": code,
                            "box_barcode": box_code,
                            "sku_code": str(item.get("sku_code") or item.get("sku") or "").strip(),
                            "size": str(item.get("size") or "").strip(),
                            "barcode": str(item.get("barcode") or "").strip(),
                        }
                    )
        flow_marking_code_variants = set()
        for item in flow_marking_refs:
            flow_marking_code_variants.add(item["code"])
            if "\x1d" in item["code"]:
                flow_marking_code_variants.add(item["code"].replace("\x1d", "_x001D_"))
        flow_marking_rows = {
            processing_views._normalize_marking_code(row.code or ""): row
            for row in MarkingCode.objects.filter(
                code__in=list(flow_marking_code_variants)
            )
        }
        for item in flow_marking_refs:
            code = item["code"]
            box_code = item["box_barcode"]
            box_label = box_label_map.get(box_code)
            marking_row = flow_marking_rows.get(code)
            if not marking_row or not box_label:
                unknown_marking_boxes = True
                continue
            marking_boxes_by_code[code] = {
                "code": code,
                "sku_code": item["sku_code"] or str(marking_row.sku_code or "").strip(),
                "size": item["size"] or str(marking_row.size or "").strip(),
                "barcode": item["barcode"] or str(marking_row.barcode or "").strip(),
                "box_barcode": box_code,
                "box_label": box_label,
            }
        if missing_marking_boxes or unknown_marking_boxes:
            return ProcessingFlowCompletionResult(status="error", error_code="marking_box_mismatch")
        marking_boxes_snapshot = list(marking_boxes_by_code.values())

        placed_cards_list = base_payload.get("placed_cards") or []
        if not isinstance(placed_cards_list, list):
            placed_cards_list = []
        for card_id in ready_cards:
            if card_id and card_id not in placed_cards_list:
                placed_cards_list.append(card_id)
        base_payload["placed_cards"] = placed_cards_list
        flow_completed_at = timezone.now()
        now = timezone.localtime(flow_completed_at).isoformat()
        for card in base_payload.get("cards") or []:
            card_id = processing_views._processing_card_id(card)
            if card_id and card_id in ready_cards:
                card["placed_at"] = card.get("placed_at") or now
                card["placed_done"] = True
        raw_box_assignments = base_payload.get(cls.PROCESSING_BOX_ASSIGNMENTS_KEY) or []
        box_assignments = [
            dict(row) for row in raw_box_assignments if isinstance(row, dict)
        ] if isinstance(raw_box_assignments, list) else []
        if box_assignments:
            box_facts_by_user: dict[str, dict] = {}
            box_facts_by_label: dict[str, dict] = {}
            for box in cleaned_boxes:
                owner_user_id = str(box.get("owner_user_id") or "").strip()
                owner_label = str(box.get("owner_user_label") or "").strip().casefold()
                box_qty = sum(
                    cls._positive_int(item.get("qty"))
                    for item in (box.get("items") or [])
                    if isinstance(item, dict)
                )
                if owner_user_id:
                    facts = box_facts_by_user.setdefault(owner_user_id, {"boxes": 0, "qty": 0})
                    facts["boxes"] += 1
                    facts["qty"] += box_qty
                if owner_label:
                    facts = box_facts_by_label.setdefault(owner_label, {"boxes": 0, "qty": 0})
                    facts["boxes"] += 1
                    facts["qty"] += box_qty
            for assignment in box_assignments:
                user_key = str(assignment.get("assignee_user_id") or "").strip()
                label_key = str(assignment.get("assignee_name") or "").strip().casefold()
                facts = box_facts_by_user.get(user_key) or box_facts_by_label.get(label_key) or {}
                assignment["status"] = "completed"
                assignment["actual_boxes"] = int(facts.get("boxes") or 0)
                assignment["actual_qty"] = int(facts.get("qty") or 0)
                assignment["completed_at"] = now
            base_payload[cls.PROCESSING_BOX_ASSIGNMENTS_KEY] = box_assignments
        act_payload = dict(base_payload)
        apply_processing_cards_subzone(
            act_payload,
            [
                processing_views._processing_card_id(card)
                for card in (act_payload.get("cards") or [])
                if isinstance(card, dict)
            ],
            PROCESSING_SUBZONE_OUT,
        )
        act_payload["flow_closed"] = True
        act_payload["flow_closed_at"] = now
        resolved_goods_type = StockAvailabilityService.normalize_goods_type(
            act_payload.get("goods_type") or base_payload.get("goods_type") or ""
        )
        if resolved_goods_type:
            act_payload["goods_type"] = resolved_goods_type
            act_payload["goods_type_label"] = processing_views.GOODS_TYPE_LABELS.get(
                resolved_goods_type,
                str(act_payload.get("goods_type_label") or "").strip(),
            )
        else:
            act_payload.pop("goods_type", None)
            act_payload.pop("goods_type_label", None)
        act_payload["act_state"] = "closed"
        act_payload["act_items"] = placement_items
        act_payload["act_boxes"] = cleaned_boxes
        act_payload["act_pallets"] = cleaned_pallets
        act_payload["act_marking_boxes"] = marking_boxes_snapshot
        act_payload["flow_state"] = normalize_flow_state(cleaned_boxes, cleaned_pallets, "", "")
        act_payload["flow_closed"] = True
        act_payload["flow_closed_at"] = now
        expected_output_qty = sum(
            max(int(item.get("actual_qty") or 0), 0)
            for item in placement_items
            if isinstance(item, dict)
        )
        set_multiplier = int(set_output_plan.get("set_multiplier") or 1)
        expected_input_qty = expected_output_qty
        if set_multiplier > 1:
            expected_input_qty = int(set_output_plan.get("source_qty_total") or 0)
        warehouse_input_qty = 0
        warehouse_qty_mismatch = False
        if keep_source_boxes_mode:
            keep_details = base_payload.get(cls.PROCESSING_KEEP_SOURCE_BOXES_KEY)
            keep_details = dict(keep_details) if isinstance(keep_details, dict) else {}
            warehouse_input_qty = int(keep_details.get("source_qty") or expected_input_qty)
            warehouse_qty_mismatch = warehouse_input_qty != expected_input_qty
        elif latest and latest.agency:
