        def make_result_line_key(
            *,
            article: str,
            size: str,
            barcode: str,
            destination: str,
            received: int,
            index: int,
        ) -> str:
            return "|".join(
                [
                    str(selected_card_id_key),
                    str(index),
                    str(article or "").strip().lower(),
                    str(size or "").strip().lower(),
                    str(barcode or "").strip().lower(),
                    str(destination or "-").strip().lower() or "-",
                    str(int(received or 0)),
                ]
            )

        def aggregate_saved_rows(rows: list[dict], article: str, size: str) -> dict:
            metric_fields = (
                "processed",
                "defect",
                "shortage",
                "labels_printed",
                "labels_unboxed",
                "shipped_qty",
                "tags_replaced",
            )
            aggregated: dict[str, str] = {
                "card_id": selected_card_id_key,
                "article": article,
                "size": size,
                "destination": "-",
            }
            has_metric = False
            for field_name in metric_fields:
                total = 0
                has_value = False
                for row in rows:
                    qty = processing_views._parse_qty_value((row or {}).get(field_name))
                    if qty is None:
                        continue
                    total += qty
                    has_value = True
                if has_value:
                    aggregated[field_name] = str(total)
                    has_metric = True
            return aggregated if has_metric else {}

        def saved_result_for(article: str, size: str, destination: str, line_key: str, received: int):
            article_key = str(article or "").strip().lower()
            size_key = str(size or "").strip().lower()
            dest_key = str(destination or "").strip().lower() or "-"
            key = (selected_card_id_key, article_key, size_key, dest_key)
            normalized_line_key = str(line_key or "").strip().lower()
            saved = results_map.get((*key, normalized_line_key)) if normalized_line_key else None
            if saved:
                return saved
            base_rows = results_by_base_key.get(key) or []
            if int(expected_base_counts.get(key, 0) or 0) > 1:
                received_text = str(int(received or 0))
                matching_rows = [
                    row
                    for row in base_rows
                    if str(row.get("received") or "").strip() == received_text
                ]
                if len(matching_rows) == 1:
                    return matching_rows[0]
                return {}
            if len(base_rows) == 1:
                return base_rows[0]
            legacy_saved = legacy_results_map.get((article_key, size_key, dest_key))
            if legacy_saved:
                return legacy_saved
            if dest_key != "-":
                return {}
            card_specific_rows = results_by_card_article_size.get((selected_card_id_key, article_key, size_key)) or []
            if card_specific_rows:
                aggregated = aggregate_saved_rows(card_specific_rows, article, size)
                if aggregated:
                    return aggregated
            rows = results_by_article_size.get((article_key, size_key)) or []
            if rows:
                aggregated = aggregate_saved_rows(rows, article, size)
                if aggregated:
                    return aggregated
            return {}

        results_rows: list[dict] = []
        if filtered_rows:
            for row in filtered_rows:
                if not isinstance(row, dict):
                    continue
                size_value = str(row.get("size") or "").strip()
                row_article = str(row.get("article") or row.get("product_name") or article_value or "").strip()
                barcode_value = barcode_map.get(size_value.lower(), "") if size_value else ""
                qty = plan_row_total_qty(row)
                if qty <= 0:
                    continue
                line_key = make_result_line_key(
                    article=row_article,
                    size=size_value,
                    barcode=barcode_value,
                    destination="-",
                    received=qty,
                    index=len(results_rows),
                )
                base_key = (
                    selected_card_id_key,
                    str(row_article or "").strip().lower(),
                    str(size_value or "").strip().lower(),
                    "-",
                )
                expected_base_counts[base_key] = expected_base_counts.get(base_key, 0) + 1
                saved = saved_result_for(row_article, size_value, "-", line_key, qty)
                results_rows.append(
                    {
                        "article": row_article or "-",
                        "source_article": row_article or "-",
                        "product_name": product_name_value,
                        "barcode": barcode_value or "-",
                        "size": size_value or "-",
                        "line_key": line_key,
                        "received": qty,
                        "destination": "-",
                        "processed": saved.get("processed") or "",
                        "defect": saved.get("defect") or "",
                        "shortage": saved.get("shortage") or "",
                        "labels_printed": saved.get("labels_printed") or "",
                        "labels_unboxed": saved.get("labels_unboxed") or (saved.get("shipped_qty") or ""),
                        "shipped_qty": saved.get("shipped_qty") or "",
                        "tags_replaced": saved.get("tags_replaced") or "",
                    }
                )
        if not results_rows:
            for row in card_rows:
                if not isinstance(row, dict):
                    continue
                row_article = str(row.get("article") or article_value or "").strip()
                source_article_value = str(row.get("source_article") or article_value or "").strip()
                size_value = str(row.get("size") or "").strip()
                barcode_value = str(row.get("barcode") or "").strip()
                qty = processing_views._parse_qty_value(row.get("qty")) or 0
                if qty <= 0:
                    continue
                line_key = make_result_line_key(
                    article=row_article,
                    size=size_value,
                    barcode=barcode_value,
                    destination="-",
                    received=qty,
                    index=len(results_rows),
                )
                base_key = (
                    selected_card_id_key,
                    str(row_article or "").strip().lower(),
                    str(size_value or "").strip().lower(),
                    "-",
                )
                expected_base_counts[base_key] = expected_base_counts.get(base_key, 0) + 1
                saved = saved_result_for(row_article, size_value, "-", line_key, qty)
                results_rows.append(
                    {
                        "article": row_article or "-",
                        "source_article": source_article_value or row_article or "-",
                        "product_name": row.get("product_name") or label_product_name_value or product_name_value,
                        "barcode": barcode_value or "-",
                        "size": size_value or "-",
                        "line_key": line_key,
                        "received": qty,
                        "destination": "-",
                        "processed": saved.get("processed") or "",
                        "defect": saved.get("defect") or "",
                        "shortage": saved.get("shortage") or "",
                        "labels_printed": saved.get("labels_printed") or "",
                        "labels_unboxed": saved.get("labels_unboxed") or (saved.get("shipped_qty") or ""),
                        "shipped_qty": saved.get("shipped_qty") or "",
                        "tags_replaced": saved.get("tags_replaced") or "",
                    }
                )

        if processing_set_summary["active"] and results_rows:
            # Repeated source rows describe the units inside one finished set.
            # In the result accounting they must become one output position,
            # otherwise the operator sees (and may save) the same set four times.
            source_rows = [row for row in results_rows if isinstance(row, dict)]
            set_result = dict(source_rows[0])

            output_article = (
                processing_set_summary["result_articles"][0]
                if processing_set_summary["result_articles"]
                else str(set_result.get("article") or "").strip()
            )
            output_barcode = (
                processing_set_summary["result_barcodes"][0]
                if processing_set_summary["result_barcodes"]
                else str(set_result.get("barcode") or "").strip()
            )
            output_size = str(set_result.get("size") or "").strip()
            stored_set_results = []
            for stored_row in payload.get("processing_results") or []:
                if not isinstance(stored_row, dict):
                    continue
                stored_card_id = str(stored_row.get("card_id") or "").strip().casefold()
                if stored_card_id and stored_card_id != str(card_id_value or "").strip().casefold():
                    continue
                stored_set_results.append(stored_row)

            def stored_set_score(stored_row: dict) -> tuple[int, int, int, int, int]:
                stored_article = str(stored_row.get("article") or "").strip().casefold()
                stored_barcode = str(stored_row.get("barcode") or "").strip()
                stored_size = str(stored_row.get("size") or "").strip().casefold()
                metric_count = sum(
                    processing_views._parse_qty_value(stored_row.get(field_name)) is not None
                    for field_name in (
                        "processed",
                        "defect",
                        "shortage",
                        "labels_printed",
                        "labels_unboxed",
                        "shipped_qty",
                        "tags_replaced",
                    )
                )
                return (
                    int(bool(output_article) and stored_article == output_article.casefold()),
                    int(bool(output_barcode) and stored_barcode == output_barcode),
                    int(processing_views._parse_qty_value(stored_row.get("processed")) is not None),
                    int(bool(output_size) and stored_size == output_size.casefold()),
                    metric_count,
                )

            saved_set_result = (
                max(stored_set_results, key=stored_set_score)
                if stored_set_results
                else {}
            )

            def completed_set_metric(field_name: str):
                saved_value = processing_views._parse_qty_value(saved_set_result.get(field_name))
                if saved_value is not None:
                    return saved_value
                values = [
                    processing_views._parse_qty_value(row.get(field_name))
                    for row in source_rows
                ]
                declared = [value for value in values if value is not None]
                if not declared:
                    return ""
                if field_name == "processed" and len(declared) != len(values):
                    return ""
                if field_name == "processed":
                    return min(declared)
                return sum(declared)
            set_result.update(
                {
                    "article": output_article or "-",
                    "source_article": article_value or set_result.get("source_article") or "-",
                    "product_name": result_product_name_value or set_result.get("product_name") or product_name_value,
                    "barcode": output_barcode or "-",
                    "size": output_size or "-",
                    "line_key": make_result_line_key(
                        article=output_article,
                        size=output_size,
                        barcode=output_barcode,
                        destination="-",
                        received=processing_set_summary["finished_qty"],
                        index=0,
                    ),
                    "received": processing_set_summary["finished_qty"],
                    "processed": completed_set_metric("processed"),
                    "defect": completed_set_metric("defect"),
                    "shortage": completed_set_metric("shortage"),
                    "labels_printed": completed_set_metric("labels_printed"),
                    "labels_unboxed": completed_set_metric("labels_unboxed"),
                    "shipped_qty": completed_set_metric("shipped_qty"),
                    "tags_replaced": completed_set_metric("tags_replaced"),
                    "is_set_output": True,
                    "set_units_per_set": processing_set_summary["units_per_set"],
                    "set_source_qty": processing_set_summary["source_qty"],
                }
            )
            results_rows = [set_result]

        def metric_or_none(value):
            return processing_views._parse_qty_value(value)

        def metric_or_zero(value) -> int:
            parsed = metric_or_none(value)
            return parsed if parsed is not None else 0

        job_barcode_map: dict[tuple[str, str], int] = {}
        job_sku_map: dict[tuple[str, str], int] = {}
        job_barcode_label_map: dict[tuple[str, str, str], int] = {}
        job_sku_label_map: dict[tuple[str, str, str], int] = {}
        marking_barcode_map: dict[tuple[str, str], int] = {}
        marking_sku_map: dict[tuple[str, str], int] = {}
        if order_id:
            printed_jobs_qs = (
                ProcessingPrintJob.objects.filter(
                    order_id=str(order_id),
                    status=ProcessingPrintJob.STATUS_PRINTED,
                )
                .values(
                    "article",
                    "barcode",
                    "size",
                    "processing_param_key",
                    "label_width_mm",
                    "label_height_mm",
                )
                .annotate(copies=Sum("copies_count"))
            )
            for item in printed_jobs_qs:
                label_key = (
                    processing_views._processing_marking_label_key_from_param_key(
                        item.get("processing_param_key"),
                    )
                    or
                    processing_views._processing_marking_label_key_from_dimensions(
                        item.get("label_width_mm"),
                        item.get("label_height_mm"),
                    )
                    or "item"
                )
                barcode_key = (
                    str(item.get("barcode") or "").strip(),
                    str(item.get("size") or "").strip().lower(),
                )
                sku_key = (
                    str(item.get("article") or "").strip().lower(),
                    str(item.get("size") or "").strip().lower(),
                )
                count_value = int(item.get("copies") or 0)
                if barcode_key[0]:
                    job_barcode_map[barcode_key] = max(job_barcode_map.get(barcode_key, 0), count_value)
                    label_barcode_key = (label_key, barcode_key[0], barcode_key[1])
                    job_barcode_label_map[label_barcode_key] = max(
                        job_barcode_label_map.get(label_barcode_key, 0),
                        count_value,
                    )
                if sku_key[0]:
                    job_sku_map[sku_key] = max(job_sku_map.get(sku_key, 0), count_value)
                    label_sku_key = (label_key, sku_key[0], sku_key[1])
                    job_sku_label_map[label_sku_key] = max(
                        job_sku_label_map.get(label_sku_key, 0),
