        processing_act_status = str(processing_act.get("status") or "").strip().lower()
        client_response = str(processing_act.get("client_response") or "pending").strip().lower()
        updates["processing_act"] = processing_act
        updates["processing_act_visible"] = bool(
            int(processing_act.get("version") or 0) >= 1
            and processing_act_status in {"awaiting_confirmations", "confirmed", "dispute"}
        )
        updates["processing_act_manager_response"] = str(
            processing_act.get("manager_response") or "not_required"
        ).strip().lower()
        updates["processing_act_client_response"] = client_response
        updates["processing_act_confirmed_by"] = str(
            processing_act.get("confirmed_by")
            or processing_act.get("head_confirmed_by")
            or ""
        ).strip()
        updates["processing_act_confirmed_at"] = (
