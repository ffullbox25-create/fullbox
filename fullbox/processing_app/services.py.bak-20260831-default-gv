    @classmethod
    @staticmethod
    def _parse_agent_version_parts(version: str) -> tuple[int, int, int]:
        match = re.search(r"(\d+)(?:\.(\d+))?(?:\.(\d+))?", str(version or ""))
        if not match:
            return (0, 0, 0)
        return tuple(int(part or 0) for part in match.groups(default="0"))

    @classmethod
    def _print_agent_supports_batch_jobs(cls, agent_version: str) -> bool:
        return cls._parse_agent_version_parts(agent_version) >= (1, 0, 55)

    @staticmethod
    def _print_job_lease_seconds() -> int:
        try:
            configured_value = int(getattr(settings, "PROCESSING_PRINT_JOB_LEASE_SECONDS", 600))
        except (TypeError, ValueError):
            configured_value = 600
        return max(configured_value, 60)

    @staticmethod
    def _print_job_label_payloads(job: ProcessingPrintJob) -> list[str]:
        label_list = job.label_png_base64_list if isinstance(job.label_png_base64_list, list) else []
        label_list = [str(item or "").strip() for item in label_list if str(item or "").strip()]
        if label_list:
            return label_list
        label = str(job.label_png_base64 or "").strip()
        if not label:
            return []
        copies_count = max(1, int(job.copies_count or 1))
        return [label for _ in range(copies_count)]

    @classmethod
    def processing_print_jobs_next(cls, *, agent_name: str, agent_version: str = "") -> ProcessingJsonResult:
        processing_views = cls._views()
        agent_status = processing_views.save_print_agent_status(agent_name)
        if agent_status.get("paused"):
            return ProcessingJsonResult(
                status="paused",
                http_status=200,
                payload={"ok": True, "has_job": False, "hasJob": False, "paused": True},
            )
        agent_targets = cls._resolve_print_agent_targets(agent_name)
        supports_batch_jobs = cls._print_agent_supports_batch_jobs(agent_version)
        with transaction.atomic():
            claim_time = timezone.now()
            # Jobs created before leases were introduced have a NULL lease. Treat
            # them as abandoned as well, otherwise they would remain in printing
            # forever after an agent or workstation crash.
            ProcessingPrintJob.objects.filter(
                status=ProcessingPrintJob.STATUS_PRINTING,
            ).filter(
                Q(lease_until__isnull=True) | Q(lease_until__lte=claim_time),
            ).update(
                status=ProcessingPrintJob.STATUS_PENDING,
                claimed_at=None,
                lease_until=None,
                error="",
                updated_at=claim_time,
            )
            # Several Desktop agents poll concurrently.  Do not wait for a row
            # already being claimed by another worker; otherwise all sync
            # Gunicorn workers can queue behind one print job.
            pending_qs = ProcessingPrintJob.objects.select_for_update(skip_locked=True).filter(
                status=ProcessingPrintJob.STATUS_PENDING
            )
            if agent_targets:
                targeted_job = pending_qs.filter(agent__in=agent_targets).order_by("created_at").first()
                job = targeted_job or pending_qs.filter(agent="").order_by("created_at").first()
            else:
                job = pending_qs.filter(agent="").order_by("created_at").first()
            if not job:
                return ProcessingJsonResult(
                    status="empty",
                    http_status=200,
                    payload={"ok": True, "has_job": False, "hasJob": False, "retry_after_ms": 1200},
                )
            batch_jobs = [job]
            if supports_batch_jobs:
                # Never sleep while holding SELECT FOR UPDATE locks.  Enqueue now
                # creates one atomic batch job, so the old coalescing delay only
                # serialized concurrent controllers and caused 502/499 responses.
                batch_qs = pending_qs.exclude(pk=job.pk).filter(
                    printer_name=job.printer_name,
                    label_width_mm=job.label_width_mm,
                    label_height_mm=job.label_height_mm,
                )
                if str(job.agent or "").strip():
                    batch_qs = batch_qs.filter(agent=job.agent)
                else:
                    batch_qs = batch_qs.filter(agent="")
                batch_jobs.extend(list(batch_qs.order_by("created_at")[:79]))

            label_payloads = []
            job_ids = []
            for batch_job in batch_jobs:
                labels = cls._print_job_label_payloads(batch_job)
                if not labels:
                    continue
                label_payloads.extend(labels)
                job_ids.append(int(batch_job.id))
                batch_job.status = ProcessingPrintJob.STATUS_PRINTING
                batch_job.claimed_at = claim_time
                batch_job.lease_until = claim_time + timedelta(seconds=cls._print_job_lease_seconds())
                batch_job.attempt_count = int(batch_job.attempt_count or 0) + 1
                if not str(batch_job.agent or "").strip() and agent_targets:
                    batch_job.agent = agent_targets[0]
                batch_job.save(
                    update_fields=[
                        "status",
                        "agent",
                        "claimed_at",
                        "lease_until",
                        "attempt_count",
                        "updated_at",
                    ]
                )

            if not label_payloads or not job_ids:
                return ProcessingJsonResult(
                    status="empty",
                    http_status=200,
                    payload={"ok": True, "has_job": False, "hasJob": False, "retry_after_ms": 1200},
                )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "has_job": True,
                "hasJob": True,
                "job": processing_views._serialize_print_job(
                    job,
                    label_list=label_payloads,
                    job_ids=job_ids,
                ),
            },
        )

    @classmethod
    def processing_print_jobs_complete(cls, *, data, agent_name: str = "") -> ProcessingJsonResult:
        job_id = data.get("job_id") or data.get("id")
        if not job_id:
            return ProcessingJsonResult(status="missing_job_id", http_status=400, payload={"ok": False, "error": "job_id is required"})
        job = ProcessingPrintJob.objects.filter(pk=job_id).first()
        if not job:
            return ProcessingJsonResult(status="missing_job", http_status=404, payload={"ok": False, "error": "Job not found"})
        agent_targets = cls._resolve_print_agent_targets(agent_name)
        if agent_name and str(job.agent or "").strip() not in agent_targets:
            return ProcessingJsonResult(
                status="agent_mismatch",
                http_status=403,
                payload={"ok": False, "error": "agent_mismatch"},
            )
        raw_job_ids = data.get("job_ids")
        if raw_job_ids is None:
            raw_job_ids = data.get("jobIds")
        batch_job_ids = []
        if isinstance(raw_job_ids, (list, tuple)):
            for value in raw_job_ids[:100]:
                try:
                    value = int(value)
                except (TypeError, ValueError):
                    continue
                if value > 0 and value not in batch_job_ids:
                    batch_job_ids.append(value)
        if int(job.id) not in batch_job_ids:
            batch_job_ids.insert(0, int(job.id))
        status_value = str(data.get("status") or "").strip().lower()
        error_text = str(data.get("error") or "").strip()
        if status_value not in {
            ProcessingPrintJob.STATUS_PRINTED,
            ProcessingPrintJob.STATUS_FAILED,
            ProcessingPrintJob.STATUS_PENDING,
        }:
            status_value = ProcessingPrintJob.STATUS_PRINTED
        batch_jobs = ProcessingPrintJob.objects.filter(
            id__in=batch_job_ids,
            status__in=[
                ProcessingPrintJob.STATUS_PENDING,
                ProcessingPrintJob.STATUS_PRINTING,
            ],
        )
        if agent_name:
            batch_jobs = batch_jobs.filter(agent__in=agent_targets)
        if len(batch_job_ids) > 1:
            batch_jobs = batch_jobs.filter(
                status=ProcessingPrintJob.STATUS_PRINTING,
                agent=job.agent,
                printer_name=job.printer_name,
            )
        actual_job_ids = list(batch_jobs.values_list("id", flat=True))
        updates = {
            "status": status_value,
            "error": error_text,
            "claimed_at": None,
            "lease_until": None,
            "updated_at": timezone.now(),
        }
        if status_value == ProcessingPrintJob.STATUS_PRINTED:
            # The image is only a transport payload.  Keep the small job record for
            # quantity/audit checks, but do not retain a completed label indefinitely.
            updates["label_png_base64"] = ""
            updates["label_png_base64_list"] = []
        with transaction.atomic():
            updated = batch_jobs.update(**updates)
            tracked_codes = MarkingCode.objects.filter(print_job_id__in=actual_job_ids)
            if status_value == ProcessingPrintJob.STATUS_PRINTED:
                tracked_codes.filter(printed_at__isnull=True).update(printed_at=timezone.now())
            elif status_value == ProcessingPrintJob.STATUS_FAILED:
                tracked_codes.filter(printed_at__isnull=True).update(
                    print_job_id=None,
                    print_reserved_at=None,
                    printed_by=None,
                )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={"ok": True, "updated": updated},
        )

    @classmethod
    def processing_print_jobs_renew(cls, *, agent_name: str, data) -> ProcessingJsonResult:
        agent_name = str(agent_name or "").strip()
        if not agent_name:
            return ProcessingJsonResult(
                status="missing_agent",
                http_status=400,
                payload={"ok": False, "error": "X-Print-Agent is required"},
            )

        raw_job_ids = data.get("job_ids")
        if raw_job_ids is None:
            raw_job_ids = data.get("jobIds")
        if not isinstance(raw_job_ids, (list, tuple)):
            raw_job_ids = []
        primary_job_id = data.get("job_id") or data.get("id")
        if primary_job_id:
            raw_job_ids = [primary_job_id, *raw_job_ids]

        job_ids: list[int] = []
        for raw_value in raw_job_ids[:100]:
            try:
                value = int(raw_value)
            except (TypeError, ValueError):
                continue
            if value > 0 and value not in job_ids:
                job_ids.append(value)
        if not job_ids:
            return ProcessingJsonResult(
                status="missing_job_id",
                http_status=400,
                payload={"ok": False, "error": "job_id or job_ids is required"},
            )

        agent_targets = cls._resolve_print_agent_targets(agent_name)
        lease_until = timezone.now() + timedelta(seconds=cls._print_job_lease_seconds())
        with transaction.atomic():
            renewable_jobs = ProcessingPrintJob.objects.select_for_update().filter(
                id__in=job_ids,
                status=ProcessingPrintJob.STATUS_PRINTING,
                agent__in=agent_targets,
            )
            renewable_ids = list(renewable_jobs.values_list("id", flat=True))
            updated = ProcessingPrintJob.objects.filter(id__in=renewable_ids).update(
                lease_until=lease_until,
                updated_at=timezone.now(),
            )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "updated": updated,
                "job_ids": renewable_ids,
                "lease_until": lease_until.isoformat(),
            },
        )

