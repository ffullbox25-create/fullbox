    @staticmethod
    def _work_short_name(full_name: str | None) -> str:
        parts = [part for part in str(full_name or "").split() if part]
        if not parts:
            return "-"
        initials = "".join(f"{part[:1].upper()}." for part in parts[1:3])
        return f"{parts[0]} {initials}".strip()

    @staticmethod
    def _work_initials(full_name: str | None) -> str:
        parts = [part for part in str(full_name or "").split() if part]
        return "".join(part[:1].upper() for part in parts[:2]) or "Ф"

    @classmethod
    def _work_user_label(cls, user, *, fallback: str = "-") -> str:
        if not user:
            return fallback
        profile = getattr(user, "employee_profile", None)
        if profile and getattr(profile, "full_name", ""):
            return profile.full_name
        full_name = ""
        if hasattr(user, "get_full_name"):
            full_name = user.get_full_name()
        return full_name or getattr(user, "username", "") or fallback

    @classmethod
    def _work_first_card(cls, payload: dict) -> dict:
        cards = payload.get("cards")
        if isinstance(cards, list):
            for card in cards:
                if isinstance(card, dict):
                    return card
        return {}

    @classmethod
    def _work_first_row(cls, payload: dict) -> dict:
        card = cls._work_first_card(payload)
        rows = card.get("rows")
        if isinstance(rows, list):
            for row in rows:
                if isinstance(row, dict):
                    return row
        rows = payload.get("stock_rows")
        if isinstance(rows, list):
            for row in rows:
                if isinstance(row, dict):
                    return row
        return {}

    @classmethod
    def _work_items_total_qty(cls, payload: dict) -> int:
        rows = []
        cards = payload.get("cards")
        if isinstance(cards, list):
            for card in cards:
                if isinstance(card, dict) and isinstance(card.get("rows"), list):
                    rows.extend(row for row in card["rows"] if isinstance(row, dict))
        if not rows and isinstance(payload.get("stock_rows"), list):
            rows = [row for row in payload["stock_rows"] if isinstance(row, dict)]
        total = 0
        for row in rows:
            try:
                total += int(str(row.get("qty") or row.get("quantity") or 0).strip() or 0)
            except (TypeError, ValueError):
                continue
        return total

