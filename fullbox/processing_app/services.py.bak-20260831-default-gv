        if not label_png_base64:
            return ProcessingJsonResult(status="missing_label", http_status=400, payload={"ok": False, "error": "Label image is required"})
        template_key = str(data.get("template_key") or data.get("templateKey") or "").strip()
        if template_key and not get_label_template(template_key):
            template_key = ""
        template_meta = get_label_template(template_key) if template_key else {}
        processing_param_key = str(
            data.get("processing_param_key")
            or data.get("processingParamKey")
            or ""
        ).strip()
        processing_views = cls._views()
        try:
            label_width_mm = int(data.get("label_width_mm") or 58)
