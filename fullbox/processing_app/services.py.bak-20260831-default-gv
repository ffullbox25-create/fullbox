    @classmethod
    def finish_processing(cls, *, order_id: str, entries, request, role: str) -> ProcessingFinishResult:
        with transaction.atomic():
            locked_entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=order_id, order_type="processing")
                .select_related("agency")
                .order_by("created_at", "id")
            )
            if not locked_entries:
                return ProcessingFinishResult(
                    status="blocked",
                    error_message="Заявка на обработку не найдена.",
                )
            return cls._finish_processing_locked(
                order_id=order_id,
                entries=locked_entries,
                request=request,
                role=role,
            )

    @classmethod
    def _finish_processing_locked(cls, *, order_id: str, entries, request, role: str) -> ProcessingFinishResult:
        processing_views = cls._views()
        latest = entries[-1] if entries else None
        payload = processing_views._processing_work_payload_from_entries(entries)
        def _complete_processing_obr_reachtruck_tasks() -> None:
            from processing_reachtruck.services import complete_obr_move_requests_for_processing

            complete_obr_move_requests_for_processing(processing_order_id=str(order_id))

        if processing_is_done(payload):
            _complete_processing_obr_reachtruck_tasks()
            return ProcessingFinishResult(status="already_done")

        quality_review = (
            payload.get("quality_review")
            if isinstance(payload.get("quality_review"), dict)
            else {}
        )
        quality_approved = bool(
            processing_stage_from_payload(payload) == PROCESSING_STAGE_QUALITY_APPROVED
            or str(quality_review.get("status") or "").strip().lower() == "approved"
        )
        if not quality_approved:
            return ProcessingFinishResult(
                status="blocked",
                error_message=(
                    "Нельзя завершить заявку. Сначала проведите проверку качества "
                    "и подтвердите результат."
                ),
            )

        processing_act = payload.get(cls.PROCESSING_ACT_KEY)
        processing_act = dict(processing_act) if isinstance(processing_act, dict) else {}
        if (
            int(processing_act.get("version") or 0) >= 1
            and str(processing_act.get("client_response") or "").strip().lower()
            == "dispute"
        ):
            return ProcessingFinishResult(
                status="blocked",
                error_message=(
                    "По акту обработки зафиксировано расхождение. "
                    "Проверьте его до закрытия заявки."
                ),
            )

        transition_error = processing_stage_transition_error(payload, PROCESSING_STAGE_DONE)
        if transition_error:
            return ProcessingFinishResult(
                status="blocked",
                error_message=f"Нельзя завершить заявку. {transition_error}",
            )

        finish_checks = processing_views._processing_finish_checks(str(order_id), payload, entries)
        finish_blockers = finish_checks.get("blockers") or []
        if finish_blockers:
            blockers_text = " ".join(f"{idx + 1}) {message}" for idx, message in enumerate(finish_blockers))
            return ProcessingFinishResult(
                status="blocked",
                error_message=f"Нельзя завершить заявку. Не выполнены условия: {blockers_text}",
            )

        placement_payload = finish_checks.get("placement_payload") or {}
        resolved_goods_type = StockAvailabilityService.normalize_goods_type(
            payload.get("goods_type") or placement_payload.get("goods_type") or ""
        )
        if resolved_goods_type:
            payload["goods_type"] = resolved_goods_type
            payload["goods_type_label"] = processing_views.GOODS_TYPE_LABELS.get(
                resolved_goods_type,
                str(payload.get("goods_type_label") or "").strip(),
            )
        else:
            payload.pop("goods_type", None)
            payload.pop("goods_type_label", None)
        mismatch_rows = processing_views._processing_discrepancy_rows(payload, placement_payload)
        if mismatch_rows:
            now_iso = timezone.localtime().isoformat()
            current_discrepancy_status = str(payload.get("discrepancy_status") or "").strip().lower()
            discrepancy_already_approved = current_discrepancy_status in {
                "approved_pending_warehouse",
                "approved",
            }
            can_approve_discrepancy = role == "processing_head" and current_discrepancy_status == "reported"
            payload["discrepancy_detected"] = True
            payload["discrepancy_items"] = mismatch_rows
            payload["discrepancy_act_label"] = "Акт разногласий по обработке"
            payload["discrepancy_act_created_at"] = payload.get("discrepancy_act_created_at") or now_iso
            if not can_approve_discrepancy and not discrepancy_already_approved:
                if current_discrepancy_status != "reported":
                    payload["discrepancy_status"] = "reported"
                    payload["discrepancy_reported_at"] = payload.get("discrepancy_reported_at") or now_iso
                    payload["status"] = "processing_in_work"
                    payload["status_label"] = "Разногласия — на утверждении руководителя обработки"
                    processing_views._create_processing_discrepancy_task(order_id, latest.agency, request, mismatch_rows)
                    log_order_action(
                        "status",
                        order_id=order_id,
                        order_type="processing",
                        user=request.user if request.user.is_authenticated else None,
                        agency=latest.agency if latest else None,
                        description="Разногласия по обработке переданы на утверждение руководителю",
                        payload=payload,
                    )
                    log_order_action(
                        "update",
                        order_id=order_id,
                        order_type="processing",
                        user=request.user if request.user.is_authenticated else None,
                        agency=latest.agency if latest else None,
                        description="Создан акт разногласий по обработке",
                        payload={
                            "act": "processing_discrepancy",
                            "act_label": "Акт разногласий по обработке",
                            "order_id": str(order_id),
                            "discrepancy_items": mismatch_rows,
                            "created_at": now_iso,
                        },
                    )
                if role != "processing_head":
                    return ProcessingFinishResult(
                        status="discrepancy_reported_wait",
                        error_message=(
                            "Выявлены разногласия. Отчёт отправлен руководителю обработки. "
                            "Заявка закроется после его утверждения."
                        ),
                    )
            if not discrepancy_already_approved:
                payload["discrepancy_status"] = "approved_pending_warehouse"
                payload["discrepancy_approved_at"] = now_iso
                payload["status_label"] = "Разногласия утверждены — ожидается складская проводка"
                if request.user and request.user.is_authenticated:
                    payload["discrepancy_approved_by"] = (
                        request.user.get_full_name().strip() or request.user.username or str(request.user)
                    )
                log_order_action(
                    "status",
                    order_id=order_id,
                    order_type="processing",
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency if latest else None,
                    description="Разногласия утверждены; ожидается складская проводка",
                    payload=payload,
                )
                log_order_action(
                    "update",
                    order_id=order_id,
                    order_type="processing",
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency if latest else None,
                    description="Разногласия по обработке утверждены руководителем обработки",
                    payload={
                        "act": "processing_discrepancy_approval",
                        "order_id": str(order_id),
                        "approved_at": now_iso,
                        "discrepancy_items": mismatch_rows,
                    },
                )
                cls._set_task_status(Task.objects.filter(
                    route=f"/orders/processing/{order_id}/",
                    assigned_to__role="processing_head",
                    title=f"Р Р°Р·РЅРѕРіР»Р°СЃРёРµ РїРѕ РѕР±СЂР°Р±РѕС‚РєРµ в„–{order_id}",
                ), "done")

        commit_state = payload.get(cls.PROCESSING_WAREHOUSE_COMMIT_KEY)
        commit_state = dict(commit_state) if isinstance(commit_state, dict) else {}
        if str(commit_state.get("status") or "").strip().lower() != "approved":
            committed, commit_error = cls._commit_processing_result_after_head_approval(
                order_id=str(order_id),
                payload=payload,
                entries=entries,
                request=request,
                role=role,
            )
            if not committed:
                return ProcessingFinishResult(
                    status="blocked",
                    error_message=(
                        "Нельзя завершить заявку: "
                        + (commit_error or "складской результат не подтвержден руководителем.")
                    ),
                )
        if (
            mismatch_rows
            and str(payload.get("discrepancy_status") or "").strip().lower()
            == "approved_pending_warehouse"
        ):
            payload["discrepancy_status"] = "approved"
        cls._release_unused_processing_marking_codes(order_id=str(order_id))
        completed_at_value = timezone.now()
        completed_at = timezone.localtime(completed_at_value).isoformat()
        payload["completed_at"] = completed_at
        billing_application = None
        billing_service_facts = []
        if latest and latest.agency:
            from billing.warehouse_services import (
                facts_payload,
                sync_processing_facts_to_billing,
            )

            billing_application, billing_service_facts = sync_processing_facts_to_billing(
                client=latest.agency,
                order_id=str(order_id),
                completed_at=completed_at_value,
                user=request.user if request.user.is_authenticated else None,
                source_payload={
                    "quantity_summary": finish_checks.get("quantity_summary") or {},
                    "closed_by_role": role,
                },
            )
            if billing_application:
                payload["billing_transfer"] = {
                    "status": "sent_to_billing",
                    "application_id": billing_application.id,
                    "transferred_at": completed_at,
                    "service_fact_ids": [fact.id for fact in billing_service_facts],
                    "services": facts_payload(billing_service_facts),
                }
        _logged, payload = log_processing_stage(
            order_id=order_id,
            payload=payload,
            stage=PROCESSING_STAGE_DONE,
            user=request.user if request.user.is_authenticated else None,
            agency=latest.agency if latest else None,
            description="Заявка завершена, фактические услуги переданы в биллинг",
            extra_payload={
                "completed_at": completed_at,
                "billing_transfer": payload.get("billing_transfer") or {},
            },
        )
        cls._set_task_status(Task.objects.filter(
            route__in=[
                f"/orders/processing/{order_id}/",
                f"/orders/processing/{order_id}/flow/",
            ]
        ), "done")
        _complete_processing_obr_reachtruck_tasks()
        if latest and latest.agency:
            WarehouseWritePathService.complete_processing_if_started(
                agency=latest.agency,
                order_id=str(order_id),
                performed_by=request.user if request.user.is_authenticated else None,
                performed_by_role=role,
            )
        return ProcessingFinishResult(status="done")

    @classmethod
    def save_processing_flow_draft(
        cls,
        *,
        order_id: str,
        entries,
        request,
        normalize_flow_state,
        can_reassign_boxes: bool,
    ) -> ProcessingFlowDraftResult:
        processing_views = cls._views()
        role = get_request_role(request)
        if not processing_views._processing_flow_has_write_access(request, str(order_id or "")):
            return ProcessingFlowDraftResult(status="forbidden")
        if role not in {"storekeeper", "processing_head", "processing_worker", "head_manager", "director", "admin", "manager"}:
            return ProcessingFlowDraftResult(status="forbidden")
        if processing_views._flow_closed_from_entries(entries):
            return ProcessingFlowDraftResult(status="closed")
        if not processing_views.ProcessingFlowView()._can_start(entries):
            return ProcessingFlowDraftResult(status="not_allowed")

        boxes_raw = request.POST.get("boxes_json") or "[]"
        pallets_raw = request.POST.get("pallets_json") or "[]"
        active_box = request.POST.get("active_box") or ""
        active_pallet = request.POST.get("active_pallet") or ""
        try:
            boxes_data = json.loads(boxes_raw)
            pallets_data = json.loads(pallets_raw)
        except json.JSONDecodeError:
            return ProcessingFlowDraftResult(status="invalid_json")
        if not isinstance(boxes_data, list):
            boxes_data = []
        if not isinstance(pallets_data, list):
            pallets_data = []
        canceled_box_codes = cls.canceled_processing_box_codes(
            order_id=str(order_id),
            entries=entries,
        )
        cleaned_posted_state, _ = (
            cls.strip_canceled_processing_boxes_from_flow_state(
                {
                    "boxes": boxes_data,
                    "pallets": pallets_data,
                    "activeBox": active_box,
                    "activePallet": active_pallet,
                },
                canceled_box_codes,
            )
        )
        boxes_data = cleaned_posted_state["boxes"]
        pallets_data = cleaned_posted_state["pallets"]
        active_box = cleaned_posted_state["activeBox"]
        active_pallet = cleaned_posted_state["activePallet"]
        cls.purge_canceled_processing_boxes_from_open_sessions(
            order_id=str(order_id),
            entries=entries,
        )
        agent_id = (request.POST.get("agent_id") or "").strip()
        session = processing_views._flow_session_for_request(order_id, agent_id, request, create=True)
        if not session:
            return ProcessingFlowDraftResult(status="session_not_found")
        with transaction.atomic():
            locked_entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=str(order_id), order_type="processing")
                .order_by("created_at", "id")
            )
            locked_sessions = list(
                ProcessingFlowSession.objects.select_for_update(of=("self",))
                .filter(
                    order_id=order_id,
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("id")
            )
            session = next((row for row in locked_sessions if int(row.pk) == int(session.pk)), None)
            if session is None:
                return ProcessingFlowDraftResult(status="session_not_found")
            canceled_box_codes = cls.canceled_processing_box_codes(
                order_id=str(order_id),
            )
            stored_state, _ = cls.strip_canceled_processing_boxes_from_flow_state(
                session.flow_state,
                canceled_box_codes,
            )
            stored_state = processing_views._sanitize_flow_state_for_session(
                stored_state,
                session,
            )
            boxes_data = processing_views._filter_flow_values_for_session(boxes_data, session)
            pallets_data = processing_views._filter_flow_values_for_session(pallets_data, session)
            boxes_data = processing_views._apply_flow_owner(boxes_data, session)
            pallets_data = processing_views._apply_flow_owner(pallets_data, session)
            posted_state = normalize_flow_state(boxes_data, pallets_data, active_box, active_pallet)
            posted_state = processing_views._sanitize_flow_state_for_session(posted_state, session)
            posted_state, _ = cls.strip_canceled_processing_boxes_from_flow_state(
                posted_state,
                canceled_box_codes,
            )
            posted_codes = {
                str(box.get("code") or "").strip()
                for box in (posted_state.get("boxes") or [])
                if isinstance(box, dict) and str(box.get("code") or "").strip()
            }
            protected_boxes = [
                dict(box)
                for box in (stored_state.get("boxes") or [])
                if (
                    isinstance(box, dict)
                    and str(box.get("code") or "").strip()
                    and str(box.get("code") or "").strip() not in posted_codes
                    and processing_views._flow_box_items_count(box) > 0
                )
            ]
            protected_codes = {
                str(box.get("code") or "").strip()
                for box in protected_boxes
            }
            if protected_boxes:
                posted_state["boxes"] = [
                    *(posted_state.get("boxes") or []),
                    *protected_boxes,
                ]
                posted_pallets = posted_state.get("pallets") or []
                posted_pallet_map = {
                    str(pallet.get("code") or "").strip(): pallet
                    for pallet in posted_pallets
                    if isinstance(pallet, dict) and str(pallet.get("code") or "").strip()
                }
                for stored_pallet in stored_state.get("pallets") or []:
                    if not isinstance(stored_pallet, dict):
                        continue
                    stored_pallet_code = str(stored_pallet.get("code") or "").strip()
                    protected_links = [
                        str(code or "").strip()
                        for code in (stored_pallet.get("boxes") or [])
                        if str(code or "").strip() in protected_codes
                    ]
                    if not stored_pallet_code or not protected_links:
                        continue
                    target_pallet = posted_pallet_map.get(stored_pallet_code)
                    if not target_pallet:
                        target_pallet = dict(stored_pallet)
                        target_pallet["boxes"] = []
                        posted_pallets.append(target_pallet)
                        posted_pallet_map[stored_pallet_code] = target_pallet
                    target_boxes = [
                        str(code or "").strip()
                        for code in (target_pallet.get("boxes") or [])
                        if str(code or "").strip()
                    ]
                    target_pallet["boxes"] = list(
                        dict.fromkeys([*target_boxes, *protected_links])
                    )
                posted_state["pallets"] = posted_pallets
            flow_state = {
                "boxes": processing_views._merge_flow_boxes_preserving_confirmed(
                    stored_state.get("boxes") or [],
                    posted_state.get("boxes") or [],
                ),
                "pallets": processing_views._merge_flow_values_by_code(
                    stored_state.get("pallets") or [],
                    posted_state.get("pallets") or [],
                ),
                "activeBox": posted_state.get("activeBox") or stored_state.get("activeBox") or "",
                "activePallet": posted_state.get("activePallet") or stored_state.get("activePallet") or "",
            }
            flow_state = processing_views._sanitize_flow_state_for_session(flow_state, session)
            flow_state, _ = cls.strip_canceled_processing_boxes_from_flow_state(
                flow_state,
                canceled_box_codes,
            )
            marking_validation = cls.validate_processing_flow_box_modes(
                flow_state.get("boxes") or []
            )
            if not marking_validation["ok"]:
                return ProcessingFlowDraftResult(status="marking_mode_conflict")
            if not can_reassign_boxes:
                sessions = locked_sessions
                merged_boxes, merged_pallets = (
                    processing_views._merge_flow_sessions(sessions) if sessions else ([], [])
                )
                candidate_boxes = processing_views._merge_flow_values_by_code(
                    merged_boxes,
                    flow_state.get("boxes") or [],
                )
                candidate_pallets = processing_views._merge_flow_values_by_code(
                    merged_pallets,
                    flow_state.get("pallets") or [],
                )
                candidate_boxes, candidate_pallets = processing_views._dedupe_pallet_box_links(
                    candidate_boxes,
                    candidate_pallets,
                )
                if processing_views._has_box_reassignment_between_pallets(merged_pallets, candidate_pallets):
                    return ProcessingFlowDraftResult(status="box_move_head_only")
            previous_session_state = session.flow_state
            session.flow_state = flow_state
            merged_boxes, merged_pallets = processing_views._merge_flow_sessions(locked_sessions)
            merged_boxes, merged_pallets = processing_views._dedupe_pallet_box_links(
                merged_boxes,
                merged_pallets,
            )
            released_changes = cls._released_processing_pallet_changes(
                entries=locked_entries,
                flow_state={"boxes": merged_boxes, "pallets": merged_pallets},
            )
            if released_changes:
                session.flow_state = previous_session_state
                return ProcessingFlowDraftResult(
                    status="released_pallet_locked",
                    pallet_code=released_changes[0],
                )
            session.flow_state = flow_state
            session.last_seen = timezone.localtime()
            session.status = ProcessingFlowSession.STATUS_OPEN
            session.save(update_fields=["flow_state", "last_seen", "status", "updated_at"])
        latest = entries[-1] if entries else None
        if latest and latest.agency:
            WarehouseWritePathService.sync_box_characteristics(
                agency=latest.agency,
                order_id=order_id,
                order_type="processing",
                boxes=flow_state.get("boxes") or [],
                performed_by=request.user if request.user.is_authenticated else None,
                clear_incomplete=True,
            )
        return ProcessingFlowDraftResult(status="ok", session_id=session.id)

