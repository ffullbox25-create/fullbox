    @staticmethod
    def _safe_int(value) -> int:
        try:
            return int(float(str(value or "").replace(",", ".").strip()))
        except (TypeError, ValueError):
            return 0

    @classmethod
    def _processing_client_step_key(cls, payload: dict | None) -> str:
        if processing_is_cancelled(payload):
            return "cancelled"
        if processing_is_done(payload):
            return "done"
        stage = processing_stage_from_payload(payload)
        if stage == PROCESSING_STAGE_AWAITING_APPROVAL:
            return "manager_review"
        if stage == PROCESSING_STAGE_MANAGER_APPROVED:
            return "approved"
        if stage in {PROCESSING_STAGE_OBR_MOVE_CREATED, PROCESSING_STAGE_OBR_ARRIVED}:
            return "handoff"
        if stage in {
            PROCESSING_STAGE_TAKEN_INTO_PROCESSING,
            PROCESSING_STAGE_UNBOXING_OPENED,
            PROCESSING_STAGE_UNBOXING_COMPLETED,
            PROCESSING_STAGE_QUALITY_CONTROL,
            PROCESSING_STAGE_REWORK,
            PROCESSING_STAGE_QUALITY_APPROVED,
            PROCESSING_STAGE_RETURN_TO_STOCK_SENT,
            PROCESSING_STAGE_RETURNED_TO_STOCK,
        }:
            return "in_work"
        if stage == PROCESSING_STAGE_DONE:
            return "done"
        return "submitted"

    @classmethod
    def _processing_manager_result_context(cls, *, payload: dict, entries: list) -> dict:
        """Build a read-only summary of the processing result for the manager UI."""

        processing_views = cls._views()
        placement_entry = processing_views._processing_placement_entry(entries or [])
        placement_payload = (
            dict(getattr(placement_entry, "payload", None) or {})
            if placement_entry
            else {}
        )

        def list_value(source: dict, key: str) -> list:
            value = source.get(key)
            return value if isinstance(value, list) else []

        results = list_value(payload, "processing_results")
        act_items = list_value(placement_payload, "act_items") or list_value(payload, "act_items")
        act_boxes = list_value(placement_payload, "act_boxes") or list_value(payload, "act_boxes")
        act_pallets = list_value(placement_payload, "act_pallets") or list_value(payload, "act_pallets")
        summary = processing_views._processing_quantity_summary(payload, placement_payload)

        item_by_article: dict[str, dict] = {}
        for item in act_items:
            if not isinstance(item, dict):
                continue
            article_key = str(item.get("sku_code") or item.get("sku") or "").strip().casefold()
            if article_key:
                item_by_article[article_key] = item

        result_rows = []
        for row in results:
            if not isinstance(row, dict):
                continue
            source_article = str(row.get("source_article") or "").strip()
            result_article = str(row.get("article") or row.get("result_article") or "").strip()
            processed_qty = cls._safe_int(row.get("processed"))
            item = item_by_article.get(result_article.casefold(), {})
            operations = []
            if source_article and result_article and source_article.casefold() != result_article.casefold():
                operations.append(f"Замена артикула: {source_article} → {result_article}")
            tags_replaced = cls._safe_int(row.get("tags_replaced"))
            labels_printed = cls._safe_int(row.get("labels_printed"))
            labels_unboxed = cls._safe_int(row.get("labels_unboxed"))
            defect_qty = cls._safe_int(row.get("defect"))
            shortage_qty = cls._safe_int(row.get("shortage"))
            if tags_replaced:
                operations.append(f"Заменено бирок: {tags_replaced}")
            if labels_printed:
                operations.append(f"Напечатано этикеток: {labels_printed}")
            if labels_unboxed:
                operations.append(f"Снято этикеток: {labels_unboxed}")
            if defect_qty:
                operations.append(f"Брак: {defect_qty}")
            if shortage_qty:
                operations.append(f"Недостача: {shortage_qty}")
            if not operations and processed_qty:
                operations.append(f"Обработано: {processed_qty}")
            result_rows.append(
                {
                    "source_article": source_article or result_article,
                    "result_article": result_article or source_article,
                    "product_name": str(row.get("product_name") or item.get("name") or "").strip(),
                    "barcode": str(row.get("barcode") or row.get("result_barcode") or "").strip(),
                    "processed_qty": processed_qty,
                    "box_qty": cls._safe_int(item.get("box_qty")),
                    "pallet_qty": cls._safe_int(item.get("pallet_qty")),
                    "operations_text": "; ".join(operations) or "—",
                }
            )

        pallet_by_box: dict[str, str] = {}
        for pallet in act_pallets:
            if not isinstance(pallet, dict):
                continue
            pallet_code = str(pallet.get("code") or "").strip()
            for box_code in pallet.get("boxes") or []:
                normalized_box_code = str(box_code or "").strip()
                if normalized_box_code:
                    pallet_by_box[normalized_box_code] = pallet_code

        box_rows = []
        for box in act_boxes:
            if not isinstance(box, dict):
                continue
            box_code = str(box.get("code") or "").strip()
            article_names = []
            box_qty = 0
            for item in box.get("items") or []:
                if not isinstance(item, dict):
                    continue
                box_qty += cls._safe_int(item.get("qty") or item.get("actual_qty"))
                article = str(item.get("sku_code") or item.get("sku") or "").strip()
                if article and article not in article_names:
                    article_names.append(article)
            box_rows.append(
                {
                    "code": box_code,
                    "articles": ", ".join(article_names) or "—",
                    "qty": box_qty,
                    "pallet_code": pallet_by_box.get(box_code, ""),
                    "sealed": bool(box.get("sealed")),
                }
            )

        return {
            "has_data": bool(results or act_items or act_boxes or act_pallets),
            "declared_qty": cls._safe_int(summary.get("declared_qty")),
            "processed_qty": cls._safe_int(summary.get("processed_qty")),
            "boxed_qty": cls._safe_int(summary.get("boxed_qty")),
            "matches": bool(summary.get("matches")),
            "box_count": len(act_boxes),
            "pallet_count": len(act_pallets),
            "result_rows": result_rows,
            "box_rows": box_rows,
        }

