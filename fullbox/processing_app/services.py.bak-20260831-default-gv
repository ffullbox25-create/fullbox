    @classmethod
    def _find_processing_card(
        cls,
        payload: dict | None,
        *,
        card_id: str = "",
        article: str = "",
    ) -> dict | None:
        cards = (payload or {}).get("cards") or []
        if not isinstance(cards, list):
            cards = []
        normalized_card_id = str(card_id or "").strip()
        normalized_article = str(article or "").strip()
        for card in cards:
            if not isinstance(card, dict):
                continue
            if normalized_card_id and str(card.get("id") or "").strip() == normalized_card_id:
                return card
        if normalized_article:
            for card in cards:
                if not isinstance(card, dict):
                    continue
                if str(card.get("article") or "").strip() == normalized_article:
                    return card
        if len(cards) == 1 and isinstance(cards[0], dict):
            return cards[0]
        return None

