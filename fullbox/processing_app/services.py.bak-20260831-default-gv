        replaced_direction_groups = {
            (key[0], key[1], key[2])
            for key in current_base_keys
            if key[3] == "-"
        }
        merged: list[dict] = []
        seen_storage_keys: set[tuple[str, str, str, str, str]] = set()
        existing_results = payload.get("processing_results") or []
        if isinstance(existing_results, list):
            for item in existing_results:
                if not isinstance(item, dict):
                    continue
                item_card_key = str(item.get("card_id") or "").strip().casefold()
                if item_card_key and item_card_key in replace_set_card_ids:
                    continue
                key = processing_views._processing_result_key(item)
                item_storage_key = storage_key(item)
                if item_storage_key in current_storage_keys or key in current_base_keys or item_storage_key in seen_storage_keys:
                    continue
                if key[3] != "-" and (key[0], key[1], key[2]) in replaced_direction_groups:
                    continue
                merged.append(item)
                seen_storage_keys.add(item_storage_key)
        for item in current_results or []:
            if not isinstance(item, dict):
                continue
            item_storage_key = storage_key(item)
            if item_storage_key in seen_storage_keys:
                continue
            merged.append(item)
            seen_storage_keys.add(item_storage_key)
        return merged

    @classmethod
    def _processing_card_performers(
        cls,
        *,
        order_id: str,
        card_id: str,
        payload: dict | None = None,
    ) -> list[dict]:
        processing_views = cls._views()
        route = processing_views._processing_card_task_route(order_id, card_id)
        performers: list[dict] = []
        seen_ids: set[int] = set()
        for employee_id, full_name in (
            Task.objects.filter(
                route=route,
                assigned_to__role="packer",
                assigned_to__is_active=True,
            )
            .exclude(status="done")
            .order_by("assigned_to__full_name", "assigned_to_id")
            .values_list("assigned_to_id", "assigned_to__full_name")
        ):
            if not employee_id or employee_id in seen_ids:
                continue
            seen_ids.add(employee_id)
            performers.append({"id": employee_id, "name": str(full_name or "").strip()})
        for assignment in cls._processing_work_assignments(payload):
            if str(assignment.get("card_id") or "").strip().casefold() != str(card_id or "").strip().casefold():
                continue
            if str(assignment.get("status") or "").strip().casefold() == "cancelled":
                continue
            try:
                employee_id = int(assignment.get("assignee_id") or 0)
            except (TypeError, ValueError):
                continue
            name = str(assignment.get("assignee_name") or "").strip()
            if employee_id <= 0 or not name or employee_id in seen_ids:
                continue
            seen_ids.add(employee_id)
            performers.append({"id": employee_id, "name": name})
        performer_map = (payload or {}).get("processing_card_performers") or {}
        if not isinstance(performer_map, dict):
            return performers
        for item in performer_map.get(card_id) or []:
            if not isinstance(item, dict):
                continue
            try:
                employee_id = int(item.get("id") or 0)
            except (TypeError, ValueError):
                continue
            name = str(item.get("name") or "").strip()
            if employee_id <= 0 or not name or employee_id in seen_ids:
                continue
            seen_ids.add(employee_id)
            performers.append({"id": employee_id, "name": name})
        return performers

    @classmethod
    def _selected_processing_card_performer(
        cls,
        *,
        order_id: str,
        card_id: str,
        payload: dict,
        employee_id,
    ) -> dict | None:
        try:
            selected_id = int(employee_id or 0)
        except (TypeError, ValueError):
            return None
        return next(
            (
                performer
                for performer in cls._processing_card_performers(
                    order_id=order_id,
                    card_id=card_id,
                    payload=payload,
                )
                if performer["id"] == selected_id
            ),
            None,
        )

    @classmethod
    def _mark_processing_card_processed(
        cls,
        payload: dict,
        *,
        order_id: str,
        card_id: str,
        request,
        performer_name: str = "",
    ) -> bool:
        processing_views = cls._views()
        if not card_id:
            return False
        cards = payload.get("cards") or []
        target_card = None
        for card in cards:
            if not isinstance(card, dict):
                continue
            if processing_views._processing_card_id(card) == card_id:
                target_card = card
                break
        if not target_card and len(cards) == 1 and isinstance(cards[0], dict):
            target_card = cards[0]
        changed = False
        if target_card:
            if not target_card.get("processed_at"):
                changed = True
            target_card["processed_at"] = timezone.localtime().isoformat()
            actor_name = cls._processing_actor_label(request)
            target_card["processed_by"] = str(performer_name or actor_name).strip()
            target_card["processing_recorded_by"] = actor_name
            if not target_card.get("processed_done"):
                changed = True
            target_card["processed_done"] = True
        processed_cards = payload.get("processed_cards") or []
        if not isinstance(processed_cards, list):
            processed_cards = []
        if card_id and card_id not in processed_cards:
            processed_cards.append(card_id)
            changed = True
        payload["processed_cards"] = processed_cards
        payload["cards"] = cards
        return changed

