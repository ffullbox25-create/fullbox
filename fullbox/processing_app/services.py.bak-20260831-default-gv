        placement_payload = finish_checks.get("placement_payload") or {}
        placement_boxes = placement_payload.get("act_boxes") or []
        placement_pallets = placement_payload.get("act_pallets") or []
        if not isinstance(placement_boxes, list):
            placement_boxes = []
        if not isinstance(placement_pallets, list):
            placement_pallets = []
        updates["processing_service_metrics"] = {
            **quantity_summary,
            "boxes_count": len(
                {
                    str(box.get("code") or "").strip()
                    for box in placement_boxes
                    if isinstance(box, dict) and str(box.get("code") or "").strip()
                }
            ),
            "pallets_count": len(
                {
                    str(pallet.get("code") or "").strip()
                    for pallet in placement_pallets
                    if isinstance(pallet, dict) and str(pallet.get("code") or "").strip()
                }
            ),
        }
        updates["processing_act_finish_blockers"] = finish_checks.get("blockers") or []
        updates["processing_act_finish_hard_blockers"] = finish_checks.get("hard_blockers") or []
        updates["processing_act_services_confirmed"] = bool(
            finish_checks.get("service_facts_confirmed")
        )
        quality_review = (
            status_payload.get("quality_review")
            if isinstance(status_payload.get("quality_review"), dict)
            else {}
        )
        quality_approved = bool(
            processing_stage_from_payload(status_payload) == PROCESSING_STAGE_QUALITY_APPROVED
            or str(quality_review.get("status") or "").strip().lower() == "approved"
        )
        manager_act_roles = {"manager", "head_manager", "director", "admin", "developer"}
        updates["can_confirm_processing_act_manager"] = bool(
            role in manager_act_roles
            and updates["processing_act_visible"]
            and not is_processing_done
            and not is_cancelled
            and quality_approved
            and processing_act_status in {"awaiting_confirmations", "confirmed"}
            and client_response != "dispute"
            and not updates["processing_act_finish_hard_blockers"]
        )
        updates["can_confirm_processing_act_client"] = False
        if ctx.get("history"):
            updates["history"] = cls._compact_processing_history(ctx.get("history") or [])
        if updates["can_edit_processing"]:
            agency = ctx.get("agency")
            if client_view and agency and getattr(agency, "id", None):
                updates["processing_edit_url"] = (
                    f"/orders/processing/?client={agency.id}&order={order_id}&edit=1"
                )
            elif agency and getattr(agency, "id", None):
                updates["processing_edit_url"] = f"/orders/processing/?order={order_id}&agency={agency.id}&edit=1"
            else:
                updates["processing_edit_url"] = f"/orders/processing/?order={order_id}&edit=1"
        return updates

    @staticmethod
    def _compact_processing_history(rows: list[dict]) -> list[dict]:
        compacted: list[dict] = []
        for row in rows or []:
            if not compacted:
                compacted.append(row)
                continue
            previous = compacted[-1]
            if (
                str(row.get("action_label") or "").strip().lower() == "СЃС‚Р°С‚СѓСЃ"
                and str(previous.get("action_label") or "").strip().lower() == "СЃС‚Р°С‚СѓСЃ"
                and str(row.get("status_label") or "").strip() == str(previous.get("status_label") or "").strip()
                and str(row.get("description") or "").strip() == str(previous.get("description") or "").strip()
                and str(row.get("actor_label") or "").strip() == str(previous.get("actor_label") or "").strip()
            ):
                continue
            compacted.append(row)
        return compacted

    @classmethod
    def processing_detail_work_redirect_url(
        cls,
        *,
        order_id: str,
        entries_list,
        request,
        payload_from_entries,
    ) -> str:
        role = get_request_role(request)
        if role not in {"storekeeper", "processing_head"}:
            return ""
        payload = payload_from_entries(entries_list)
        if cls.processing_warehouse_cancel_request_payload(entries_list):
            return ""
        processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
            order_id=str(order_id or ""),
            agency=entries_list[-1].agency if entries_list else None,
            payload=payload,
        )
        if processing_is_done(payload):
            return ""
        if processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES:
            return f"/orders/processing/{order_id}/work/"
        if processing_is_in_work(payload):
            return f"/orders/processing/{order_id}/work/"
        can_take = WarehouseActionPolicy.can_take_processing(
            processing_result,
            role=role,
            client_view=False,
        ).allowed
        if can_take:
            return f"/orders/processing/{order_id}/work/"
        return ""

    @classmethod
    def handle_processing_detail_action(
        cls,
        *,
        order_id: str,
        request,
        order_type: str,
        payload_from_entries,
    ) -> ProcessingDetailActionResult:
        processing_views = cls._views()
        action = str(request.POST.get("action") or "").strip().lower()
        entries = list(
            OrderAuditEntry.objects.filter(order_id=order_id, order_type=order_type)
            .select_related("agency")
            .order_by("created_at")
        )
        if not entries:
            return ProcessingDetailActionResult(status="missing_order", redirect_to="/orders/")
        latest = entries[-1]
        merged_payload = dict(payload_from_entries(entries))
        if order_type == "processing":
            processing_payload = dict(processing_views._processing_work_payload_from_entries(entries))
            if processing_payload:
                # Processing actions should use the processing-specific merged payload
                # even when a generic helper returns the latest non-status entry.
                for key, value in processing_payload.items():
                    if key in {
                        cls.PROCESSING_WORK_ASSIGNMENTS_KEY,
                        cls.PROCESSING_BOX_ASSIGNMENTS_KEY,
                        cls.PROCESSING_ACT_KEY,
                        cls.PROCESSING_WAREHOUSE_COMMIT_KEY,
                        "quality_review",
                    }:
                        if value not in (None, "", [], {}):
                            merged_payload[key] = value
                        continue
                    if key in {"status", "status_label", "submit_action", "work_started_at", "act", "act_state", "flow_closed"}:
                        if value not in (None, "", [], {}):
                            merged_payload[key] = value
                        continue
                    if merged_payload.get(key) in (None, "", [], {}) and value not in (None, "", [], {}):
                        merged_payload[key] = value

        if action == "confirm_processing_act_manager":
            role = get_request_role(request)
            client_param = str(request.GET.get("client") or "").strip()
            suffix = f"?client={client_param}" if client_param else ""
            redirect_to = f"/orders/processing/{order_id}/{suffix}"
            if role not in {"manager", "head_manager", "director", "admin", "developer"}:
                return ProcessingDetailActionResult(
                    status="forbidden",
                    redirect_to=f"{redirect_to}#processing-act",
                )
            if processing_is_cancelled(merged_payload):
                return ProcessingDetailActionResult(
                    status="already_closed",
                    redirect_to=f"{redirect_to}#processing-act",
                    error_message="Заявка на обработку уже отменена.",
                )
            if processing_is_done(merged_payload):
                return ProcessingDetailActionResult(
                    status="already_done",
                    redirect_to=f"{redirect_to}#processing-act",
                )
            processing_act = merged_payload.get(cls.PROCESSING_ACT_KEY)
            processing_act = dict(processing_act) if isinstance(processing_act, dict) else {}
            processing_act_status = str(processing_act.get("status") or "").strip().lower()
            client_response = str(processing_act.get("client_response") or "").strip().lower()
            if (
                int(processing_act.get("version") or 0) < 1
                or processing_act_status not in {"awaiting_confirmations", "confirmed"}
                or client_response == "dispute"
            ):
                return ProcessingDetailActionResult(
                    status="forbidden",
                    redirect_to=f"{redirect_to}#processing-act",
                    error_message="Акт обработки не готов к подтверждению менеджером.",
                )
            quality_review = (
                merged_payload.get("quality_review")
                if isinstance(merged_payload.get("quality_review"), dict)
                else {}
            )
            quality_approved = bool(
                processing_stage_from_payload(merged_payload) == PROCESSING_STAGE_QUALITY_APPROVED
                or str(quality_review.get("status") or "").strip().lower() == "approved"
            )
            if not quality_approved:
                return ProcessingDetailActionResult(
                    status="blocked",
                    redirect_to=f"{redirect_to}#processing-act",
                    error_message="Сначала подтвердите проверку качества обработки.",
                )
            finish_checks = processing_views._processing_finish_checks(
                str(order_id or ""),
                merged_payload,
                entries,
            )
            hard_blockers = finish_checks.get("hard_blockers") or []
            if hard_blockers:
                blockers_text = " ".join(
                    f"{idx + 1}) {message}" for idx, message in enumerate(hard_blockers)
                )
                return ProcessingDetailActionResult(
                    status="blocked",
                    redirect_to=f"{redirect_to}#processing-act",
                    error_message=f"Нельзя завершить заявку. Не выполнены условия: {blockers_text}",
                )
            if not finish_checks.get("service_facts_confirmed"):
                return ProcessingDetailActionResult(
                    status="services_required",
                    redirect_to=f"{redirect_to}#processing-act",
                    error_message="Перед завершением укажите фактически оказанные услуги.",
                )
            result = cls.finish_processing(
                order_id=str(order_id),
                entries=entries,
                request=request,
                role=role,
            )
            if result.status in {"done", "already_done"}:
                return ProcessingDetailActionResult(
                    status=result.status,
                    redirect_to=f"{redirect_to}#processing-act",
                )
            return ProcessingDetailActionResult(
                status=result.status,
                redirect_to=f"{redirect_to}#processing-act",
                error_message=result.error_message,
            )

        if action in {
            "confirm_processing_act_client",
            "dispute_processing_act_client",
        }:
            client_param = str(request.GET.get("client") or "").strip()
            suffix = f"?client={client_param}" if client_param else ""
            redirect_to = f"/orders/processing/{order_id}/{suffix}"
            return ProcessingDetailActionResult(
                status="forbidden",
                redirect_to=f"{redirect_to}#processing-act",
            )

        if action in {
            "request_warehouse_cancel",
            "approve_warehouse_cancel",
            "reject_warehouse_cancel",
        }:
            role = get_request_role(request)
            client_param = str(request.GET.get("client") or "").strip()
            suffix = f"?client={client_param}" if client_param else ""
            redirect_to = f"/orders/processing/{order_id}/{suffix}"
            pending = cls.processing_warehouse_cancel_request_payload(entries)
            reason = str(request.POST.get("cancel_reason") or "").strip()

            if action == "request_warehouse_cancel":
                if role not in {"manager", "head_manager", "director", "admin"}:
                    return ProcessingDetailActionResult(
                        status="forbidden",
                        redirect_to=redirect_to,
                    )
                if not reason:
                    return ProcessingDetailActionResult(
                        status="cancel_reason_required",
                        redirect_to=redirect_to,
                    )
                if not cls.requires_processing_warehouse_cancel_confirmation(
                    merged_payload
                ):
                    return ProcessingDetailActionResult(
                        status="forbidden",
                        redirect_to=redirect_to,
                    )
                if pending:
                    return ProcessingDetailActionResult(
                        status="warehouse_cancel_requested",
                        redirect_to=redirect_to,
                    )
                if not cls._ensure_processing_warehouse_cancel_review_task(
                    order_id=str(order_id),
                    agency=latest.agency,
                    user=request.user if request.user.is_authenticated else None,
                    reason=reason,
                ):
                    return ProcessingDetailActionResult(
                        status="forbidden",
                        redirect_to=redirect_to,
                    )
                request_payload = dict(merged_payload)
                request_payload.update(
                    {
                        "status": "warehouse_cancel_requested",
                        "status_label": "Отмена ожидает подтверждения склада",
                        "cancel_reason": reason,
                        "cancel_requested_by_manager": True,
                        "warehouse_cancel_previous_status": merged_payload.get(
                            "manager_cancel_previous_status"
                        )
                        or merged_payload.get("status")
                        or merged_payload.get("submit_action")
                        or "",
                        "warehouse_cancel_previous_status_label": merged_payload.get(
                            "manager_cancel_previous_status_label"
                        )
                        or merged_payload.get(
                            "status_label"
                        )
                        or "",
                        "warehouse_cancel_previous_submit_action": merged_payload.get(
                            "manager_cancel_previous_submit_action"
                        )
                        or merged_payload.get(
                            "submit_action"
                        )
                        or "",
                    }
                )
                log_order_action(
                    "warehouse_cancel_request",
                    order_id=order_id,
                    order_type=order_type,
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency,
                    description="Менеджер запросил подтверждение отмены у склада",
                    payload=request_payload,
                )
                return ProcessingDetailActionResult(
                    status="warehouse_cancel_requested",
                    redirect_to=redirect_to,
                )

            if role not in cls._PROCESSING_WAREHOUSE_CANCEL_REVIEW_ROLES:
                return ProcessingDetailActionResult(
                    status="forbidden",
                    redirect_to=redirect_to,
                )
            if not pending:
                return ProcessingDetailActionResult(
                    status="forbidden",
                    redirect_to=redirect_to,
                )

            restored_payload = dict(pending)
            restored_payload["status"] = restored_payload.pop(
                "warehouse_cancel_previous_status", ""
            ) or "processing_head"
            restored_payload["status_label"] = restored_payload.pop(
                "warehouse_cancel_previous_status_label", ""
            ) or "утверждено менеджером"
            restored_payload["submit_action"] = restored_payload.pop(
                "warehouse_cancel_previous_submit_action", ""
            ) or restored_payload["status"]
            restored_payload.pop("cancel_requested_by_manager", None)
            restored_payload.pop("cancel_requested_by_client", None)
            restored_payload.pop("manager_cancel_previous_status", None)
            restored_payload.pop("manager_cancel_previous_status_label", None)
            restored_payload.pop("manager_cancel_previous_submit_action", None)

            if action == "reject_warehouse_cancel":
                restored_payload.pop("cancel_reason", None)
                cls._close_processing_warehouse_cancel_review_task(str(order_id))
                log_order_action(
                    "warehouse_cancel_rejected",
                    order_id=order_id,
                    order_type=order_type,
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency,
                    description="Склад не подтвердил отмену; заявка остаётся в работе",
                    payload=restored_payload,
                )
                return ProcessingDetailActionResult(
                    status="warehouse_cancel_rejected",
                    redirect_to=redirect_to,
                )

            processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
                order_id=str(order_id or ""),
                agency=latest.agency,
                payload=pending,
            )
            delivery_tasks = MoveTask.objects.filter(
                request__context_type="processing",
                request__context_id=str(order_id),
            )
            cancelable_delivery_only = bool(
                processing_result.code == WarehouseStateCode.MOVING_TO_PROCESSING
                and delivery_tasks.exists()
                and not delivery_tasks.filter(
                    Q(qty_done__gt=0) | Q(status=MoveTask.STATUS_DONE)
                ).exists()
                and not delivery_tasks.exclude(
                    status__in={
                        MoveTask.STATUS_CREATED,
                        MoveTask.STATUS_IN_PROGRESS,
                        MoveTask.STATUS_FAILED,
                        MoveTask.STATUS_CANCELED,
                    }
                ).exists()
            )
            warehouse_started = bool(
                processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES
                and not cancelable_delivery_only
            )
            safe_stage = (
                processing_stage_from_payload(pending)
                == PROCESSING_STAGE_MANAGER_APPROVED
            )
            if warehouse_started or not safe_stage:
                restored_payload.pop("cancel_reason", None)
                cls._close_processing_warehouse_cancel_review_task(str(order_id))
                log_order_action(
                    "warehouse_cancel_rejected",
                    order_id=order_id,
                    order_type=order_type,
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency,
                    description=(
                        "Автоматическая отмена отклонена: склад уже начал "
                        "фактическое движение или обработку товара"
                    ),
                    payload=restored_payload,
                )
                return ProcessingDetailActionResult(
                    status="warehouse_cancel_rejected",
                    redirect_to=redirect_to,
                )

            cancel_reason = str(pending.get("cancel_reason") or reason).strip()
            payload = apply_processing_stage(
                pending,
                PROCESSING_STAGE_CANCELLED,
                status_value="cancelled",
            )
            payload.update(
                {
                    "submit_action": "cancelled",
                    "status_label": "Отменена",
                    "cancel_reason": cancel_reason,
                    "cancelled_by": "warehouse",
                    "cancelled_at": timezone.localtime().isoformat(),
                }
            )
            for key in (
                "cancel_requested_by_manager",
                "cancel_requested_by_client",
                "warehouse_cancel_previous_status",
                "warehouse_cancel_previous_status_label",
                "warehouse_cancel_previous_submit_action",
                "manager_cancel_previous_status",
                "manager_cancel_previous_status_label",
                "manager_cancel_previous_submit_action",
            ):
                payload.pop(key, None)
            if latest.agency_id:
                WarehouseWritePathService.replace_processing_reserves(
                    agency=latest.agency,
                    order_id=str(order_id),
                    items=[],
                    created_by=request.user if request.user.is_authenticated else None,
                )
            cls.cancel_processing_warehouse_moves(
                order_id=str(order_id),
                entries=entries,
                request=request,
            )
            log_order_action(
                "warehouse_cancel_approved",
                order_id=order_id,
                order_type=order_type,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency,
                description=f"Склад подтвердил отмену заявки. Причина: {cancel_reason}",
                payload=payload,
            )
            cls._set_task_status(
                Task.objects.filter(
                    route__in=[
                        f"/orders/processing/{order_id}/",
                        f"/orders/processing/{order_id}/flow/",
                    ]
                ),
                "done",
            )
            return ProcessingDetailActionResult(
                status="cancelled",
                redirect_to=redirect_to,
            )

        if action == "cancel_order":
            role = get_request_role(request)
            client_param = request.GET.get("client")
            suffix = f"?client={client_param}" if client_param else ""
            redirect_to = f"/orders/processing/{order_id}/{suffix}"
            processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
                order_id=str(order_id or ""),
                agency=latest.agency,
                payload=merged_payload,
            )
            warehouse_started = processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES
            client_cancel = bool(getattr(request, "_client_agency", None) and processing_client_can_edit(merged_payload))
            manager_cancel = bool(
                role in {"manager", "head_manager", "director", "admin", "developer"}
                and not processing_is_locked_for_edit(merged_payload)
                and not processing_is_in_work(merged_payload)
            )
            if warehouse_started:
                client_cancel = False
                manager_cancel = False
            if not (client_cancel or manager_cancel):
                return ProcessingDetailActionResult(status="forbidden", redirect_to=redirect_to)
            reason_choice = str(request.POST.get("cancel_reason_choice") or "").strip()
            reason_comment = str(request.POST.get("cancel_reason") or "").strip()
            reason = ". ".join(part for part in (reason_choice, reason_comment) if part).strip()
            if not reason:
                return ProcessingDetailActionResult(
                    status="cancel_reason_required",
                    redirect_to=f"{redirect_to}#cancel-reason-required",
                )
            if processing_is_cancelled(merged_payload) or processing_is_done(merged_payload):
                return ProcessingDetailActionResult(status="already_closed", redirect_to=redirect_to)
            if not processing_stage_transition_allowed(merged_payload, PROCESSING_STAGE_CANCELLED):
                return ProcessingDetailActionResult(status="forbidden", redirect_to=redirect_to)
            payload = apply_processing_stage(
                merged_payload,
                PROCESSING_STAGE_CANCELLED,
                status_value="cancelled",
            )
            payload["submit_action"] = "cancelled"
            payload["status_label"] = "Отменена"
            payload["cancel_reason"] = reason
            payload["cancelled_by"] = "client" if client_cancel else "manager"
            payload["cancelled_at"] = timezone.localtime().isoformat()
            uploaded_documents = processing_views._save_processing_attachments(order_id, latest.agency, request)
            if uploaded_documents:
                payload["cancel_documents"] = uploaded_documents
            if latest.agency_id:
                WarehouseWritePathService.replace_processing_reserves(
                    agency=latest.agency,
                    order_id=str(order_id),
                    items=[],
                    created_by=request.user if request.user.is_authenticated else None,
                )
            cls.cancel_processing_warehouse_moves(
                order_id=str(order_id),
                entries=entries,
                request=request,
            )
            log_order_action(
                "status",
                order_id=order_id,
                order_type=order_type,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency,
                description=f"Заявка отменена {'клиентом' if client_cancel else 'менеджером'}. Причина: {reason}",
                payload=payload,
            )
            cls._set_task_status(
                Task.objects.filter(
                    route__in=[
                        f"/orders/processing/{order_id}/",
                        f"/orders/processing/{order_id}/flow/",
                    ]
                ),
                "done",
            )
            return ProcessingDetailActionResult(status="cancelled", redirect_to=redirect_to)

        if action in {"request_change", "request_cancel"}:
            client_agency = getattr(request, "_client_agency", None)
            client_param = request.GET.get("client")
            suffix = f"?client={client_param}" if client_param else ""
            notice = "change" if action == "request_change" else "cancel"
            redirect_to = f"/orders/processing/{order_id}/{suffix}"
            if "?" in redirect_to:
                redirect_to = f"{redirect_to}&request_sent={notice}"
            else:
                redirect_to = f"{redirect_to}?request_sent={notice}"
            if not client_agency:
                return ProcessingDetailActionResult(status="forbidden", redirect_to=redirect_to)
            if processing_is_cancelled(merged_payload) or processing_is_done(merged_payload):
                return ProcessingDetailActionResult(status="already_closed", redirect_to=redirect_to)
            request_reason = str(request.POST.get("request_reason") or "").strip()
            request_comment = str(request.POST.get("request_comment") or "").strip()
            if not request_reason and action == "request_cancel":
                return ProcessingDetailActionResult(status="request_reason_required", redirect_to=redirect_to)
            uploaded_documents = processing_views._save_processing_attachments(order_id, latest.agency, request)
            payload = dict(merged_payload)
            payload["client_request_type"] = notice
            payload["client_request_reason"] = request_reason
            payload["client_request_comment"] = request_comment
            payload["client_request_at"] = timezone.localtime().isoformat()
            if uploaded_documents:
                payload["client_request_documents"] = uploaded_documents
            description = (
                "Клиент запросил отмену заявки на обработку"
                if action == "request_cancel"
                else "Клиент запросил изменение заявки на обработку"
            )
            if request_reason:
                description = f"{description}. Причина: {request_reason}"
            if request_comment:
                description = f"{description}. Комментарий: {request_comment}"
            log_order_action(
                "request",
                order_id=order_id,
                order_type=order_type,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency,
                description=description,
                payload=payload,
            )
            processing_views._create_processing_manager_task(order_id, latest.agency, request, timezone.localtime())
            return ProcessingDetailActionResult(status="ok", redirect_to=redirect_to)

        if action == "take_processing":
            role = get_request_role(request)
            if role not in {"storekeeper", "processing_head"}:
                return ProcessingDetailActionResult(status="forbidden", redirect_to=f"/orders/processing/{order_id}/")
            status_payload = merged_payload
            if not processing_stage_transition_allowed(status_payload, PROCESSING_STAGE_TAKEN_INTO_PROCESSING):
                processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
                    order_id=str(order_id or ""),
                    agency=latest.agency if latest else None,
                    payload=status_payload,
                )
                if processing_result.code == WarehouseStateCode.PROCESSING_IN_PROGRESS:
                    return ProcessingDetailActionResult(
                        status="already_in_progress",
                        redirect_to=f"/orders/processing/{order_id}/work/",
                    )
                return ProcessingDetailActionResult(
                    status="denied",
                    redirect_to=f"/orders/processing/{order_id}/",
                )
            command_result = processing_views.WarehouseCommandService.take_processing(
                order_id=str(order_id or ""),
                agency=latest.agency if latest else None,
                role=role,
                status_payload=status_payload,
                started_by=request.user if request.user.is_authenticated else None,
            )
            if command_result.status == "denied":
                return ProcessingDetailActionResult(status="denied", redirect_to=f"/orders/processing/{order_id}/")
            payload = dict(merged_payload)
            work_started_at = timezone.localtime().isoformat()
            _logged, payload = log_processing_stage(
                order_id=order_id,
                payload=payload,
                stage=PROCESSING_STAGE_TAKEN_INTO_PROCESSING,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency if latest else None,
                order_type=order_type,
                description="Р—Р°СЏРІРєР° РІР·СЏС‚Р° РІ РѕР±СЂР°Р±РѕС‚РєСѓ",
                extra_payload={"work_started_at": work_started_at},
            )
            payload["work_started_at"] = work_started_at
            cls._set_task_status(
                Task.objects.filter(route=f"/orders/processing/{order_id}/", assigned_to__role="processing_head"),
                "in_progress",
            )
            if command_result.status == "already_in_progress":
                return ProcessingDetailActionResult(
                    status="already_in_progress",
                    redirect_to=f"/orders/processing/{order_id}/work/",
                )
            return ProcessingDetailActionResult(status="ok", redirect_to=f"/orders/processing/{order_id}/work/")

        if action == "approve_processing":
            role = get_request_role(request)
            client_param = str(request.GET.get("client") or "").strip()
            suffix = f"?client={client_param}" if client_param else ""
            detail_url = f"/orders/processing/{order_id}/{suffix}"
            if role not in {"manager", "head_manager", "director", "admin"}:
                return ProcessingDetailActionResult(status="forbidden", redirect_to=detail_url)
            status_payload = merged_payload
            processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
                order_id=str(order_id or ""),
                agency=latest.agency if latest else None,
                payload=status_payload,
            )
            if processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES:
                return ProcessingDetailActionResult(status="done", redirect_to=detail_url)
            if processing_is_done(status_payload):
                return ProcessingDetailActionResult(status="done", redirect_to=detail_url)
            article_change_valid, article_change_error = (
                cls._validate_processing_article_change_payload(status_payload)
            )
            if not article_change_valid:
                return ProcessingDetailActionResult(
                    status="invalid_article_change",
                    redirect_to=f"{detail_url}#invalid-article-change",
                    error_message=article_change_error,
                )
            if not processing_stage_transition_allowed(status_payload, PROCESSING_STAGE_MANAGER_APPROVED):
                return ProcessingDetailActionResult(
                    status="invalid_transition",
                    redirect_to=f"{detail_url}#invalid-stage-transition",
                )
            payload = dict(merged_payload)
            approved_at = timezone.localtime().isoformat()
            approval_extra = {"approved_at": approved_at, "approved_by_role": role}
            if request.user.is_authenticated:
                approved_by_name = request.user.get_full_name() or request.user.get_username()
                if approved_by_name:
                    approval_extra["approved_by_name"] = approved_by_name
                approval_extra["approved_by_user_id"] = request.user.id
            logged, payload = log_processing_stage(
                order_id=order_id,
                payload=payload,
                stage=PROCESSING_STAGE_MANAGER_APPROVED,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency if latest else None,
                order_type=order_type,
                description="Р—Р°СЏРІРєР° СѓС‚РІРµСЂР¶РґРµРЅР° РјРµРЅРµРґР¶РµСЂРѕРј",
                extra_payload=approval_extra,
            )
            if not logged:
                return ProcessingDetailActionResult(
                    status="invalid_transition",
                    redirect_to=f"{detail_url}#invalid-stage-transition",
                )
            payload["approved_at"] = approved_at
            cls._set_task_status(
                Task.objects.filter(route=f"/orders/processing/{order_id}/", assigned_to__role="manager"),
                "done",
            )
            processing_views._create_processing_head_task(order_id, latest.agency if latest else None, request, timezone.localtime())
            return ProcessingDetailActionResult(status="ok", redirect_to=detail_url)

        comment = str(request.POST.get("comment") or "").strip()
        if comment:
            latest_comment = (
                OrderAuditEntry.objects.filter(order_id=order_id, order_type=order_type)
                .select_related("agency")
                .order_by("-created_at")
                .first()
            )
            log_order_action(
                "comment",
                order_id=order_id,
                order_type=order_type,
                user=request.user if request.user.is_authenticated else None,
                agency=latest_comment.agency if latest_comment else None,
                description=comment,
                payload={"comment": comment},
            )
        return ProcessingDetailActionResult(status="ok", redirect_to=f"/orders/processing/{order_id}/")

    @classmethod
    def processing_marking_availability(
        cls,
        *,
        request,
        data: dict,
    ) -> ProcessingJsonResult:
        processing_views = cls._views()
        items = data.get("items") or []
        order_id = str(data.get("order_id") or "").strip()
        client_agency = processing_views._client_agency_from_request(request)
        agency = client_agency
        if not agency:
            role = get_request_role(request)
            if role not in {"manager", "storekeeper", "head_manager", "director", "admin"}:
                return ProcessingJsonResult(
                    status="forbidden",
                    http_status=403,
                    payload={"ok": False, "error": "Р”РѕСЃС‚СѓРї Р·Р°РїСЂРµС‰РµРЅ"},
                )
            agency_id = data.get("agency_id") or request.GET.get("client") or request.GET.get("agency")
            agency = processing_views.Agency.objects.filter(pk=agency_id).first() if agency_id else None
        if not agency:
            return ProcessingJsonResult(
                status="missing_agency",
                http_status=400,
                payload={"ok": False, "error": "РљР»РёРµРЅС‚ РЅРµ РІС‹Р±СЂР°РЅ"},
            )
        required: dict[str, int] = {}
        required_total = 0
        missing_barcodes = 0
        for item in items:
            if not isinstance(item, dict):
                continue
            qty = processing_views._parse_qty_value(item.get("qty"))
            if not qty or qty <= 0:
                continue
            barcode = str(item.get("barcode") or "").strip()
            if not barcode:
                missing_barcodes += qty
                continue
            required_total += qty
            required[barcode] = required.get(barcode, 0) + qty
        available_map = processing_views._marking_available_by_barcode(agency, order_id)
        free_map = processing_views._marking_free_by_barcode(agency)
        details = []
        covered_total = 0
        missing_total = 0
        free_total = 0
        for barcode, need in required.items():
            have = available_map.get(barcode, 0)
            free_count = free_map.get(barcode, 0)
            covered = min(need, have)
            missing = max(need - have, 0)
            covered_total += covered
            missing_total += missing
            free_total += free_count
            details.append({"barcode": barcode, "required": need, "available": have, "missing": missing})
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "required": required_total,
                "available": covered_total,
                "missing": missing_total,
                "free": free_total,
                "missing_barcodes": missing_barcodes,
                "items": details,
            },
        )

