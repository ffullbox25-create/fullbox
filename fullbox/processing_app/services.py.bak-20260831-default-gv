    @classmethod
    def scan_processing_flow_marking(cls, *, order_id: str, request) -> ProcessingMarkingScanResult:
        processing_views = cls._views()
        role = get_request_role(request)
        if (
            role != "processing_worker"
            or not processing_views._processing_flow_has_write_access(request, str(order_id or ""))
        ):
            return ProcessingMarkingScanResult(
                status="forbidden",
                http_status=403,
                payload={"ok": False, "error": "Доступ запрещен."},
            )
        data = processing_views._parse_json_body(request)
        if data is None:
            return ProcessingMarkingScanResult(
                status="invalid_json",
                http_status=400,
                payload={"ok": False, "error": "Некорректный JSON."},
            )
        if str(data.get("worker_marking_mode") or "").strip().lower() != "with_cz":
            return ProcessingMarkingScanResult(
                status="marking_mode_required",
                http_status=409,
                payload={"ok": False, "error": "Включите режим «Товар с ЧЗ»."},
            )
        entries = list(
            OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            .select_related("agency")
            .order_by("created_at")
        )
        if not entries:
            return ProcessingMarkingScanResult(
                status="missing_order",
                http_status=404,
                payload={"ok": False, "error": "Заявка не найдена."},
            )
        latest = entries[-1]
        payload = processing_views._processing_work_payload_from_entries(entries)
        raw_code = str(data.get("code") or "")
        scan_values: list[str] = []
        seen_scan_values: set[str] = set()
        for raw_value in re.split(r"[\r\n]+", raw_code):
            normalized_value = processing_views._normalize_marking_code(raw_value)
            if not normalized_value or normalized_value in seen_scan_values:
                continue
            seen_scan_values.add(normalized_value)
            scan_values.append(normalized_value)
        product_barcode = str(data.get("product_barcode") or "").strip()
        box_barcode = str(data.get("box_barcode") or "").strip()
        agent_id = str(data.get("agent_id") or data.get("agentId") or "").strip()
        if not scan_values:
            return ProcessingMarkingScanResult(
                status="missing_code",
                http_status=400,
                payload={"ok": False, "error": "Код ЧЗ не указан."},
            )

        def is_marking_code(value: str) -> bool:
            if len(value) < 20 or not value.startswith("01"):
                return False
            gtin = value[2:16]
            if not gtin.isdigit() or value[16:18] != "21":
                return False
            return bool(value[18:].split("\x1d", 1)[0])

        marking_values = [value for value in scan_values if is_marking_code(value)]
        if not marking_values:
            return ProcessingMarkingScanResult(
                status="missing_marking",
                http_status=400,
                payload={"ok": False, "error": "Сканируйте DataMatrix ЧЗ."},
            )
        if len(marking_values) > 1:
            return ProcessingMarkingScanResult(
                status="multiple_markings",
                http_status=409,
                payload={"ok": False, "error": "Сканируйте один код ЧЗ для одного товара."},
            )
        marking_code = marking_values[0]
        if not product_barcode:
            barcode_values = [value for value in scan_values if value != marking_code]
            if len(barcode_values) == 1:
                product_barcode = barcode_values[0]
            elif len(barcode_values) > 1:
                return ProcessingMarkingScanResult(
                    status="multiple_barcodes",
                    http_status=409,
                    payload={"ok": False, "error": "Сканируйте один штрихкод товара."},
                )
        if not product_barcode:
            return ProcessingMarkingScanResult(
                status="missing_barcode",
                http_status=400,
                payload={"ok": False, "error": "Сначала сопоставьте код ЧЗ со штрихкодом товара."},
            )
        if not box_barcode:
            return ProcessingMarkingScanResult(
                status="missing_box",
                http_status=400,
                payload={"ok": False, "error": "Не выбран короб."},
            )
        session = processing_views._flow_session_for_request(order_id, agent_id, request, create=True)
        if not session:
            return ProcessingMarkingScanResult(
                status="missing_session",
                http_status=409,
                payload={"ok": False, "error": "Контекст упаковки не найден."},
            )
        processed_cards, placed_cards = processing_views._processing_card_sets(payload)
        ready_cards = processing_views._processing_flow_ready_cards(payload)
        items = processing_views._processing_receiving_items(
            payload,
            latest.agency_id,
            ready_cards if ready_cards else None,
        )
        if not items:
            return ProcessingMarkingScanResult(
                status="no_items",
                http_status=400,
                payload={"ok": False, "error": "Нет товаров для размещения."},
            )
        allowed_map: dict[tuple[str, str], dict] = {}
        for item in items:
            sku_value = str(item.get("sku_code") or "").strip()
            size_value = str(item.get("size") or "").strip()
            if not sku_value:
                continue
            allowed_map[(sku_value.lower(), size_value.lower())] = item
        if not allowed_map:
            return ProcessingMarkingScanResult(
                status="no_allowed_items",
                http_status=400,
                payload={"ok": False, "error": "Нет товаров для размещения."},
            )

        allowed_keys = set(allowed_map)

        def resolve_barcode(value: str):
            barcode_values = {str(value or "").strip()}
            if len(value) == 14 and value.startswith("0"):
                barcode_values.add(value[1:])
            barcode_rows = list(
                processing_views.SKUBarcode.objects.select_related("sku")
                .filter(
                    value__in=barcode_values,
                    sku__agency_id=latest.agency_id,
                    sku__deleted=False,
                )
                .order_by("-is_primary", "id")
            )
            matches = []
            for barcode_row in barcode_rows:
                sku = barcode_row.sku
                sku_code = str(sku.sku_code or "").strip()
                size = str(barcode_row.size or sku.size or "").strip()
                key = (sku_code.lower(), size.lower())
                if key not in allowed_map and sku_code:
                    candidate_keys = [candidate for candidate in allowed_keys if candidate[0] == sku_code.lower()]
                    if len(candidate_keys) == 1:
                        key = candidate_keys[0]
                        size = str(allowed_map[key].get("size") or "").strip()
                if key in allowed_map:
                    matches.append((barcode_row, key, allowed_map[key], size))
            unique_matches = {}
            for barcode_row, key, item, size in matches:
                unique_matches[key] = (barcode_row, key, item, size)
            if len(unique_matches) == 1:
                return next(iter(unique_matches.values()))
            return None

        resolved = resolve_barcode(product_barcode)
        if not resolved:
            return ProcessingMarkingScanResult(
                status="missing_barcode",
                http_status=404,
                payload={"ok": False, "error": "Штрихкод товара не найден в этой заявке."},
            )
        barcode_row, allowed_key, allowed_item, size = resolved
        sku_code = str(allowed_item.get("sku_code") or barcode_row.sku.sku_code or "").strip()
        marking_gtin = marking_code[2:16]
        if not cls.is_valid_gtin14(marking_gtin):
            return ProcessingMarkingScanResult(
                status="invalid_marking_gtin",
                http_status=409,
                payload={
                    "ok": False,
                    "error_code": "invalid_marking_gtin",
                    "error": (
                        f"GTIN {marking_gtin} в DataMatrix некорректен. "
                        "Товар не добавлен."
                    ),
                    "scanned_gtin": marking_gtin,
                    "sku_code": sku_code,
                },
            )
        code_variants = marking_code_variants(marking_code)
        marking_identity = marking_code_identity(marking_code)

        now = timezone.localtime()
        with transaction.atomic():
            locked_sessions = list(
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    order_id=order_id,
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("id")
            )
            canceled_box_codes = cls.canceled_processing_box_codes(
                order_id=str(order_id),
            )
            for flow_session in locked_sessions:
                cleaned_state, details = (
                    cls.strip_canceled_processing_boxes_from_flow_state(
                        flow_session.flow_state,
                        canceled_box_codes,
                    )
                )
                if not details["changed"]:
                    continue
                cleaned_state = processing_views._sanitize_flow_state_for_session(
                    cleaned_state,
                    flow_session,
                )
                flow_session.flow_state = cleaned_state
                flow_session.save(update_fields=["flow_state", "updated_at"])
            locked_session = next((item for item in locked_sessions if item.pk == session.pk), None)
            if not locked_session:
                return ProcessingMarkingScanResult(
                    status="missing_session",
                    http_status=409,
                    payload={"ok": False, "error": "Контекст упаковки не найден."},
                )

            flow_state = processing_views._sanitize_flow_state_for_session(
                locked_session.flow_state,
                locked_session,
            )
            boxes = flow_state.get("boxes") or []
            box = next(
                (
                    item
                    for item in boxes
                    if isinstance(item, dict) and str(item.get("code") or "").strip() == box_barcode
                ),
                None,
            )
            if cls.is_processing_box_canceled(
                order_id=str(order_id),
                box_code=box_barcode,
            ):
                return ProcessingMarkingScanResult(
                    status="box_canceled",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error_code": "box_canceled",
                        "error": (
                            f"Короб {box_barcode} отменён руководителем. "
                            "Используйте новый короб."
                        ),
                        "box_barcode": box_barcode,
                    },
                )
            if not box:
                box = {
                    "code": box_barcode,
                    "items": [],
                    "sealed": False,
                    "marking_mode": cls.MARKING_MODE_WITH_CZ,
                    "owner_agent_id": locked_session.agent_id or agent_id,
                    "owner_user_id": locked_session.user_id,
                    "owner_user_label": processing_views._flow_owner_label(locked_session),
                }
                boxes.append(box)
            if box.get("sealed"):
                return ProcessingMarkingScanResult(
                    status="sealed_box",
                    http_status=409,
                    payload={"ok": False, "error": "Короб уже закрыт."},
                )
            box_marking_validation = cls.inspect_processing_box_marking_mode(box)
            if not box_marking_validation["ok"]:
                return ProcessingMarkingScanResult(
                    status="box_marking_mode_conflict",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": (
                            f"Короб {box_barcode} содержит смешанные данные ЧЗ. "
                            "Закройте его после исправления или откройте новый короб."
                        ),
                        "box_barcode": box_barcode,
                    },
                )
            if (
                box_marking_validation["qty"] > 0
                and box_marking_validation["mode"] != cls.MARKING_MODE_WITH_CZ
            ):
                return ProcessingMarkingScanResult(
                    status="box_marking_mode_conflict",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": (
                            f"В коробе {box_barcode} уже есть товар без ЧЗ. "
                            "Добавлять товар с ЧЗ в этот короб запрещено."
                        ),
                        "box_barcode": box_barcode,
                        "box_marking_mode": box_marking_validation["mode"],
                    },
                )
            box["marking_mode"] = cls.MARKING_MODE_WITH_CZ

            flow_usage: dict[str, dict] = {}
            for flow_session in locked_sessions:
                used_flow_state = flow_session.flow_state if isinstance(flow_session.flow_state, dict) else {}
                for used_box in used_flow_state.get("boxes") or []:
                    if not isinstance(used_box, dict):
                        continue
                    used_box_code = str(used_box.get("code") or "").strip()
                    for item in used_box.get("items") or []:
                        if not isinstance(item, dict):
                            continue
                        usage_sku = str(item.get("sku_code") or item.get("sku") or "").strip().lower()
                        usage_size = str(item.get("size") or "").strip().lower()
                        raw_marking_codes = item.get("marking_codes") or []
                        if not isinstance(raw_marking_codes, list):
                            raw_marking_codes = [raw_marking_codes]
                        for raw_marking in raw_marking_codes:
                            if isinstance(raw_marking, dict):
                                raw_marking = raw_marking.get("code")
                            normalized_marking = processing_views._normalize_marking_code(raw_marking or "")
                            if normalized_marking:
                                flow_usage[marking_code_identity(normalized_marking)] = {
                                    "key": (usage_sku, usage_size),
                                    "box_barcode": used_box_code,
                                    "session_id": flow_session.id,
                                }
            if marking_identity in flow_usage:
                used_box_barcode = flow_usage[marking_identity].get("box_barcode") or ""
                return ProcessingMarkingScanResult(
                    status="already_used",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": (
                            f"Код ЧЗ уже принят в короб {used_box_barcode}."
                            if used_box_barcode
                            else "Код ЧЗ уже принят в короб этой заявки."
                        ),
                        "used_box_barcode": used_box_barcode,
                        "used_order_id": order_id,
                    },
                )

            existing_rows = list(
                MarkingCode.objects.select_for_update()
                .filter(
                    Q(identity_key=marking_identity)
                    | Q(code__in=list(code_variants))
                )
                .order_by("id")
            )
            existing_by_code = {}
            for row in existing_rows:
                normalized_existing = processing_views._normalize_marking_code(row.code or "")
                if normalized_existing:
                    existing_by_code[normalized_existing] = row
            if len(existing_by_code) > 1:
                return ProcessingMarkingScanResult(
                    status="multiple_markings",
                    http_status=409,
                    payload={"ok": False, "error": "Сканер передал несколько разных кодов ЧЗ. Сканируйте по одному товару."},
                )
            existing = next(iter(existing_by_code.values()), None)
            created_processing_code = False
            receiving_reuse = False
            if existing:
                normalized_code = processing_views._normalize_marking_code(existing.code or "")
                if latest.agency_id and existing.agency_id and existing.agency_id != latest.agency_id:
                    return ProcessingMarkingScanResult(
                        status="other_agency",
                        http_status=409,
                        payload={"ok": False, "error": "Код принадлежит другому клиенту."},
                    )
                receiving_reuse = bool(
                    existing.used_at
                    and existing.order_type == "receiving"
                    and existing.agency_id
                    and existing.agency_id == latest.agency_id
                )
                if existing.used_at and not receiving_reuse:
                    used_box_barcode = str(existing.box_barcode or "").strip()
                    return ProcessingMarkingScanResult(
                        status="already_used",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": (
                                f"Код ЧЗ уже принят в короб {used_box_barcode}."
                                if used_box_barcode
                                else "Код ЧЗ уже использован."
                            ),
                            "used_box_barcode": used_box_barcode,
                            "used_order_id": str(existing.order_id or ""),
                        },
                    )
                if existing.order_type and existing.order_type != "processing" and not receiving_reuse:
                    return ProcessingMarkingScanResult(
                        status="other_process",
                        http_status=409,
                        payload={"ok": False, "error": "Код закреплен в другом процессе."},
                    )
                if existing.order_id and existing.order_id != order_id and not receiving_reuse:
                    return ProcessingMarkingScanResult(
                        status="other_order",
                        http_status=409,
                        payload={"ok": False, "error": "Код закреплен за другой заявкой."},
                    )
                existing_key = (
                    str(existing.sku_code or "").strip().lower(),
                    str(existing.size or "").strip().lower(),
                )
                if not existing_key[1]:
                    candidate_keys = [key for key in allowed_keys if key[0] == existing_key[0]]
                    if len(candidate_keys) == 1:
                        existing_key = candidate_keys[0]
                if existing_key != allowed_key:
                    return ProcessingMarkingScanResult(
                        status="marking_barcode_mismatch",
                        http_status=409,
                        payload={"ok": False, "error": "Код ЧЗ не совпадает с отсканированным ШК."},
                    )
                if existing.box_barcode and existing.box_barcode != box_barcode and not receiving_reuse:
                    return ProcessingMarkingScanResult(
                        status="other_box",
                        http_status=409,
                        payload={"ok": False, "error": "Код закреплен за другим коробом."},
                    )

            allowed_qty = processing_views._parse_qty_value(allowed_item.get("actual_qty")) or 0
            used_codes = {
                marking_code_identity(value or "")
                for value in MarkingCode.objects.filter(
                    order_type="processing",
                    order_id=order_id,
                    sku_code=sku_code,
                    size=size,
                    used_at__isnull=False,
                ).values_list("code", flat=True)
            }
            used_codes.update(
                code_value
                for code_value, usage in flow_usage.items()
                if usage.get("key") == allowed_key
            )
            used_codes.discard(marking_identity)
            if allowed_qty and len(used_codes) >= allowed_qty:
                return ProcessingMarkingScanResult(
                    status="limit_reached",
                    http_status=409,
                    payload={"ok": False, "error": "Количество ЧЗ уже закрыто."},
                )

            if not existing:
                existing, created_processing_code = MarkingCode.objects.get_or_create(
                    identity_key=marking_identity,
                    defaults={
                        "code": marking_code,
                        "order_type": "processing",
                        "order_id": order_id,
                        "agency": latest.agency,
                        "sku": barcode_row.sku,
                        "sku_code": sku_code,
                        "size": allowed_item.get("size") or size,
                        "barcode": barcode_row.value,
                        "box_barcode": box_barcode,
                        "source": "scan",
                        "created_by": request.user if request.user.is_authenticated else None,
                        "used_at": now,
                        "used_by": request.user if request.user.is_authenticated else None,
                    },
                )
                if not created_processing_code:
                    existing = MarkingCode.objects.select_for_update().get(pk=existing.pk)
            if not receiving_reuse and not created_processing_code:
                update_fields: list[str] = []
                if not existing.order_id:
                    existing.order_id = order_id
                    update_fields.append("order_id")
                if not existing.order_type:
                    existing.order_type = "processing"
                    update_fields.append("order_type")
                if not existing.size and size:
                    existing.size = size
                    update_fields.append("size")
                if box_barcode and not existing.box_barcode:
                    existing.box_barcode = box_barcode
                    update_fields.append("box_barcode")
                if not existing.sku:
                    existing.sku = barcode_row.sku
                    update_fields.append("sku")
                if not existing.sku_code:
                    existing.sku_code = sku_code
                    update_fields.append("sku_code")
                if not existing.barcode:
                    existing.barcode = barcode_row.value
                    update_fields.append("barcode")
                existing.used_at = now
                existing.used_by = request.user if request.user.is_authenticated else None
                update_fields.extend(["used_at", "used_by"])
                existing.save(update_fields=update_fields)

            box_items = box.get("items") or []
            if not isinstance(box_items, list):
                box_items = []
            box_item = next(
                (
                    item
                    for item in box_items
                    if isinstance(item, dict)
                    and str(item.get("sku_code") or item.get("sku") or "").strip().lower() == allowed_key[0]
                    and str(item.get("size") or "").strip().lower() == allowed_key[1]
                ),
                None,
            )
            if not box_item:
                box_item = {
                    "sku_code": allowed_item.get("sku_code") or sku_code,
                    "sku": allowed_item.get("sku_code") or sku_code,
                    "name": allowed_item.get("name") or "",
                    "size": allowed_item.get("size") or size,
                    "barcode": barcode_row.value,
                    "qty": 0,
                    "marking_codes": [],
                }
                box_items.append(box_item)
            marking_codes = box_item.get("marking_codes") or []
            if not isinstance(marking_codes, list):
                marking_codes = [marking_codes]
            marking_codes = [
                str(value.get("code") if isinstance(value, dict) else value or "").strip()
                for value in marking_codes
                if str(value.get("code") if isinstance(value, dict) else value or "").strip()
            ]
            marking_codes.append(existing.code)
            box_item["marking_codes"] = list(dict.fromkeys(marking_codes))
            box_item["qty"] = (processing_views._parse_qty_value(box_item.get("qty")) or 0) + 1
            box["items"] = box_items
            flow_state["boxes"] = boxes
            flow_state["activeBox"] = box_barcode
            locked_session.flow_state = flow_state
            locked_session.last_seen = now
            locked_session.save(update_fields=["flow_state", "last_seen", "updated_at"])
        return ProcessingMarkingScanResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "scan_type": "marking_pair",
                "sku_code": allowed_item.get("sku_code") or sku_code,
                "size": allowed_item.get("size") or size,
                "name": allowed_item.get("name") or "",
                "box_barcode": box_barcode,
                "barcode": barcode_row.value,
                "marking_code": existing.code,
                "box_marking_mode": cls.MARKING_MODE_WITH_CZ,
            },
        )

    @classmethod
    def assign_processing_packaging(cls, *, order_id: str, request) -> ProcessingPackagingAssignmentResult:
        processing_views = cls._views()
        employee_id = str(request.POST.get("assignee_id") or request.POST.get("worker_id") or "").strip()
        if not employee_id:
            return ProcessingPackagingAssignmentResult(
                status="missing_worker",
                redirect_to=f"/orders/processing/{order_id}/work/?assign_error=missing_worker",
            )
        assignee = (
            Employee.objects.select_related("user")
            .filter(pk=employee_id, role="processing_worker", is_active=True)
            .first()
        )
        if not assignee:
            return ProcessingPackagingAssignmentResult(
                status="invalid_worker",
                redirect_to=f"/orders/processing/{order_id}/work/?assign_error=invalid_worker",
            )
        if not assignee.user_id or not assignee.user.is_active:
            return ProcessingPackagingAssignmentResult(
                status="worker_cabinet_missing",
                redirect_to=(
                    f"/orders/processing/{order_id}/work/"
                    "?assign_error=worker_cabinet_missing"
                ),
            )
        entries = list(
            OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            .select_related("agency")
            .order_by("created_at")
        )
        if not entries:
            return ProcessingPackagingAssignmentResult(
                status="invalid_order",
                redirect_to=f"/orders/processing/{order_id}/work/?assign_error=invalid_order",
            )
        latest = entries[-1]
        payload = processing_views._processing_work_payload_from_entries(entries)
        ready_cards = processing_views._processing_flow_ready_cards(payload)
        placement_completed = processing_views._flow_closed_from_entries(entries)
        can_open_processing_flow = bool(
            str(order_id)
            and not placement_completed
            and processing_views.ProcessingFlowView()._can_start(entries)
        )
        task_route = processing_views._processing_packaging_task_route(str(order_id))
        raw_box_assignments = payload.get(cls.PROCESSING_BOX_ASSIGNMENTS_KEY) or []
        box_assignments = [
            dict(row) for row in raw_box_assignments if isinstance(row, dict)
        ] if isinstance(raw_box_assignments, list) else []

        def assignment_payload(state: str, dispatch_mode: str) -> dict:
            now_iso = timezone.localtime().isoformat()
            updated_rows = [
                row
                for row in box_assignments
                if str(row.get("assignee_id") or "").strip() != str(assignee.id)
                or str(row.get("status") or "").strip().lower() in {"completed", "cancelled"}
            ]
            updated_rows.append(
                {
                    "id": uuid.uuid4().hex,
                    "assignee_id": assignee.id,
                    "assignee_name": assignee.full_name,
                    "assignee_user_id": assignee.user_id,
                    "status": state,
                    "ready_card_ids": list(ready_cards),
                    "assigned_at": now_iso,
                    "assigned_by": cls._processing_actor_label(request),
                }
            )
            return {
                cls.PROCESSING_BOX_ASSIGNMENTS_KEY: updated_rows,
                "packing_assignment_state": state,
                "packing_assignee_id": assignee.id,
                "packing_assignee": assignee.full_name,
                "packing_assignee_role": assignee.role,
                "packing_assignment_dispatch_mode": dispatch_mode,
            }

        if can_open_processing_flow:
            direct_payload = assignment_payload("dispatched", "direct")
            apply_processing_cards_subzone(
                direct_payload,
                ready_cards,
                PROCESSING_SUBZONE_PACK,
            )
            with transaction.atomic():
                existing_task = (
                    Task.objects.select_for_update()
                    .filter(route=task_route, assigned_to=assignee)
                    .exclude(status="done")
                    .order_by("-updated_at", "-id")
                    .first()
                )
                if existing_task and existing_task.status != "blocked":
                    return ProcessingPackagingAssignmentResult(
                        status="already_assigned",
                        redirect_to=f"/orders/processing/{order_id}/work/?assign_error=already_assigned",
                    )
                if existing_task:
                    existing_task.status = "backlog"
                    existing_task.updated_at = timezone.now()
                    existing_task.save(update_fields=["status", "updated_at"])
                else:
                    processing_views._create_processing_packaging_task(
                        str(order_id),
                        assignee,
                        request.user,
                    )
                log_order_action(
                    "update",
                    order_id=order_id,
                    order_type="processing",
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency if latest else None,
                    description=f"Поручено формирование коробов: {assignee.full_name}",
                    payload=direct_payload,
                )
            return ProcessingPackagingAssignmentResult(
                status="ok",
                redirect_to=f"/orders/processing/{order_id}/work/?assign=ok",
            )
        pending_payload = assignment_payload("pending", "deferred")
        with transaction.atomic():
            existing_task = (
                Task.objects.select_for_update()
                .filter(route=task_route, assigned_to=assignee)
                .exclude(status="done")
                .order_by("-updated_at", "-id")
                .first()
            )
            if existing_task:
                existing_task.status = "blocked"
                existing_task.updated_at = timezone.now()
                existing_task.save(update_fields=["status", "updated_at"])
            else:
                processing_views._create_processing_packaging_task(
                    str(order_id),
                    assignee,
                    request.user,
                    status="blocked",
                )
            log_order_action(
                "update",
                order_id=order_id,
                order_type="processing",
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency if latest else None,
                description=(
                    "Поручено формирование коробов после завершения обработки: "
                    f"{assignee.full_name}"
                ),
                payload=pending_payload,
            )
        return ProcessingPackagingAssignmentResult(
            status="deferred",
            redirect_to=f"/orders/processing/{order_id}/work/?assign=deferred",
        )

    @classmethod
    def assign_processing_card(cls, *, order_id: str, request) -> ProcessingCardAssignmentResult:
        processing_views = cls._views()
        card_id = str(request.POST.get("card_id") or "").strip()
        raw_employee_ids = [
            str(value or "").strip()
            for value in request.POST.getlist("assignee_ids")
            if str(value or "").strip()
        ]
        legacy_employee_id = str(request.POST.get("assignee_id") or "").strip()
        if not raw_employee_ids and legacy_employee_id:
            raw_employee_ids = [legacy_employee_id]
        employee_ids: list[str] = []
        seen_employee_ids: set[str] = set()
        for employee_id in raw_employee_ids:
            if employee_id in seen_employee_ids:
                continue
            seen_employee_ids.add(employee_id)
            employee_ids.append(employee_id)
        redirect_base = f"/orders/processing/{order_id}/work/"
        if not card_id:
            return ProcessingCardAssignmentResult(
                status="missing_card",
                redirect_to=f"{redirect_base}?card_assign_error=missing_card",
            )
        if not employee_ids:
            return ProcessingCardAssignmentResult(
                status="missing_worker",
                redirect_to=f"{redirect_base}?card_assign_error=missing_worker",
            )
        if any(not employee_id.isdigit() for employee_id in employee_ids):
            return ProcessingCardAssignmentResult(
                status="invalid_worker",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_worker",
            )
        assignees_by_id = {
            str(employee.id): employee
            for employee in Employee.objects.filter(
                pk__in=employee_ids,
                role="packer",
                is_active=True,
            )
        }
        if len(assignees_by_id) != len(employee_ids):
            return ProcessingCardAssignmentResult(
                status="invalid_worker",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_worker",
            )
        assignees = [assignees_by_id[employee_id] for employee_id in employee_ids]
        valid_assignee_ids = {assignee.id for assignee in assignees}
        requested_operation_key = str(
            request.POST.get("operation_key") or "technical_card"
        ).strip()[:128]
        planned_qty_by_employee = {
            str(employee_id): cls._positive_int(request.POST.get(f"assignee_qty_{employee_id}"))
            for employee_id in employee_ids
        }
        has_quantity_plan = any(planned_qty_by_employee.values())
        if not has_quantity_plan or any(value <= 0 for value in planned_qty_by_employee.values()):
            return ProcessingCardAssignmentResult(
                status="invalid_quantity",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_quantity",
            )
        entries = list(
            OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            .select_related("agency")
            .order_by("created_at", "id")
        )
        if not entries:
            return ProcessingCardAssignmentResult(
                status="invalid_order",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_order",
            )
        latest = entries[-1]
        payload = dict(processing_views._processing_work_payload_from_entries(entries))
        operation_options = {
            str(row.get("key") or ""): str(row.get("label") or "")
            for row in cls._processing_operation_options(payload)
        }
        if requested_operation_key not in operation_options:
            return ProcessingCardAssignmentResult(
                status="invalid_operation",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_operation",
            )
        operation_key = requested_operation_key
        operation_label = operation_options[operation_key]
        card = next(
            (
                item
                for item in (payload.get("cards") or [])
                if isinstance(item, dict)
                and processing_views._processing_card_id(item) == card_id
            ),
            None,
        )
        if card is None:
            return ProcessingCardAssignmentResult(
                status="invalid_card",
                redirect_to=f"{redirect_base}?card_assign_error=invalid_card",
            )
        processed_cards, _ = processing_views._processing_card_sets(payload)
        if card_id in processed_cards:
            return ProcessingCardAssignmentResult(
                status="card_done",
                redirect_to=f"{redirect_base}?card_assign_error=card_done",
            )
        declared_qty = sum(
            cls._positive_int(row.get("qty") or row.get("recount_qty") or row.get("processing_qty"))
            for row in (card.get("rows") or [])
            if isinstance(row, dict)
        )
        work_assignments = cls._processing_work_assignments(payload)
        requested_planned = sum(planned_qty_by_employee.values())
        if has_quantity_plan and declared_qty > 0:
            if requested_planned > declared_qty:
                return ProcessingCardAssignmentResult(
                    status="quantity_exceeded",
                    redirect_to=(
                        f"{redirect_base}?card_assign_error=quantity_exceeded"
                        f"&card_declared_qty={declared_qty}"
                    ),
                )
        route = processing_views._processing_card_task_route(order_id, card_id)
        article = str(card.get("article") or card_id).strip()
        product_name = str(card.get("product_name") or card.get("name") or "").strip()
        title = f"Обработать {article} по заявке №{order_id}"[:255]
        description_parts = [
            part
            for part in (
                product_name,
                f"Карточка: {card_id}",
                "Операции: по техкарте товара",
            )
            if part
        ]
        actor = get_request_employee(request)
        with transaction.atomic():
            tasks = list(
                Task.objects.select_for_update()
                .filter(route=route)
                .exclude(status="done")
                .order_by("-updated_at", "-id")
            )
            tasks_by_assignee: dict[int, Task] = {}
            duplicate_task_ids: list[int] = []
            for existing_task in tasks:
                if (
                    existing_task.assigned_to_id
                    and existing_task.assigned_to_id not in tasks_by_assignee
                ):
                    tasks_by_assignee[existing_task.assigned_to_id] = existing_task
                else:
                    duplicate_task_ids.append(existing_task.id)
            scoped_assignments = [
                row
                for row in work_assignments
                if str(row.get("card_id") or "").strip() == card_id
                and str(row.get("operation_key") or "").strip() == operation_key
            ]
            completed_actual_by_assignee: dict[str, int] = {}
            completed_actual_total = 0
            for row in scoped_assignments:
                if str(row.get("status") or "").strip().lower() != "completed":
                    continue
                actual_qty = cls._positive_int(row.get("actual_qty"))
                completed_actual_total += actual_qty
                assignee_key = str(row.get("assignee_id") or "").strip()
                completed_actual_by_assignee[assignee_key] = (
                    completed_actual_by_assignee.get(assignee_key, 0) + actual_qty
                )
            open_scoped_assignments = [
                row
                for row in scoped_assignments
                if str(row.get("status") or "").strip().lower() == "assigned"
            ]
            if (
                set(tasks_by_assignee) == valid_assignee_ids
                and not duplicate_task_ids
                and (
                    not has_quantity_plan
                    or (
                        not open_scoped_assignments
                        and completed_actual_total >= requested_planned
                    )
                )
            ):
                return ProcessingCardAssignmentResult(
                    status="already_assigned",
                    redirect_to=f"{redirect_base}?card_assign=already_assigned",
                )
            task_ids_to_close = duplicate_task_ids + [
                existing_task.id
                for assignee_id, existing_task in tasks_by_assignee.items()
                if assignee_id not in valid_assignee_ids
            ]
            if task_ids_to_close:
                Task.objects.filter(pk__in=task_ids_to_close).update(
                    status="done",
                    updated_at=timezone.now(),
                )
            assignment_tasks: list[Task] = []
            for assignee in assignees:
                task = tasks_by_assignee.get(assignee.id)
                if task:
                    task.title = title
                    task.description = " · ".join(description_parts)
                    task.observer = actor if actor and actor.id != assignee.id else None
                    task.created_by = request.user if request.user.is_authenticated else None
                    task.save(
                        update_fields=[
                            "title",
                            "description",
                            "observer",
                            "created_by",
                            "updated_at",
                        ]
                    )
                else:
                    task = Task.objects.create(
                        title=title,
                        description=" · ".join(description_parts),
                        route=route,
                        assigned_to=assignee,
                        observer=actor if actor and actor.id != assignee.id else None,
                        created_by=request.user if request.user.is_authenticated else None,
                        status="backlog",
                        priority="normal",
                    )
                assignment_tasks.append(task)
            primary_task = assignment_tasks[0]
            primary_assignee = assignees[0]
            payload["last_processing_card_assignment"] = {
                "card_id": card_id,
                "task_id": primary_task.id,
                "task_ids": [task.id for task in assignment_tasks],
                "assignee_id": primary_assignee.id,
                "assignee_name": primary_assignee.full_name,
                "assignee_ids": [assignee.id for assignee in assignees],
                "assignee_names": [assignee.full_name for assignee in assignees],
                "assigned_at": timezone.localtime().isoformat(),
            }
            performer_map = payload.get("processing_card_performers") or {}
            if not isinstance(performer_map, dict):
                performer_map = {}
            performer_map = dict(performer_map)
            performer_map[card_id] = [
                {"id": assignee.id, "name": assignee.full_name}
                for assignee in assignees
            ]
            payload["processing_card_performers"] = performer_map
            if has_quantity_plan:
                now_iso = timezone.localtime().isoformat()
                updated_assignments = []
                for row in work_assignments:
                    if (
                        str(row.get("card_id") or "").strip() == card_id
                        and str(row.get("operation_key") or "").strip() == operation_key
                        and str(row.get("status") or "").strip().lower() == "assigned"
                    ):
                        continue
                    updated_assignments.append(row)
                remaining_planned = max(0, requested_planned - completed_actual_total)
                for assignee in assignees:
                    assignee_key = str(assignee.id)
                    assignee_remaining = max(
                        0,
                        planned_qty_by_employee.get(assignee_key, 0)
                        - completed_actual_by_assignee.get(assignee_key, 0),
                    )
                    assigned_qty = min(assignee_remaining, remaining_planned)
                    if assigned_qty <= 0:
                        continue
                    updated_assignments.append(
                        {
                            "id": uuid.uuid4().hex,
                            "card_id": card_id,
                            "article": article,
                            "operation_key": operation_key,
                            "operation_label": operation_label,
                            "assignee_id": assignee.id,
                            "assignee_name": assignee.full_name,
                            "planned_qty": assigned_qty,
                            "actual_qty": 0,
                            "status": "assigned",
                            "assigned_at": now_iso,
                            "assigned_by": cls._processing_actor_label(request),
                        }
                    )
                    remaining_planned -= assigned_qty
                payload[cls.PROCESSING_WORK_ASSIGNMENTS_KEY] = updated_assignments
            apply_processing_card_subzone(payload, card_id, PROCESSING_SUBZONE_WORK)
            log_order_action(
                "update",
                order_id=order_id,
                order_type="processing",
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency,
                description=(
                    f"Карточка {article} назначена упаковщицам: "
                    f"{', '.join(assignee.full_name for assignee in assignees)}"
                    + (
                        f". Операция: {operation_label}. План: "
                        + ", ".join(
                            f"{assignee.full_name} — {planned_qty_by_employee.get(str(assignee.id), 0)} шт."
                            for assignee in assignees
                        )
                        if has_quantity_plan
                        else ""
                    )
                ),
                payload=payload,
            )
        return ProcessingCardAssignmentResult(
            status="ok",
            redirect_to=f"{redirect_base}?card_assign=ok",
        )

    @classmethod
    def complete_packer_work_assignment(
        cls,
        *,
        order_id: str,
        request,
    ) -> ProcessingCardAssignmentResult:
        redirect_base = f"/orders/processing/{order_id}/work/"
        role = get_request_role(request)
        if role not in {"processing_head", "head_manager", "director", "admin"}:
            return ProcessingCardAssignmentResult(status="forbidden", redirect_to=redirect_base)
        assignment_id = str(request.POST.get("assignment_id") or "").strip()
        actual_qty = cls._positive_int(request.POST.get("actual_qty"))
        comment = str(request.POST.get("assignment_comment") or "").strip()[:2000]
        if not assignment_id or actual_qty <= 0:
            return ProcessingCardAssignmentResult(
                status="invalid_quantity",
                redirect_to=f"{redirect_base}?work_fact_error=invalid_quantity",
            )
        with transaction.atomic():
            entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=order_id, order_type="processing")
                .select_related("agency")
                .order_by("created_at", "id")
            )
            if not entries:
                return ProcessingCardAssignmentResult(status="invalid_order", redirect_to="/orders/")
            processing_views = cls._views()
            payload = dict(processing_views._processing_work_payload_from_entries(entries))
            assignments = cls._processing_work_assignments(payload)
            target = next(
                (row for row in assignments if str(row.get("id") or "").strip() == assignment_id),
                None,
            )
            if target is None:
                return ProcessingCardAssignmentResult(
                    status="invalid_assignment",
                    redirect_to=f"{redirect_base}?work_fact_error=invalid_assignment",
                )
            if str(target.get("status") or "").strip().lower() == "completed":
                return ProcessingCardAssignmentResult(
                    status="already_completed",
                    redirect_to=f"{redirect_base}?work_fact=already_completed",
                )
            planned_qty = cls._positive_int(target.get("planned_qty"))
            if actual_qty != planned_qty and not comment:
                return ProcessingCardAssignmentResult(
                    status="comment_required",
                    redirect_to=f"{redirect_base}?work_fact_error=comment_required",
                )
            completed_at_value = timezone.now()
            target["actual_qty"] = actual_qty
            target["status"] = "completed"
            target["completed_at"] = timezone.localtime(completed_at_value).isoformat()
            target["completed_by"] = cls._processing_actor_label(request)
            target["comment"] = comment
            payload[cls.PROCESSING_WORK_ASSIGNMENTS_KEY] = assignments
            log_order_action(
                "update",
                order_id=order_id,
                order_type="processing",
                user=request.user if request.user.is_authenticated else None,
                agency=entries[-1].agency,
                description=(
                    f"Зафиксирован результат упаковщицы {target.get('assignee_name') or '-'}: "
                    f"{target.get('operation_label') or 'операция'} — {actual_qty} шт."
                ),
                payload=payload,
            )
            record_processing_assignment_completion(
                order_id=str(order_id),
                agency=entries[-1].agency,
                assignment=target,
                occurred_at=completed_at_value,
                recorded_by=request.user if request.user.is_authenticated else None,
            )
        return ProcessingCardAssignmentResult(
            status="ok",
            redirect_to=f"{redirect_base}?work_fact=ok",
        )

    @classmethod
    def _complete_processing_card_task(cls, *, order_id: str, card_id: str) -> None:
