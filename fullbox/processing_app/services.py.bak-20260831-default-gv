    @classmethod
    def delete_processing_draft(
        cls,
        *,
        request,
        order_id: str,
    ):
        processing_views = cls._views()
        if request.method != "POST":
            return HttpResponseForbidden("Доступ запрещен")
        if not request.user.is_authenticated:
            return HttpResponseForbidden("Доступ запрещен")
        client_agency = processing_views._client_agency_from_request(request)
        if not client_agency:
            return HttpResponseForbidden("Доступ запрещен")
        entries = OrderAuditEntry.objects.filter(
            order_id=order_id,
            order_type="processing",
            agency=client_agency,
        ).order_by("-created_at")
        latest = entries.first()
        if not latest or not processing_views._is_draft_payload(latest.payload or {}):
            return HttpResponseForbidden("Доступ запрещен")
        from client_cabinet.request_ownership import (
            PORTAL_REQUEST_OWNER_MESSAGE,
            portal_user_can_edit_request,
        )

        if not portal_user_can_edit_request(
            user=request.user,
            agency=client_agency,
            order_type="processing",
            order_id=order_id,
            request=request,
        ):
            return HttpResponseForbidden(PORTAL_REQUEST_OWNER_MESSAGE)
        MarkingCode.objects.filter(
            order_type="processing",
            order_id=order_id,
            agency=client_agency,
            used_at__isnull=True,
        ).update(order_id="")
        processing_views._delete_processing_attachments(order_id, client_agency)
        entries.delete()
        return redirect(f"/client/dashboard/lk/?client={client_agency.id}")

    @classmethod
    def submit_processing(cls, *, request):
        processing_views = cls._views()
        autosave = str(request.POST.get("draft_autosave") or "").strip() == "1"

        def autosave_error(message: str):
            if not autosave:
                return None
            return JsonResponse({"ok": False, "error": message}, status=400)

        def render_home_error(message: str):
            error_response = autosave_error(message)
            if error_response:
                return error_response
            view = processing_views.ProcessingHomeView()
            view.setup(request)
            return view.get(request, error=message)

        submit_action = str(request.POST.get("submit_action") or "send").strip().lower()
        is_draft = submit_action == "draft"
        draft_order_id = str(request.POST.get("draft_order_id") or "").strip()
        edit_order_id = str(request.POST.get("edit_order_id") or "").strip()
        client_agency = getattr(request, "_client_agency", None) or processing_views._client_agency_from_request(request)
        if client_agency:
            agency = client_agency
        else:
            agency_id = request.POST.get("agency_id")
            agency = processing_views.Agency.objects.filter(pk=agency_id).first()
        if not agency:
            return render_home_error("Выберите клиента.")

        # Защита от гонки: autosave после «Отправить» не создаёт новый draft-*.
        if autosave and is_draft and client_agency and not edit_order_id:
            recent_cutoff = timezone.now() - timedelta(seconds=90)
            recent_entries = (
                OrderAuditEntry.objects.filter(
                    agency=agency,
                    order_type="processing",
                    user=request.user,
                    created_at__gte=recent_cutoff,
                )
                .exclude(order_id__startswith="draft-")
                .order_by("-created_at", "-id")[:12]
            )
            for entry in recent_entries:
                payload = entry.payload if isinstance(entry.payload, dict) else {}
                status = str(payload.get("status") or payload.get("submit_action") or "").strip().lower()
                if status in {"sent_unconfirmed", "submitted", "send"}:
                    return JsonResponse(
                        {
                            "ok": True,
                            "order_id": str(entry.order_id),
                            "draft_order_id": "",
                            "status": status,
                            "status_label": str(payload.get("status_label") or "Ждет подтверждения"),
                            "skipped": "already_submitted",
                        }
                    )

        role = get_request_role(request)
        existing_entries = []
        preserved_status = ""
        preserved_label = ""
        preserved_submit_action = ""
        if edit_order_id:
            existing_entries = list(
                OrderAuditEntry.objects.filter(order_id=edit_order_id, order_type="processing")
                .order_by("created_at")
            )
            if not existing_entries:
                return render_home_error("Заявка не найдена.")
            latest_payload = existing_entries[-1].payload or {}
            entry_agency = existing_entries[-1].agency
            if client_agency:
                if not entry_agency or int(entry_agency.id) != int(client_agency.id):
                    return HttpResponseForbidden("Доступ запрещен")
                from client_cabinet.request_ownership import (
                    PORTAL_REQUEST_OWNER_MESSAGE,
                    portal_user_can_edit_request,
                )

                if not portal_user_can_edit_request(
                    user=request.user,
                    agency=client_agency,
                    order_type="processing",
                    order_id=edit_order_id,
                    request=request,
                ):
                    return HttpResponseForbidden(PORTAL_REQUEST_OWNER_MESSAGE)
                if not processing_client_can_edit(latest_payload):
                    return HttpResponseForbidden("Доступ запрещен")
            elif role not in {"manager", "head_manager", "director", "admin"}:
                return HttpResponseForbidden("Доступ запрещен")
            preserved_status = str(latest_payload.get("status") or latest_payload.get("submit_action") or "").strip()
            preserved_label = str(latest_payload.get("status_label") or "").strip()
            preserved_submit_action = str(latest_payload.get("submit_action") or "").strip()
            if processing_is_done(latest_payload):
                message = "Заявка уже утверждена и недоступна для редактирования."
                return render_home_error(message)
            if processing_is_locked_for_edit(latest_payload):
                message = "Заявка уже передана в обработку и недоступна для редактирования."
                return render_home_error(message)
            processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
                order_id=str(edit_order_id or ""),
                agency=entry_agency if entry_agency else agency,
                payload=latest_payload,
            )
            if processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES:
                message = "Заявка уже передана в обработку и недоступна для редактирования."
                return render_home_error(message)
            is_draft = False

        existing_draft_entries = []
        if client_agency and is_draft and not draft_order_id and not edit_order_id:
            from client_cabinet.client_drafts import resolve_client_draft_order_id

            draft_order_id = resolve_client_draft_order_id(
                agency=agency,
                order_type="processing",
                allow_new=True,
                user=request.user,
            )
        if draft_order_id:
            draft_qs = OrderAuditEntry.objects.filter(
                order_id=draft_order_id,
                order_type="processing",
                agency=agency,
            ).order_by("created_at")
            existing_draft_entries = list(draft_qs)
            latest_draft = existing_draft_entries[-1] if existing_draft_entries else None
            if not latest_draft or not processing_views._is_draft_payload(latest_draft.payload or {}):
                draft_order_id = ""
                existing_draft_entries = []
            elif client_agency:
                from client_cabinet.request_ownership import (
                    PORTAL_REQUEST_OWNER_MESSAGE,
                    portal_user_can_edit_request,
                )

                if not portal_user_can_edit_request(
                    user=request.user,
                    agency=client_agency,
                    order_type="processing",
                    order_id=draft_order_id,
                    request=request,
                ):
                    return HttpResponseForbidden(PORTAL_REQUEST_OWNER_MESSAGE)

        client_unit_picker_v1 = bool(
            client_agency
            and not edit_order_id
            and (
                str(request.POST.get("client_unit_picker_v1") or "").strip() in {"1", "true", "True"}
                or (
                    bool(existing_draft_entries)
                    and bool((existing_draft_entries[-1].payload or {}).get("client_unit_picker_v1"))
                )
            )
        )

        cards_payload = []
        cards_json = str(request.POST.get("cards_json") or "").strip()
        if cards_json:
            try:
                parsed_cards = json.loads(cards_json)
            except json.JSONDecodeError:
                parsed_cards = []
            if isinstance(parsed_cards, list):
                for entry in parsed_cards:
                    if not isinstance(entry, dict):
                        continue
                    card_id = str(entry.get("id") or "").strip()
                    article = str(entry.get("article") or "").strip()
                    product_name = str(entry.get("product_name") or "").strip()
                    photo_url = str(entry.get("photo_url") or "").strip()
                    goods_type = str(entry.get("goods_type") or "").strip()
                    result_sku_id = str(entry.get("result_sku_id") or "").strip()
                    result_article = str(entry.get("result_article") or "").strip()
                    result_product_name = str(entry.get("result_product_name") or "").strip()
                    result_barcode = str(entry.get("result_barcode") or "").strip()
                    result_marketplace = str(entry.get("result_marketplace") or "").strip()
                    result_source_reference = str(entry.get("result_source_reference") or "").strip()
                    rows = []
                    for row in entry.get("rows") or []:
                        if not isinstance(row, dict):
                            continue
                        box_codes = row.get("box_codes") or row.get("box_code") or []
                        if isinstance(box_codes, str):
                            box_codes = [code.strip() for code in box_codes.split(",") if code.strip()]
                        elif isinstance(box_codes, (list, tuple)):
                            box_codes = [str(code or "").strip() for code in box_codes if str(code or "").strip()]
                        else:
                            box_codes = []
                        row_result_sku_id = str(row.get("result_sku_id") or "").strip()
                        row_result_article = str(row.get("result_article") or "").strip()
                        row_result_product_name = str(row.get("result_product_name") or "").strip()
                        row_result_barcode = str(row.get("result_barcode") or "").strip()
                        if row_result_sku_id and not result_sku_id:
                            result_sku_id = row_result_sku_id
                        if row_result_article and not result_article:
                            result_article = row_result_article
                        if row_result_product_name and not result_product_name:
                            result_product_name = row_result_product_name
                        if row_result_barcode and not result_barcode:
                            result_barcode = row_result_barcode
                        row_payload = {
                            "article": str(row.get("article") or row.get("sku") or "").strip(),
                            "size": str(row.get("size") or "").strip(),
                            "barcode": str(row.get("barcode") or "").strip(),
                            "qty": row.get("qty"),
                        }
                        if row_result_sku_id:
                            row_payload["result_sku_id"] = row_result_sku_id
                        if row_result_article:
                            row_payload["result_article"] = row_result_article
                        if row_result_product_name:
                            row_payload["result_product_name"] = row_result_product_name
                        if row_result_barcode:
                            row_payload["result_barcode"] = row_result_barcode
                        for source_key, target_key in (
                            ("box_qty", "box_qty"),
                            ("boxes", "boxes"),
                            ("partial_boxes", "partial_boxes"),
                            ("is_mixed_box", "is_mixed_box"),
                            ("mixed_group", "mixed_group"),
                            ("source_state", "source_state"),
                            ("source_zone", "source_zone"),
                            ("strict_selected_box", "strict_selected_box"),
                            ("allow_partial_box_reserve", "allow_partial_box_reserve"),
                            ("partial_box_split", "partial_box_split"),
                        ):
                            if source_key in row:
                                row_payload[target_key] = row.get(source_key)
                        if box_codes:
