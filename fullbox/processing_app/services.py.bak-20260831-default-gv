    @classmethod
    def _validate_processing_article_change_payload(cls, payload: dict | None) -> tuple[bool, str]:
        if not cls._processing_article_change_requested(payload):
            return True, ""
        cards = (payload or {}).get("cards") or []
        if not isinstance(cards, list) or not cards:
            return False, "Для замены артикула в заявке должен быть выбран товар."
        for card in cards:
            if not isinstance(card, dict):
                continue
            source_article = str(card.get("article") or card.get("sku") or "").strip()
            target_article = str(card.get("result_article") or "").strip()
            rows = [row for row in (card.get("rows") or []) if isinstance(row, dict)]
            if not rows:
                rows = [card]
            for row in rows:
                row_source = str(row.get("article") or row.get("sku") or source_article).strip()
                row_target = str(row.get("result_article") or target_article).strip()
                if not row_source:
                    return False, "Для замены артикула не указан исходный артикул А."
                if not row_target:
                    return False, f"Для артикула А {row_source} не указан артикул Б."
                if row_source.casefold() == row_target.casefold():
                    return False, f"Артикул Б должен отличаться от артикула А: {row_source}."
        return True, ""

    @classmethod
    def _processing_article_change_print_target(
        cls,
        *,
        order_id: str,
        card_id: str,
        article: str,
        size: str,
    ) -> tuple[str, dict, str]:
        normalized_order_id = str(order_id or "").strip()
        if not normalized_order_id:
            return "inactive", {}, ""
        entries = list(
            OrderAuditEntry.objects.filter(
                order_id=normalized_order_id,
                order_type="processing",
            )
            .select_related("agency")
            .order_by("created_at")
        )
        if not entries:
            return "inactive", {}, ""
        processing_views = cls._views()
        payload = processing_views._processing_work_payload_from_entries(entries)
        if not cls._processing_article_change_requested(payload):
            return "inactive", {}, ""
        valid, error_message = cls._validate_processing_article_change_payload(payload)
        if not valid:
            return "invalid", {}, error_message
        selected_card = cls._find_processing_card(
            payload,
            card_id=str(card_id or "").strip(),
            article=str(article or "").strip(),
        )
        if not selected_card:
            return "invalid", {}, "Не удалось определить товар заявки для печати артикула Б."
        source_article = str(selected_card.get("article") or selected_card.get("sku") or "").strip()
        target_article = str(selected_card.get("result_article") or "").strip()
        target_name = str(selected_card.get("result_product_name") or "").strip()
        target_barcode = str(selected_card.get("result_barcode") or "").strip()
        rows = [row for row in (selected_card.get("rows") or []) if isinstance(row, dict)]
        size_key = str(size or "").strip().casefold()
        selected_row = None
        if size_key:
            selected_row = next(
                (
                    row
                    for row in rows
                    if str(
                        row.get("size")
                        or row.get("size_value")
                        or row.get("size_no")
                        or ""
                    ).strip().casefold()
                    == size_key
                ),
                None,
            )
        if selected_row is None and len(rows) == 1:
            selected_row = rows[0]
        if selected_row:
            source_article = str(
                selected_row.get("article")
                or selected_row.get("sku")
                or source_article
            ).strip()
            target_article = str(
                selected_row.get("result_article")
                or target_article
            ).strip()
            target_name = str(
                selected_row.get("result_product_name")
                or target_name
            ).strip()
            target_barcode = str(
                selected_row.get("result_barcode")
                or target_barcode
            ).strip()
        if not target_article:
            return "invalid", {}, f"Для артикула А {source_article or '-'} не указан артикул Б."
        if source_article and source_article.casefold() == target_article.casefold():
            return "invalid", {}, f"Артикул Б должен отличаться от артикула А: {source_article}."
        if not target_barcode:
            return "invalid", {}, f"Для артикула Б {target_article} не найден штрихкод."
        return (
            "active",
            {
                "source_article": source_article,
                "article": target_article,
                "name": target_name,
                "barcode": target_barcode,
            },
            "",
        )

