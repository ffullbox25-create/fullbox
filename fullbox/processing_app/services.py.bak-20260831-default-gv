            (not is_processing_done)
            and (not is_cancelled)
            and not warehouse_started
            and processing_is_waiting_approval(status_payload)
        )
        updates["can_approve_processing"] = bool(can_manage and is_waiting and not is_locked)
        client_can_edit = bool(
            client_view
            and not is_locked
            and not is_cancelled
