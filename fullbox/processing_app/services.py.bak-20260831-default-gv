            {"label": "Смена артикула", "value": article_change_summary},
            {"label": "Смена ШК", "value": barcode_change_summary},
            {"label": "Комментарий клиента", "value": visible_value(payload.get("comments"))},
            {"label": "Выбранные услуги", "value": ", ".join(selected_services)},
        ]

        latest_history = entries[-1] if entries else None
        return {
            "status_key": current_key,
            "status_title": status_title_map.get(current_key, "Ожидает проверки менеджером"),
            "status_help": status_help_map.get(current_key, "Менеджер проверит состав обработки и подтвердит заявку."),
            "status_tone": "danger" if is_cancelled else ("success" if current_key == "done" else "info"),
            "created_at": created_at,
            "show_success": current_key in {"submitted", "manager_review"} and not is_cancelled,
            "steps": steps,
            "general_rows": [row for row in general_rows if str(row.get("value") or "").strip()],
            "technical_rows": [row for row in technical_rows if str(row.get("value") or "").strip()],
            "composition_rows": composition_rows,
            "sku_count": sku_count,
            "qty_total": qty_total,
            "selected_services": selected_services,
            "attachment_count": len(processing_attachments or []),
            "latest_history": latest_history,
            "history_count": len(entries or []),
        }

    @classmethod
    def build_processing_home_page_context(
        cls,
        *,
        request,
        submitted: bool,
        draft_saved: bool,
        error: str | None,
    ) -> dict:
        processing_views = cls._views()
        ctx: dict = {
            "submitted": submitted,
            "draft_saved": draft_saved,
            "error": error,
            "cabinet_url": resolve_cabinet_url(get_request_role(request)),
            "can_assign_packaging": get_request_role(request) in {
                "processing_head",
                "head_manager",
                "director",
                "admin",
            },
        }
        status = request.GET.get("status")
        status_label = cls._processing_home_status_label(status)
        ctx["order_number"] = request.GET.get("order", "")

        client_id = request.GET.get("client") or request.POST.get("client")
        agency_id = request.GET.get("agency") or request.POST.get("agency_id") or request.POST.get("agency")
        agency_key = client_id or agency_id
        client_agency = getattr(request, "_client_agency", None) or processing_views._client_agency_from_request(request)
        agency = client_agency or (processing_views.Agency.objects.filter(pk=agency_key).first() if agency_key else None)
        ctx["agency"] = agency
        ctx["client_view"] = bool(client_agency)
        ctx["draft_order_id"] = ""
        ctx["edit_order_id"] = ""
        ctx["existing_attachments"] = []
        ctx["attachment_order_id"] = ""
        ctx["attachment_retention_days"] = ProcessingOrderAttachment.RETENTION_DAYS
        order_id = request.GET.get("order") or request.POST.get("edit_order_id") or request.POST.get("draft_order_id")
        draft_payload = None
        role = get_request_role(request)
        edit_flag = (request.GET.get("edit") or "").strip().lower()
        edit_mode = edit_flag in {"1", "true", "yes"} and (
            role in {
                "manager",
                "head_manager",
                "director",
                "admin",
            }
            or bool(client_agency)
        )
        if order_id:
            draft_entries = OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            if client_agency:
                draft_entries = draft_entries.filter(agency=client_agency)
            elif agency:
                draft_entries = draft_entries.filter(agency=agency)
            draft_entry = draft_entries.order_by("-created_at").first()
            if draft_entry:
                if client_agency:
                    from client_cabinet.request_ownership import (
                        PORTAL_REQUEST_OWNER_MESSAGE,
                        portal_user_can_edit_request,
                    )

                    if not portal_user_can_edit_request(
                        user=request.user,
                        agency=client_agency,
                        order_type="processing",
                        order_id=order_id,
                        request=request,
                    ):
                        ctx["error"] = PORTAL_REQUEST_OWNER_MESSAGE
                        draft_entry = None
            if draft_entry:
                payload = draft_entry.payload or {}
                is_draft = processing_views._is_draft_payload(payload)
                if is_draft:
                    ctx["draft_order_id"] = order_id
                    draft_payload = payload
                elif edit_mode and (
                    (not client_agency and role in {"manager", "head_manager", "director", "admin"})
                    or (client_agency and processing_client_can_edit(payload) and not processing_is_locked_for_edit(payload))
                ):
                    ctx["edit_order_id"] = order_id
                    draft_payload = payload
        if client_agency and not str(ctx.get("draft_order_id") or "").strip() and not str(ctx.get("edit_order_id") or "").strip():
            from client_cabinet.client_drafts import client_draft_limit_reached, find_client_draft

            existing_draft = find_client_draft(
                agency=client_agency,
                order_type="processing",
                user=request.user,
            )
            if (
                existing_draft
                and existing_draft.get("order_id")
                and client_draft_limit_reached(
                    agency=client_agency,
                    order_type="processing",
                    user=request.user,
                )
            ):
                ctx["draft_order_id"] = existing_draft["order_id"]
                draft_entries = OrderAuditEntry.objects.filter(
                    order_id=existing_draft["order_id"],
                    order_type="processing",
                    agency=client_agency,
                ).order_by("-created_at")
                draft_entry = draft_entries.first()
                if draft_entry:
                    draft_payload = draft_entry.payload or {}
        transient_payload = cls._build_processing_home_transient_payload(request=request) if error else {}
        if transient_payload:
            draft_payload = {
                **(draft_payload or {}),
                **transient_payload,
            }
            posted_draft_order_id = str(request.POST.get("draft_order_id") or "").strip()
            posted_edit_order_id = str(request.POST.get("edit_order_id") or "").strip()
            if posted_edit_order_id:
                ctx["edit_order_id"] = posted_edit_order_id
                ctx["draft_order_id"] = ""
            elif posted_draft_order_id:
                ctx["draft_order_id"] = posted_draft_order_id
        ctx["draft_payload"] = draft_payload or {}
        ctx["client_processing_unit_picker"] = bool(
            client_agency
            and not str(ctx.get("edit_order_id") or "").strip()
            and (
                not str(ctx.get("draft_order_id") or "").strip()
                or bool((draft_payload or {}).get("client_unit_picker_v1"))
            )
        )
        client_sku_options = []
        if agency:
            sku_qs = (
                cls._marketplace_target_sku_queryset(agency)
                .select_related("market")
                .prefetch_related("barcodes", "marketplace_bindings")
                .order_by("sku_code")
            )
            for sku in sku_qs:
                sku_code = str(sku.sku_code or "").strip()
                if not sku_code:
                    continue
                barcodes = []
                primary_barcode = ""
                for barcode in sku.barcodes.all():
                    barcode_value = str(barcode.value or "").strip()
                    if not barcode_value:
                        continue
                    barcodes.append(
                        {
                            "value": barcode_value,
                            "size": str(barcode.size or "").strip(),
                            "primary": bool(barcode.is_primary),
                        }
                    )
                    if barcode.is_primary and not primary_barcode:
                        primary_barcode = barcode_value
                if not primary_barcode and barcodes:
                    primary_barcode = barcodes[0]["value"]
                if not primary_barcode:
                    primary_barcode = str(getattr(sku, "code", "") or "").strip()
                bindings = list(sku.marketplace_bindings.all())
                marketplace = str(bindings[0].marketplace or "").strip() if bindings else ""
                if not marketplace:
                    marketplace = str(getattr(sku.market, "name", "") or "").strip()
                source_reference = str(sku.source_reference or "").strip()
                if not source_reference and bindings:
                    source_reference = str(bindings[0].external_id or "").strip()
                client_sku_options.append(
                    {
                        "id": sku.id,
                        "article": sku_code,
                        "name": str(sku.name or "").strip(),
                        "size": str(sku.size or "").strip(),
                        "barcode": primary_barcode,
                        "barcodes": barcodes,
                        "marketplace": marketplace,
                        "source_reference": source_reference,
                        "photo_url": str(sku.img or "").strip(),
                    }
                )
        ctx["client_sku_options_json"] = json.dumps(client_sku_options, ensure_ascii=True)
        ctx["draft_payload_json"] = json.dumps(draft_payload or {}, ensure_ascii=True)
        exclude_stock_order_id = str(ctx.get("edit_order_id") or ctx.get("draft_order_id") or order_id or "").strip() or None
        stock_rows = processing_views._processing_box_picker_rows(
            agency,
            exclude_order_id=exclude_stock_order_id,
            include_receiving_stock=bool(ctx["client_processing_unit_picker"]),
            separate_boxes=bool(ctx["client_processing_unit_picker"]),
        )
        ctx["stock_rows"] = stock_rows
        ctx["stock_rows_json"] = json.dumps(stock_rows, ensure_ascii=True)
        ctx["stock_available_lines"] = len(stock_rows)
        ctx["stock_available_boxes"] = sum(int(row.get("available_boxes") or 0) for row in stock_rows)
        ctx["stock_available_qty"] = sum(int(row.get("available_qty") or 0) for row in stock_rows)
        ctx["page_title"] = (
            f"Редактирование заявки на обработку №{ctx['edit_order_id']}"
            if ctx.get("edit_order_id")
            else "Новая заявка на обработку"
        )
        ctx["selected_client"] = agency
        if draft_payload:
            payload_status = draft_payload.get("status") or draft_payload.get("submit_action")
            payload_label = str(draft_payload.get("status_label") or "").strip()
            if ctx.get("draft_order_id"):
                status_label = cls._processing_home_status_label(payload_status, payload_label)
            else:
                status_label = processing_stage_label(
                    draft_payload,
                    fallback=cls._processing_home_status_label(payload_status, payload_label),
                )
        elif order_id and agency:
            latest_payload = draft_entry.payload or {} if 'draft_entry' in locals() and draft_entry else {}
            status_label = processing_stage_label(latest_payload, fallback=status_label)
        ctx["status_label"] = processing_views._repair_mojibake_text(status_label).strip() or status_label
        attachment_order_id = str(ctx.get("edit_order_id") or ctx.get("draft_order_id") or "").strip()
        ctx["attachment_order_id"] = attachment_order_id
        if attachment_order_id and agency:
            ctx["existing_attachments"] = list(
                processing_views._active_processing_attachments(attachment_order_id, agency)
            )
        return ctx

