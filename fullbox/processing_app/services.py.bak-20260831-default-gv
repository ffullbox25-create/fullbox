    @classmethod
    def enqueue_processing_print_job(
        cls,
        *,
        request,
        data: dict,
    ) -> ProcessingJsonResult:
        order_id = str(data.get("order_id") or "").strip()
        card_id = str(data.get("card_id") or "").strip()
        performed_for = None
        has_processing_card_context = bool(
            order_id
            and card_id
            and card_id.lower() not in {"box", "pallet"}
            and OrderAuditEntry.objects.filter(
                order_id=order_id,
                order_type="processing",
            ).exists()
        )
        current_processing_card = None
        if has_processing_card_context:
            try:
                performed_for_id = int(data.get("performed_for_id") or 0)
            except (TypeError, ValueError):
                performed_for_id = 0
            route = cls._views()._processing_card_task_route(order_id, card_id)
            if performed_for_id > 0:
                performed_for = Employee.objects.filter(
                    pk=performed_for_id,
                    role="packer",
                    is_active=True,
                ).first()
                if performed_for and not Task.objects.filter(
                    route=route,
                    assigned_to=performed_for,
                ).exists():
                    performed_for = None
            processing_views = cls._views()
            entries = list(
                OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
                .only("payload", "created_at", "id")
                .order_by("created_at", "id")
            )
            current_payload = processing_views._processing_work_payload_from_entries(entries)
            current_processing_card = next(
                (
                    row
                    for row in (current_payload.get("cards") or [])
                    if isinstance(row, dict)
                    and processing_views._processing_card_id(row) == card_id
                ),
                None,
            )
            if not performed_for:
                processed_by_name = str((current_processing_card or {}).get("processed_by") or "").strip()
                if processed_by_name:
                    performed_for = Employee.objects.filter(
                        full_name__iexact=processed_by_name,
                        role="packer",
                        is_active=True,
                    ).first()
            if not performed_for:
                assigned_task = (
                    Task.objects.select_related("assigned_to")
                    .filter(
                        route=route,
                        assigned_to__role="packer",
                        assigned_to__is_active=True,
                    )
                    .order_by("-id")
                    .first()
                )
                performed_for = assigned_task.assigned_to if assigned_task else None
        barcode = str(data.get("barcode") or "").strip()
        if not barcode:
            return ProcessingJsonResult(status="missing_barcode", http_status=400, payload={"ok": False, "error": "Barcode is required"})
        raw_label_list = data.get("label_png_base64_list")
        if raw_label_list is None:
            raw_label_list = data.get("labelPngBase64List")
        label_png_base64_list = []
        if isinstance(raw_label_list, list):
            label_png_base64_list = [
                str(item or "").strip()
                for item in raw_label_list
                if str(item or "").strip()
            ]
        label_png_base64 = str(data.get("label_png_base64") or "").strip()
        if not label_png_base64 and label_png_base64_list:
            label_png_base64 = label_png_base64_list[0]
        if label_png_base64 and not label_png_base64_list:
