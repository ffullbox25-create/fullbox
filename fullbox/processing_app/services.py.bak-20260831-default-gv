    @classmethod
    def _ensure_processing_data_review_task(
        cls,
        *,
        order_id: str,
        card_id: str,
        agency,
        request,
        comment: str,
    ) -> bool:
        assignee = cls._processing_data_review_assignee(order_id=order_id, card_id=card_id)
        if assignee is None:
            return False
        processing_views = cls._views()
        route = processing_views._processing_card_task_route(order_id, card_id)
        title = cls._processing_data_review_task_title(order_id, card_id)
        client_name = (
            getattr(agency, "agn_name", None)
            or getattr(agency, "short_name", None)
            or str(getattr(agency, "id", "") or "")
            or "-"
        )
        description = (
            f"Клиент: {client_name}\n"
            f"Обработчик: {cls._processing_actor_label(request) or '-'}\n"
            f"Расхождение: {comment}"
        )
        task = (
            Task.objects.filter(route=route, title=title, assigned_to=assignee)
            .exclude(status="done")
            .order_by("-id")
            .first()
        )
        if task:
            task.description = description
            task.due_date = timezone.localtime()
            task.save(update_fields=["description", "due_date", "updated_at"])
            return True
        Task.objects.create(
            title=title,
            description=description,
            route=route,
            assigned_to=assignee,
            created_by=request.user if request.user.is_authenticated else None,
            status="backlog",
            priority="high",
            due_date=timezone.localtime(),
        )
        return True

