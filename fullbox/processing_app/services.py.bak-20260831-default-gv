        if not processing_param_key:
            derived_label_key = processing_views._processing_marking_label_key_from_param_key(
                template_meta.get("size_key"),
            )
            if not derived_label_key and str(template_meta.get("mode") or "").strip() == "cz":
                derived_label_key = processing_views.PROCESSING_CZ_LABEL_KEY
            if not derived_label_key:
                derived_label_key = processing_views._processing_marking_label_key_from_dimensions(
                    label_width_mm,
                    label_height_mm,
                )
            if derived_label_key:
                processing_param_key = processing_views._processing_param_key_for_label_key(derived_label_key)
        is_cz_print = bool(
            str(template_meta.get("mode") or "").strip() == "cz"
            or processing_views._processing_marking_label_key_from_param_key(processing_param_key)
            == processing_views.PROCESSING_CZ_LABEL_KEY
        )
        request_path = str(getattr(request, "path", "") or "")
        is_verified_marking_request = request_path.startswith(
            ("/marking/processing/", "/marking/free-print/", "/marking/duplicate/")
        )
        if is_cz_print and not is_verified_marking_request:
            return ProcessingJsonResult(
                status="marking_reservation_required",
                http_status=409,
                payload={
                    "ok": False,
                    "error": (
                        "Печать ЧЗ разрешена только через резервирование реального КИЗ "
                        "в заявке на обработку. Обновите страницу и повторите печать."
                    ),
                },
            )
        article = str(data.get("article") or "").strip()
        label_layout = str(
            template_meta.get("layout_key")
            or template_meta.get("key")
            or template_key
            or ""
        ).strip()
        is_item_label = not label_layout or label_layout in {"item", "item_cz"}
        article_change_status, article_change_target, article_change_error = ("inactive", {}, "")
        if is_item_label:
            article_change_status, article_change_target, article_change_error = cls._processing_article_change_print_target(
                order_id=order_id,
                card_id=card_id,
                article=article,
                size=str(data.get("size") or "").strip(),
            )
        if article_change_status == "invalid":
            return ProcessingJsonResult(
                status="invalid_article_change",
                http_status=409,
                payload={"ok": False, "error": article_change_error},
            )
        if article_change_status == "active" and is_item_label:
            expected_article = str(article_change_target.get("article") or "").strip()
            expected_barcode = str(article_change_target.get("barcode") or "").strip()
            if article.casefold() != expected_article.casefold() or barcode != expected_barcode:
                return ProcessingJsonResult(
                    status="article_change_target_mismatch",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": (
                            f"Для замены артикула разрешена печать только артикула Б "
                            f"{expected_article} со штрихкодом {expected_barcode}."
                        ),
                    },
                )
            article = expected_article
            barcode = expected_barcode
        try:
            copies = int(data.get("copies") or 1)
        except (TypeError, ValueError):
            copies = 1
        copies = max(1, copies)
        label_images = label_png_base64_list or [label_png_base64]
        queued_count = copies * max(1, len(label_images))
        declared_qty = 0
        if has_processing_card_context and is_cz_print:
            declared_qty = sum(
                cls._positive_int(row.get("qty") or row.get("recount_qty") or row.get("processing_qty"))
                for row in ((current_processing_card or {}).get("rows") or [])
                if isinstance(row, dict)
            )
            if declared_qty > 0:
                printed_scope = ProcessingPrintJob.objects.filter(
                    order_id=order_id,
                    card_id=card_id,
                    status__in=[
                        ProcessingPrintJob.STATUS_PENDING,
                        ProcessingPrintJob.STATUS_PRINTING,
                        ProcessingPrintJob.STATUS_PRINTED,
                    ],
                )
                if processing_param_key:
                    printed_scope = printed_scope.filter(processing_param_key=processing_param_key)
                elif template_key:
                    printed_scope = printed_scope.filter(template_key=template_key)
                else:
                    printed_scope = printed_scope.filter(
                        label_width_mm=label_width_mm,
                        label_height_mm=label_height_mm,
                    )
                already_requested = ProcessingPrintJob.total_copies(printed_scope)
                if already_requested + queued_count > declared_qty:
                    return ProcessingJsonResult(
                        status="label_quantity_exceeded",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": (
                                "Количество этикеток превышает заявленное по товарной карте. "
                                f"Заявлено: {declared_qty}, уже отправлено: {already_requested}, "
                                f"сейчас запрошено: {queued_count}."
                            ),
                            "declared_qty": declared_qty,
                            "already_requested": already_requested,
                            "requested_now": queued_count,
                            "remaining": max(declared_qty - already_requested, 0),
                        },
                    )
        requested_agent = str(data.get("agent_id") or "").strip()
        resolved_agent = requested_agent or cls._resolve_print_agent_for_printer(
            str(data.get("printer_name") or "").strip()
        )
        common_job_kwargs = {
            "order_id": order_id,
            "card_id": card_id,
            "article": article,
            "barcode": barcode,
            "size": str(data.get("size") or "").strip(),
            "printer_name": str(data.get("printer_name") or "").strip(),
            "copies_count": copies,
            "template_key": template_key,
            "processing_param_key": processing_param_key,
            "label_width_mm": label_width_mm,
            "label_height_mm": label_height_mm,
            "requested_by": (
                f"packer:{performed_for.id}:{performed_for.full_name}"[:150]
                if performed_for
                else (request.user.username if request.user.is_authenticated else "")
            ),
            "agent": resolved_agent,
        }
        with transaction.atomic():
            if has_processing_card_context and is_cz_print and declared_qty > 0:
                OrderAuditEntry.objects.select_for_update().filter(
                    order_id=order_id,
                    order_type="processing",
                ).order_by("-created_at", "-id").first()
                locked_scope = ProcessingPrintJob.objects.filter(
                    order_id=order_id,
                    card_id=card_id,
                    status__in=[
                        ProcessingPrintJob.STATUS_PENDING,
                        ProcessingPrintJob.STATUS_PRINTING,
                        ProcessingPrintJob.STATUS_PRINTED,
                    ],
                )
                if processing_param_key:
                    locked_scope = locked_scope.filter(processing_param_key=processing_param_key)
                elif template_key:
                    locked_scope = locked_scope.filter(template_key=template_key)
                else:
                    locked_scope = locked_scope.filter(
                        label_width_mm=label_width_mm,
                        label_height_mm=label_height_mm,
                    )
                locked_requested = ProcessingPrintJob.total_copies(locked_scope)
                if locked_requested + queued_count > declared_qty:
                    return ProcessingJsonResult(
                        status="label_quantity_exceeded",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": (
                                "Количество этикеток превышает заявленное по товарной карте. "
                                f"Заявлено: {declared_qty}, уже отправлено: {locked_requested}, "
                                f"сейчас запрошено: {queued_count}."
                            ),
                            "declared_qty": declared_qty,
                            "already_requested": locked_requested,
                            "requested_now": queued_count,
                            "remaining": max(declared_qty - locked_requested, 0),
                        },
                    )
            job = ProcessingPrintJob.objects.create(
                **{**common_job_kwargs, "copies_count": queued_count},
                label_png_base64=label_images[0],
                label_png_base64_list=label_images,
            )
        job_ids = [int(job.id)]
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "job_id": int(job.id),
                "job_ids": job_ids,
                "queued_count": queued_count,
                "label_count": max(1, len(label_images)),
                "agent_id": resolved_agent,
                "performed_for": performed_for.full_name if performed_for else "",
            },
        )

    @staticmethod
    def _resolve_print_agent_targets(agent_name: str) -> list[str]:
        value = str(agent_name or "").strip()
        if not value:
            return []
        targets: list[str] = [value]
        try:
            from agent.models import DeviceAgent

            agent = (
                DeviceAgent.objects.filter(
                    Q(agent_id=value) | Q(name=value) | Q(host=value)
                )
                .order_by("-last_seen", "-updated_at")
                .first()
            )
            if agent:
                for candidate in (agent.agent_id, agent.name, agent.host):
                    text = str(candidate or "").strip()
                    if text and text not in targets:
                        targets.append(text)
                # Desktop may keep the same physical workstation while its agent
                # id changes after reinstall/update (for example
                # ``desktop-comp027`` -> ``desktop:desktop-comp027-2``).  Jobs
                # addressed to the old id must remain available to that same host,
                # but never to an unrelated workstation.
                host = str(agent.host or "").strip().lower()
                if host:
                    for alias in (host, f"desktop-{host}", f"desktop:desktop-{host}"):
                        if alias not in targets:
                            targets.append(alias)
        except Exception:
            pass
        return targets

    @staticmethod
    def _resolve_print_agent_for_printer(printer_name: str) -> str:
        value = str(printer_name or "").strip().lower()
        if not value:
            return ""
        try:
            from agent.models import DeviceAgent

            online_since = timezone.now() - timedelta(seconds=60)
            candidates = list(
                DeviceAgent.objects.filter(last_seen__gte=online_since).order_by("-last_seen", "-updated_at")
            )
            if not candidates:
                candidates = list(DeviceAgent.objects.order_by("-last_seen", "-updated_at")[:10])
            for agent in candidates:
                meta = agent.meta if isinstance(agent.meta, dict) else {}
                printer_names: list[str] = list(agent_printer_names_from_meta(meta))
                raw_details = meta.get("printer_details")
                if isinstance(raw_details, list):
                    printer_names.extend(
                        str((item or {}).get("name") or "").strip()
                        for item in raw_details
                        if isinstance(item, dict)
                    )
                if any(str(name or "").strip().lower() == value for name in printer_names if str(name or "").strip()):
                    return str(agent.agent_id or agent.name or agent.host or "").strip()
        except Exception:
            return ""
        return ""

    @classmethod
    def _scoped_print_jobs_qs(cls, *, agent_name: str = "", statuses: list[str] | tuple[str, ...] | None = None):
        qs = ProcessingPrintJob.objects.all()
        if statuses:
            qs = qs.filter(status__in=list(statuses))
        targets = cls._resolve_print_agent_targets(agent_name)
        if targets:
            qs = qs.filter(agent__in=targets)
        return qs

