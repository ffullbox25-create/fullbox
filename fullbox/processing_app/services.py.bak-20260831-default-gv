    @staticmethod
    def _aggregate_processing_display_rows(rows: list, *, processing_views) -> list[dict]:
        aggregated_rows: list[dict] = []
        rows_by_key: dict[tuple[str, ...], dict] = {}
        for index, raw_row in enumerate(rows or []):
            if not isinstance(raw_row, dict):
                continue
            row = dict(raw_row)
            qty_value = row.get("qty")
            if qty_value in (None, ""):
                qty_value = row.get("recount_qty")
            if qty_value in (None, ""):
                qty_value = row.get("processing_qty")
            qty = processing_views._parse_qty_value(qty_value)
            identity = (
                str(row.get("result_article") or row.get("article") or row.get("sku") or "").strip().casefold(),
                str(row.get("source_article") or row.get("article") or row.get("sku") or "").strip().casefold(),
                str(row.get("result_product_name") or row.get("product_name") or row.get("name") or "").strip().casefold(),
                str(row.get("size") or row.get("size_value") or row.get("size_no") or "").strip().casefold(),
                str(row.get("result_barcode") or row.get("barcode") or row.get("barcode_value") or "").strip().casefold(),
                str(row.get("source_barcode") or row.get("barcode") or row.get("barcode_value") or "").strip().casefold(),
                str(row.get("goods_type") or "").strip().casefold(),
            )
            key = identity if qty is not None else (*identity, str(index))
            source_box_codes = list(row.get("source_box_codes") or [])
            raw_box_codes = row.get("box_codes") or []
            if isinstance(raw_box_codes, (list, tuple, set)):
                source_box_codes.extend(str(code or "").strip() for code in raw_box_codes)
            raw_box_code = str(row.get("box_code") or "").strip()
            if raw_box_code:
                source_box_codes.append(raw_box_code)
            source_box_codes = list(dict.fromkeys(code for code in source_box_codes if code))
            existing = rows_by_key.get(key)
            if existing is None:
                if qty is not None:
                    row["qty"] = qty
                row["source_row_count"] = int(row.get("source_row_count") or 1)
                row["source_box_codes"] = source_box_codes
                row["source_box_count"] = len(source_box_codes)
                rows_by_key[key] = row
                aggregated_rows.append(row)
                continue
            existing["qty"] = int(processing_views._parse_qty_value(existing.get("qty")) or 0) + int(qty or 0)
            existing["source_row_count"] = int(existing.get("source_row_count") or 1) + int(
                row.get("source_row_count") or 1
            )
            existing_codes = list(existing.get("source_box_codes") or [])
            for code in source_box_codes:
                if code and code not in existing_codes:
                    existing_codes.append(code)
            existing["source_box_codes"] = existing_codes
            existing["source_box_count"] = len(existing_codes)
        return aggregated_rows

