            item
            for item in timeline
            if str(item.get("description") or "").strip()
            and str(item.get("status") or "").strip().lower() in {"comment", "комментарий"}
        ]
        if not comments and payload.get("comments"):
            comments = [
                {
                    "actor_short": cls._work_short_name(current_user),
                    "description": repaired(payload.get("comments") or ""),
                    "time": "",
                    "initials": cls._work_initials(current_user),
                }
            ]

        return {
            "work_current_user": current_user,
            "work_current_user_initials": cls._work_initials(current_user),
            "work_order_details": {
                "client": repaired(client_label),
                "product": repaired(product_name),
                "article": repaired(article),
                "barcode": barcode,
                "size": size,
                "total_qty": cls._work_items_total_qty(payload),
                "supplier": repaired(payload.get("supplier") or payload.get("vendor") or "-"),
                "brand": repaired(payload.get("brand") or "-"),
                "subject": repaired(payload.get("subject") or payload.get("category") or "-"),
            },
            "work_participants": participants,
            "work_summary_params": params,
            "work_timeline": timeline,
            "work_comments": comments[:4],
        }

    @classmethod
    def build_processing_work_page_context(cls, *, order_id, entries, payload, agency, request, error: str | None = None) -> dict:
        processing_views = cls._views()
        ctx: dict = {}
        work_payload = dict(payload or {})
        marking_qty_map = processing_views._processing_marking_qty_by_label_key(work_payload)
        marking_each_qty_value = marking_qty_map.get(processing_views.PROCESSING_CZ_LABEL_KEY, 0)
        printed_cz_base_qs = None
        if order_id and marking_each_qty_value:
            printed_cz_base_qs = MarkingCode.objects.filter(
                order_type="processing",
                order_id=order_id,
                printed_at__isnull=False,
            )
            if agency:
                printed_cz_base_qs = printed_cz_base_qs.filter(agency=agency)

        cards_payload = work_payload.get("cards")
        if isinstance(cards_payload, list) and cards_payload:
            enriched_cards = []
            for raw_card in cards_payload:
                if not isinstance(raw_card, dict):
                    enriched_cards.append(raw_card)
                    continue
                card_payload = cls._strip_processing_card_legacy_fields(raw_card)
                card_rows = card_payload.get("rows") if isinstance(card_payload.get("rows"), list) else []
                card_scope_id = processing_views._processing_card_id(card_payload)
                card_set_summary = processing_views._processing_set_assembly_summary(
                    work_payload,
                    card_ids={card_scope_id} if card_scope_id else None,
                )
                if not card_set_summary["active"]:
                    card_rows = cls._aggregate_processing_display_rows(
                        card_rows,
                        processing_views=processing_views,
                    )
                    card_payload["rows"] = card_rows
                card_payload["printed_cz_total"] = cls._printed_cz_total_for_rows(printed_cz_base_qs, card_rows)
                for option in processing_views.PROCESSING_MARKING_LABELS:
                    card_payload[option["field"]] = marking_qty_map.get(option["label_key"], 0)
                card_payload["marking_5840_each_qty"] = marking_each_qty_value
                enriched_cards.append(card_payload)
            work_payload["cards"] = cls._annotate_processing_cards_delivery_state(
                order_id=str(order_id or ""),
                agency=agency,
                cards_payload=enriched_cards,
                processing_views=processing_views,
            )
        else:
            fallback_rows = work_payload.get("stock_rows") if isinstance(work_payload.get("stock_rows"), list) else []
            work_payload["printed_cz_total"] = cls._printed_cz_total_for_rows(printed_cz_base_qs, fallback_rows)
            for option in processing_views.PROCESSING_MARKING_LABELS:
                work_payload[option["field"]] = marking_qty_map.get(option["label_key"], 0)
            work_payload["marking_5840_each_qty"] = marking_each_qty_value
        payload = work_payload

        ctx["submitted"] = False
        ctx["draft_saved"] = False
        raw_error = error or request.GET.get("error")
        ctx["cabinet_url"] = resolve_cabinet_url(get_request_role(request))
        ctx["order_number"] = order_id or ""
        ctx["agency"] = agency
        ctx["client_view"] = False
        ctx["draft_order_id"] = ""
        ctx["edit_order_id"] = ""
        ctx["draft_payload"] = payload
        ctx["draft_payload_json"] = json.dumps(payload or {}, ensure_ascii=True)
        delivery_cards = [
            card
            for card in (payload.get("cards") or [])
            if isinstance(card, dict)
        ]
        ctx["processing_delivery_completed"] = bool(delivery_cards) and all(
            bool(card.get("delivery_ready"))
            for card in delivery_cards
        )
        processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
            order_id=str(order_id or ""),
            agency=agency,
            payload=payload,
        )
        warehouse_status_label = ""
        if processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES:
            warehouse_status_label = processing_result.label_for("processing")
        ctx["status_label"] = (
            warehouse_status_label
            or processing_stage_label(payload, fallback="Обработка товара")
            or "Обработка товара"
        )
        ctx["processing_attachments"] = list(processing_views._active_processing_attachments(order_id, agency))
        ctx["attachment_retention_days"] = ProcessingOrderAttachment.RETENTION_DAYS

        processed_cards, placed_cards = processing_views._processing_card_sets(payload)
        ready_cards = processing_views._processing_flow_ready_cards(payload)
        cards_total_count = processing_views._processing_cards_total(payload)
        cards_done_count = len(processed_cards)
        all_cards_processed = cards_total_count <= 0 or cards_done_count >= cards_total_count
        results_ready_for_flow = processing_views._processing_results_are_ready(payload, include_shipping=False)
        results_ready_card_ids = processing_views._processing_results_ready_card_ids(payload, include_shipping=False)
        cards_payload_for_flags = payload.get("cards")
        if isinstance(cards_payload_for_flags, list):
            for card in cards_payload_for_flags:
                if not isinstance(card, dict):
                    continue
                card_key = processing_views._processing_card_id(card).strip().lower()
                card["results_ready_for_flow"] = bool(card_key and card_key in results_ready_card_ids)
        results = payload.get("processing_results") or []
        has_ready_results = False
        if isinstance(results, list):
            for row in results:
                if not isinstance(row, dict):
                    continue
                processed_qty = processing_views._parse_qty_value(row.get("processed")) or 0
                shipped_qty = processing_views._parse_qty_value(row.get("shipped_qty")) or 0
                if processed_qty - shipped_qty > 0:
                    has_ready_results = True
                    break
        ctx["can_place_processed"] = bool(ready_cards) or has_ready_results
        ctx["processed_cards_count"] = len(processed_cards)
        ctx["placed_cards_count"] = len(placed_cards)
        ctx["ready_cards_count"] = len(ready_cards)
        ctx["processing_cards_total_count"] = cards_total_count
        ctx["processing_cards_done_count"] = cards_done_count
        ctx["processing_all_cards_processed"] = all_cards_processed
        ctx["processing_results_ready_for_flow"] = results_ready_for_flow
        ctx["processing_results_ready_card_ids"] = sorted(results_ready_card_ids)
        placement_entry = processing_views._processing_placement_entry(entries)
        placement_payload = placement_entry.payload if placement_entry else {}
        processing_quantity_summary = processing_views._processing_quantity_summary(
            payload,
            placement_payload,
        )
        ctx["processing_quantity_summary"] = processing_quantity_summary
        processing_quantity_discrepancy_rows = processing_views._processing_discrepancy_rows(
            payload,
            placement_payload,
        )
        for row in processing_quantity_discrepancy_rows:
            expected_qty = int(row.get("expected_qty") or 0)
            factual_qty = int(row.get("factual_qty") or 0)
            row["missing_qty"] = max(expected_qty - factual_qty, 0)
            row["extra_qty"] = max(factual_qty - expected_qty, 0)
        ctx["processing_quantity_discrepancy_rows"] = processing_quantity_discrepancy_rows
        ctx["processing_processed_entered"] = any(
            isinstance(row, dict)
            and processing_views._parse_qty_value(row.get("processed")) is not None
            for row in (payload.get("processing_results") or [])
        )
        ctx["processing_set_summary"] = processing_views._processing_set_assembly_summary(payload)
        placement_boxes = placement_payload.get("act_boxes") or []
        placement_pallets = placement_payload.get("act_pallets") or []
        if not isinstance(placement_boxes, list):
            placement_boxes = []
        if not isinstance(placement_pallets, list):
            placement_pallets = []
        ctx["processing_service_metrics"] = {
            **processing_quantity_summary,
            "boxes_count": len(
                {
                    str(box.get("code") or "").strip()
                    for box in placement_boxes
                    if isinstance(box, dict) and str(box.get("code") or "").strip()
                }
            ),
            "pallets_count": len(
                {
                    str(pallet.get("code") or "").strip()
                    for pallet in placement_pallets
                    if isinstance(pallet, dict) and str(pallet.get("code") or "").strip()
                }
            ),
        }
        ctx["processing_manual_params"] = processing_views._processing_manual_params_from_payload(payload)
        ctx.update(
            cls._build_work_summary_context(
                entries=entries,
                payload=payload,
                agency=agency,
                request=request,
            )
        )

        marking_items = extract_processing_items(payload)
        counts = (
            MarkingCode.objects.filter(order_type="processing", order_id=order_id, used_at__isnull=False)
            .values("sku_code", "size")
            .annotate(count=Count("id"))
        )
        counts_map = {(item["sku_code"], item["size"] or ""): item["count"] for item in counts}
        total_count = 0
        for item in marking_items:
            key = (item["sku_code"], item["size"] or "")
            scanned = counts_map.get(key, 0)
            expected = item.get("qty") or 0
            item["scanned"] = scanned
            item["remaining"] = max(expected - scanned, 0)
            total_count += scanned
        ctx["marking_items"] = marking_items
        ctx["marking_total_count"] = total_count
        ctx["marking_api_base"] = f"/marking/processing/{order_id}/"
        packaging_role = get_request_role(request)
        ctx["can_assign_packaging"] = packaging_role in {
            "processing_head",
            "head_manager",
            "director",
            "admin",
        }
        keep_source_boxes_mode = (
            str(payload.get(cls.PROCESSING_PACKAGING_MODE_KEY) or "").strip().lower()
            == cls.PROCESSING_PACKAGING_MODE_KEEP_SOURCE_BOXES
        )
        keep_source_boxes_details = payload.get(cls.PROCESSING_KEEP_SOURCE_BOXES_KEY)
        keep_source_boxes_details = (
            dict(keep_source_boxes_details)
            if isinstance(keep_source_boxes_details, dict)
            else {}
        )
        keep_source_boxes_plan = {"ok": False, "error": ""}
        keep_source_boxes_placement_completed = bool(
            processing_views._flow_closed_from_entries(entries)
        )
        if ctx["can_assign_packaging"] and not keep_source_boxes_placement_completed:
            keep_source_boxes_plan = cls._keep_source_boxes_plan(
                order_id=str(order_id or ""),
                entries=entries,
                payload=payload,
            )
        ctx["keep_source_boxes_mode"] = keep_source_boxes_mode
        ctx["keep_source_boxes_details"] = keep_source_boxes_details
        ctx["keep_source_boxes_box_codes"] = list(
            keep_source_boxes_details.get("source_box_codes") or []
        )
        ctx["can_keep_source_boxes"] = bool(
            ctx["can_assign_packaging"]
            and not keep_source_boxes_placement_completed
            and (keep_source_boxes_mode or keep_source_boxes_plan.get("ok"))
        )
        ctx["keep_source_boxes_error"] = str(
            keep_source_boxes_plan.get("error") or ""
        ).strip()
        ctx["keep_source_boxes_status"] = str(
            request.GET.get("keep_boxes") or ""
        ).strip().lower()
        ctx["processing_workers"] = list(
            Employee.objects.filter(
                role="processing_worker",
                is_active=True,
                user__isnull=False,
                user__is_active=True,
            )
            .only("id", "full_name")
            .order_by("full_name")
        )
        ctx["processing_packers"] = list(
            Employee.objects.filter(
                role="packer",
                is_active=True,
            )
            .only("id", "full_name")
            .order_by("full_name")
        )
        role = get_request_role(request)
        actor = get_request_employee(request)
        has_assigned_head_task = bool(
            actor
            and Task.objects.filter(
                route=f"/orders/processing/{order_id}/",
                assigned_to=actor,
            )
            .exclude(status="done")
            .exists()
        )
        cancel_is_prestart = bool(
            not processing_is_in_work(payload)
            and processing_result.code not in cls._PROCESSING_WAREHOUSE_STARTED_CODES
        )
        ctx["can_processing_head_cancel"] = bool(
            role == "processing_head"
            and has_assigned_head_task
            and cancel_is_prestart
            and not processing_is_cancelled(payload)
            and not processing_is_done(payload)
            and not cls.processing_warehouse_cancel_request_payload(entries)
        )
        ctx["processing_cancel_error"] = str(
            getattr(request, "_processing_cancel_error", "") or ""
        ).strip()
        ctx["can_assign_processing_cards"] = role in {
            "processing_head",
            "head_manager",
            "director",
            "admin",
        }
        processing_card_assignments: dict[str, list[dict]] = {}
        card_task_prefix = f"/orders/processing/{order_id}/card/"
        for task in (
            Task.objects.select_related("assigned_to")
            .filter(
                route__startswith=card_task_prefix,
                assigned_to__role="packer",
            )
            .exclude(status="done")
            .order_by("route", "assigned_to__full_name", "id")
        ):
            assigned_card_id = processing_views._processing_card_task_card_id(
                task.route,
                str(order_id),
            )
            if not assigned_card_id or not task.assigned_to_id:
                continue
            assignments = processing_card_assignments.setdefault(assigned_card_id, [])
            if any(item["assignee_id"] == task.assigned_to_id for item in assignments):
                continue
            assignments.append({
                "task_id": task.id,
                "assignee_id": task.assigned_to_id,
                "assignee_name": task.assigned_to.full_name if task.assigned_to else "",
                "status": task.status,
            })
        ctx["processing_card_assignments_json"] = json.dumps(
            processing_card_assignments,
            ensure_ascii=True,
        )
        work_assignments = cls._processing_work_assignments(payload)
        ctx["processing_work_assignments"] = work_assignments
        ctx["processing_work_assignment_open_count"] = sum(
            1 for row in work_assignments if str(row.get("status") or "").strip().lower() == "assigned"
        )
        ctx["processing_operation_options"] = cls._processing_operation_options(payload)
        ctx["card_assign_status"] = str(request.GET.get("card_assign") or "").strip()
        ctx["card_assign_error"] = str(request.GET.get("card_assign_error") or "").strip()
        ctx["work_fact_status"] = str(request.GET.get("work_fact") or "").strip()
        ctx["work_fact_error"] = str(request.GET.get("work_fact_error") or "").strip()
        assign_status = request.GET.get("assign")
        assign_error = request.GET.get("assign_error")
        finish_checks = processing_views._processing_finish_checks(str(order_id), payload, entries)
        current_processing_stage = processing_stage_from_payload(payload)
        quality_review = (
            dict(payload.get("quality_review"))
            if isinstance(payload.get("quality_review"), dict)
            else {}
        )
        quality_review_status = str(quality_review.get("status") or "").strip().lower()
        quality_review_stages = {
            PROCESSING_STAGE_UNBOXING_COMPLETED,
            PROCESSING_STAGE_QUALITY_CONTROL,
        }
        ctx["processing_stage"] = current_processing_stage
        ctx["quality_review"] = quality_review
        ctx["quality_status"] = str(request.GET.get("quality") or "").strip().lower()
        ctx["quality_can_review"] = bool(
            role in {"processing_head", "head_manager", "director", "admin"}
            and current_processing_stage in quality_review_stages
        )
        ctx["quality_can_return"] = ctx["quality_can_review"]
        ctx["quality_is_rework"] = current_processing_stage == PROCESSING_STAGE_REWORK
        ctx["quality_is_approved"] = bool(
            current_processing_stage == PROCESSING_STAGE_QUALITY_APPROVED
            or quality_review_status == "approved"
        )
        discrepancy_status = str(payload.get("discrepancy_status") or "").strip().lower()
        stock_discrepancy = next(
            (
                dict(row)
                for row in (payload.get("discrepancy_items") or [])
                if isinstance(row, dict)
                and str(row.get("discrepancy_type") or "").strip().lower()
                == "processing_stock_balance"
            ),
            {},
        )
        ctx["processing_discrepancy_requires_approval"] = bool(
            discrepancy_status == "reported" and stock_discrepancy
        )
        ctx["processing_stock_discrepancy"] = stock_discrepancy
        ctx["quality_card_options"] = [
            {
                "id": processing_views._processing_card_id(card),
                "article": str(card.get("article") or "").strip(),
                "product_name": str(card.get("product_name") or card.get("name") or "").strip(),
            }
            for card in (payload.get("cards") or [])
            if isinstance(card, dict) and processing_views._processing_card_id(card)
        ]
        placement_completed = bool(
            processing_views._flow_closed_from_entries(entries) or finish_checks.get("placement_closed")
        )
        ctx["placement_completed"] = placement_completed
        ctx["placement_change_url"] = f"/orders/processing/{order_id}/flow/"
        flow_view = processing_views.ProcessingFlowView()
        can_open_processing_flow = bool(
            order_id
            and not placement_completed
            and flow_view._can_start(entries)
        )
        can_complete_processing_flow = bool(
            order_id
            and not placement_completed
            and flow_view._can_complete(entries)
        )
        processing_flow_blockers: list[str] = []
        if not can_open_processing_flow:
            if cards_total_count > 0 and not ready_cards:
                processing_flow_blockers.append(
                    "Для начала формирования коробов завершите хотя бы одну товарную карту "
                    "и заполните её результаты."
                )
            else:
                processing_flow_blockers.append(
                    "Нет готового обработанного товара для формирования коробов."
                )
        ctx["processing_flow_blockers"] = processing_flow_blockers
        ctx["can_open_processing_flow"] = can_open_processing_flow
        ctx["can_complete_processing_flow"] = can_complete_processing_flow
        ctx["error"] = "" if ctx["can_open_processing_flow"] else processing_views._repair_mojibake_text(raw_error or "")
        pending_packaging_assignment, auto_assign_status = processing_views._processing_auto_dispatch_pending_packaging(
            order_id=str(order_id),
            entries=entries,
            can_open_processing_flow=bool(ctx["can_open_processing_flow"]),
            placement_completed=placement_completed,
        )
        if auto_assign_status == "auto_dispatched" and not assign_status:
            assign_status = "auto_dispatched"
        if auto_assign_status in {"invalid_worker", "worker_cabinet_missing"} and not assign_error:
            assign_error = auto_assign_status
        ctx["assign_status"] = assign_status
        ctx["assign_error"] = assign_error
        ctx["pending_packaging_assignment"] = pending_packaging_assignment
        packaging_tasks = list(
            Task.objects.select_related("assigned_to")
            .filter(
                route=processing_views._processing_packaging_task_route(str(order_id)),
                assigned_to__role="processing_worker",
            )
            .exclude(status__in=("done", "blocked"))
            .order_by("-created_at")
        )
        ctx["packaging_tasks"] = packaging_tasks
        not_received_card_ids = {
            processing_views._processing_card_id(card)
            for card in (payload.get("cards") or [])
            if isinstance(card, dict)
            and processing_views._processing_card_is_not_received(card)
            and processing_views._processing_card_id(card)
        }
        card_ids = [
            processing_views._processing_card_id(card)
            for card in (payload.get("cards") or [])
            if isinstance(card, dict)
            and processing_views._processing_card_id(card)
            and processing_views._processing_card_id(card) not in not_received_card_ids
        ]
        subzone_state = build_processing_subzone_state(
            card_ids=card_ids,
            processed_card_ids={
                card_id for card_id in processed_cards if card_id not in not_received_card_ids
            },
            assigned_card_ids=processing_card_assignments,
            stage=processing_stage_from_payload(payload),
            packaging_active=bool(packaging_tasks),
            placement_completed=placement_completed,
        )
        card_subzones = subzone_state["cards"]
        for card in payload.get("cards") or []:
            if not isinstance(card, dict):
                continue
            card_id = processing_views._processing_card_id(card)
            card["operational_subzone"] = card_subzones.get(card_id, {})
        ctx["processing_subzone"] = subzone_state["current"]
        ctx["processing_subzone_steps"] = subzone_state["steps"]
        ctx["processing_subzone_counts"] = subzone_state["counts"]
        ctx["processing_card_subzones"] = card_subzones
        ctx["draft_payload_json"] = json.dumps(payload or {}, ensure_ascii=True)
        finish_blockers = finish_checks.get("blockers") or []
        finish_hard_blockers = finish_checks.get("hard_blockers") or []
        warehouse_move_progress = finish_checks.get("warehouse_move_progress") or {}
        placement_payload = finish_checks.get("placement_payload") or {}
        placement_pallets = placement_payload.get("act_pallets") or []
        if not isinstance(placement_pallets, list):
            placement_pallets = []
        suggested_destinations = {}
        if placement_pallets:
            suggested_destinations = processing_views._suggest_processing_warehouse_destinations(
                placement_pallets,
                exclude_order_type="processing",
                exclude_order_id=str(order_id),
                agency_id=int(agency.id) if agency and agency.id else None,
            )
        warehouse_move_rows = cls._build_processing_warehouse_move_rows(
            placement_pallets=placement_pallets,
            suggested_destinations=suggested_destinations,
            warehouse_move_progress=warehouse_move_progress,
        )
        ctx["finish_blockers"] = finish_blockers
        ctx["finish_ready"] = bool(ctx["quality_is_approved"] and not finish_blockers)
        ctx["finish_action_ready"] = bool(ctx["quality_is_approved"] and not finish_hard_blockers)
        ctx["finish_services_confirmed"] = bool(finish_checks.get("service_facts_confirmed"))
        ctx["warehouse_move_progress"] = warehouse_move_progress
        ctx["warehouse_total_pallets"] = int(warehouse_move_progress.get("total_pallets") or 0)
        ctx["warehouse_done_pallets"] = int(warehouse_move_progress.get("done_count") or 0)
        ctx["warehouse_created_pallets"] = int(warehouse_move_progress.get("created_count") or 0)
        ctx["warehouse_in_progress_pallets"] = int(warehouse_move_progress.get("in_progress_count") or 0)
        ctx["warehouse_active_pallets"] = int(warehouse_move_progress.get("active_count") or 0)
        ctx["warehouse_canceled_pallets"] = int(warehouse_move_progress.get("canceled_count") or 0)
        ctx["warehouse_not_created_pallets"] = int(warehouse_move_progress.get("not_created_count") or 0)
        ctx["warehouse_pending_pallets"] = int(warehouse_move_progress.get("pending_count") or 0)
        ctx["warehouse_assigned_pallets"] = max(0, ctx["warehouse_total_pallets"] - ctx["warehouse_not_created_pallets"])
        ctx["warehouse_move_rows"] = warehouse_move_rows
        ctx["warehouse_destination_summary"] = cls._warehouse_destination_summary(
            warehouse_move_rows,
            canceled_count=ctx["warehouse_canceled_pallets"],
            not_created_count=ctx["warehouse_not_created_pallets"],
        )
        ctx["warehouse_move_created"] = bool(finish_checks.get("warehouse_move_created"))
        ctx["warehouse_move_completed"] = bool(finish_checks.get("warehouse_move_completed"))
        warehouse_commit = payload.get(cls.PROCESSING_WAREHOUSE_COMMIT_KEY)
        warehouse_commit = dict(warehouse_commit) if isinstance(warehouse_commit, dict) else {}
        warehouse_commit_approved = (
            str(warehouse_commit.get("status") or "").strip().lower() == "approved"
        )
        ctx["processing_warehouse_commit"] = warehouse_commit
        ctx["processing_warehouse_commit_approved"] = warehouse_commit_approved
        ctx["can_send_to_warehouse_action"] = bool(
            role in {"storekeeper", "processing_head"}
            and ctx["quality_is_approved"]
            and warehouse_commit_approved
            and finish_checks.get("placement_closed")
            and not finish_checks.get("warehouse_move_completed")
            and any(bool(row.get("selectable")) for row in warehouse_move_rows)
        )
        ctx["can_cancel_warehouse_action"] = bool(
            role in {"storekeeper", "processing_head"}
            and finish_checks.get("placement_closed")
            and not finish_checks.get("warehouse_move_completed")
            and int(warehouse_move_progress.get("active_count") or 0) > 0
        )
        ctx["warehouse_move_status"] = (request.GET.get("warehouse_move") or "").strip().lower()
        ctx["warehouse_move_created_count"] = processing_views._parse_int_value(request.GET.get("warehouse_created")) or 0
        ctx["warehouse_move_skipped_count"] = processing_views._parse_int_value(request.GET.get("warehouse_skipped")) or 0
        ctx["warehouse_move_missing_count"] = processing_views._parse_int_value(request.GET.get("warehouse_missing")) or 0
        ctx["warehouse_move_canceled_count"] = processing_views._parse_int_value(request.GET.get("warehouse_canceled")) or 0
        return ctx

    @classmethod
    def send_processing_to_warehouse(cls, *, order_id: str, entries, request) -> ProcessingWarehouseMoveActionResult:
        processing_views = cls._views()
        order_key = str(order_id or "").strip()
        if not order_key or not entries:
            return ProcessingWarehouseMoveActionResult(
                status="not_ready",
                error_message="Заявка на обработку не найдена.",
            )
        destinations, parse_error = processing_views._parse_processing_warehouse_destinations(
            request.POST.get("warehouse_destinations_json")
        )
        if destinations is None:
            return ProcessingWarehouseMoveActionResult(
                status="invalid_destination",
                error_message=parse_error or "Проверьте выбранные места хранения.",
            )
        latest_payload = dict(processing_views._processing_work_payload_from_entries(entries))
        finish_checks = processing_views._processing_finish_checks(order_key, latest_payload, entries)
        if not finish_checks.get("placement_closed"):
            return ProcessingWarehouseMoveActionResult(
                status="not_ready",
                error_message="Сначала завершите обработку и формирование коробов и палет.",
            )
        quality_review = latest_payload.get("quality_review")
        quality_review = dict(quality_review) if isinstance(quality_review, dict) else {}
        warehouse_commit = latest_payload.get(cls.PROCESSING_WAREHOUSE_COMMIT_KEY)
        warehouse_commit = dict(warehouse_commit) if isinstance(warehouse_commit, dict) else {}
        quality_approved = bool(
            processing_stage_from_payload(latest_payload) == PROCESSING_STAGE_QUALITY_APPROVED
            or str(quality_review.get("status") or "").strip().lower() == "approved"
        )
        if not quality_approved or str(warehouse_commit.get("status") or "").strip().lower() != "approved":
            return ProcessingWarehouseMoveActionResult(
                status="not_ready",
                error_message="Перемещение доступно только после подтверждения результата руководителем обработки.",
            )
        created, skipped_existing, skipped_missing = processing_views._create_processing_warehouse_moves(
            order_key,
            entries,
            request,
            destinations_by_pallet=destinations,
        )
        if created > 0:
            status = "ok"
        elif skipped_existing > 0 and skipped_missing <= 0:
            status = "exists"
        elif skipped_missing > 0 and skipped_existing <= 0:
            status = "missing_destination"
        elif skipped_existing > 0 and skipped_missing > 0:
            status = "blocked"
        else:
            status = "not_ready"
        return ProcessingWarehouseMoveActionResult(
            status=status,
            error_message=(
                ""
                if status == "ok"
                else "Новые задания ричтракеру не созданы. Проверьте палеты и места хранения."
            ),
            created_count=created,
            skipped_existing_count=skipped_existing,
            skipped_missing_count=skipped_missing,
        )

    @classmethod
    def cancel_processing_warehouse_moves(cls, *, order_id: str, entries, request) -> ProcessingWarehouseMoveActionResult:
        processing_views = cls._views()
        canceled, skipped = processing_views._cancel_processing_warehouse_moves(str(order_id), entries, request)
        if canceled <= 0:
            return ProcessingWarehouseMoveActionResult(
                status="cancel_none",
                canceled_count=0,
                skipped_count=skipped,
            )
        return ProcessingWarehouseMoveActionResult(
            status="canceled",
            canceled_count=canceled,
            skipped_count=skipped,
        )

    @classmethod
    def _processing_head_cancel_guard(
        cls,
        *,
        order_id: str,
        agency,
        payload: dict,
    ) -> dict:
        order_key = str(order_id or "").strip()
        reasons: list[str] = []
        stage = processing_stage_from_payload(payload)

        if processing_is_in_work(payload):
            reasons.append("заявка уже взята в работу")

        processing_result = WarehouseGoodsStateResolver.resolve_for_processing_order(
            order_id=order_key,
            agency=agency,
            payload=payload,
        )
        if processing_result.code in cls._PROCESSING_WAREHOUSE_STARTED_CODES:
            reasons.append("складской контур уже зафиксировал движение товара")

        reserve_qs = WarehouseReserve.objects.filter(
            Q(context_type="processing", context_id=order_key)
            | Q(source_document_type="processing", source_document_id=order_key)
        )
        reserve_totals = reserve_qs.aggregate(
            allocated=Sum("qty_allocated"),
            satisfied=Sum("qty_satisfied"),
        )
        if int(reserve_totals.get("allocated") or 0) > 0 or int(
            reserve_totals.get("satisfied") or 0
        ) > 0:
            reasons.append("резерв уже распределен или частично выполнен")

        operation_count = WarehouseOperation.objects.filter(
            Q(context_type="processing", context_id=order_key)
            | Q(source_document_type="processing", source_document_id=order_key)
        ).exclude(status__in={"canceled", "cancelled", "released"}).count()
        event_count = WarehouseEvent.objects.filter(
            Q(stock_context_type="processing", stock_context_id=order_key)
            | Q(source_document_type="processing", source_document_id=order_key)
        ).count()
        snapshot_count = WarehouseStockSnapshot.objects.filter(
            source_context_type="processing",
            source_context_id=order_key,
            is_archived=False,
        ).count()
        container_count = WarehouseContainer.objects.filter(
            source_context_type="processing",
            source_context_id=order_key,
        ).exclude(status=WarehouseContainer.STATUS_ARCHIVED).count()
        inventory_count = InventoryState.objects.filter(
            order_type="processing",
            order_id=order_key,
            qty__gt=0,
        ).count()
        pallet_state_count = StockPalletState.objects.filter(
            order_type="processing",
            order_id=order_key,
            qty__gt=0,
        ).count()
        flow_session_count = ProcessingFlowSession.objects.filter(
            order_type="processing",
            order_id=order_key,
        ).exclude(flow_state={}).count()
        marking_scan_count = MarkingCode.objects.filter(
            order_type="processing",
            order_id=order_key,
            used_at__isnull=False,
        ).count()

        physical_counts = {
            "operations": operation_count,
            "events": event_count,
            "snapshots": snapshot_count,
            "containers": container_count,
            "inventory": inventory_count,
            "pallet_states": pallet_state_count,
            "flow_sessions": flow_session_count,
            "marking_scans": marking_scan_count,
        }
        if any(physical_counts.values()):
            reasons.append("обнаружены физические результаты или незавершенные складские операции")

        latest_move_entries: dict[str, OrderAuditEntry] = {}
        for entry in (
            OrderAuditEntry.objects.filter(
                order_type="stock_move",
                payload__processing_order_id=order_key,
            )
            .only("order_id", "payload", "created_at", "id")
            .order_by("order_id", "created_at", "id")
        ):
            latest_move_entries[str(entry.order_id)] = entry
        created_move_count = 0
        blocking_move_count = 0
        for entry in latest_move_entries.values():
            move_status = str(
                (entry.payload or {}).get("status")
                or (entry.payload or {}).get("submit_action")
                or ""
            ).strip().lower()
            if move_status == "created":
                created_move_count += 1
            elif move_status not in {"", "canceled", "cancelled", "rejected"}:
                blocking_move_count += 1
        if blocking_move_count:
            reasons.append("задание на перемещение уже принято или выполнено ричтракером")

        processed_qty = 0
        for row in payload.get("processing_results") or []:
            if not isinstance(row, dict):
                continue
            try:
                processed_qty += max(0, int(row.get("processed") or 0))
            except (TypeError, ValueError):
                continue
        if processed_qty:
            reasons.append("в заявке уже указано обработанное количество")

        return {
            "allowed": not reasons,
            "reasons": list(dict.fromkeys(reasons)),
            "created_move_count": created_move_count,
            "blocking_move_count": blocking_move_count,
            "physical_counts": physical_counts,
            "reserve_count": reserve_qs.count(),
            "reserve_allocated": int(reserve_totals.get("allocated") or 0),
            "reserve_satisfied": int(reserve_totals.get("satisfied") or 0),
            "stage": stage,
            "warehouse_state": str(processing_result.code.value),
        }

    @classmethod
    @transaction.atomic
    def cancel_processing_by_head(
        cls,
        *,
        order_id: str,
        request,
    ) -> ProcessingDetailActionResult:
        order_key = str(order_id or "").strip()
        redirect_to = f"/orders/processing/{order_key}/work/"
        if get_request_role(request) != "processing_head":
            return ProcessingDetailActionResult(
                status="forbidden",
                redirect_to=redirect_to,
                error_message="Отменить заявку может только руководитель обработки.",
            )
        actor = get_request_employee(request)
        if actor is None or actor.role != "processing_head" or not actor.is_active:
            return ProcessingDetailActionResult(
                status="forbidden",
                redirect_to=redirect_to,
                error_message="Активный профиль руководителя обработки не найден.",
            )

        reason_code = str(
            request.POST.get("processing_cancel_reason") or "created_by_mistake"
        ).strip().lower()
        reason_label = cls.PROCESSING_HEAD_CANCEL_REASON_LABELS.get(reason_code)
        reason_comment = str(
            request.POST.get("processing_cancel_comment") or "Заявка больше не требуется"
        ).strip()[:1000]
        if not reason_label:
            return ProcessingDetailActionResult(
                status="cancel_reason_required",
                redirect_to=redirect_to,
                error_message="Не удалось определить причину отмены.",
            )

        entries = list(
            OrderAuditEntry.objects.select_for_update()
            .filter(order_id=order_key, order_type="processing")
            .order_by("created_at", "id")
        )
        if not entries:
            return ProcessingDetailActionResult(
                status="missing_order",
                redirect_to="/orders/",
                error_message="Заявка на обработку не найдена.",
            )
        latest = entries[-1]
        payload = dict(cls._views()._processing_work_payload_from_entries(entries))
        if processing_is_cancelled(payload) or processing_is_done(payload):
            return ProcessingDetailActionResult(
                status="already_closed",
                redirect_to=f"/orders/processing/{order_key}/",
            )
        if cls.processing_warehouse_cancel_request_payload(entries):
            return ProcessingDetailActionResult(
                status="cancel_blocked",
                redirect_to=redirect_to,
                error_message="По заявке уже ожидается решение по отмене. Завершите текущую процедуру согласования.",
            )

        assigned_task = (
            Task.objects.select_for_update()
            .filter(
                route=f"/orders/processing/{order_key}/",
                assigned_to=actor,
            )
            .exclude(status="done")
            .first()
        )
        if assigned_task is None:
            return ProcessingDetailActionResult(
                status="forbidden",
                redirect_to=redirect_to,
                error_message="Заявка не назначена текущему руководителю обработки.",
            )

        guard = cls._processing_head_cancel_guard(
            order_id=order_key,
            agency=latest.agency,
            payload=payload,
        )
        if not guard["allowed"]:
            return ProcessingDetailActionResult(
                status="cancel_blocked",
                redirect_to=redirect_to,
                error_message=(
                    "Автоматическая отмена заблокирована: "
                    + "; ".join(guard["reasons"])
                    + ". Сначала оформите возврат фактически перемещенного товара."
                ),
            )

        move_result = cls.cancel_processing_warehouse_moves(
            order_id=order_key,
            entries=entries,
            request=request,
        )
        if move_result.canceled_count < int(guard.get("created_move_count") or 0):
            transaction.set_rollback(True)
            return ProcessingDetailActionResult(
                status="cancel_blocked",
                redirect_to=redirect_to,
                error_message="Не все задания ричтрактера можно отменить. Проверьте их состояние и повторите.",
            )

        if latest.agency_id:
            WarehouseWritePathService.replace_processing_reserves(
                agency=latest.agency,
                order_id=order_key,
                items=[],
                created_by=request.user if request.user.is_authenticated else None,
            )

        cancel_reason = f"{reason_label}. {reason_comment}"
        canceled_payload = apply_processing_stage(
            payload,
            PROCESSING_STAGE_CANCELLED,
            status_value="cancelled",
        )
        canceled_payload.update(
            {
                "submit_action": "cancelled",
                "status_label": "Отменена",
                "cancel_reason": cancel_reason,
                "cancel_reason_code": reason_code,
                "cancelled_by": "processing_head",
                "cancelled_by_employee_id": actor.id,
                "cancelled_by_name": actor.full_name,
                "cancelled_at": timezone.localtime().isoformat(),
                "processing_head_cancel_guard": guard,
            }
        )
        log_order_action(
            "status",
            order_id=order_key,
            order_type="processing",
            user=request.user if request.user.is_authenticated else None,
            agency=latest.agency,
            description=f"Заявка отменена руководителем обработки. Причина: {cancel_reason}",
            payload=canceled_payload,
        )
        task_ids = list(
            Task.objects.filter(route__startswith=f"/orders/processing/{order_key}/")
            .values_list("id", flat=True)
        )
        cls._set_task_status(Task.objects.filter(id__in=task_ids), "done")

        def _mark_cancelled_snapshots():
            TaskPanelSnapshot.objects.filter(task_id__in=task_ids).update(
                task_status="done",
                order_status_label="Отменена",
                order_status_tone="danger",
                is_hidden=False,
            )

        transaction.on_commit(_mark_cancelled_snapshots)
        return ProcessingDetailActionResult(
            status="cancelled",
            redirect_to=(
                "/processing-head/requests/?tab=ready&period=all"
                f"&processing_cancelled={order_key}"
            ),
        )

    @staticmethod
    def _quality_due_at(raw_value: str):
        due_at = parse_datetime(str(raw_value or "").strip())
        if due_at is None:
            return None
        if timezone.is_naive(due_at):
            due_at = timezone.make_aware(due_at, timezone.get_current_timezone())
        return due_at

    @classmethod
    def review_processing_quality(
        cls,
        *,
        order_id: str,
        entries,
        request,
        role: str,
    ) -> ProcessingQualityActionResult:
        if role not in {"processing_head", "head_manager", "director", "admin"}:
            return ProcessingQualityActionResult(status="forbidden", error_message="Доступ запрещён.")
        action = str(request.POST.get("action") or "").strip().lower()
        if action not in {"approve_quality", "return_to_rework"}:
            return ProcessingQualityActionResult(status="invalid_action", error_message="Неизвестное действие проверки.")
        processing_views = cls._views()
        with transaction.atomic():
            locked_entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=order_id, order_type="processing")
                .select_related("agency")
                .order_by("created_at", "id")
            )
            if not locked_entries:
                return ProcessingQualityActionResult(status="invalid_order", error_message="Заявка не найдена.")
            # A concurrent approval may have inserted a new audit snapshot while this
            # transaction waited for the existing order rows. Refresh on a new
            # READ COMMITTED snapshot before deciding whether warehouse write-path
            # work is still required.
            locked_entries = list(
                OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
                .select_related("agency")
                .order_by("created_at", "id")
            )
            latest = locked_entries[-1]
            payload = dict(processing_views._processing_work_payload_from_entries(locked_entries))
            stage = processing_stage_from_payload(payload)
            quality_review = (
                dict(payload.get("quality_review"))
                if isinstance(payload.get("quality_review"), dict)
                else {}
            )
            if stage == PROCESSING_STAGE_QUALITY_APPROVED or str(quality_review.get("status") or "").lower() == "approved":
                return ProcessingQualityActionResult(status="already_approved")
            if stage == PROCESSING_STAGE_REWORK:
                return ProcessingQualityActionResult(
                    status="rework_active",
                    error_message="Дождитесь завершения назначенной доработки.",
                )
            if stage == PROCESSING_STAGE_UNBOXING_COMPLETED:
                logged, payload = log_processing_stage(
                    order_id=order_id,
                    payload=payload,
                    stage=PROCESSING_STAGE_QUALITY_CONTROL,
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency,
                    description="Результат обработки передан на проверку качества",
                    extra_payload={
                        "quality_review": {
                            **quality_review,
                            "status": "pending",
                            "submitted_at": timezone.localtime().isoformat(),
                        }
                    },
                )
                if not logged:
                    return ProcessingQualityActionResult(
                        status="invalid_stage",
                        error_message="Не удалось открыть проверку качества.",
                    )
                quality_review = dict(payload.get("quality_review") or {})
                stage = PROCESSING_STAGE_QUALITY_CONTROL
            if stage != PROCESSING_STAGE_QUALITY_CONTROL:
                return ProcessingQualityActionResult(
                    status="invalid_stage",
                    error_message="Действие доступно только на этапе проверки качества.",
                )

            actor_name = ""
            if request.user and request.user.is_authenticated:
                actor_name = (
                    request.user.get_full_name().strip()
                    or request.user.username
                    or str(request.user)
                )
            now_iso = timezone.localtime().isoformat()
            card_ids = [
                processing_views._processing_card_id(card)
                for card in (payload.get("cards") or [])
                if isinstance(card, dict) and processing_views._processing_card_id(card)
            ]

            if action == "approve_quality":
                checklist_fields = {
                    "quantity": "Количество заявлено / обработано / в коробах",
                    "processing": "Техническое задание выполнено",
                    "marking": "Маркировка и Честный знак проверены",
                    "packaging": "Короба и палеты проверены",
                }
                checklist = {
                    key: str(request.POST.get(f"quality_{key}_checked") or "").strip().lower()
                    in {"1", "true", "on", "yes"}
                    for key in checklist_fields
                }
                missing_items = [
                    label for key, label in checklist_fields.items() if not checklist.get(key)
                ]
                if missing_items:
                    return ProcessingQualityActionResult(
                        status="checklist_incomplete",
                        error_message="Подтвердите все пункты проверки качества.",
                    )
                finish_checks = processing_views._processing_finish_checks(
                    str(order_id),
                    payload,
                    locked_entries,
                )
                hard_blockers = list(finish_checks.get("hard_blockers") or [])
                open_work_assignments = [
                    row
                    for row in cls._processing_work_assignments(payload)
                    if str(row.get("status") or "").strip().lower() == "assigned"
                ]
                if open_work_assignments:
                    hard_blockers.append(
                        "Сначала внесите фактический результат по всем назначенным упаковщицам."
                    )
                if hard_blockers:
                    return ProcessingQualityActionResult(
                        status="blocked",
                        error_message="Проверка не пройдена: " + " ".join(hard_blockers),
                    )
                discrepancy_status = str(payload.get("discrepancy_status") or "").strip().lower()
                if role == "processing_head" and discrepancy_status == "reported":
                    payload["discrepancy_status"] = "approved_pending_warehouse"
                    payload["discrepancy_approved_at"] = now_iso
                    payload["status_label"] = "Разногласия утверждены — ожидается складская проводка"
                    if actor_name:
                        payload["discrepancy_approved_by"] = actor_name
                    log_order_action(
                        "status",
                        order_id=order_id,
                        order_type="processing",
                        user=request.user if request.user.is_authenticated else None,
                        agency=latest.agency,
                        description="Разногласия утверждены при проверке качества; ожидается складская проводка",
                        payload=payload,
                    )
                    log_order_action(
                        "update",
                        order_id=order_id,
                        order_type="processing",
                        user=request.user if request.user.is_authenticated else None,
                        agency=latest.agency,
                        description="Разногласия по обработке утверждены руководителем обработки",
                        payload={
                            "act": "processing_discrepancy_approval",
                            "order_id": str(order_id),
                            "approved_at": now_iso,
                            "approved_during": "quality_control",
                            "discrepancy_items": payload.get("discrepancy_items") or [],
                        },
                    )
                committed, commit_error = cls._commit_processing_result_after_head_approval(
                    order_id=str(order_id),
                    payload=payload,
                    entries=locked_entries,
                    request=request,
                    role=role,
                )
                if not committed:
                    return ProcessingQualityActionResult(
                        status="warehouse_commit_failed",
                        error_message=(
                            "Складской результат не зафиксирован. "
                            + (commit_error or "Проверьте остаток в OBR и повторите подтверждение.")
                        ),
                    )
                quality_review = {
                    **quality_review,
                    "status": "approved",
                    "checklist": checklist,
                    "comment": str(request.POST.get("quality_comment") or "").strip()[:4000],
                    "approved_at": now_iso,
                    "approved_by": actor_name,
                }
                payload["quality_review"] = quality_review
                processing_act = payload.get(cls.PROCESSING_ACT_KEY)
                processing_act = dict(processing_act) if isinstance(processing_act, dict) else {}
                processing_act["status"] = "confirmed"
                processing_act["confirmation_policy"] = "quality_control"
                processing_act["manager_response"] = "not_required"
                processing_act["client_response"] = "read_only"
                processing_act["confirmed_at"] = (
                    processing_act.get("confirmed_at") or now_iso
                )
                processing_act["confirmed_by"] = (
                    processing_act.get("confirmed_by")
                    or cls._processing_actor_label(request)
                )
                payload[cls.PROCESSING_ACT_KEY] = processing_act
                payload["status_label"] = "Обработка подтверждена контролем качества"
                apply_processing_cards_subzone(payload, card_ids, PROCESSING_SUBZONE_OUT)
                logged, _next_payload = log_processing_stage(
                    order_id=order_id,
                    payload=payload,
                    stage=PROCESSING_STAGE_QUALITY_APPROVED,
                    user=request.user if request.user.is_authenticated else None,
                    agency=latest.agency,
                    description="Проверка качества пройдена",
                )
                if not logged:
                    transaction.set_rollback(True)
                    return ProcessingQualityActionResult(status="already_approved")
                placement_pallets = finish_checks.get("placement_payload", {}).get("act_pallets") or []
                automatic_destinations = {
                    str(pallet.get("code") or "").strip(): {
                        "zone": "OS",
                        "row": "",
                        "section": "",
                        "tier": "",
                        "cell": "",
                    }
                    for pallet in placement_pallets
                    if isinstance(pallet, dict) and str(pallet.get("code") or "").strip()
                }
                if automatic_destinations:
                    created_moves, skipped_moves, missing_moves = (
                        processing_views._create_processing_warehouse_moves(
                            str(order_id),
                            locked_entries,
                            request,
                            destinations_by_pallet=automatic_destinations,
                        )
                    )
                    if created_moves or skipped_moves or missing_moves:
                        log_order_action(
                            "update",
                            order_id=order_id,
                            order_type="processing",
                            user=request.user if request.user.is_authenticated else None,
                            agency=latest.agency,
                            description=(
                                "После подтверждения обработки созданы задания ричтракеру: "
                                f"{created_moves}; ранее созданы: {skipped_moves}; "
                                f"требуют проверки: {missing_moves}."
                            ),
                            payload={
                                "processing_warehouse_move_auto": {
                                    "created": created_moves,
                                    "skipped": skipped_moves,
                                    "missing": missing_moves,
                                    "created_at": now_iso,
                                }
                            },
                        )
                return ProcessingQualityActionResult(status="approved")

            reason = str(request.POST.get("rework_reason") or "").strip()
            comment = str(request.POST.get("rework_comment") or "").strip()
            employee_id = str(request.POST.get("rework_assignee_id") or "").strip()
            due_at = cls._quality_due_at(request.POST.get("rework_due_at") or "")
            selected_card_ids = {
                str(card_id or "").strip()
                for card_id in request.POST.getlist("rework_card_ids")
                if str(card_id or "").strip()
            }
            if not reason:
                return ProcessingQualityActionResult(
                    status="missing_reason",
                    error_message="Укажите причину возврата на доработку.",
                )
            if not comment:
                return ProcessingQualityActionResult(
                    status="missing_comment",
                    error_message="Добавьте комментарий для исполнителя.",
                )
            assignee = Employee.objects.filter(
                pk=employee_id,
                role="packer",
                is_active=True,
            ).first()
            if not assignee:
                return ProcessingQualityActionResult(
                    status="invalid_worker",
                    error_message="Выберите активную упаковщицу.",
                )
            if due_at is None or due_at <= timezone.now():
                return ProcessingQualityActionResult(
                    status="invalid_due_at",
                    error_message="Укажите будущий срок исправления.",
                )
            valid_card_ids = set(card_ids)
            if not selected_card_ids:
                return ProcessingQualityActionResult(
                    status="missing_cards",
                    error_message="Выберите товарные карты для доработки.",
                )
            if not selected_card_ids.issubset(valid_card_ids):
                return ProcessingQualityActionResult(
                    status="invalid_cards",
                    error_message="В заявке найдены неизвестные товарные карты.",
                )

            cycle = max(0, int(quality_review.get("cycle") or 0)) + 1
            actor = get_request_employee(request)
            processed_cards = [
                str(card_id or "").strip()
                for card_id in (payload.get("processed_cards") or [])
                if str(card_id or "").strip() and str(card_id or "").strip() not in selected_card_ids
            ]
            payload["processed_cards"] = processed_cards
            for card in payload.get("cards") or []:
                if not isinstance(card, dict):
                    continue
                card_id = processing_views._processing_card_id(card)
                if card_id not in selected_card_ids:
                    continue
                card["last_processed_at"] = card.get("processed_at") or ""
                card["last_processed_by"] = card.get("processed_by") or ""
                card.pop("processed_at", None)
                card.pop("processed_by", None)
                card.pop("processed_done", None)
                card.pop("processed", None)
                card["rework_required"] = True
                card["rework_cycle"] = cycle
                card["rework_reason"] = reason
                card["rework_comment"] = comment
                apply_processing_card_subzone(payload, card_id, PROCESSING_SUBZONE_WORK)
                article = str(card.get("article") or card_id).strip()
                route = processing_views._processing_card_task_route(order_id, card_id)
                existing_tasks = list(
                    Task.objects.select_for_update()
                    .filter(route=route)
                    .order_by("-updated_at", "-id")
                )
                task = existing_tasks[0] if existing_tasks else None
                duplicate_task_ids = [duplicate.id for duplicate in existing_tasks[1:]]
                if duplicate_task_ids:
                    Task.objects.filter(id__in=duplicate_task_ids).update(
                        status="done",
                        updated_at=timezone.localtime(),
                    )
                title = f"Доработать {article} по заявке №{order_id}"[:255]
                description = (
                    f"Причина: {reason} · Комментарий: {comment} · "
                    f"Цикл доработки: {cycle}"
                )
                if task:
                    task.title = title
                    task.description = description
                    task.assigned_to = assignee
                    task.observer = actor if actor and actor.id != assignee.id else None
                    task.created_by = request.user if request.user.is_authenticated else None
                    task.status = "backlog"
                    task.priority = "high"
                    task.due_date = due_at
                    task.save(
                        update_fields=[
                            "title",
                            "description",
                            "assigned_to",
                            "observer",
                            "created_by",
                            "status",
                            "priority",
                            "due_date",
                            "updated_at",
                        ]
                    )
                else:
                    task = Task.objects.create(
                        title=title,
                        description=description,
                        route=route,
                        assigned_to=assignee,
                        observer=actor if actor and actor.id != assignee.id else None,
                        created_by=request.user if request.user.is_authenticated else None,
                        status="backlog",
                        priority="high",
                        due_date=due_at,
                    )

            performer_map = payload.get("processing_card_performers") or {}
            if not isinstance(performer_map, dict):
                performer_map = {}
            performer_map = dict(performer_map)
            for selected_card_id in selected_card_ids:
                performer_map[selected_card_id] = [
                    {"id": assignee.id, "name": assignee.full_name}
                ]
            payload["processing_card_performers"] = performer_map
            quality_review = {
                **quality_review,
                "status": "rework",
                "cycle": cycle,
                "reason": reason,
                "comment": comment[:4000],
                "rework_card_ids": sorted(selected_card_ids),
                "assignee_id": assignee.id,
                "assignee_name": assignee.full_name,
                "due_at": due_at.isoformat(),
                "returned_at": now_iso,
                "returned_by": actor_name,
            }
            payload["quality_review"] = quality_review
            logged, _next_payload = log_processing_stage(
                order_id=order_id,
                payload=payload,
                stage=PROCESSING_STAGE_REWORK,
                user=request.user if request.user.is_authenticated else None,
                agency=latest.agency,
                description=f"Результат возвращён на доработку: {reason}",
            )
            if not logged:
                return ProcessingQualityActionResult(
                    status="invalid_stage",
                    error_message="Не удалось вернуть заявку на доработку.",
                )
            return ProcessingQualityActionResult(status="rework")

    @classmethod
    def _resubmit_quality_after_rework(cls, *, order_id: str, request) -> bool:
        processing_views = cls._views()
        with transaction.atomic():
            entries = list(
                OrderAuditEntry.objects.select_for_update(of=("self",))
                .filter(order_id=order_id, order_type="processing")
                .select_related("agency")
                .order_by("created_at", "id")
            )
            if not entries:
                return False
            payload = dict(processing_views._processing_work_payload_from_entries(entries))
            if processing_stage_from_payload(payload) != PROCESSING_STAGE_REWORK:
                return False
            quality_review = (
                dict(payload.get("quality_review"))
                if isinstance(payload.get("quality_review"), dict)
                else {}
            )
            rework_card_ids = {
                str(card_id or "").strip()
                for card_id in (quality_review.get("rework_card_ids") or [])
                if str(card_id or "").strip()
            }
            if not rework_card_ids:
                return False
            open_tasks = Task.objects.filter(
                route__in=[
                    processing_views._processing_card_task_route(order_id, card_id)
                    for card_id in rework_card_ids
                ]
            ).exclude(status="done")
            if open_tasks.exists():
                return False
            processed_cards, _placed_cards = processing_views._processing_card_sets(payload)
            if not rework_card_ids.issubset(processed_cards):
                return False
            for card in payload.get("cards") or []:
                if not isinstance(card, dict):
                    continue
                card_id = processing_views._processing_card_id(card)
                if card_id not in rework_card_ids:
                    continue
                card.pop("rework_required", None)
                apply_processing_card_subzone(payload, card_id, PROCESSING_SUBZONE_QC)
            payload["quality_review"] = {
                **quality_review,
                "status": "pending_recheck",
                "resubmitted_at": timezone.localtime().isoformat(),
                "resubmitted_by": (
                    request.user.get_full_name().strip()
                    or request.user.username
                    or str(request.user)
                )
                if request.user and request.user.is_authenticated
                else "",
            }
            logged, _next_payload = log_processing_stage(
                order_id=order_id,
                payload=payload,
                stage=PROCESSING_STAGE_QUALITY_CONTROL,
                user=request.user if request.user.is_authenticated else None,
                agency=entries[-1].agency,
                description="Доработка завершена, результат повторно передан на проверку качества",
            )
            return logged

