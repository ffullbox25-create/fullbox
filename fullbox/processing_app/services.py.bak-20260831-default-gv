    @classmethod
    def get_processing_flow_shared_state(
        cls,
        *,
        order_id: str,
        include_integrity: bool = True,
        purge_canceled: bool = True,
    ) -> ProcessingFlowSharedResult:
        if purge_canceled:
            cls.purge_canceled_processing_boxes_from_open_sessions(
                order_id=str(order_id),
            )
        sessions = list(
            ProcessingFlowSession.objects.filter(
                order_id=order_id,
                order_type="processing",
                status=ProcessingFlowSession.STATUS_OPEN,
            )
        )
        processing_views = cls._views()
        boxes_data, pallets_data = processing_views._merge_flow_sessions(sessions) if sessions else ([], [])
        if not boxes_data and not pallets_data:
            entries = list(
                OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing").order_by("created_at")
            )
            reopened = any((entry.payload or {}).get("flow_reopened") for entry in entries or [])
            if reopened:
                placement_entry = next(
                    (entry for entry in reversed(entries) if (entry.payload or {}).get("act") == "placement"),
                    None,
                )
                if placement_entry:
                    placement_payload = placement_entry.payload or {}
                    placement_boxes = placement_payload.get("act_boxes") or []
                    placement_pallets = placement_payload.get("act_pallets") or []
                    if isinstance(placement_boxes, list):
                        boxes_data = placement_boxes
                    if isinstance(placement_pallets, list):
                        pallets_data = placement_pallets
        flow_state, _ = cls.strip_canceled_processing_boxes_from_flow_state(
            {"boxes": boxes_data, "pallets": pallets_data},
            cls.canceled_processing_box_codes(order_id=str(order_id)),
        )
        flow_integrity = cls.build_processing_flow_integrity(
            order_id=str(order_id),
            flow_state=flow_state,
            include_database=include_integrity,
        )
        return ProcessingFlowSharedResult(
            status="ok",
            flow_state=flow_state,
            flow_integrity=flow_integrity,
        )

    @classmethod
    def confirm_processing_flow_legacy_barcode(
        cls,
        *,
        order_id: str,
        request,
        payload: dict | None = None,
    ) -> ProcessingJsonResult:
        processing_views = cls._views()
        if not processing_views._processing_flow_has_write_access(request, str(order_id or "")):
            return ProcessingJsonResult(
                status="forbidden",
                http_status=403,
                payload={"ok": False, "error": "processing_assignment_required"},
            )
        data = payload if isinstance(payload, dict) else processing_views._parse_json_body(request)
        if data is None:
            return ProcessingJsonResult(
                status="invalid_json",
                http_status=400,
                payload={"ok": False, "error": "invalid_json"},
            )
        barcode = cls._normalize_processing_stock_barcode(data.get("barcode"))
        raw_targets = data.get("targets") if isinstance(data.get("targets"), list) else []
        if not barcode:
            return ProcessingJsonResult(
                status="missing_barcode",
                http_status=400,
                payload={"ok": False, "error": "missing_barcode", "message": "Сканируйте ШК товара."},
            )
        if not raw_targets or len(raw_targets) > 500:
            return ProcessingJsonResult(
                status="missing_targets",
                http_status=400,
                payload={"ok": False, "error": "missing_targets"},
            )

        entries = list(
            OrderAuditEntry.objects.filter(order_id=str(order_id), order_type="processing")
            .select_related("agency")
            .order_by("created_at", "id")
        )
        if not entries:
            return ProcessingJsonResult(
                status="missing_order",
                http_status=404,
                payload={"ok": False, "error": "missing_order"},
            )
        if processing_views._flow_closed_from_entries(entries):
            return ProcessingJsonResult(
                status="flow_closed",
                http_status=409,
                payload={"ok": False, "error": "flow_closed"},
            )

        fact_payload = processing_views._processing_work_payload_from_entries(entries)
        ready_cards = processing_views._processing_flow_ready_cards(fact_payload)
        fact_items = cls._processing_fact_items_by_barcode(
            payload=fact_payload,
            card_ids=ready_cards if ready_cards else None,
        )
        expected_by_barcode: dict[str, dict] = {}
        for item in fact_items:
            expected_barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
            expected_qty = processing_views._parse_qty_value(item.get("actual_qty")) or 0
            if not expected_barcode or expected_qty <= 0:
                continue
            entry = expected_by_barcode.setdefault(
                expected_barcode,
                {"qty": 0, "barcode": str(item.get("barcode") or "").strip()},
            )
            entry["qty"] += expected_qty
        expected = expected_by_barcode.get(barcode)
        if not expected:
            return ProcessingJsonResult(
                status="barcode_mismatch",
                http_status=409,
                payload={
                    "ok": False,
                    "error": "barcode_mismatch",
                    "message": f"ШК {str(data.get('barcode') or '').strip()} не соответствует подтвержденному факту заявки.",
                },
            )

        now = timezone.localtime()
        confirmed_qty = 0
        confirmed_box_codes: list[str] = []
        with transaction.atomic():
            sessions = list(
                ProcessingFlowSession.objects.select_for_update()
                .filter(
                    order_id=str(order_id),
                    order_type="processing",
                    status=ProcessingFlowSession.STATUS_OPEN,
                )
                .order_by("id")
            )
            if not sessions:
                return ProcessingJsonResult(
                    status="missing_session",
                    http_status=409,
                    payload={"ok": False, "error": "missing_session"},
                )

            session_states: dict[int, dict] = {}
            box_locations: dict[str, list[tuple[ProcessingFlowSession, dict, dict]]] = {}
            assigned_by_barcode: dict[str, int] = {}
            for session in sessions:
                state = processing_views._sanitize_flow_state_for_session(session.flow_state, session)
                session_states[session.id] = state
                for box in state.get("boxes") or []:
                    if not isinstance(box, dict):
                        continue
                    box_code = str(box.get("code") or "").strip()
                    if box_code:
                        box_locations.setdefault(box_code, []).append((session, state, box))
                    for item in box.get("items") or []:
                        if not isinstance(item, dict):
                            continue
                        item_qty = processing_views._parse_qty_value(item.get("qty")) or 0
                        item_barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
                        if item_qty > 0 and item_barcode:
                            assigned_by_barcode[item_barcode] = (
                                assigned_by_barcode.get(item_barcode, 0) + item_qty
                            )

            pending_updates: list[tuple[ProcessingFlowSession, dict]] = []
            changed_session_ids: set[int] = set()
            seen_targets: set[tuple[str, int]] = set()
            for raw_target in raw_targets:
                if not isinstance(raw_target, dict):
                    return ProcessingJsonResult(
                        status="invalid_target",
                        http_status=400,
                        payload={"ok": False, "error": "invalid_target"},
                    )
                box_code = str(raw_target.get("box_code") or "").strip()
                item_index = processing_views._parse_int_value(raw_target.get("item_index"))
                target_qty = processing_views._parse_qty_value(raw_target.get("qty")) or 0
                target_key = (box_code, item_index)
                if not box_code or item_index < 0 or target_qty <= 0 or target_key in seen_targets:
                    return ProcessingJsonResult(
                        status="invalid_target",
                        http_status=400,
                        payload={"ok": False, "error": "invalid_target"},
                    )
                seen_targets.add(target_key)
                locations = box_locations.get(box_code) or []
                if len(locations) != 1:
                    return ProcessingJsonResult(
                        status="state_conflict",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": "state_conflict",
                            "message": f"Короб {box_code} изменился. Обновите страницу.",
                        },
                    )
                session, _state, box = locations[0]
                items = box.get("items") if isinstance(box.get("items"), list) else []
                if item_index >= len(items) or not isinstance(items[item_index], dict):
                    return ProcessingJsonResult(
                        status="state_conflict",
                        http_status=409,
                        payload={"ok": False, "error": "state_conflict"},
                    )
                item = items[item_index]
                current_qty = processing_views._parse_qty_value(item.get("qty")) or 0
                current_barcode = cls._normalize_processing_stock_barcode(item.get("barcode"))
                if current_qty != target_qty or current_barcode:
                    return ProcessingJsonResult(
                        status="state_conflict",
                        http_status=409,
                        payload={
                            "ok": False,
                            "error": "state_conflict",
                            "message": "Состав старого короба изменился. Обновите страницу и повторите скан.",
                        },
                    )
                pending_updates.append((session, item))
                changed_session_ids.add(session.id)
                confirmed_qty += current_qty
                if box_code not in confirmed_box_codes:
                    confirmed_box_codes.append(box_code)

            available_qty = int(expected.get("qty") or 0) - int(assigned_by_barcode.get(barcode) or 0)
            if confirmed_qty <= 0 or confirmed_qty > available_qty:
                return ProcessingJsonResult(
                    status="barcode_qty_exceeded",
                    http_status=409,
                    payload={
                        "ok": False,
                        "error": "barcode_qty_exceeded",
                        "message": (
                            f"По ШК {str(data.get('barcode') or '').strip()} можно подтвердить "
                            f"не более {max(available_qty, 0)} шт., выбрано {confirmed_qty} шт."
                        ),
                    },
                )

            canonical_barcode = str(expected.get("barcode") or data.get("barcode") or "").strip()
            for _session, item in pending_updates:
                item["barcode"] = canonical_barcode
            for session in sessions:
                if session.id not in changed_session_ids:
                    continue
                session.flow_state = session_states[session.id]
                session.last_seen = now
                session.save(update_fields=["flow_state", "last_seen", "updated_at"])

            boxes_data, pallets_data = processing_views._merge_flow_sessions(sessions)
            shared_state = {"boxes": boxes_data, "pallets": pallets_data}

        flow_integrity = cls.build_processing_flow_integrity(
            order_id=str(order_id),
            flow_state=shared_state,
            include_database=True,
        )
        log_staff_overaction(
            "update",
            user=request.user if request.user.is_authenticated else None,
            agency=entries[-1].agency,
            description=f"Подтвержден ШК старых коробов по заявке {order_id}",
            snapshot={
                "action": "confirm_processing_legacy_barcode",
                "order_type": "processing",
                "order_id": str(order_id),
                "barcode": str(expected.get("barcode") or data.get("barcode") or "").strip(),
                "confirmed_qty": confirmed_qty,
                "box_codes": confirmed_box_codes,
                "confirmed_at": now.isoformat(),
            },
        )
        return ProcessingJsonResult(
            status="ok",
            http_status=200,
            payload={
                "ok": True,
                "barcode": str(expected.get("barcode") or data.get("barcode") or "").strip(),
                "confirmed_qty": confirmed_qty,
                "flow_state": shared_state,
                "flow_integrity": flow_integrity,
                "message": f"ШК подтвержден для {confirmed_qty} шт.",
            },
        )

    @classmethod
    def log_processing_flow_box_action(cls, *, order_id: str, request) -> ProcessingFlowBoxActionResult:
        if not cls._views()._processing_flow_has_write_access(request, str(order_id or "")):
            return ProcessingFlowBoxActionResult(status="forbidden")
        try:
            payload = json.loads(request.body.decode("utf-8") or "{}")
        except json.JSONDecodeError:
            payload = request.POST.dict()
        if not isinstance(payload, dict):
            payload = {}
        action = (payload.get("action") or "").lower()
        if action != "edit":
            return ProcessingFlowBoxActionResult(status="invalid_action")
        box_code = (payload.get("box_code") or "").strip()
        if not box_code:
            return ProcessingFlowBoxActionResult(status="missing_box")
        entry = (
            OrderAuditEntry.objects.filter(order_id=order_id, order_type="processing")
            .select_related("agency")
            .order_by("-created_at")
            .first()
        )
        snapshot = {
            "order_id": order_id,
            "box_code": box_code,
            "pallet_code": (payload.get("pallet_code") or "").strip(),
            "pallet_index": cls._views()._parse_int_value(payload.get("pallet_index")),
            "box_index": cls._views()._parse_int_value(payload.get("box_index")),
            "total_qty": cls._views()._parse_int_value(payload.get("total_qty")),
            "items": payload.get("items") if isinstance(payload.get("items"), list) else [],
