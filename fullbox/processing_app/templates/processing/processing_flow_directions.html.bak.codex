      const state = {
        pallets: [],
        boxes: [],
        activePallet: '',
        activeBox: '',
      };
      const sharedState = {
        pallets: [],
        boxes: [],
      };
      let pendingClosePalletCode = '';
      let pendingClosePalletAutoNext = true;
      let pendingBoxMetricsCode = '';
      let pendingBoxMetricsIndex = 0;
      let pendingBoxMetricsOnSave = null;
      let pendingBoxMetricsOnCancel = null;
      let localOverrideUntil = 0;

      const applyFlowState = (rawState) => {
        if (!rawState || typeof rawState !== 'object') {
          return;
        }
        if (Array.isArray(rawState.boxes)) {
          state.boxes = rawState.boxes;
        }
        if (Array.isArray(rawState.pallets)) {
          state.pallets = rawState.pallets;
        }
        if (rawState.activeBox) {
          state.activeBox = String(rawState.activeBox);
        }
        if (rawState.activePallet) {
          state.activePallet = String(rawState.activePallet);
        }
      };
      const applySharedFlowState = (rawState) => {
        if (!rawState || typeof rawState !== 'object') {
          return;
        }
        if (Array.isArray(rawState.boxes)) {
          sharedState.boxes = rawState.boxes;
        }
        if (Array.isArray(rawState.pallets)) {
          sharedState.pallets = rawState.pallets;
        }
      };

      applyFlowState(flowState);
      applySharedFlowState(flowStateShared);

      const normalizeText = (value) => String(value || '').trim();
      const compareContainerCodes = (left, right) => (
        normalizeText(left).localeCompare(normalizeText(right), 'ru', { numeric: true, sensitivity: 'base' })
      );
      const parseFixedOrder = (value) => {
        const numeric = Number(value || 0);
        if (Number.isFinite(numeric) && numeric > 0) {
          return Math.trunc(numeric);
        }
        const match = String(value || '').trim().match(/^(\d+)/);
        return match ? Number(match[1] || 0) : 0;
      };
      const escapeInlineHtml = (value) => String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
      const makeKey = (item) => {
        const sku = normalizeText(item.sku_code || item.sku || '');
        const name = normalizeText(item.name || '');
        const size = normalizeText(item.size || '');
        return `${sku}|${name}|${size}`.toLowerCase();
      };

      const plannedItems = itemsData.map((item) => ({
        sku_code: normalizeText(item.sku_code),
        name: normalizeText(item.name),
        size: normalizeText(item.size),
        qty: Number(item.qty || 0),
      }));
      const plannedKeys = new Set(plannedItems.map((item) => makeKey(item)));
      const extraItems = [];
      const extraKeys = new Set();
      const plannedByKey = new Map(plannedItems.map((item) => [makeKey(item), item]));
      const plannedBySku = new Map();
      plannedItems.forEach((item) => {
        if (!item.sku_code) {
          return;
        }
        plannedBySku.set(item.sku_code.toLowerCase(), item);
      });
      const normalizeMappedItem = (mapped) => ({
        sku_code: normalizeText(mapped.sku_code || mapped.sku || ''),
        name: normalizeText(mapped.name || ''),
        size: normalizeText(mapped.size || ''),
        qty: 0,
      });
      const ensurePlannedItem = (mapped) => {
        const normalized = normalizeMappedItem(mapped);
        if (!normalized.sku_code && !normalized.name && !normalized.size) {
          return null;
        }
        const key = makeKey(normalized);
        if (plannedByKey.has(key)) {
          return plannedByKey.get(key);
        }
        const entry = {
          sku_code: normalized.sku_code,
          name: normalized.name || normalized.sku_code,
          size: normalized.size,
          qty: 0,
        };
        plannedItems.push(entry);
        plannedByKey.set(key, entry);
        if (!plannedKeys.has(key) && !extraKeys.has(key)) {
          extraItems.push(entry);
          extraKeys.add(key);
        }
        if (entry.sku_code) {
          plannedBySku.set(entry.sku_code.toLowerCase(), entry);
        }
        return entry;
      };
      const seedPlannedFromBoxes = () => {
        const knownBoxes = new Map();
        state.boxes.forEach((box) => {
          if (box?.code) {
            knownBoxes.set(box.code, box);
          }
        });
        sharedState.boxes.forEach((box) => {
          if (box?.code && !knownBoxes.has(box.code)) {
            knownBoxes.set(box.code, box);
          }
        });
        Array.from(knownBoxes.values()).forEach((box) => {
          (box.items || []).forEach((item) => {
            ensurePlannedItem(item);
          });
        });
      };
      seedPlannedFromBoxes();
      const normalizeDirection = (value) => String(value || '').trim();
      const directionRows = Array.isArray(flowDirectionData?.rows) ? flowDirectionData.rows : [];
      const directionTotalsPlan = flowDirectionData?.totals && typeof flowDirectionData.totals === 'object'
        ? flowDirectionData.totals
        : {};
      const directionNames = [];
      const directionNameSet = new Set();
      (Array.isArray(flowDirectionData?.directions) ? flowDirectionData.directions : []).forEach((raw) => {
        const name = normalizeDirection(raw);
        if (!name) {
          return;
        }
        const key = name.toLowerCase();
        if (directionNameSet.has(key)) {
          return;
        }
        directionNameSet.add(key);
        directionNames.push(name);
      });
      const directionalMode = directionalUnboxing && directionNames.length > 0;
      const directionTargetsByKey = new Map();
      const makeDirectionCandidateKeys = (item) => {
        const sku = normalizeText(item?.sku_code || item?.sku || '');
        const name = normalizeText(item?.name || '');
        const size = normalizeText(item?.size || '');
        const keys = [];
        const push = (value) => {
          const raw = String(value || '').trim().toLowerCase();
          if (!raw) {
            return;
          }
          if (!keys.includes(raw)) {
            keys.push(raw);
          }
        };
        push(`${sku}|${name}|${size}`);
        if (sku || size) {
          push(`${sku}||${size}`);
        }
        if (sku) {
          push(`${sku}||`);
        }
        if (name || size) {
          push(`|${name}|${size}`);
        }
        return keys;
      };
      const mergeDirectionTargets = (key, targets) => {
        if (!key || !targets || typeof targets !== 'object') {
          return;
        }
        const current = directionTargetsByKey.get(key) || {};
        Object.entries(targets).forEach(([direction, qtyRaw]) => {
          const directionName = normalizeDirection(direction);
          const qty = Number(qtyRaw || 0);
          if (!directionName || qty <= 0) {
            return;
          }
          current[directionName] = Number(current[directionName] || 0) + qty;
        });
        directionTargetsByKey.set(key, current);
      };
      directionRows.forEach((row) => {
        if (!row || typeof row !== 'object') {
          return;
        }
        const base = normalizeMappedItem(row);
        const targets = row.targets && typeof row.targets === 'object' ? row.targets : {};
        makeDirectionCandidateKeys(base).forEach((key) => mergeDirectionTargets(key, targets));
      });
      const hasDirectionTargets = () => directionTargetsByKey.size > 0;
      const getDirectionTargetsForItem = (item) => {
        const keys = makeDirectionCandidateKeys(item);
        for (const key of keys) {
          const found = directionTargetsByKey.get(key);
          if (found) {
            return found;
          }
        }
        return {};
      };
      const getPalletDirection = (pallet) => normalizeDirection(pallet?.direction || pallet?.direction_name || '');
      const getBoxDirection = (box) => normalizeDirection(box?.direction || box?.direction_name || '');
      const inferDirectionForPallet = (pallet, palletIndex = 0) => {
        if (!directionalMode) {
          return '';
        }
        const direct = getPalletDirection(pallet);
        if (direct) {
          return direct;
        }
        const idx = Number(palletIndex || 0);
        if (idx > 0 && idx <= directionNames.length) {
          return normalizeDirection(directionNames[idx - 1]);
        }
        return '';
      };
      const getActiveDirectionName = () => {
        const activeBox = getBox(state.activeBox);
        const activePallet = getPallet(state.activePallet);
        return getBoxDirection(activeBox) || inferDirectionForPallet(activePallet, 0) || '';
      };
      const setBoxDirection = (box, directionName) => {
        if (!box || typeof box !== 'object') {
          return;
        }
        const normalized = normalizeDirection(directionName);
        box.direction = normalized;
      };
      const setPalletDirection = (pallet, directionName) => {
        if (!pallet || typeof pallet !== 'object') {
          return;
        }
        const normalized = normalizeDirection(directionName);
        pallet.direction = normalized;
        (pallet.boxes || []).forEach((code) => {
          const box = getAnyBox(code);
          if (box) {
            setBoxDirection(box, normalized);
          }
        });
      };
      const getAnyPalletByBoxCode = (boxCode) => (
        getAllPallets().find((pallet) => (pallet?.boxes || []).includes(boxCode)) || null
      );
      const getPlacedQtyByDirection = (item, directionName) => {
        const targetDirection = normalizeDirection(directionName);
        if (!targetDirection) {
          return 0;
        }
        const key = makeKey(item);
        let total = 0;
        getAllBoxes().forEach((box) => {
          if (!box) {
            return;
          }
          const boxDirection = getBoxDirection(box) || getPalletDirection(getAnyPalletByBoxCode(box.code));
          if (!boxDirection || boxDirection !== targetDirection) {
            return;
          }
          (box.items || []).forEach((entry) => {
            if (makeKey(entry) === key) {
              total += Number(entry.qty || 0);
            }
          });
        });
        return total;
      };
      const chooseDirectionForItem = (item, options = {}) => {
        const forFocus = !!options.forFocus;
        const targets = getDirectionTargetsForItem(item);
        let fallbackDirection = '';
        for (const directionName of directionNames) {
          const target = Number(targets[directionName] || 0);
          if (target <= 0) {
            continue;
          }
          if (!fallbackDirection) {
            fallbackDirection = directionName;
          }
          const placed = getPlacedQtyByDirection(item, directionName);
          if (placed < target) {
            return directionName;
          }
        }
        if (forFocus) {
          return '';
        }
        return fallbackDirection;
      };
      const getDirectionStatsForItem = (item) => {
        if (!directionalMode) {
          return [];
        }
        const targets = getDirectionTargetsForItem(item);
        return directionNames.map((directionName) => {
          const planned = Number(targets[directionName] || 0);
          const placed = getPlacedQtyByDirection(item, directionName);
          const remaining = Math.max(0, planned - placed);
          return {
            direction: directionName,
            planned,
            placed,
            remaining,
          };
        });
      };
      const makeFamilyKey = (item) => {
        const sku = normalizeText(item?.sku_code || item?.sku || '');
        const name = normalizeText(item?.name || '');
        return `${sku}|${name}`.toLowerCase();
      };
      const collectDirectionBoxMatches = (item, directionName) => {
        const targetDirection = normalizeDirection(directionName);
        if (!targetDirection) {
          return [];
        }
        const itemKey = makeKey(item);
        const familyKey = makeFamilyKey(item);
        const matches = [];
        getAllBoxes().forEach((box) => {
          if (!box) {
            return;
          }
          const boxDirection = getBoxDirection(box) || getPalletDirection(getAnyPalletByBoxCode(box.code));
          if (!boxDirection || boxDirection !== targetDirection) {
            return;
          }
          let itemQty = 0;
          const familySizes = new Set();
          (box.items || []).forEach((entry) => {
            const qty = Number(entry.qty || 0);
            if (qty <= 0) {
              return;
            }
            if (makeKey(entry) === itemKey) {
              itemQty += qty;
            }
            if (makeFamilyKey(entry) === familyKey) {
              const sizeKey = normalizeText(entry.size || '').toLowerCase() || '__empty__';
              familySizes.add(sizeKey);
            }
          });
          if (itemQty <= 0) {
            return;
          }
          matches.push({
            box,
            qty: itemQty,
            hasMixedSizes: familySizes.size > 1,
          });
        });
        matches.sort((left, right) => {
          if (!!left.box?.sealed !== !!right.box?.sealed) {
            return left.box?.sealed ? 1 : -1;
          }
          if (left.qty !== right.qty) {
            return right.qty - left.qty;
          }
          return String(left.box?.code || '').localeCompare(String(right.box?.code || ''), 'ru');
        });
        return matches;
      };
      const focusCellDirectionBox = (item, directionName) => {
        if (!directionalMode) {
          return false;
        }
        const targetDirection = normalizeDirection(directionName);
        if (!targetDirection) {
          return false;
        }
        const matches = collectDirectionBoxMatches(item, targetDirection);
        if (!matches.length) {
          setActiveDirection(targetDirection, true);
          return true;
        }
        const ownOpen = matches.find((entry) => entry && entry.box && !entry.box.sealed && isOwnBoxCode(entry.box.code));
        if (ownOpen) {
          const info = findBoxPalletInfo(ownOpen.box.code);
          if (info.palletCode) {
            state.activePallet = info.palletCode;
          }
          state.activeBox = ownOpen.box.code;
          renderAll();
          return true;
        }
        const anyOpen = matches.find((entry) => entry && entry.box && !entry.box.sealed);
        if (anyOpen) {
          openBoxView(anyOpen.box.code);
          return true;
        }
        openBoxView(matches[0].box.code);
        return true;
      };
      const mixGroupPalette = [
        '#0ea5e9',
        '#22c55e',
        '#f59e0b',
        '#ef4444',
        '#8b5cf6',
        '#14b8a6',
        '#f97316',
        '#ec4899',
        '#65a30d',
        '#3b82f6',
      ];
      const hashText = (value) => {
        const text = String(value || '');
        let hash = 0;
        for (let idx = 0; idx < text.length; idx += 1) {
          hash = ((hash << 5) - hash) + text.charCodeAt(idx);
          hash |= 0;
        }
        return Math.abs(hash);
      };
      const getMixGroupColor = (groupKey) => {
        if (!groupKey) {
          return '#0ea5e9';
        }
        return mixGroupPalette[hashText(groupKey) % mixGroupPalette.length];
      };
      const hexToRgba = (hex, alpha) => {
        const raw = String(hex || '').trim().replace('#', '');
        const full = raw.length === 3
          ? `${raw[0]}${raw[0]}${raw[1]}${raw[1]}${raw[2]}${raw[2]}`
          : raw;
        if (!/^[0-9a-fA-F]{6}$/.test(full)) {
          return `rgba(14,165,233,${alpha})`;
        }
        const r = parseInt(full.slice(0, 2), 16);
        const g = parseInt(full.slice(2, 4), 16);
        const b = parseInt(full.slice(4, 6), 16);
        return `rgba(${r},${g},${b},${alpha})`;
      };
      const applyMixedSizeGroups = () => {
        if (!directionalMode || !remainingBody) {
          return;
        }
        const rows = Array.from(remainingBody.querySelectorAll('tr[data-key]'));
        if (!rows.length) {
          return;
        }
        const segments = [];
        for (let directionIdx = 0; directionIdx < directionNames.length; directionIdx += 1) {
          let currentKey = '';
          let currentCells = [];
          const flush = () => {
            if (!currentCells.length || !currentKey) {
              currentCells = [];
              currentKey = '';
              return;
            }
            segments.push({
              key: currentKey,
              cells: currentCells,
            });
            currentCells = [];
            currentKey = '';
          };
          rows.forEach((row) => {
            const cell = row.querySelector(`td.direction-cell[data-direction-idx="${directionIdx}"][data-mix-group]`);
            const groupKey = cell ? String(cell.dataset.mixGroup || '').trim() : '';
            if (!cell || !groupKey) {
              flush();
              return;
            }
            if (groupKey !== currentKey) {
              flush();
              currentKey = groupKey;
              currentCells = [cell];
              return;
            }
            currentCells.push(cell);
          });
          flush();
        }
        if (!segments.length) {
          return;
        }
        const groupSegmentCounts = new Map();
        segments.forEach((segment) => {
          groupSegmentCounts.set(segment.key, Number(groupSegmentCounts.get(segment.key) || 0) + 1);
        });
        segments.forEach((segment) => {
          const segmentSize = segment.cells.length;
          const isSplitGroup = Number(groupSegmentCounts.get(segment.key) || 0) > 1;
          const color = getMixGroupColor(segment.key);
          const soft = hexToRgba(color, 0.18);
          const ring = hexToRgba(color, isSplitGroup ? 0.64 : 0.50);
          segment.cells.forEach((cell, cellIdx) => {
            cell.style.setProperty('--mix-color', color);
            cell.style.setProperty('--mix-soft', soft);
            cell.style.setProperty('--mix-ring', ring);
            cell.classList.add('mixed-group');
            if (isSplitGroup) {
              cell.classList.add('mixed-group-split');
            }
            if (segmentSize <= 1) {
              cell.classList.add('mixed-group-single');
              return;
            }
            if (cellIdx === 0) {
              cell.classList.add('mixed-group-top');
              return;
            }
            if (cellIdx === segmentSize - 1) {
              cell.classList.add('mixed-group-bottom');
              return;
            }
            cell.classList.add('mixed-group-middle');
          });
        });
      };
      const getRemainingColumnCount = () => {
        if (directionalMode) {
          return 3 + directionNames.length + 1;
        }
        return 6;
      };
      const renderRemainingHead = () => {
        if (!remainingHead) {
          return;
        }
        if (directionalMode) {
          const activeDirection = getActiveDirectionName();
          const directionHeaders = directionNames
            .map((name) => {
              const isActive = !!activeDirection && name === activeDirection;
              const cls = isActive ? 'direction-head active' : 'direction-head';
              return `<th class="${cls}"><span class="direction-name">${escapeInlineHtml(name)}</span></th>`;
            })
            .join('');
          remainingHead.innerHTML = `
            <tr>
              <th>SKU</th>
              <th>Наименование</th>
              <th>Размер</th>
              ${directionHeaders}
              <th>В короб</th>
            </tr>
          `;
          return;
        }
        remainingHead.innerHTML = `
          <tr>
            <th>SKU</th>
            <th>Наименование</th>
            <th>Размер</th>
            <th>По заявке</th>
            <th>Факт</th>
            <th>В короб</th>
          </tr>
        `;
      };
      const playDirectionSignal = (type) => {
        const Context = window.AudioContext || window.webkitAudioContext;
        if (!Context) {
          return;
        }
        const ctx = new Context();
        const scheduleTone = (freq, durationMs, offsetMs = 0) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq;
          osc.connect(gain);
          gain.connect(ctx.destination);
          const startAt = ctx.currentTime + (offsetMs / 1000);
          gain.gain.setValueAtTime(0.0001, startAt);
          gain.gain.exponentialRampToValueAtTime(0.17, startAt + 0.01);
          gain.gain.exponentialRampToValueAtTime(0.0001, startAt + (durationMs / 1000));
          osc.start(startAt);
          osc.stop(startAt + (durationMs / 1000) + 0.02);
        };
        if (type === 'alarm') {
          scheduleTone(210, 180);
          scheduleTone(140, 220, 190);
        } else {
          scheduleTone(860, 120);
        }
      };
      const catalogOptions = [];
      const catalogKeySet = new Set();
      const catalogBySku = new Map();
      const catalogByName = new Map();
      const catalogBySize = new Map();
      const catalogSkuValues = [];
      const catalogSkuSet = new Set();
      const catalogNameValues = [];
      const catalogNameSet = new Set();
      const catalogSizeValues = [];
      const catalogSizeSet = new Set();
      const addCatalogValue = (value, set, list) => {
        const normalized = normalizeText(value);
        if (!normalized) {
          return;
        }
        const key = normalized.toLowerCase();
        if (set.has(key)) {
          return;
        }
        set.add(key);
        list.push(normalized);
      };
      const addCatalogItem = (raw) => {
        const normalized = normalizeMappedItem(raw);
        if (!normalized.sku_code && !normalized.name && !normalized.size) {
          return;
        }
        const key = makeKey(normalized);
        if (!catalogKeySet.has(key)) {
          catalogKeySet.add(key);
          catalogOptions.push({
            ...normalized,
            key,
          });
        }
        addCatalogValue(normalized.sku_code, catalogSkuSet, catalogSkuValues);
        addCatalogValue(normalized.name, catalogNameSet, catalogNameValues);
        addCatalogValue(normalized.size, catalogSizeSet, catalogSizeValues);
      };
      (catalogItems || []).forEach(addCatalogItem);
      itemsData.forEach(addCatalogItem);
      Object.values(barcodeMap || {}).forEach(addCatalogItem);
      const addToCatalogIndex = (map, rawValue, item) => {
        const key = normalizeText(rawValue).toLowerCase();
        if (!key) {
          return;
        }
        const list = map.get(key) || [];
        if (!list.some((entry) => makeKey(entry) === makeKey(item))) {
          list.push(item);
          map.set(key, list);
        }
      };
      catalogOptions.forEach((item) => {
        addToCatalogIndex(catalogBySku, item.sku_code, item);
        addToCatalogIndex(catalogByName, item.name, item);
        addToCatalogIndex(catalogBySize, item.size, item);
      });
      const fillCatalogList = (el, values) => {
        if (!el) {
          return;
        }
        el.innerHTML = '';
        values.forEach((value) => {
          const option = document.createElement('option');
          option.value = value;
          el.appendChild(option);
        });
      };
      fillCatalogList(catalogSkuList, catalogSkuValues);
      fillCatalogList(catalogNameList, catalogNameValues);
      fillCatalogList(catalogSizeList, catalogSizeValues);
      const getCatalogMatches = (skuValue, nameValue, sizeValue) => {
        const skuKey = normalizeText(skuValue).toLowerCase();
        const nameKey = normalizeText(nameValue).toLowerCase();
        const sizeKey = normalizeText(sizeValue).toLowerCase();
        if (!skuKey && !nameKey && !sizeKey) {
          return [];
        }
        let candidates = [];
        if (skuKey) {
          candidates = catalogBySku.get(skuKey) || [];
        } else if (nameKey) {
          candidates = catalogByName.get(nameKey) || [];
        } else if (sizeKey) {
          candidates = catalogBySize.get(sizeKey) || [];
        }
        const matches = candidates.filter((item) => {
          const itemSku = (item.sku_code || '').toLowerCase();
          const itemName = (item.name || '').toLowerCase();
          const itemSize = (item.size || '').toLowerCase();
          if (skuKey && itemSku !== skuKey) {
            return false;
          }
          if (nameKey && itemName !== nameKey) {
            return false;
          }
          if (sizeKey && itemSize !== sizeKey) {
            return false;
          }
          return true;
        });
        return matches;
      };
      const scoreCatalogItem = (item) => {
        let score = 0;
        if (normalizeText(item.sku_code)) {
          score += 1;
        }
        if (normalizeText(item.name)) {
          score += 1;
        }
        if (normalizeText(item.size)) {
          score += 1;
        }
        return score;
      };
      const pickCatalogItem = (matches) => {
        if (!matches.length) {
          return null;
        }
        let best = matches[0];
        let bestScore = scoreCatalogItem(best);
        for (const item of matches) {
          const score = scoreCatalogItem(item);
          if (score > bestScore) {
            best = item;
            bestScore = score;
          }
        }
        return best;
      };
      const getSelectedCatalogItem = (skuValue, nameValue, sizeValue) => {
        const matches = getCatalogMatches(skuValue, nameValue, sizeValue);
        return pickCatalogItem(matches);
      };
      let highlightedKey = '';
      let highlightTimer = null;
      let pendingFocusKey = '';
      let pendingFocusEl = null;
      let lastFocusedRowKey = '';
      let suppressBlurApply = false;
      let addRowSku = '';
      let addRowName = '';
      let addRowSize = '';
      let addRowQty = '';
      let addRowItem = null;
      let pendingAddRowFocus = false;
      const manualInputByKey = new Map();
      const remainingItemByKey = new Map();
      const boxAdjustByKey = new Map();
      let draftSaveTimer = null;
      let draftEnabled = false;
      let isSubmitting = false;
      let mainQrLoading = false;
      let mainQrFailed = false;
      const mainQrQueue = [];
      let flowSessionId = '';
      let flowSessionReady = false;
      let agentId = '';

      const normalizePrefix = (value) => {
        const raw = String(value || '').trim().toUpperCase();
        const cleaned = raw.replace(/[^\p{L}\p{N}]/gu, '');
        return cleaned;
      };

      const buildDatePart = () => {
        const now = new Date();
        const day = String(now.getDate()).padStart(2, '0');
        const month = String(now.getMonth() + 1).padStart(2, '0');
        return `${day}${month}`;
      };

      const makeCode = (kind = 'box') => {
        const entityLabel = kind === 'pallet' ? 'палеты' : 'короба';
        if (!containerCodeUrl) {
          alert(`Не настроена выдача номера ${entityLabel}.`);
          return '';
        }
        const request = new XMLHttpRequest();
        try {
          request.open('POST', containerCodeUrl, false);
          request.setRequestHeader('Content-Type', 'application/json');
          if (csrfToken) {
            request.setRequestHeader('X-CSRFToken', csrfToken);
          }
          request.send(JSON.stringify({ goods_type: goodsType || 'na', kind }));
        } catch (error) {
          alert(`Не удалось получить номер ${entityLabel}.`);
          return '';
        }
        let payload = {};
        try {
          payload = JSON.parse(request.responseText || '{}');
        } catch (error) {
          payload = {};
        }
        const code = String(payload.code || '').trim();
        if (request.status < 200 || request.status >= 300 || !payload.ok || !code) {
          alert(payload.error || `Не удалось получить номер ${entityLabel}.`);
          return '';
        }
        return code;
      };

      const getAllBoxes = () => {
        const map = new Map();
        state.boxes.forEach((box) => {
          if (box && box.code) {
            map.set(box.code, box);
          }
        });
        sharedState.boxes.forEach((box) => {
          if (box && box.code && !map.has(box.code)) {
            map.set(box.code, box);
          }
        });
        return Array.from(map.values());
      };
      const getAllPallets = () => {
        const map = new Map();
        state.pallets.forEach((pallet) => {
          if (pallet && pallet.code) {
            map.set(pallet.code, pallet);
          }
        });
        sharedState.pallets.forEach((pallet) => {
          if (pallet && pallet.code && !map.has(pallet.code)) {
            map.set(pallet.code, pallet);
          }
        });
        return Array.from(map.values());
      };
      const ensureFixedPalletOrders = () => {
        const pallets = getAllPallets();
        const usedNumbers = new Set();
        pallets.forEach((pallet) => {
          const current = parseFixedOrder(pallet?.fixed_order);
          if (current > 0) {
            pallet.fixed_order = current;
            usedNumbers.add(current);
          }
        });
        let nextNum = 1;
        pallets
          .slice()
          .sort((left, right) => compareContainerCodes(left?.code, right?.code))
          .forEach((pallet) => {
            if (parseFixedOrder(pallet?.fixed_order) > 0) {
              return;
            }
            while (usedNumbers.has(nextNum)) {
              nextNum += 1;
            }
            pallet.fixed_order = nextNum;
            usedNumbers.add(nextNum);
          });
      };
      const getPalletDisplayNumber = (pallet) => {
        ensureFixedPalletOrders();
        return parseFixedOrder(pallet?.fixed_order);
      };
      const getSortedPallets = () => {
        ensureFixedPalletOrders();
        return getAllPallets().slice().sort((left, right) => {
          const leftNum = parseFixedOrder(left?.fixed_order);
          const rightNum = parseFixedOrder(right?.fixed_order);
          if (leftNum && rightNum && leftNum !== rightNum) {
            return leftNum - rightNum;
          }
          if (leftNum && !rightNum) {
            return -1;
          }
          if (!leftNum && rightNum) {
            return 1;
          }
          return compareContainerCodes(left?.code, right?.code);
        });
      };
      const getNextPalletFixedOrder = () => {
        ensureFixedPalletOrders();
        const used = new Set(
          getAllPallets()
            .map((pallet) => parseFixedOrder(pallet?.fixed_order))
            .filter((value) => value > 0),
        );
        let nextNum = 1;
        while (used.has(nextNum)) {
          nextNum += 1;
        }
        return nextNum;
      };
      const getBox = (code) => state.boxes.find((box) => box.code === code) || null;
      const getPallet = (code) => state.pallets.find((pallet) => pallet.code === code) || null;
        const getAnyBox = (code) => getAllBoxes().find((box) => box.code === code) || null;
        const getAnyPallet = (code) => getAllPallets().find((pallet) => pallet.code === code) || null;
        const isOwnBoxCode = (code) => state.boxes.some((box) => box.code === code);
        const isOwnPalletCode = (code) => state.pallets.some((pallet) => pallet.code === code);
        const normalizeInitial = (value) => {
          const cleaned = String(value || '').replace(/[^\p{L}]/gu, '');
          return cleaned ? cleaned[0].toUpperCase() : '';
        };
        const getPackerInitials = (label) => {
          const parts = String(label || '').trim().split(/\s+/).filter(Boolean);
          if (!parts.length) {
            return '';
          }
          const first = normalizeInitial(parts[0]);
          const second = parts.length > 1 ? normalizeInitial(parts[1]) : '';
          return `${first}${second}`;
        };
        const resolveActorLabel = (label, agentIdValue, userIdValue, fallback = 'Не указано') => {
          const direct = String(label || '').trim();
          if (direct) {
            return direct;
          }
          const agent = String(agentIdValue || '').trim();
          if (agent && agent !== '__reopen_snapshot__') {
            return agent;
          }
          const userId = String(userIdValue || '').trim();
          if (userId) {
            return `ID ${userId}`;
          }
          return String(fallback || '').trim();
        };
        const formatBoxDisplayNumber = (index, box) => {
          const fixedLabel = String(box?.fixed_label || '').trim();
          if (fixedLabel) {
            return fixedLabel;
          }
          const numeric = Number(index || 0);
          if (!numeric) {
            return '-';
          }
          const ownerLabel = box?.owner_user_label || box?.owner_agent_id || currentUserLabel || '';
          const initials = getPackerInitials(ownerLabel);
          return initials ? `${numeric}${initials}` : String(numeric);
        };
        const cloneBox = (box) => {
          const items = Array.isArray(box?.items)
            ? box.items.map((item) => ({ ...item }))
            : [];
          return {
            code: box?.code || '',
            items,
            sealed: !!box?.sealed,
            direction: normalizeDirection(box?.direction || box?.direction_name || ''),
            fixed_label: box?.fixed_label || '',
            owner_agent_id: box?.owner_agent_id || '',
            owner_user_id: box?.owner_user_id || '',
            owner_user_label: box?.owner_user_label || '',
          };
        };
        const ensureLocalBox = (code) => {
          if (!code) {
            return null;
          }
          const existing = getBox(code);
          if (existing) {
            return existing;
          }
          const source = getAnyBox(code);
          if (!source) {
            return null;
          }
          const box = cloneBox(source);
          state.boxes.push(box);
          return box;
        };
        const cloneLocation = (location) => ({
          zone: (location && location.zone) ? location.zone : 'PR',
          row: (location && location.row) ? location.row : '',
          section: (location && location.section) ? location.section : '',
          tier: (location && location.tier) ? location.tier : '',
          cell: (location && location.cell) ? location.cell : '',
        });
        const clonePallet = (pallet) => ({
          code: pallet?.code || '',
          boxes: Array.isArray(pallet?.boxes) ? [...pallet.boxes] : [],
          items: Array.isArray(pallet?.items) ? pallet.items.map((item) => ({ ...item })) : [],
          sealed: !!pallet?.sealed,
          direction: normalizeDirection(pallet?.direction || pallet?.direction_name || ''),
          fixed_order: parseFixedOrder(pallet?.fixed_order),
          location: cloneLocation(pallet?.location),
          owner_agent_id: pallet?.owner_agent_id || '',
          owner_user_id: pallet?.owner_user_id || '',
          owner_user_label: pallet?.owner_user_label || '',
          closed_by_agent_id: pallet?.closed_by_agent_id || '',
          closed_by_user_id: pallet?.closed_by_user_id || '',
          closed_by_user_label: pallet?.closed_by_user_label || '',
        });
        const ensureLocalPallet = (code) => {
          if (!code) {
            return null;
          }
          const existing = getPallet(code);
          if (existing) {
            return existing;
          }
          const source = getAnyPallet(code);
          if (!source) {
            return null;
          }
          const pallet = clonePallet(source);
          state.pallets.push(pallet);
          (pallet.boxes || []).forEach((boxCode) => {
            ensureLocalBox(boxCode);
          });
          return pallet;
        };
        const syncLocalFromShared = () => {
          const boxesMap = new Map();
          state.boxes.forEach((box) => {
            if (!box || !box.code) {
              return;
            }
            if (!isEntryOwnedByCurrentUser(box, true)) {
              return;
            }
            boxesMap.set(box.code, cloneBox(box));
          });
          sharedState.boxes.forEach((box) => {
            if (!box || !box.code) {
              return;
            }
            if (!isEntryOwnedByCurrentUser(box, false)) {
              return;
            }
            if (!boxesMap.has(box.code)) {
              boxesMap.set(box.code, cloneBox(box));
              return;
            }
            const local = boxesMap.get(box.code);
            const sharedFixed = String(box.fixed_label || '').trim();
            if (local && !String(local.fixed_label || '').trim() && sharedFixed) {
              local.fixed_label = sharedFixed;
            }
            const sharedDirection = normalizeDirection(box.direction || box.direction_name || '');
            if (local && !getBoxDirection(local) && sharedDirection) {
              local.direction = sharedDirection;
            }
          });
          const palletsMap = new Map();
          state.pallets.forEach((pallet) => {
            if (!pallet || !pallet.code) {
              return;
            }
            if (!isEntryOwnedByCurrentUser(pallet, true)) {
              return;
            }
            palletsMap.set(pallet.code, clonePallet(pallet));
          });
          sharedState.pallets.forEach((pallet) => {
            if (!pallet || !pallet.code) {
              return;
            }
            if (!isEntryOwnedByCurrentUser(pallet, false)) {
              return;
            }
            if (!palletsMap.has(pallet.code)) {
              palletsMap.set(pallet.code, clonePallet(pallet));
              return;
            }
            const local = palletsMap.get(pallet.code);
            const sharedFixedOrder = parseFixedOrder(pallet.fixed_order);
            if (local && !parseFixedOrder(local.fixed_order) && sharedFixedOrder) {
              local.fixed_order = sharedFixedOrder;
            }
            const sharedDirection = normalizeDirection(pallet.direction || pallet.direction_name || '');
            if (local && !getPalletDirection(local) && sharedDirection) {
              local.direction = sharedDirection;
            }
          });
          state.boxes = Array.from(boxesMap.values());
          state.pallets = Array.from(palletsMap.values());
          const boxCodes = new Set(state.boxes.map((box) => box.code));
          state.pallets.forEach((pallet) => {
            pallet.boxes = (pallet.boxes || []).filter((code) => boxCodes.has(code));
          });
          if (state.activeBox && !boxCodes.has(state.activeBox)) {
            state.activeBox = '';
          }
          const palletCodes = new Set(state.pallets.map((pallet) => pallet.code));
          if (state.activePallet && !palletCodes.has(state.activePallet)) {
            state.activePallet = '';
          }
        };
        if (!flowLocked) {
          syncLocalFromShared();
        }
        const moveBoxToPallet = (boxCode, targetPalletCode) => {
          if (flowLocked) {
            return false;
          }
          if (!canReassignBoxes) {
            alert('Перемещать короба между палетами может только руководитель обработки.');
            return false;
          }
          if (!boxCode || !targetPalletCode) {
            return false;
          }
          ensureLocalBox(boxCode);
          const target = ensureLocalPallet(targetPalletCode);
          if (!target || target.sealed) {
            alert('Палета закрыта. Откройте палету, чтобы переместить короб.');
            return false;
          }
          const info = findBoxPalletInfo(boxCode);
          if (!info.palletCode || info.palletCode === targetPalletCode) {
            return false;
          }
          const source = ensureLocalPallet(info.palletCode);
          if (source && source.sealed) {
            alert('Палета закрыта. Откройте палету, чтобы переместить короб.');
            return false;
          }
          const box = ensureLocalBox(boxCode);
          const sourceDirection = source ? getPalletDirection(source) : '';
          const targetDirection = getPalletDirection(target);
          const boxDirection = getBoxDirection(box) || sourceDirection;
          if (directionalMode && boxDirection && targetDirection && boxDirection !== targetDirection) {
            alert(`Короб направления "${boxDirection}" нельзя переместить на палету направления "${targetDirection}".`);
            playDirectionSignal('alarm');
            return false;
          }
          state.pallets.forEach((pallet) => {
            pallet.boxes = (pallet.boxes || []).filter((code) => code !== boxCode);
          });
          target.boxes = target.boxes || [];
          if (!target.boxes.includes(boxCode)) {
            target.boxes.push(boxCode);
          }
          if (directionalMode) {
            if (!getPalletDirection(target) && boxDirection) {
              setPalletDirection(target, boxDirection);
            }
            if (box) {
              const finalDirection = getPalletDirection(target) || boxDirection;
              if (finalDirection) {
                setBoxDirection(box, finalDirection);
              }
            }
          }
          markDraftDirty();
          renderAll();
          return true;
        };
      function getBoxItemsCount(box) {
        if (!box || !Array.isArray(box.items)) {
          return 0;
        }
        return box.items.reduce((sum, item) => sum + Number(item.qty || 0), 0);
      }
      const getBoxItemQty = (key) => {
        const box = getBox(state.activeBox);
        if (!box || !Array.isArray(box.items)) {
          return 0;
        }
        const existing = box.items.find((entry) => makeKey(entry) === key);
        return existing ? Number(existing.qty || 0) : 0;
      };

      const createBox = () => {
        const code = makeCode('box');
        if (!code) {
          return null;
        }
        const box = {
          code,
          items: [],
          sealed: false,
          direction: '',
          fixed_label: '',
          owner_agent_id: agentId || '',
          owner_user_id: currentUserId || '',
          owner_user_label: currentUserLabel || '',
        };
        state.boxes.push(box);
        return box;
      };

      const createPallet = () => {
        const code = makeCode('pallet');
        if (!code) {
          return null;
        }
        const pallet = {
          code,
          boxes: [],
          items: [],
          sealed: false,
          direction: '',
          fixed_order: getNextPalletFixedOrder(),
          location: { zone: 'PR', row: '', section: '', tier: '', cell: '' },
          owner_agent_id: agentId || '',
          owner_user_id: currentUserId || '',
          owner_user_label: currentUserLabel || '',
        };
        state.pallets.push(pallet);
        return pallet;
      };

      const attachBoxToPallet = (pallet, box) => {
        if (!pallet || !box) {
          return;
        }
        const palletDirection = getPalletDirection(pallet);
        const boxDirection = getBoxDirection(box);
        if (directionalMode && palletDirection && boxDirection && palletDirection !== boxDirection) {
          return;
        }
        if (!(pallet.boxes || []).includes(box.code)) {
          pallet.boxes = pallet.boxes || [];
          pallet.boxes.push(box.code);
        }
        if (directionalMode) {
          if (palletDirection && !boxDirection) {
            setBoxDirection(box, palletDirection);
          } else if (!palletDirection && boxDirection) {
            setPalletDirection(pallet, boxDirection);
          }
        }
      };

      const hasRemaining = () => {
        return getRemaining().some(
          (item) => item.remaining > 0 || (Number(item.qty || 0) <= 0 && Number(item.placed || 0) > 0),
        );
      };

      function isEntryOwnedByCurrentUser(entry, allowUnassigned = false) {
        if (!entry || typeof entry !== 'object') {
          return false;
        }
        const ownerId = String(entry.owner_user_id || '').trim();
        const ownerLabel = String(entry.owner_user_label || '').trim();
        const ownerAgent = String(entry.owner_agent_id || '').trim();
        if (!ownerId && !ownerLabel && !ownerAgent) {
          return allowUnassigned;
        }
        if (ownerId) {
          return !!(currentUserId && ownerId === currentUserId);
        }
        if (ownerLabel) {
          return !!(currentUserLabel && ownerLabel === currentUserLabel);
        }
        return !!(agentId && ownerAgent && ownerAgent === agentId);
      }

      function isOwnedByCurrentUser(pallet) {
        return isEntryOwnedByCurrentUser(pallet, false);
      }

      const getPalletOwnerKey = (pallet) => {
        if (!pallet) {
          return '';
        }
        const ownerId = String(pallet.owner_user_id || '').trim();
        const ownerLabel = String(pallet.owner_user_label || '').trim();
        const ownerAgent = String(pallet.owner_agent_id || '').trim();
        return ownerId || ownerLabel || ownerAgent;
      };
      const findPalletForBox = (box) => {
        if (!box || !box.code) {
          return null;
        }
        const boxOwnerKey = getPalletOwnerKey(box);
        const sameOwner = state.pallets.filter((pallet) => {
          if (!pallet || !pallet.code) {
            return false;
          }
          const palletOwnerKey = getPalletOwnerKey(pallet);
          return boxOwnerKey ? palletOwnerKey === boxOwnerKey : true;
        });
        const candidates = sameOwner.length ? sameOwner : (state.pallets.length === 1 ? state.pallets : []);
        return candidates.find((pallet) => pallet.code === state.activePallet && !pallet.sealed)
          || candidates.find((pallet) => pallet.code === state.activePallet)
          || candidates.find((pallet) => !pallet.sealed)
          || candidates[0]
          || null;
      };
      const ensureBoxesBelongToPallets = (preferredBoxCode = '') => {
        const assigned = new Set();
        state.pallets.forEach((pallet) => {
          const unique = [];
          (pallet.boxes || []).forEach((rawCode) => {
            const code = String(rawCode || '').trim();
            if (!code || assigned.has(code)) {
              return;
            }
            unique.push(code);
            assigned.add(code);
          });
          pallet.boxes = unique;
        });
        const boxes = state.boxes
          .filter((box) => box && box.code && getBoxItemsCount(box) > 0 && !assigned.has(box.code))
          .sort((left, right) => {
            if (preferredBoxCode && left.code === preferredBoxCode) {
              return -1;
            }
            if (preferredBoxCode && right.code === preferredBoxCode) {
              return 1;
            }
            return 0;
          });
        boxes.forEach((box) => {
          const pallet = findPalletForBox(box);
          if (!pallet) {
            return;
          }
          attachBoxToPallet(pallet, box);
          assigned.add(box.code);
        });
      };
      const getPalletItemTotal = (pallet) => {
        if (!pallet) {
          return 0;
        }
        const directQty = getBoxItemsCount({ items: pallet.items || [] });
        const boxesQty = (pallet.boxes || [])
          .map((code) => getAnyBox(code))
          .filter((box) => box)
          .reduce((sum, box) => sum + getBoxItemsCount(box), 0);
        return directQty + boxesQty;
      };
      const ensureLocalPalletWithBoxes = (palletCode) => {
        if (!palletCode) {
          return null;
        }
        const local = getPallet(palletCode);
        if (local) {
          (local.boxes || []).forEach((code) => ensureLocalBox(code));
          return local;
        }
        const pallet = ensureLocalPallet(palletCode);
        if (!pallet) {
          return null;
        }
        (pallet.boxes || []).forEach((code) => ensureLocalBox(code));
        return pallet;
      };
      const getCurrentOwnerKey = () => {
        const userId = String(currentUserId || '').trim();
        const userLabel = String(currentUserLabel || '').trim();
        const agent = String(agentId || '').trim();
        return userId || userLabel || agent;
      };
      const buildCloserOverrideFromOwner = (pallet) => ({
        agent_id: pallet?.owner_agent_id || '',
        user_id: pallet?.owner_user_id || '',
        user_label: pallet?.owner_user_label || '',
      });

      const BOX_METRIC_FIELDS = ['gross_weight_g', 'width_mm', 'height_mm', 'depth_mm'];

      const parseMetricNumber = (value) => {
        const normalized = String(value ?? '').replace(',', '.').trim();
        if (!normalized) {
          return null;
        }
        const parsed = Number(normalized);
        return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
      };

      const formatMetricDisplay = (value, divider, digits) => {
        const numeric = Number(value || 0);
        if (!Number.isFinite(numeric) || numeric <= 0) {
          return '';
        }
        const fixed = (numeric / divider).toFixed(digits);
        return fixed.replace(/\.0+$/, '').replace(/(\.\d*?)0+$/, '$1');
      };

      const clearBoxCharacteristics = (box) => {
        if (!box || typeof box !== 'object') {
          return;
        }
        BOX_METRIC_FIELDS.forEach((field) => {
          delete box[field];
        });
      };

      const hasCompleteBoxCharacteristics = (box) => BOX_METRIC_FIELDS.every((field) => {
        const numeric = Number(box?.[field] || 0);
        return Number.isFinite(numeric) && numeric > 0;
      });

      const applyBoxCharacteristics = (box, values) => {
        if (!box || typeof box !== 'object') {
          return;
        }
        BOX_METRIC_FIELDS.forEach((field) => {
          const numeric = Number(values?.[field] || 0);
          if (Number.isFinite(numeric) && numeric > 0) {
            box[field] = numeric;
          }
        });
      };

      const buildKnownBoxMetricLookupKey = (box) => {
        const grouped = new Map();
        (box?.items || []).forEach((item) => {
          const qty = Number(item?.qty || 0);
          if (!Number.isFinite(qty) || qty <= 0) {
            return;
          }
          const key = [
            String(item?.sku_code || item?.sku || '').trim().toLowerCase(),
            String(item?.name || '').trim().toLowerCase(),
            String(item?.size || '').trim().toLowerCase(),
          ].join('|');
          grouped.set(key, (grouped.get(key) || 0) + qty);
        });
        return JSON.stringify(
          Array.from(grouped.entries()).sort((left, right) => left[0].localeCompare(right[0])),
        );
      };

      const getKnownBoxMetrics = (box) => {
        const lookupKey = buildKnownBoxMetricLookupKey(box);
        if (!lookupKey || lookupKey === '[]') {
          return null;
        }
        const raw = knownBoxMetrics && typeof knownBoxMetrics === 'object'
          ? knownBoxMetrics[lookupKey]
          : null;
        if (!raw || typeof raw !== 'object') {
          return null;
        }
        const values = {};
        for (const field of BOX_METRIC_FIELDS) {
          const numeric = Number(raw[field] || 0);
          if (!Number.isFinite(numeric) || numeric <= 0) {
            return null;
          }
          values[field] = numeric;
        }
        return values;
      };

      const buildBoxCompositionKey = (box) => {
        return buildKnownBoxMetricLookupKey(box);
      };

      const findMatchingClosedBox = (targetBox) => {
        const targetKey = buildBoxCompositionKey(targetBox);
        if (!targetKey || targetKey === '[]') {
          return null;
        }
        return state.boxes.find((box) => (
          box
          && box.code !== targetBox.code
          && box.sealed
          && hasCompleteBoxCharacteristics(box)
          && buildBoxCompositionKey(box) === targetKey
        )) || null;
      };

      const setBoxMetricsError = (message) => {
        if (!boxMetricsError) {
          return;
        }
        const text = String(message || '').trim();
        boxMetricsError.textContent = text;
        boxMetricsError.classList.toggle('is-open', Boolean(text));
      };

      const closeBoxMetricsModal = () => {
        pendingBoxMetricsCode = '';
        pendingBoxMetricsIndex = 0;
        pendingBoxMetricsOnSave = null;
        pendingBoxMetricsOnCancel = null;
        setBoxMetricsError('');
        boxMetricsForm?.reset();
        boxMetricsModal?.classList.remove('is-open');
        boxMetricsModal?.setAttribute('aria-hidden', 'true');
      };

      const openBoxMetricsPrompt = (box, { boxIndex = 0, onSave = null, onCancel = null } = {}) => {
        pendingBoxMetricsCode = String(box?.code || '').trim();
        pendingBoxMetricsIndex = Number(boxIndex || 0);
        pendingBoxMetricsOnSave = typeof onSave === 'function' ? onSave : null;
        pendingBoxMetricsOnCancel = typeof onCancel === 'function' ? onCancel : null;
        const initialMetrics = getKnownBoxMetrics(box) || {};
        if (boxMetricsCaption) {
          const label = pendingBoxMetricsIndex > 0
            ? `Короб ${pendingBoxMetricsCode} (№ ${pendingBoxMetricsIndex})`
            : `Короб ${pendingBoxMetricsCode}`;
          boxMetricsCaption.textContent = `${label}: укажите вес и размеры для закрытия.`;
        }
        if (boxMetricsWeightInput) {
          boxMetricsWeightInput.value = formatMetricDisplay(box?.gross_weight_g || initialMetrics.gross_weight_g, 1000, 3);
        }
        if (boxMetricsHeightInput) {
          boxMetricsHeightInput.value = formatMetricDisplay(box?.height_mm || initialMetrics.height_mm, 10, 1);
        }
        if (boxMetricsWidthInput) {
          boxMetricsWidthInput.value = formatMetricDisplay(box?.width_mm || initialMetrics.width_mm, 10, 1);
        }
        if (boxMetricsDepthInput) {
          boxMetricsDepthInput.value = formatMetricDisplay(box?.depth_mm || initialMetrics.depth_mm, 10, 1);
        }
        setBoxMetricsError('');
        boxMetricsModal?.classList.add('is-open');
        boxMetricsModal?.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => boxMetricsWeightInput?.focus(), 0);
      };

      const saveBoxMetricsFromModal = () => {
        const box = getAnyBox(pendingBoxMetricsCode);
        if (!box) {
          closeBoxMetricsModal();
          renderAll();
          return;
        }
        const weightKg = parseMetricNumber(boxMetricsWeightInput?.value);
        const heightCm = parseMetricNumber(boxMetricsHeightInput?.value);
        const widthCm = parseMetricNumber(boxMetricsWidthInput?.value);
        const depthCm = parseMetricNumber(boxMetricsDepthInput?.value);
        if (!weightKg || !heightCm || !widthCm || !depthCm) {
          setBoxMetricsError('Заполните вес, высоту, ширину и глубину положительными значениями.');
          return;
        }
        applyBoxCharacteristics(box, {
          gross_weight_g: Math.round(weightKg * 1000),
          height_mm: Math.round(heightCm * 10),
          width_mm: Math.round(widthCm * 10),
          depth_mm: Math.round(depthCm * 10),
        });
        markDraftDirty();
        const onSave = pendingBoxMetricsOnSave;
        closeBoxMetricsModal();
        if (onSave) {
          onSave(box);
        }
      };

      const cancelBoxMetricsPrompt = () => {
        const onCancel = pendingBoxMetricsOnCancel;
        closeBoxMetricsModal();
        if (onCancel) {
          onCancel();
        }
      };

      const ensureBoxCharacteristics = (box, { allowPrompt = true, boxIndex = 0, onReady = null, onAbort = null } = {}) => {
        if (!box || getBoxItemsCount(box) <= 0) {
          return true;
        }
        if (hasCompleteBoxCharacteristics(box)) {
          return true;
        }
        const matchedBox = findMatchingClosedBox(box);
        if (matchedBox) {
          applyBoxCharacteristics(box, matchedBox);
          markDraftDirty();
          return true;
        }
        if (!allowPrompt) {
          state.activeBox = box.code;
          alert(`Сначала укажите вес и размеры для короба ${box.code}.`);
          if (typeof onAbort === 'function') {
            onAbort();
          }
          return false;
        }
        openBoxMetricsPrompt(box, { boxIndex, onSave: onReady, onCancel: onAbort });
        return false;
      };

      const sealReadyBox = (box, { boxIndex = 0, clearActive = true } = {}) => {
        if (!box || box.sealed) {
          return;
        }
        if (!String(box.fixed_label || '').trim()) {
          box.fixed_label = formatBoxDisplayNumber(boxIndex || findBoxPalletInfo(box.code).index || 0, box);
        }
        box.sealed = true;
        ensureBoxesBelongToPallets(box.code);
        if (clearActive && state.activeBox === box.code) {
          state.activeBox = '';
        }
        markDraftDirty();
      };

      function closePalletByCode(palletCode, autoNext = true, closerOverride = null, options = {}) {
        if (flowLocked) {
          return false;
        }
        const allowPrompt = options.allowPrompt === true;
        const continueClosing = () => {
          const pallet = getPallet(palletCode);
          if (!pallet || pallet.sealed) {
            renderAll();
            return false;
          }
          const palletBoxes = (pallet.boxes || [])
            .map((code) => getBox(code))
            .filter((box) => box);
          for (let index = 0; index < palletBoxes.length; index += 1) {
            const box = palletBoxes[index];
            if (!box || box.sealed || getBoxItemsCount(box) <= 0) {
              continue;
            }
            const ready = ensureBoxCharacteristics(box, {
              allowPrompt,
              boxIndex: index + 1,
              onReady: () => {
                sealReadyBox(box, { boxIndex: index + 1 });
                continueClosing();
              },
              onAbort: () => {
                renderAll();
              },
            });
            if (!ready) {
              state.activePallet = pallet.code;
              state.activeBox = box.code;
              renderAll();
              return false;
            }
            sealReadyBox(box, { boxIndex: index + 1 });
          }
          const emptyBoxCodes = new Set(
            palletBoxes
              .filter((box) => box && getBoxItemsCount(box) <= 0)
              .map((box) => box.code),
          );
          if (emptyBoxCodes.size) {
            state.boxes = state.boxes.filter((box) => !emptyBoxCodes.has(box.code));
            pallet.boxes = (pallet.boxes || []).filter((code) => !emptyBoxCodes.has(code));
            if (emptyBoxCodes.has(state.activeBox)) {
              state.activeBox = '';
            }
          }
          const refreshBoxes = () => (pallet.boxes || [])
            .map((code) => getBox(code))
            .filter((box) => box);
          const palletItemCount = getBoxItemsCount({ items: pallet.items || [] });
          const boxesItemCount = refreshBoxes().reduce(
            (sum, box) => sum + getBoxItemsCount(box),
            0,
          );
          if (directionalMode && palletItemCount + boxesItemCount > 0) {
            const directionName = getPalletDirection(pallet);
            if (!directionName) {
              alert('Для палеты не задано направление. Укажите направление и повторите.');
              playDirectionSignal('alarm');
              renderAll();
              return false;
            }
            const mixed = refreshBoxes().some((box) => {
              const boxDirection = getBoxDirection(box);
              return !!boxDirection && boxDirection !== directionName;
            });
            if (mixed) {
              alert('На палете найдены короба другого направления. Исправьте раскладку.');
              playDirectionSignal('alarm');
              renderAll();
              return false;
            }
            refreshBoxes().forEach((box) => {
              if (!getBoxDirection(box)) {
                setBoxDirection(box, directionName);
              }
            });
          }
          if (palletItemCount + boxesItemCount <= 0) {
            state.pallets = state.pallets.filter((entry) => entry.code !== pallet.code);
            if (state.activePallet === pallet.code) {
              state.activePallet = '';
            }
            if (state.activeBox && !getBox(state.activeBox)) {
              state.activeBox = '';
            }
            markDraftDirty();
            if (autoNext && hasRemaining()) {
              openNewPallet();
            }
            renderAll();
            return true;
          }
          pallet.sealed = true;
          const closerAgentId = closerOverride?.agent_id || agentId || '';
          const closerUserId = closerOverride?.user_id || currentUserId || '';
          const closerUserLabel = closerOverride?.user_label || currentUserLabel || '';
          pallet.closed_by_agent_id = closerAgentId;
          pallet.closed_by_user_id = closerUserId;
          pallet.closed_by_user_label = closerUserLabel;
          markDraftDirty();
          if (autoNext && hasRemaining()) {
            openNewPallet();
          }
          renderAll();
          return true;
        };
        return continueClosing();
      }

      function enforceSingleOpenPalletForUser(keepCode = '') {
        if (flowReopened || directionalMode) {
          return;
        }
        const currentOwnerKey = getCurrentOwnerKey();
        const openByOwner = new Map();
        const allPallets = getAllPallets();
        allPallets.forEach((pallet) => {
          if (!pallet || pallet.sealed) {
            return;
          }
          const ownerKey = getPalletOwnerKey(pallet);
          if (!ownerKey) {
            return;
          }
          if (!openByOwner.has(ownerKey)) {
            openByOwner.set(ownerKey, []);
          }
          openByOwner.get(ownerKey).push(pallet);
        });
        openByOwner.forEach((pallets, ownerKey) => {
          if (pallets.length <= 1) {
            return;
          }
          let keep = null;
          if (ownerKey === currentOwnerKey) {
            keep = pallets.find((pallet) => pallet.code === keepCode) || null;
            if (!keep && state.activePallet) {
              const active = getPallet(state.activePallet) || getAnyPallet(state.activePallet);
              if (active && !active.sealed && getPalletOwnerKey(active) === ownerKey) {
                keep = active;
              }
            }
          }
          if (!keep) {
            keep = pallets.reduce((best, candidate) => {
              const bestScore = best ? getPalletItemTotal(best) : -1;
              const candScore = getPalletItemTotal(candidate);
              if (candScore > bestScore) {
                return candidate;
              }
              if (candScore === bestScore) {
                return candidate;
              }
              return best;
            }, null);
          }
          pallets.forEach((pallet) => {
            if (keep && pallet.code === keep.code) {
              return;
            }
            const localPallet = ensureLocalPalletWithBoxes(pallet.code);
            if (!localPallet) {
              return;
            }
            const closerOverride = ownerKey === currentOwnerKey ? null : buildCloserOverrideFromOwner(localPallet);
            closePalletByCode(localPallet.code, false, closerOverride);
          });
          if (ownerKey === currentOwnerKey && keep) {
            state.activePallet = keep.code;
          }
        });
      }

      const getDirectionPlacedTotals = () => {
        const totals = {};
        getAllBoxes().forEach((box) => {
          const directionName = getBoxDirection(box) || getPalletDirection(getAnyPalletByBoxCode(box?.code));
          if (!directionName) {
            return;
          }
          const boxQty = getBoxItemsCount(box);
          totals[directionName] = Number(totals[directionName] || 0) + boxQty;
        });
        return totals;
      };
      const chooseNextPalletDirection = () => {
        if (!directionalMode) {
          return '';
        }
        const placedTotals = getDirectionPlacedTotals();
        for (const directionName of directionNames) {
          const planned = Number(directionTotalsPlan[directionName] || 0);
          if (planned <= 0) {
            continue;
          }
          if (Number(placedTotals[directionName] || 0) < planned) {
            return directionName;
          }
        }
        return directionNames[0] || '';
      };
      const ensureDirectionalPallet = (pallet, item = null) => {
        if (!directionalMode || !pallet) {
          return '';
        }
        let directionName = getPalletDirection(pallet);
        if (!directionName && item) {
          directionName = chooseDirectionForItem(item);
        }
        if (!directionName) {
          directionName = chooseNextPalletDirection();
        }
        if (directionName) {
          setPalletDirection(pallet, directionName);
        }
        return directionName;
      };
      const findOpenPalletByDirection = (directionName) => {
        const target = normalizeDirection(directionName);
        if (!target) {
          return null;
        }
        return state.pallets.find((pallet) => (
          pallet
          && !pallet.sealed
          && getPalletDirection(pallet) === target
          && isOwnedByCurrentUser(pallet)
        )) || null;
      };
      const ensureOpenBoxForDirection = (pallet, directionName) => {
        if (!pallet || pallet.sealed) {
          return null;
        }
        const target = normalizeDirection(directionName || getPalletDirection(pallet));
        const existing = (pallet.boxes || [])
          .map((code) => getBox(code))
          .find((box) => box && !box.sealed && (!target || getBoxDirection(box) === target));
        if (existing) {
          if (target && !getBoxDirection(existing)) {
            setBoxDirection(existing, target);
          }
          return existing;
        }
        const box = createBox();
        if (target) {
          setBoxDirection(box, target);
        }
        attachBoxToPallet(pallet, box);
        return box;
      };
      const ensureDirectionalContainersForAllDirections = () => {
        if (!directionalMode || flowLocked) {
          return false;
        }
        let changed = false;
        directionNames.forEach((directionName) => {
          let pallet = findOpenPalletByDirection(directionName);
          if (!pallet) {
            pallet = createPallet();
            setPalletDirection(pallet, directionName);
            changed = true;
          } else if (!getPalletDirection(pallet)) {
            setPalletDirection(pallet, directionName);
            changed = true;
          }
          const box = ensureOpenBoxForDirection(pallet, directionName);
          if (box && !getBoxDirection(box)) {
            setBoxDirection(box, directionName);
            changed = true;
          }
          if (!box) {
            changed = true;
          }
        });
        return changed;
      };
      const setActiveDirection = (directionName, rerender = true) => {
        if (!directionalMode) {
          return false;
        }
        const target = normalizeDirection(directionName);
        if (!target) {
          return false;
        }
        let changed = ensureDirectionalContainersForAllDirections();
        let pallet = findOpenPalletByDirection(target);
        if (!pallet) {
          pallet = createPallet();
          setPalletDirection(pallet, target);
          changed = true;
        }
        let box = ensureOpenBoxForDirection(pallet, target);
        if (!box) {
          box = createBox();
          setBoxDirection(box, target);
          attachBoxToPallet(pallet, box);
          changed = true;
        }
        if (state.activePallet !== pallet.code) {
          state.activePallet = pallet.code;
          changed = true;
        }
        if (state.activeBox !== box.code) {
          state.activeBox = box.code;
          changed = true;
        }
        if (changed) {
          markDraftDirty();
          if (rerender) {
            renderAll();
          }
        }
        return changed;
      };

      const openNewPallet = () => {
        enforceSingleOpenPalletForUser();
        const pallet = createPallet();
        const box = createBox();
        if (!pallet || !box) {
          return;
        }
        attachBoxToPallet(pallet, box);
        if (directionalMode) {
          ensureDirectionalPallet(pallet, null);
        }
        state.activePallet = pallet.code;
        state.activeBox = box.code;
      };

      const openNewBox = (pallet) => {
        if (!pallet || pallet.sealed) {
          return;
        }
        const box = createBox();
        if (!box) {
          return;
        }
        attachBoxToPallet(pallet, box);
        if (directionalMode) {
          const directionName = getPalletDirection(pallet);
          if (directionName) {
            setBoxDirection(box, directionName);
          }
        }
        state.activeBox = box.code;
      };

      const selectPalletByCode = (palletCode) => {
        const pallet = getPallet(palletCode);
        if (!pallet || pallet.sealed) {
          return false;
        }
        state.activePallet = pallet.code;
        const openBox = (pallet.boxes || [])
          .map((code) => getBox(code))
          .find((box) => box && !box.sealed);
        state.activeBox = openBox ? openBox.code : '';
        if (isOwnedByCurrentUser(pallet)) {
          enforceSingleOpenPalletForUser(pallet.code);
        }
        renderAll();
        return true;
      };

      const ensureOpenContainers = (forceOpen = false) => {
        if (directionalMode) {
          const changed = ensureDirectionalContainersForAllDirections();
          if (changed) {
            markDraftDirty();
          }
          let activeDirection = getActiveDirectionName();
          if (!activeDirection) {
            activeDirection = chooseNextPalletDirection() || (directionNames[0] || '');
          }
          if (activeDirection) {
            const switched = setActiveDirection(activeDirection, false);
            if (switched) {
              markDraftDirty();
            }
          }
          return;
        }
        const ownOpenPallet = state.pallets.find(
          (pallet) => pallet && !pallet.sealed && isOwnedByCurrentUser(pallet),
        ) || null;
        let activePallet = getPallet(state.activePallet);
        if (
          !activePallet
          || activePallet.sealed
          || !isOwnedByCurrentUser(activePallet)
        ) {
          activePallet = ownOpenPallet;
          if (!activePallet) {
            openNewPallet();
            return;
          }
          state.activePallet = activePallet ? activePallet.code : '';
        }
        const pallet = getPallet(state.activePallet);
        if (!pallet) {
          state.activeBox = '';
          return;
        }
        if (directionalMode && !getPalletDirection(pallet)) {
          ensureDirectionalPallet(pallet, null);
        }
        const openBox = (pallet.boxes || [])
          .map((code) => getBox(code))
          .find((box) => box && !box.sealed);
        if (!openBox && isOwnedByCurrentUser(pallet)) {
          openNewBox(pallet);
          return;
        }
        state.activeBox = openBox ? openBox.code : '';
      };

      const getPlacedMap = () => {
        const map = new Map();
        getAllBoxes().forEach((box) => {
          (box.items || []).forEach((item) => {
            const key = makeKey(item);
            const current = map.get(key) || 0;
            map.set(key, current + Number(item.qty || 0));
          });
        });
        return map;
      };

      const getRemaining = () => {
        const placedMap = getPlacedMap();
        const buildEntry = (item) => {
          const key = makeKey(item);
          const placed = placedMap.get(key) || 0;
          return {
            ...item,
            key,
            placed,
            remaining: item.qty - placed,
          };
        };
        const extras = extraItems.map((item) => buildEntry(item));
        const planned = plannedItems
          .filter((item) => !extraKeys.has(makeKey(item)))
          .map((item) => buildEntry(item));
        return [...extras, ...planned];
      };

      const addToBox = (item, qty) => {
        if (flowLocked) {
          return false;
        }
        let box = getBox(state.activeBox);
        if (!box || box.sealed) {
          return false;
        }
        let pallet = getPallet(state.activePallet);
        if (directionalMode) {
          if (!pallet || pallet.sealed) {
            return false;
          }
          let directionName = ensureDirectionalPallet(pallet, item);
          if (!directionName) {
            alert('Не удалось определить направление для активной палеты.');
            return false;
          }
          const targets = getDirectionTargetsForItem(item);
          if (hasDirectionTargets()) {
            let plannedQty = Number(targets[directionName] || 0);
            let placedQty = getPlacedQtyByDirection(item, directionName);
            if (plannedQty <= 0 || placedQty >= plannedQty) {
              const suggestedDirection = chooseDirectionForItem(item);
              if (suggestedDirection && suggestedDirection !== directionName) {
                setActiveDirection(suggestedDirection, false);
                pallet = getPallet(state.activePallet);
                box = getBox(state.activeBox);
                if (!pallet || !box || pallet.sealed || box.sealed) {
                  return false;
                }
                directionName = ensureDirectionalPallet(pallet, item);
                plannedQty = Number(targets[directionName] || 0);
                placedQty = getPlacedQtyByDirection(item, directionName);
              }
            }
            if (plannedQty <= 0) {
              alert(`Для направления "${directionName}" в плане нет этого товара.`);
              playDirectionSignal('alarm');
              return false;
            }
            const nextQty = placedQty + Number(qty || 0);
            if (nextQty > plannedQty) {
              alert(
                `Превышение по направлению "${directionName}": план ${plannedQty}, ` +
                `попытка ${nextQty}.`,
              );
              playDirectionSignal('alarm');
              return false;
            }
            if (nextQty === plannedQty) {
              playDirectionSignal('ok');
            }
          }
          const boxDirection = getBoxDirection(box);
          if (boxDirection && boxDirection !== directionName) {
            alert(`Короб закреплен за направлением "${boxDirection}".`);
            playDirectionSignal('alarm');
            return false;
          }
          setBoxDirection(box, directionName);
        }
        if (!Array.isArray(box.items)) {
          box.items = [];
        }
        const existing = (box.items || []).find((entry) => makeKey(entry) === item.key);
        if (existing) {
          existing.qty = Number(existing.qty || 0) + qty;
        } else {
          box.items.push({
            sku_code: item.sku_code,
            sku: item.sku_code,
            name: item.name,
            size: item.size,
            qty,
          });
        }
        clearBoxCharacteristics(box);
        markDraftDirty();
        return true;
      };
      const applyAddRow = (keepFocus) => {
        if (flowLocked || czRequired) {
          return;
        }
        const selected = addRowItem || getSelectedCatalogItem(addRowSku, addRowName, addRowSize);
        if (!selected) {
          return;
        }
        const rawQty = parseInt(addRowQty, 10);
        if (!Number.isFinite(rawQty) || rawQty <= 0) {
          return;
        }
        ensureOpenContainers(true);
        const planned = ensurePlannedItem(selected);
        if (!planned) {
          return;
        }
        const plannedKey = makeKey(planned);
        const added = addToBox({ ...planned, key: plannedKey }, rawQty);
        if (!added) {
          return;
        }
        manualInputByKey.set(plannedKey, '');
        addRowSku = '';
        addRowName = '';
        addRowSize = '';
        addRowQty = '';
        addRowItem = null;
        pendingAddRowFocus = keepFocus;
        suppressBlurApply = true;
        pendingFocusKey = '__add-row__';
        renderAll();
      };

      const setBoxItemQty = (item, qty) => {
        if (flowLocked) {
          return false;
        }
        const box = getBox(state.activeBox);
        if (!box || box.sealed) {
          return false;
        }
        if (!Array.isArray(box.items)) {
          box.items = [];
        }
        const existing = (box.items || []).find((entry) => makeKey(entry) === item.key);
        if (qty <= 0) {
          if (existing) {
            box.items = (box.items || []).filter((entry) => makeKey(entry) !== item.key);
          }
          return true;
        }
        if (existing) {
          existing.qty = qty;
        } else {
          box.items.push({
            sku_code: item.sku_code,
            sku: item.sku_code,
            name: item.name,
            size: item.size,
            qty,
          });
        }
        clearBoxCharacteristics(box);
        markDraftDirty();
        return true;
      };

      const removeFromBox = (key) => {
        if (flowLocked) {
          return;
        }
        const box = getBox(state.activeBox);
        if (!box || box.sealed) {
          return;
        }
        const beforeCount = (box.items || []).length;
        box.items = (box.items || []).filter((item) => makeKey(item) !== key);
        if ((box.items || []).length !== beforeCount) {
          clearBoxCharacteristics(box);
          markDraftDirty();
        }
      };

      const decreaseBoxItemQty = (key, qty) => {
        if (flowLocked) {
          return false;
        }
        if (!Number.isFinite(qty) || qty <= 0) {
          return false;
        }
        const box = getBox(state.activeBox);
        if (!box || box.sealed) {
          return false;
        }
        if (!Array.isArray(box.items)) {
          box.items = [];
        }
        const existing = (box.items || []).find((entry) => makeKey(entry) === key);
        if (!existing) {
          return false;
        }
        const current = Number(existing.qty || 0);
        const next = current - qty;
        if (next <= 0) {
          box.items = (box.items || []).filter((entry) => makeKey(entry) !== key);
        } else {
          existing.qty = next;
        }
        clearBoxCharacteristics(box);
        markDraftDirty();
        return true;
      };

      const closeBox = (autoNext = true, options = {}) => {
        if (flowLocked) {
          return false;
        }
        const box = getBox(state.activeBox);
        if (!box || box.sealed) {
          return false;
        }
        if (getBoxItemsCount(box) <= 0) {
          const boxCode = box.code;
          state.boxes = state.boxes.filter((entry) => entry.code !== boxCode);
          state.pallets.forEach((pallet) => {
            pallet.boxes = (pallet.boxes || []).filter((code) => code !== boxCode);
          });
          if (state.activeBox === boxCode) {
            state.activeBox = '';
          }
          markDraftDirty();
          if (autoNext && hasRemaining()) {
            const pallet = getPallet(state.activePallet);
            if (pallet && !pallet.sealed) {
              openNewBox(pallet);
            } else {
              openNewPallet();
            }
          }
          renderAll();
          return true;
        }
        const boxIndex = findBoxPalletInfo(box.code).index || 0;
        const finishClosing = () => {
          sealReadyBox(box, { boxIndex });
          if (autoNext && hasRemaining()) {
            const pallet = getPallet(state.activePallet);
            openNewBox(pallet);
          }
          renderAll();
        };
        const ready = ensureBoxCharacteristics(box, {
          allowPrompt: options.allowPrompt !== false,
          boxIndex,
          onReady: finishClosing,
          onAbort: () => {
            renderAll();
          },
        });
        if (!ready) {
          return false;
        }
        finishClosing();
        return true;
      };

      const closePallet = (autoNext = true, options = {}) => {
        return closePalletByCode(state.activePallet, autoNext, null, options);
      };

      const countClosablePalletBoxes = (pallet) => ((pallet?.boxes || [])
        .map((code) => getBox(code))
        .filter((box) => box && getBoxItemsCount(box) > 0)
        .length);

      const setPalletCloseError = (message) => {
        if (!palletCloseError) {
          return;
        }
        const text = String(message || '').trim();
        palletCloseError.textContent = text;
        palletCloseError.classList.toggle('is-open', Boolean(text));
      };

      const closePalletCloseModal = () => {
        pendingClosePalletCode = '';
        pendingClosePalletAutoNext = true;
        setPalletCloseError('');
        if (palletCloseInput) {
          palletCloseInput.value = '';
        }
        palletCloseModal?.classList.remove('is-open');
        palletCloseModal?.setAttribute('aria-hidden', 'true');
      };

      const openPalletCloseConfirm = (autoNext = true) => {
        if (flowLocked) {
          return;
        }
        const pallet = getPallet(state.activePallet);
        if (!pallet || pallet.sealed) {
          renderAll();
          return;
        }
        const expectedCount = countClosablePalletBoxes(pallet);
        if (expectedCount <= 0) {
          closePallet(autoNext);
          renderAll();
          return;
        }
        pendingClosePalletCode = String(pallet.code || '').trim();
        pendingClosePalletAutoNext = !!autoNext;
        if (palletCloseCaption) {
          palletCloseCaption.textContent = `Сколько коробов в палете ${String(pallet.code || '').trim()}?`;
        }
        setPalletCloseError('');
        if (palletCloseInput) {
          palletCloseInput.value = '';
        }
        palletCloseModal?.classList.add('is-open');
        palletCloseModal?.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => palletCloseInput?.focus(), 0);
      };

      const confirmPalletClose = () => {
        const target = getPallet(pendingClosePalletCode);
        if (!target) {
          closePalletCloseModal();
          renderAll();
          return;
        }
        const expectedCount = countClosablePalletBoxes(target);
        const rawCount = String(palletCloseInput?.value || '').trim();
        const submittedCount = Number(rawCount);
        if (!rawCount || !Number.isInteger(submittedCount) || submittedCount < 0) {
          setPalletCloseError('Введите целое количество коробов.');
          palletCloseInput?.focus();
          return;
        }
        if (submittedCount !== expectedCount) {
          setPalletCloseError('Количество не совпадает. Проверьте короба в палете и попробуйте снова.');
          palletCloseInput?.select();
          return;
        }
        state.activePallet = target.code;
        closePalletCloseModal();
        closePallet(pendingClosePalletAutoNext, { allowPrompt: true });
      };

      const cleanupEmpty = () => {
        const validBoxes = new Set();
        state.boxes = state.boxes.filter((box) => {
          const hasItems = (box.items || []).length > 0;
          if (hasItems || !box.sealed) {
            validBoxes.add(box.code);
          }
          return hasItems || !box.sealed;
        });
        state.pallets.forEach((pallet) => {
          pallet.boxes = (pallet.boxes || []).filter((code) => validBoxes.has(code));
        });
        ensureBoxesBelongToPallets();
        state.pallets = state.pallets.filter((pallet) => {
          if (!pallet.sealed) {
            return true;
          }
          return (pallet.items || []).length > 0 || (pallet.boxes || []).length > 0;
        });
      };

      const finalizeContainers = () => {
        const removedBoxes = new Set();
        state.boxes.forEach((box) => {
          if (getBoxItemsCount(box) <= 0) {
            removedBoxes.add(box.code);
            return;
          }
          box.sealed = true;
        });
        if (removedBoxes.size) {
          state.boxes = state.boxes.filter((box) => !removedBoxes.has(box.code));
        }
        ensureBoxesBelongToPallets();
        state.pallets.forEach((pallet) => {
          if (removedBoxes.size) {
            pallet.boxes = (pallet.boxes || []).filter((code) => !removedBoxes.has(code));
          }
          const directQty = getBoxItemsCount({ items: pallet.items || [] });
          const boxesQty = (pallet.boxes || [])
            .map((code) => getBox(code))
            .filter((box) => box)
            .reduce((sum, box) => sum + getBoxItemsCount(box), 0);
          if (directQty + boxesQty > 0) {
            pallet.sealed = true;
          }
        });
        state.pallets = state.pallets.filter((pallet) => {
          const directQty = getBoxItemsCount({ items: pallet.items || [] });
          const boxesQty = (pallet.boxes || [])
            .map((code) => getBox(code))
            .filter((box) => box)
            .reduce((sum, box) => sum + getBoxItemsCount(box), 0);
          return directQty + boxesQty > 0;
        });
        if (removedBoxes.has(state.activeBox)) {
          state.activeBox = '';
        }
        if (state.activePallet && !getPallet(state.activePallet)) {
          state.activePallet = '';
        }
      };

      const updateHidden = () => {
        cleanupEmpty();
        if (boxesInput) {
          boxesInput.value = JSON.stringify(state.boxes);
        }
        if (palletsInput) {
          palletsInput.value = JSON.stringify(state.pallets);
        }
      };

      const resetFlowState = () => {
        state.boxes = [];
        state.pallets = [];
        state.activeBox = '';
        state.activePallet = '';
      };
      const resetSharedFlowState = () => {
        sharedState.boxes = [];
        sharedState.pallets = [];
      };

      const loadFlowSession = async () => {
        flowSessionReady = false;
        flowSessionId = '';
        if (flowSessionIdInput) {
          flowSessionIdInput.value = '';
        }
        if (flowLocked) {
          flowSessionReady = true;
          renderAll();
          return;
        }
        try {
          const params = new URLSearchParams();
          if (agentId) {
            params.set('agent_id', agentId);
          }
          const url = params.toString() ? `${flowSessionUrl}?${params.toString()}` : flowSessionUrl;
          const resp = await fetch(url, {
            credentials: 'same-origin',
          });
          const data = await resp.json().catch(() => ({}));
          if (!resp.ok || !data || data.ok === false) {
            resetFlowState();
            renderAll();
            return;
          }
          resetFlowState();
          applyFlowState(data.flow_state || {});
          if (!flowLocked && (!state.boxes.length && !state.pallets.length)) {
            syncLocalFromShared();
          }
          enforceSingleOpenPalletForUser();
          flowSessionId = data.session_id || '';
          flowSessionReady = true;
          if (flowSessionIdInput) {
            flowSessionIdInput.value = flowSessionId;
          }
          renderAll();
        } catch (err) {
          resetFlowState();
          renderAll();
        }
      };

      let sharedFlowTimer = null;
      const scheduleSharedFlowPoll = (delay = 4000) => {
        if (sharedFlowTimer) {
          clearTimeout(sharedFlowTimer);
        }
        sharedFlowTimer = setTimeout(loadSharedFlowState, delay);
      };
      const loadSharedFlowState = async () => {
        if (!orderId || flowLocked) {
          scheduleSharedFlowPoll(8000);
          return;
        }
        const params = new URLSearchParams();
        if (agentId) {
          params.set('agent_id', agentId);
        }
        const url = params.toString() ? `${sharedFlowUrl}?${params.toString()}` : sharedFlowUrl;
        const preserveFocusedQtyInput = () => {
          const active = document.activeElement;
          if (!active || !active.classList || !active.classList.contains('qty-input')) {
            return;
          }
          const row = active.closest('tr[data-key]');
          if (!row) {
            return;
          }
          const rowKey = String(row.dataset.key || '').trim();
          if (!rowKey) {
            return;
          }
          const raw = String(active.value || '');
          const cleaned = raw.replace(/[^\d]/g, '');
          manualInputByKey.set(rowKey, cleaned);
          pendingFocusKey = rowKey;
          pendingFocusEl = null;
          suppressBlurApply = true;
        };
        try {
          const resp = await fetch(url, { credentials: 'same-origin' });
          const data = await resp.json().catch(() => ({}));
          if (resp.ok && data && data.ok) {
            resetSharedFlowState();
            applySharedFlowState(data.flow_state || {});
            if (!isSubmitting && Date.now() >= localOverrideUntil) {
              syncLocalFromShared();
              enforceSingleOpenPalletForUser();
            }
            preserveFocusedQtyInput();
            renderAll();
          }
        } catch (err) {
          // ignore polling errors
        } finally {
          scheduleSharedFlowPoll(4000);
        }
      };

      const getCsrfToken = () => {
        if (!formEl) {
          return '';
        }
        const tokenInput = formEl.querySelector('input[name="csrfmiddlewaretoken"]');
        return tokenInput ? tokenInput.value : '';
      };

      const saveDraft = () => {
        if (!formEl || !boxesInput || !palletsInput || isSubmitting) {
          return;
        }
        updateHidden();
        const data = new FormData();
        data.append('flow_action', 'draft');
        data.append('boxes_json', boxesInput.value || '[]');
        data.append('pallets_json', palletsInput.value || '[]');
        data.append('active_box', state.activeBox || '');
        data.append('active_pallet', state.activePallet || '');
        data.append('agent_id', agentId || '');
        if (flowSessionId) {
          data.append('flow_session_id', flowSessionId);
        }
        const csrfToken = getCsrfToken();
        const headers = csrfToken ? { 'X-CSRFToken': csrfToken } : {};
        fetch(window.location.pathname, {
          method: 'POST',
          headers,
          body: data,
          credentials: 'same-origin',
        }).catch(() => {});
      };

      const scheduleDraftSave = () => {
        if (!draftEnabled || isSubmitting) {
          return;
        }
        if (draftSaveTimer) {
          clearTimeout(draftSaveTimer);
        }
        draftSaveTimer = setTimeout(saveDraft, 400);
      };

      const markDraftDirty = () => {
        if (flowLocked || !flowSessionReady) {
          return;
        }
        localOverrideUntil = Date.now() + 2000;
        draftEnabled = true;
        scheduleDraftSave();
      };

      const updateSummary = () => {
        const remaining = getRemaining();
        const totalPlanned = remaining.reduce((sum, item) => sum + Number(item.qty || 0), 0);
        const totalPlaced = remaining.reduce((sum, item) => sum + Number(item.placed || 0), 0);
        const totalBoxes = getAllBoxes().filter((box) => (box.items || []).length > 0).length;
        const totalPallets = getAllPallets().filter((pallet) => (pallet.boxes || []).length > 0).length;
        const placedByDirection = getDirectionPlacedTotals();
        const activeDirection = getActiveDirectionName();
        const directionSummaryItems = directionalMode
          ? directionNames.map((directionName) => ({
            direction: directionName,
            placed: Number(placedByDirection[directionName] || 0),
            planned: Number(directionTotalsPlan[directionName] || 0),
          }))
          : [];
        const directionSummaryText = directionSummaryItems
          .map((entry) => `${entry.direction}: ${entry.placed}/${entry.planned || 0}`)
          .join(' · ');
        const directionSummaryHtml = directionSummaryItems
          .map((entry) => {
            const nameClass = activeDirection && entry.direction === activeDirection
              ? 'direction-name-strong'
              : 'direction-name';
            return `<span class="${nameClass}">${escapeInlineHtml(entry.direction)}</span>: ${entry.placed}/${entry.planned || 0}`;
          })
          .join(' · ');
        const baseSummaryText = `Принято ${totalPlaced} из ${totalPlanned}. Коробов: ${totalBoxes}. Палет: ${totalPallets}.`;
        if (summaryLine) {
          if (directionSummaryHtml) {
            summaryLine.innerHTML = `${baseSummaryText} Направления: ${directionSummaryHtml}.`;
          } else {
            summaryLine.textContent = baseSummaryText;
          }
        }
        if (directionBanner) {
          if (!directionalMode) {
            directionBanner.textContent = 'Режим по направлениям недоступен: не найдены данные распределения.';
          } else if (!directionSummaryText) {
            directionBanner.textContent = 'Режим раскоробовки по направлениям активен.';
          } else {
            directionBanner.innerHTML = `Режим по направлениям: ${directionSummaryHtml}.`;
          }
        }
      };

      const updateButtons = () => {
        const box = getBox(state.activeBox);
        const pallet = getPallet(state.activePallet);
        if (flowLocked) {
          if (closeBoxBtn) {
            closeBoxBtn.disabled = true;
          }
          if (closePalletBtn) {
            closePalletBtn.disabled = true;
          }
          if (finishBtn) {
            finishBtn.disabled = true;
          }
          return;
        }
        const canCloseBox = box && !box.sealed;
        const canClosePallet = pallet
          && !pallet.sealed
          && (!directionalMode || !!getPalletDirection(pallet));
        if (closeBoxBtn) {
          closeBoxBtn.disabled = !canCloseBox;
        }
        if (closePalletBtn) {
          closePalletBtn.disabled = !canClosePallet;
        }
        const remaining = getRemaining();
        const totalPlaced = remaining.reduce((sum, item) => sum + Number(item.placed || 0), 0);
        const missingTotal = remaining.reduce(
          (sum, item) => sum + Math.max(0, Number(item.remaining || 0)),
          0,
        );
        const overTotal = remaining.reduce(
          (sum, item) => sum + Math.max(0, -Number(item.remaining || 0)),
          0,
        );
        const hasMismatch = missingTotal > 0 || overTotal > 0;
        if (finishBtn) {
          finishBtn.disabled = !canFinishFlow || totalPlaced <= 0 || (hasMismatch && !canFinishFlowMismatch);
        }
      };

      const renderRemaining = () => {
        if (!remainingBody) {
          return;
        }
        pendingFocusEl = null;
        remainingItemByKey.clear();
        remainingBody.innerHTML = '';
        const remaining = getRemaining();
        renderRemainingHead();
        if (!czRequired) {
          const addRow = document.createElement('tr');
          if (directionalMode) {
            const dirCells = directionNames.map(() => '<td class="muted">-</td>').join('');
            addRow.innerHTML = `
              <td></td>
              <td></td>
              <td></td>
              ${dirCells}
              <td></td>
            `;
          } else {
            addRow.innerHTML = `
              <td></td>
              <td></td>
              <td></td>
              <td class="muted">-</td>
              <td class="muted">-</td>
              <td></td>
            `;
          }
          const skuCell = addRow.children[0];
          const nameCell = addRow.children[1];
          const sizeCell = addRow.children[2];
          const qtyCell = addRow.children[addRow.children.length - 1];
          const skuInput = document.createElement('input');
          const nameInput = document.createElement('input');
          const sizeInput = document.createElement('input');
          const qtyInput = document.createElement('input');
          skuInput.type = 'text';
          skuInput.className = 'catalog-input';
          skuInput.placeholder = 'SKU';
          skuInput.setAttribute('list', 'catalog-sku-list');
          skuInput.value = addRowSku;
          nameInput.type = 'text';
          nameInput.className = 'catalog-input';
          nameInput.placeholder = 'Наименование';
          nameInput.setAttribute('list', 'catalog-name-list');
          nameInput.value = addRowName;
          sizeInput.type = 'text';
          sizeInput.className = 'catalog-input';
          sizeInput.placeholder = 'Размер';
          sizeInput.setAttribute('list', 'catalog-size-list');
          sizeInput.value = addRowSize;
          if (flowLocked || czRequired) {
            skuInput.disabled = true;
            nameInput.disabled = true;
            sizeInput.disabled = true;
          }
          const updateAddRowItem = () => {
            addRowItem = getSelectedCatalogItem(addRowSku, addRowName, addRowSize);
            if (!addRowItem) {
              return;
            }
            if (!addRowSku && addRowItem.sku_code) {
              addRowSku = addRowItem.sku_code;
              skuInput.value = addRowSku;
            }
            if (!addRowName && addRowItem.name) {
              addRowName = addRowItem.name;
              nameInput.value = addRowName;
            }
            if (!addRowSize && addRowItem.size) {
              addRowSize = addRowItem.size;
              sizeInput.value = addRowSize;
            }
          };
          const handleAddRowEnter = (event) => {
            if (event.key !== 'Enter') {
              return;
            }
            event.preventDefault();
            if (addRowQty) {
              applyAddRow(true);
            } else {
              qtyInput.focus();
              qtyInput.select();
            }
          };
          skuInput.addEventListener('input', () => {
            addRowSku = skuInput.value;
            updateAddRowItem();
          });
          skuInput.addEventListener('change', () => {
            addRowSku = skuInput.value;
            updateAddRowItem();
          });
          skuInput.addEventListener('keydown', handleAddRowEnter);
          nameInput.addEventListener('input', () => {
            addRowName = nameInput.value;
            updateAddRowItem();
          });
          nameInput.addEventListener('change', () => {
            addRowName = nameInput.value;
            updateAddRowItem();
          });
          nameInput.addEventListener('keydown', handleAddRowEnter);
          sizeInput.addEventListener('input', () => {
            addRowSize = sizeInput.value;
            updateAddRowItem();
          });
          sizeInput.addEventListener('change', () => {
            addRowSize = sizeInput.value;
            updateAddRowItem();
          });
          sizeInput.addEventListener('keydown', handleAddRowEnter);
          qtyInput.type = 'number';
          qtyInput.min = '0';
          qtyInput.step = '1';
          qtyInput.className = 'qty-input';
          qtyInput.value = addRowQty;
          if (flowLocked || czRequired) {
            qtyInput.disabled = true;
          }
          qtyInput.addEventListener('input', () => {
            const raw = String(qtyInput.value || '');
            const cleaned = raw.replace(/[^\d]/g, '');
            qtyInput.value = cleaned;
            addRowQty = cleaned;
          });
          qtyInput.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              applyAddRow(true);
            }
          });
          qtyInput.addEventListener('blur', () => {
            if (suppressBlurApply) {
              return;
            }
            applyAddRow(false);
          });
          skuCell.appendChild(skuInput);
          nameCell.appendChild(nameInput);
          sizeCell.appendChild(sizeInput);
          qtyCell.appendChild(qtyInput);
          remainingBody.appendChild(addRow);
          if (pendingAddRowFocus) {
            pendingFocusKey = '__add-row__';
            pendingFocusEl = skuInput;
            pendingAddRowFocus = false;
          }
        }
        if (!remaining.length) {
          const row = document.createElement('tr');
          row.innerHTML = `<td colspan="${getRemainingColumnCount()}" class="muted">Нет данных.</td>`;
          remainingBody.appendChild(row);
          return;
        }
        remaining.forEach((item) => {
          remainingItemByKey.set(item.key, item);
          const row = document.createElement('tr');
          const remainingValue = item.remaining;
          const factValue = item.placed || 0;
          if (directionalMode) {
            const directionStats = getDirectionStatsForItem(item);
            const activeDirection = getActiveDirectionName();
            const directionCells = directionStats.map((stat, directionIdx) => {
              const headline = stat.planned > 0 ? `${stat.placed}/${stat.planned}` : (stat.placed > 0 ? `${stat.placed}/0` : '-');
              const detail = stat.planned > 0
                ? (stat.remaining > 0 ? `ост ${stat.remaining}` : 'готово')
                : (stat.placed > 0 ? 'вне плана' : '-');
              const boxMatches = collectDirectionBoxMatches(item, stat.direction);
              const hasAnyBox = boxMatches.length > 0;
              const hasMixedSizes = boxMatches.some((entry) => entry && entry.hasMixedSizes);
              const mixedEntry = boxMatches.find((entry) => entry && entry.hasMixedSizes && entry.box && entry.box.code);
              const mixGroupKey = mixedEntry ? `${stat.direction}::${mixedEntry.box.code}` : '';
              const isActive = !!activeDirection && stat.direction === activeDirection;
              const classNames = ['direction-cell', 'clickable'];
              if (isActive) {
                classNames.push('active');
              }
              if (hasAnyBox) {
                classNames.push('has-box');
              }
              if (hasMixedSizes) {
                classNames.push('mixed-sizes');
              }
              return `
                <td class="${classNames.join(' ')}" data-direction="${escapeInlineHtml(stat.direction)}" data-item-key="${escapeInlineHtml(item.key)}" data-direction-idx="${directionIdx}" data-mix-group="${escapeInlineHtml(mixGroupKey)}">
                  <span class="direction-value">${headline}</span>
                  <small>${detail}</small>
                </td>
              `;
            }).join('');
            row.innerHTML = `
              <td>${item.sku_code || '-'}</td>
              <td>${item.name || '-'}</td>
              <td>${item.size || '-'}</td>
              ${directionCells}
              <td></td>
            `;
          } else {
            row.innerHTML = `
              <td>${item.sku_code || '-'}</td>
              <td>${item.name || '-'}</td>
              <td>${item.size || '-'}</td>
              <td>${item.qty}</td>
              <td>${factValue}</td>
              <td></td>
            `;
          }
          row.dataset.key = item.key;
          if (Number(item.qty || 0) === Number(factValue || 0)) {
            row.classList.add('row-done');
          }
          if (highlightedKey && item.key === highlightedKey) {
            row.classList.add('row-scan');
          }
          const cell = row.querySelector('td:last-child');
          const actions = document.createElement('div');
          actions.className = 'row-actions';
          const input = document.createElement('input');
          input.type = 'number';
          input.min = '0';
          input.step = '1';
          input.className = 'qty-input';
            if (flowLocked || czRequired) {
              input.disabled = true;
            }
          const manualValue = manualInputByKey.get(item.key) || '';
          input.value = manualValue;
          if (flowLocked || czRequired) {
            input.disabled = true;
          }
          input.addEventListener('focus', () => {
            lastFocusedRowKey = item.key;
            if (!directionalMode) {
              return;
            }
            // Для "чистой" строки (еще не раскладывали) не прыгаем по направлениям:
            // работаем в том коробе/палете, который выбрал оператор.
            if (Number(item.placed || 0) <= 0) {
              return;
            }
            const focusDirection = chooseDirectionForItem(item, { forFocus: true });
            const currentDirection = getActiveDirectionName();
            if (!focusDirection || focusDirection === currentDirection) {
              return;
            }
            pendingFocusKey = item.key;
            pendingFocusEl = null;
            suppressBlurApply = true;
            const switched = setActiveDirection(focusDirection, true);
            if (!switched) {
              pendingFocusKey = '';
              pendingFocusEl = null;
              suppressBlurApply = false;
            }
          });
          input.addEventListener('input', () => {
            const raw = String(input.value || '');
            const cleaned = raw.replace(/[^\d]/g, '');
            input.value = cleaned;
            manualInputByKey.set(item.key, cleaned);
          });
            const applyInputValue = (keepFocus) => {
              if (czRequired) {
                return;
              }
              const storedValue = manualInputByKey.get(item.key);
            if (storedValue == null || storedValue === '') {
              return;
            }
            const raw = parseInt(storedValue, 10);
            if (!Number.isFinite(raw) || raw < 0) {
              return;
            }
            addToBox(item, raw);
            manualInputByKey.set(item.key, '');
            renderAll();
            if (keepFocus) {
              focusRowInput(item.key);
            }
          };
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              applyInputValue(true);
            }
          });
          input.addEventListener('blur', () => {
            if (suppressBlurApply) {
              return;
            }
            applyInputValue(false);
          });
          actions.appendChild(input);
          cell.appendChild(actions);
          remainingBody.appendChild(row);
          if (pendingFocusKey && item.key === pendingFocusKey) {
            pendingFocusEl = input;
          }
        });
        applyMixedSizeGroups();
      };

      const renderCurrentBox = () => {
        const box = getBox(state.activeBox);
        const activePallet = getPallet(state.activePallet);
        const directionName = getBoxDirection(box) || getPalletDirection(activePallet);
        if (currentBoxCode) {
          currentBoxCode.textContent = box ? box.code : '-';
        }
        if (currentBoxStatus) {
          const statusText = box && !box.sealed ? 'Открыт' : 'Закрыт';
          if (directionalMode) {
            currentBoxStatus.innerHTML = directionName
              ? `${statusText} · <span class="direction-name-strong">${escapeInlineHtml(directionName)}</span>`
              : `${statusText} · <span class="direction-inline missing">направление не задано</span>`;
            currentBoxStatus.classList.toggle('missing', !directionName);
          } else {
            currentBoxStatus.textContent = statusText;
            currentBoxStatus.classList.remove('missing');
          }
        }
        renderCurrentBoxQr(box);
        if (!currentBoxItems) {
          return;
        }
        currentBoxItems.innerHTML = '';
        if (!box || !(box.items || []).length) {
          const empty = document.createElement('div');
          empty.className = 'muted';
          empty.textContent = 'Товаров в коробе пока нет.';
          currentBoxItems.appendChild(empty);
          return;
        }
        (box.items || []).forEach((item) => {
          const itemKey = makeKey(item);
          const row = document.createElement('div');
          row.className = 'box-item';
          row.innerHTML = `
            <div>
              <strong>${item.name || item.sku_code || '-'}</strong>
              <small>${item.size || '-'} · <span class="box-qty">${item.qty} шт.</span></small>
            </div>
          `;
          const actions = document.createElement('div');
          actions.className = 'row-actions';
          const input = document.createElement('input');
          input.type = 'number';
          input.min = '0';
          input.step = '1';
          input.className = 'qty-input';
          input.dataset.adjustKey = itemKey;
          if (flowLocked || czRequired) {
            input.disabled = true;
          }
          const manualValue = boxAdjustByKey.get(itemKey) || '';
          input.value = manualValue;
          input.addEventListener('input', () => {
            const raw = String(input.value || '');
            const cleaned = raw.replace(/[^\d]/g, '');
            input.value = cleaned;
            boxAdjustByKey.set(itemKey, cleaned);
          });
          const applyAdjust = () => {
            if (czRequired) {
              return;
            }
            const storedValue = boxAdjustByKey.get(itemKey);
            if (storedValue == null || storedValue === '') {
              return;
            }
            const raw = parseInt(storedValue, 10);
            if (!Number.isFinite(raw) || raw <= 0) {
              return;
            }
            decreaseBoxItemQty(itemKey, raw);
            boxAdjustByKey.set(itemKey, '');
            renderAll();
          };
          input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
              event.preventDefault();
              applyAdjust();
            }
          });
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn';
          btn.textContent = 'Убрать лишнее';
          if (flowLocked || czRequired) {
            btn.disabled = true;
          }
          btn.addEventListener('click', () => {
            applyAdjust();
          });
          const printBtn = document.createElement('button');
          printBtn.type = 'button';
          printBtn.className = 'btn';
          printBtn.textContent = 'Печать';
          printBtn.addEventListener('click', () => {
            const previewWindow = window.open('', '_blank', 'width=520,height=620');
            if (!previewWindow) {
              alert('Разрешите всплывающие окна для печати.');
              return;
            }
            openBoxPrintPreview(previewWindow, ({ doc, qrPayload }) => {
              loadQrInPreview(doc, qrPayload);
            });
          });
          actions.appendChild(input);
          actions.appendChild(btn);
          actions.appendChild(printBtn);
          row.appendChild(actions);
          currentBoxItems.appendChild(row);
        });
      };

        const renderPallets = () => {
          if (!palletBoard) {
            return;
          }
          palletBoard.innerHTML = '';
          const allPallets = getSortedPallets();
          if (!allPallets.length) {
            const empty = document.createElement('div');
            empty.className = 'muted';
            empty.textContent = 'Палеты не созданы.';
            palletBoard.appendChild(empty);
            return;
          }
          const openPallets = [];
          const closedPallets = [];
          allPallets.forEach((pallet, palletIndex) => {
            const palletNumber = getPalletDisplayNumber(pallet) || (palletIndex + 1);
            if (flowLocked || pallet.sealed) {
              closedPallets.push({ pallet, palletNumber });
            } else {
              openPallets.push({ pallet, palletNumber });
            }
          });
          if (flowLocked) {
            openPallets.length = 0;
          }
          const activeDirectionName = directionalMode ? getActiveDirectionName() : '';
          openPallets.forEach(({ pallet, palletNumber }) => {
            const card = document.createElement('div');
            const isOwnPallet = isOwnPalletCode(pallet.code);
            const isActive = state.activePallet === pallet.code;
            const palletDirection = directionalMode ? inferDirectionForPallet(pallet, palletNumber) : '';
            const isDirectionMuted = directionalMode && !!activeDirectionName && palletDirection !== activeDirectionName;
            card.className = `pallet-card${pallet.sealed ? '' : ' is-open'}${isOwnPallet ? '' : ' readonly'}${isActive ? ' is-active' : ''}${isDirectionMuted ? ' direction-muted' : ''}`;
            card.dataset.palletCode = pallet.code || '';
            const openerLabel = resolveActorLabel(
              pallet.owner_user_label,
              pallet.owner_agent_id,
              pallet.owner_user_id,
              '',
            );
            const closerLabel = resolveActorLabel(
              pallet.closed_by_user_label,
              pallet.closed_by_agent_id,
              pallet.closed_by_user_id,
              '',
            );
            const openerInitials = getPackerInitials(openerLabel) || '-';
            const closerInitials = getPackerInitials(closerLabel) || '-';
            const boxCount = (pallet.boxes || []).length;
            const header = document.createElement('div');
            header.className = 'pallet-header';
            const palletLabel = `${palletNumber}.${pallet.code || '-'}`;
            const headerLeft = document.createElement('div');
            headerLeft.className = 'pallet-header-left';
            const badge = document.createElement('div');
            badge.className = 'pallet-badge';
            badge.innerHTML = `
              <div class="pallet-badge-top">${palletNumber}${openerInitials}/${closerInitials}</div>
              <div class="pallet-badge-bottom">${boxCount} кор.</div>
            `;
            const codeEl = document.createElement('div');
            codeEl.className = 'pallet-code';
            codeEl.textContent = palletLabel;
            headerLeft.appendChild(badge);
            headerLeft.appendChild(codeEl);
            if (directionalMode) {
              const dirEl = document.createElement('div');
              const directionName = palletDirection;
              const isActiveDirection = !!activeDirectionName && !!directionName && activeDirectionName === directionName;
              dirEl.className = `direction-inline${isActiveDirection ? ' active' : ''}${directionName ? '' : ' missing'}`;
              dirEl.textContent = directionName ? `→ ${directionName}` : '→ направление не задано';
              headerLeft.appendChild(dirEl);
            }
            header.appendChild(headerLeft);
            if (pallet.sealed) {
              const statusEl = document.createElement('div');
              statusEl.className = 'pallet-status';
              statusEl.textContent = 'Закрыта';
              header.appendChild(statusEl);
              card.title = `Открыл: ${openerLabel || 'Не указано'} · Закрыл: ${closerLabel || 'Не указано'}`;
            }
            card.appendChild(header);
            const grid = document.createElement('div');
            grid.className = 'box-grid';
            (pallet.boxes || []).forEach((code, index) => {
              const box = getAnyBox(code);
              const isOwnBox = isOwnBoxCode(code);
              const chip = document.createElement('div');
              const boxIndex = index + 1;
              const boxDirection = directionalMode ? normalizeDirection(getBoxDirection(box) || palletDirection) : '';
              const isBoxDirectionMuted = directionalMode && !!activeDirectionName && boxDirection !== activeDirectionName;
              chip.className = `box-chip ${box && box.sealed ? 'closed' : 'open'}${isOwnBox ? '' : ' readonly'}${isBoxDirectionMuted ? ' direction-muted' : ''}`;
              chip.dataset.boxCode = code;
              const displayNumber = formatBoxDisplayNumber(boxIndex, box);
              const countLabel = `${getBoxItemsCount(box)} шт.`;
              const numberEl = document.createElement('div');
              numberEl.className = 'box-chip-number';
              numberEl.textContent = displayNumber;
              const countEl = document.createElement('div');
              countEl.className = 'box-chip-count';
              countEl.textContent = countLabel;
              chip.appendChild(numberEl);
              chip.appendChild(countEl);
              if (isOwnBox) {
                chip.title = `${displayNumber} · ${code}`;
              } else {
                const ownerLabel = box?.owner_user_label || box?.owner_agent_id || 'другой пользователь';
                chip.title = `${displayNumber} · ${code} · ${ownerLabel}`;
              }
              const canDrag = !flowLocked && !pallet.sealed && canReassignBoxes;
              if (canDrag) {
                chip.draggable = true;
                chip.addEventListener('dragstart', (event) => {
                  event.dataTransfer.setData('text/plain', code);
                  event.dataTransfer.effectAllowed = 'move';
                  chip.classList.add('dragging');
                });
                chip.addEventListener('dragend', () => {
                  chip.classList.remove('dragging');
                });
              }
              grid.appendChild(chip);
            });
            headerLeft.appendChild(grid);
            card.addEventListener('click', (event) => {
              if (event.target.closest('.box-chip')) {
                return;
              }
              selectPalletByCode(pallet.code);
            });
            const canDrop = !flowLocked && !pallet.sealed && canReassignBoxes;
            if (canDrop) {
              card.addEventListener('dragover', (event) => {
                event.preventDefault();
                if (event.dataTransfer) {
                  event.dataTransfer.dropEffect = 'move';
                }
                card.classList.add('drag-over');
              });
              card.addEventListener('dragleave', () => {
                card.classList.remove('drag-over');
              });
              card.addEventListener('drop', (event) => {
                event.preventDefault();
                card.classList.remove('drag-over');
                const boxCode = event.dataTransfer.getData('text/plain') || '';
                moveBoxToPallet(boxCode, pallet.code || '');
              });
            }
            palletBoard.appendChild(card);
          });
        if (closedPallets.length) {
          const title = document.createElement('div');
          title.className = 'pallet-closed-title';
          title.textContent = 'Закрытые палеты';
          palletBoard.appendChild(title);
            const grid = document.createElement('div');
            grid.className = 'pallet-closed-grid';
              closedPallets.forEach(({ pallet, palletNumber }) => {
                const chip = document.createElement('div');
                chip.className = 'pallet-chip';
                const openerLabel = resolveActorLabel(
                  pallet.owner_user_label,
                  pallet.owner_agent_id,
                  pallet.owner_user_id,
                  '',
                );
                const closerLabel = resolveActorLabel(
                  pallet.closed_by_user_label,
                  pallet.closed_by_agent_id,
                  pallet.closed_by_user_id,
                  '',
                );
                const openerInitials = getPackerInitials(openerLabel) || '-';
                const closerInitials = getPackerInitials(closerLabel) || '-';
                const boxCount = (pallet.boxes || []).length;
                chip.innerHTML = `
                  <div class="pallet-chip-top">${palletNumber}${openerInitials}/${closerInitials}</div>
                  <div class="pallet-chip-bottom">${boxCount} кор.</div>
                `;
                const locationLabel = formatLocationLabel(pallet.location);
              const directionName = inferDirectionForPallet(pallet, palletNumber);
              const baseParts = [pallet.code || ''];
              if (locationLabel) {
                baseParts.push(locationLabel);
              }
              if (directionName) {
                baseParts.push(`направление ${directionName}`);
              }
              const baseTitle = baseParts.filter(Boolean).join(' · ');
              chip.title = `${baseTitle} · Открыл: ${openerLabel || 'Не указано'} · Закрыл: ${closerLabel || 'Не указано'}`;
              chip.dataset.palletCode = pallet.code || '';
              chip.addEventListener('click', (event) => {
                event.stopPropagation();
                openPalletViewModal(pallet.code || '');
              });
              grid.appendChild(chip);
            });
          palletBoard.appendChild(grid);
        }
      };

      const renderClosedBoxes = () => {
        if (!closedBoxesEl) {
          return;
        }
        closedBoxesEl.innerHTML = '';
        const closedBoxes = getAllBoxes().filter((box) => box.sealed).slice().reverse();
        if (!closedBoxes.length) {
          const empty = document.createElement('div');
          empty.className = 'muted';
          empty.textContent = 'Закрытых коробов пока нет.';
          closedBoxesEl.appendChild(empty);
          return;
        }
        if (!directionalMode) {
          closedBoxes.forEach((box) => {
            const total = (box.items || []).reduce((sum, item) => sum + Number(item.qty || 0), 0);
            const info = findBoxPalletInfo(box.code);
            const palletNumber = info.palletIndex || 0;
            const boxLabel = formatBoxDisplayNumber(info.index || 0, box);
            const label = palletNumber ? `${palletNumber}.${boxLabel}` : `${boxLabel}`;
            const row = document.createElement('div');
            const isOwnBox = isOwnBoxCode(box.code);
            row.className = `closed-box${isOwnBox ? '' : ' readonly'}`;
            row.dataset.boxCode = box.code;
            if (isOwnBox) {
              row.title = `${boxLabel} · ${box.code}`;
            } else {
              const ownerLabel = box?.owner_user_label || box?.owner_agent_id || 'другой пользователь';
              row.title = `${boxLabel} · ${box.code} · ${ownerLabel}`;
            }
            row.innerHTML = `<span>${label}</span><span>${total} шт.</span>`;
            closedBoxesEl.appendChild(row);
          });
          return;
        }
        const directionOrder = new Map(
          directionNames.map((name, idx) => [normalizeDirection(name), idx]),
        );
        const groupsByDirection = new Map();
        closedBoxes.forEach((box) => {
          const total = (box.items || []).reduce((sum, item) => sum + Number(item.qty || 0), 0);
          const info = findBoxPalletInfo(box.code);
          const pallet = info.palletCode ? getAnyPallet(info.palletCode) : null;
          const inferredPalletDirection = inferDirectionForPallet(pallet, info.palletIndex || 0);
          const directionName = normalizeDirection(getBoxDirection(box) || inferredPalletDirection) || 'Без направления';
          const directionKey = normalizeDirection(directionName) || '__no_direction__';
          const palletCode = info.palletCode || '';
          const palletKey = palletCode || '__no_pallet__';
          const boxLabel = formatBoxDisplayNumber(info.index || 0, box);
          if (!groupsByDirection.has(directionKey)) {
            groupsByDirection.set(directionKey, {
              directionName,
              directionRank: directionOrder.has(directionKey) ? directionOrder.get(directionKey) : 9999,
              pallets: new Map(),
            });
          }
          const directionGroup = groupsByDirection.get(directionKey);
          if (!directionGroup.pallets.has(palletKey)) {
            directionGroup.pallets.set(palletKey, {
              palletCode,
              palletIndex: Number(info.palletIndex || 0),
              boxes: [],
            });
          }
          directionGroup.pallets.get(palletKey).boxes.push({
            box,
            total,
            info,
            boxLabel,
          });
        });
        const directionGroups = Array.from(groupsByDirection.values()).sort((left, right) => {
          if (left.directionRank !== right.directionRank) {
            return left.directionRank - right.directionRank;
          }
          return String(left.directionName || '').localeCompare(String(right.directionName || ''), 'ru');
        });
        directionGroups.forEach((directionGroup) => {
          const directionEl = document.createElement('div');
          directionEl.className = 'closed-direction-group';
          const directionTitle = document.createElement('div');
          directionTitle.className = 'closed-direction-title';
          directionTitle.textContent = directionGroup.directionName || 'Без направления';
          directionEl.appendChild(directionTitle);

          const palletGroups = Array.from(directionGroup.pallets.values()).sort((left, right) => {
            if (left.palletIndex !== right.palletIndex) {
              return left.palletIndex - right.palletIndex;
            }
            return String(left.palletCode || '').localeCompare(String(right.palletCode || ''), 'ru');
          });
          palletGroups.forEach((palletGroup) => {
            const palletEl = document.createElement('div');
            palletEl.className = 'closed-pallet-group';
            const palletTitle = document.createElement('div');
            palletTitle.className = 'closed-pallet-title';
            const directionLabel = directionGroup.directionName || 'Без направления';
            if (palletGroup.palletCode) {
              palletTitle.textContent = `Палета ${palletGroup.palletIndex || '-'} · ${palletGroup.palletCode} → ${directionLabel}`;
            } else {
              palletTitle.textContent = `Палета не задана → ${directionLabel}`;
            }
            palletEl.appendChild(palletTitle);

            const boxList = document.createElement('div');
            boxList.className = 'closed-pallet-boxes';
            palletGroup.boxes.forEach((entry) => {
              const row = document.createElement('div');
              const isOwnBox = isOwnBoxCode(entry.box.code);
              row.className = `closed-box${isOwnBox ? '' : ' readonly'}`;
              row.dataset.boxCode = entry.box.code;
              const label = `${entry.boxLabel}`;
              if (isOwnBox) {
                row.title = `${entry.boxLabel} · ${entry.box.code}`;
              } else {
                const ownerLabel = entry.box?.owner_user_label || entry.box?.owner_agent_id || 'другой пользователь';
                row.title = `${entry.boxLabel} · ${entry.box.code} · ${ownerLabel}`;
              }
              row.innerHTML = `<span>${label}</span><span>${entry.total} шт.</span>`;
              boxList.appendChild(row);
            });
            palletEl.appendChild(boxList);
            directionEl.appendChild(palletEl);
          });
          closedBoxesEl.appendChild(directionEl);
        });
      };

      const renderAll = () => {
        if (!flowLocked && flowSessionReady) {
          ensureOpenContainers();
        }
        seedPlannedFromBoxes();
        ensureFixedPalletOrders();
        cleanupEmpty();
        renderRemaining();
        renderCurrentBox();
        renderPallets();
        renderClosedBoxes();
        updateSummary();
        updateButtons();
        updateHidden();
        if (currentBoxSection) {
          currentBoxSection.classList.toggle('is-hidden', flowLocked);
        }
        if (activePalletCode) {
          activePalletCode.textContent = state.activePallet || '-';
        }
        if (activeBoxCode) {
          activeBoxCode.textContent = state.activeBox || '-';
        }
        applyPendingFocus();
      };

      const flashScan = (key) => {
        const nextKey = key || '';
        if (!nextKey) {
          return;
        }
        highlightedKey = nextKey;
        if (highlightTimer) {
          clearTimeout(highlightTimer);
        }
        highlightTimer = setTimeout(() => {
          if (highlightedKey !== nextKey) {
            return;
          }
          highlightedKey = '';
          if (!remainingBody) {
            return;
          }
          const safeKey = typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(nextKey) : nextKey;
          const row = remainingBody.querySelector(`tr[data-key="${safeKey}"]`);
          if (row) {
            row.classList.remove('row-scan');
          }
        }, 1500);
      };

      const focusRowInput = (key) => {
        if (!remainingBody || !key) {
          return false;
        }
        const row = remainingBody.querySelector(`tr[data-key="${key}"]`);
        if (!row) {
          return false;
        }
        const input = row.querySelector('input.qty-input');
        if (input) {
          input.focus();
          input.select();
          return true;
        }
        return false;
      };

      const applyPendingFocus = () => {
        if (!pendingFocusKey) {
          return;
        }
        const key = pendingFocusKey;
        const target = pendingFocusEl;
        let attempts = 0;
        const finalize = () => {
          pendingFocusKey = '';
          pendingFocusEl = null;
          setTimeout(() => {
            suppressBlurApply = false;
          }, 0);
        };
        const focusTarget = () => {
          if (target && document.body.contains(target)) {
            target.focus();
            target.select();
            return true;
          }
          return focusRowInput(key);
        };
        const tryFocus = () => {
          if (focusTarget()) {
            finalize();
            return;
          }
          attempts += 1;
          if (attempts < 3) {
            requestAnimationFrame(tryFocus);
          } else {
            finalize();
          }
        };
        requestAnimationFrame(tryFocus);
      };

      const setScannerStatus = (text, isError) => {
        if (!scannerStatus) {
          return;
        }
        scannerStatus.textContent = text;
        scannerStatus.style.color = isError ? 'var(--danger)' : '';
      };
      const setScannerStatusIfIdle = (text, isError, force) => {
        if (!scannerStatus) {
          return;
        }
        const current = String(scannerStatus.textContent || '').trim().toLowerCase();
        const idleStates = new Set(['ожидаю чз', 'ожидаю штрихкод', 'ожидание', '']);
        if (force || idleStates.has(current)) {
          setScannerStatus(text, isError);
        }
      };
      const describeScannerState = (data) => {
        const ready = data && typeof data.scanner_ready === 'boolean' ? data.scanner_ready : null;
        const reason = String((data && data.scanner_reason) || '').trim();
        const port = String((data && data.scanner_port) || '').trim();
        const error = String((data && data.scanner_error) || '').trim();
        if (ready === true) {
          return { text: 'Сканер готов', level: 'ok' };
        }
        if (reason === 'disabled') {
          return { text: 'Сканер выключен в агенте', level: 'warn' };
        }
        if (reason === 'port_missing') {
          return { text: 'Не выбран COM порт', level: 'warn' };
        }
        if (reason === 'port_not_found') {
          return { text: `COM порт не найден${port ? ` (${port})` : ''}`, level: 'error' };
        }
        if (reason === 'not_connected') {
          return { text: 'Нет соединения со сканером', level: 'warn' };
        }
        if (reason === 'error' || error) {
          return { text: `Ошибка сканера${error ? `: ${error}` : ''}`, level: 'error' };
        }
        if (ready === false) {
          return { text: 'Сканер не готов', level: 'warn' };
        }
        return { text: 'Сканер: нет данных', level: 'muted' };
      };
      const applyScannerState = (data, agentOnline) => {
        const selected = agentSelect ? agentSelect.selectedOptions[0] : null;
        const agentLabel = selected
          ? (selected.dataset.title || selected.value || agentId || 'агент')
          : (agentId || 'агент');
        updateSelectedAgentDataset({
          online: agentOnline,
          status: agentOnline ? 'онлайн' : 'нет связи',
          lastSeen: data && data.agent_last_seen ? String(data.agent_last_seen) : '',
        });
        setAgentStatus(`${agentLabel} · ${agentOnline ? 'онлайн' : 'нет связи'}`, !agentOnline);
        if (!agentOnline) {
          setAgentIndicator('error', 'нет связи');
          setScannerStatusIfIdle('Агент не в сети', true, false);
          return;
        }
        const scannerState = describeScannerState(data);
        const isError = scannerState.level === 'error';
        const isWarn = scannerState.level === 'warn';
        if (scannerState.level === 'ok') {
          setAgentIndicator('ok', 'готов');
        } else if (isError) {
          setAgentIndicator('error', 'ошибка');
        } else if (isWarn) {
          setAgentIndicator('warn', 'не готов');
        } else {
          setAgentIndicator('muted', 'нет данных');
        }
        setScannerStatusIfIdle(scannerState.text, isError, false);
      };
        const scanSourceLabels = {
          enter: 'Enter',
          input: 'Ввод',
          idle: 'Пауза',
          tab: 'Tab',
          agent: 'Агент',
        };
        const updateScanTest = (value, source, detected) => {
          const text = String(value || '').trim();
          if (!text) {
            return;
          }
          if (scanTestCode) {
            scanTestCode.textContent = text;
          }
          if (scanTestLength) {
            scanTestLength.textContent = String(text.length);
          }
        if (scanTestSource) {
          const label = scanSourceLabels[source] || source || '-';
          scanTestSource.textContent = label;
          if (detected && typeof appendSerialRaw === 'function') {
            appendSerialRaw(label, text);
          }
        }
        if (scanTestDetected) {
          scanTestDetected.textContent = detected == null ? '-' : (detected ? 'да' : 'нет');
        }
        if (scanTestTime) {
          scanTestTime.textContent = new Date().toLocaleTimeString('ru-RU');
        }
      };
      const clearScanTest = () => {
        if (scanTestCode) {
          scanTestCode.textContent = '-';
        }
        if (scanTestLength) {
          scanTestLength.textContent = '-';
        }
        if (scanTestSource) {
          scanTestSource.textContent = '-';
        }
        if (scanTestDetected) {
          scanTestDetected.textContent = '-';
        }
        if (scanTestTime) {
          scanTestTime.textContent = '-';
        }
      };
      if (scanTestClear) {
        scanTestClear.addEventListener('click', clearScanTest);
      }

      const escapeHtml = (value) =>
        String(value || '').replace(/[&<>"']/g, (char) => {
          const map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          };
          return map[char] || char;
        });

      const ensureMainQrLib = (callback) => {
        if (window.QRCode) {
          if (typeof callback === 'function') {
            callback();
          }
          return;
        }
        if (mainQrFailed) {
          console.error('QR lib unavailable; previous load failed.', {
            boxCode: getBox(state.activeBox)?.code || '',
          });
          return;
        }
        if (typeof callback === 'function') {
          mainQrQueue.push(callback);
        }
        if (mainQrLoading) {
          return;
        }
        mainQrLoading = true;
        const script = document.createElement('script');
        script.src = '/static/vendor/qrcode.min.js';
        script.onload = () => {
          mainQrLoading = false;
          console.info('QR lib loaded.', { src: script.src });
          const queue = mainQrQueue.splice(0, mainQrQueue.length);
          queue.forEach((fn) => fn());
        };
        script.onerror = () => {
          mainQrLoading = false;
          mainQrFailed = true;
          console.error('QR lib failed to load.', { src: script.src });
          mainQrQueue.length = 0;
        };
        document.head.appendChild(script);
      };

      const renderCurrentBoxQr = (box) => {
        if (!currentBoxQr) {
          return;
        }
        currentBoxQr.innerHTML = '';
        const placeholder = document.createElement('div');
        placeholder.className = 'qr-placeholder';
        placeholder.textContent = 'QR...';
        currentBoxQr.appendChild(placeholder);
        if (!box || !box.code) {
          placeholder.textContent = 'Нет открытого короба';
          console.warn('QR render skipped: no active box code.');
          return;
        }
        if (!window.QRCode) {
          if (mainQrFailed) {
            placeholder.textContent = 'QR не загружен';
            console.error('QR render failed: QR lib missing after load.', {
              boxCode: box.code,
            });
          } else {
            console.warn('QR lib missing; loading.', { boxCode: box.code });
            ensureMainQrLib(() => renderCurrentBoxQr(box));
          }
          return;
        }
        const qrBox = document.createElement('div');
        qrBox.className = 'qr-box';
        currentBoxQr.appendChild(qrBox);
        const size = Math.max(
          120,
          Math.min(currentBoxQr.clientWidth || 160, currentBoxQr.clientHeight || 160)
        );
        try {
          new QRCode(qrBox, {
            text: String(box.code),
            width: size,
            height: size,
            correctLevel: QRCode.CorrectLevel.M,
          });
          placeholder.style.display = 'none';
        } catch (error) {
          placeholder.textContent = 'QR не загружен';
          console.error('QR render error.', { boxCode: box.code, error });
        }
      };

      const loadQrInPreview = (previewWindow, qrPayload) => {
        if (!previewWindow || !previewWindow.document) {
          return;
        }
        const doc = previewWindow.document;
        const payload = String(qrPayload || '').trim();
        const setPlaceholder = (ready) => {
          const placeholder = doc.getElementById('qr-placeholder');
          if (!placeholder) {
            return;
          }
          placeholder.textContent = ready ? '' : 'QR не загружен';
          placeholder.style.display = ready ? 'none' : 'grid';
        };
        const render = () => {
          const qrBox = doc.getElementById('qr-box');
          if (!previewWindow.QRCode || !qrBox) {
            setPlaceholder(false);
            return;
          }
          if (!payload) {
            setPlaceholder(false);
            return;
          }
          qrBox.innerHTML = '';
          new previewWindow.QRCode(qrBox, {
            text: payload,
            width: 240,
            height: 240,
            correctLevel: previewWindow.QRCode.CorrectLevel.M,
          });
          setPlaceholder(true);
          setTimeout(() => {
            previewWindow.focus();
            previewWindow.print();
          }, 80);
        };
        const loadScript = () => {
          if (previewWindow.QRCode) {
            render();
            return;
          }
          const existing = doc.getElementById('qr-lib-loader');
          if (existing) {
            existing.addEventListener('load', render, { once: true });
            return;
          }
          const script = doc.createElement('script');
          script.id = 'qr-lib-loader';
          script.src = window.location.origin + '/static/vendor/qrcode.min.js';
          script.onload = () => render();
          script.onerror = () => {
            setPlaceholder(false);
          };
          const target = doc.head || doc.body;
          if (target) {
            target.appendChild(script);
          } else {
            setPlaceholder(false);
          }
        };
        const start = () => {
          if (!payload) {
            setPlaceholder(false);
            return;
          }
          loadScript();
        };
        if (doc.readyState === 'loading') {
          doc.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      };

      const loadQrBatchInPreview = (previewWindow, payloads) => {
        if (!previewWindow || !previewWindow.document) {
          return;
        }
        const doc = previewWindow.document;
        const list = Array.isArray(payloads) ? payloads : [];
        const setPlaceholder = (placeholder, ready) => {
          if (!placeholder) {
            return;
          }
          placeholder.textContent = ready ? '' : 'QR не загружен';
          placeholder.style.display = ready ? 'none' : 'grid';
        };
        const render = () => {
          if (!previewWindow.QRCode) {
            list.forEach((_, index) => {
              const placeholder = doc.getElementById(`qr-placeholder-${index}`);
              setPlaceholder(placeholder, false);
            });
            return;
          }
          list.forEach((payload, index) => {
            const qrBox = doc.getElementById(`qr-box-${index}`);
            const placeholder = doc.getElementById(`qr-placeholder-${index}`);
            const text = String(payload || '').trim();
            if (!qrBox || !text) {
              setPlaceholder(placeholder, false);
              return;
            }
            qrBox.innerHTML = '';
            new previewWindow.QRCode(qrBox, {
              text,
              width: 240,
              height: 240,
              correctLevel: previewWindow.QRCode.CorrectLevel.M,
            });
            setPlaceholder(placeholder, true);
          });
          setTimeout(() => {
            previewWindow.focus();
            previewWindow.print();
          }, 80);
        };
        const loadScript = () => {
          if (previewWindow.QRCode) {
            render();
            return;
          }
          const existing = doc.getElementById('qr-lib-loader');
          if (existing) {
            existing.addEventListener('load', render, { once: true });
            return;
          }
          const script = doc.createElement('script');
          script.id = 'qr-lib-loader';
          script.src = window.location.origin + '/static/vendor/qrcode.min.js';
          script.onload = () => render();
          script.onerror = () => {
            list.forEach((_, index) => {
              const placeholder = doc.getElementById(`qr-placeholder-${index}`);
              setPlaceholder(placeholder, false);
            });
          };
          const target = doc.head || doc.body;
          if (target) {
            target.appendChild(script);
          }
        };
        const start = () => {
          if (!list.length) {
            return;
          }
          loadScript();
        };
        if (doc.readyState === 'loading') {
          doc.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      };

      const findBoxPalletInfo = (boxCode) => {
        const pallets = getSortedPallets();
        for (let palletIndex = 0; palletIndex < pallets.length; palletIndex += 1) {
          const pallet = pallets[palletIndex];
          const codes = pallet.boxes || [];
          const index = codes.indexOf(boxCode);
          if (index >= 0) {
            return {
              index: index + 1,
              total: codes.length,
              palletCode: pallet.code,
              palletIndex: getPalletDisplayNumber(pallet) || (palletIndex + 1),
            };
          }
        }
        return { index: 0, total: 0, palletCode: '', palletIndex: 0 };
      };

      let contextMenuBoxCode = '';
      let contextMenuPalletCode = '';
      let locationModalPalletCode = '';
      let copyModalBoxCode = '';
      const closeContextMenu = () => {
        if (!contextMenu) {
          return;
        }
        contextMenu.classList.remove('is-open');
        contextMenu.setAttribute('aria-hidden', 'true');
        contextMenuBoxCode = '';
      };
      const closePalletContextMenu = () => {
        if (!palletContextMenu) {
          return;
        }
        palletContextMenu.classList.remove('is-open');
        palletContextMenu.setAttribute('aria-hidden', 'true');
        contextMenuPalletCode = '';
      };

      const formatLocationLabel = (location) => {
        if (!location) {
          return '';
        }
        const zone = String(location.zone || '').trim();
        const row = String(location.row || '').trim();
        const section = String(location.section || '').trim();
        const tier = String(location.tier || '').trim();
        const cell = String(location.cell || '').trim();
        const parts = [];
        if (zone) {
          parts.push(zone);
        }
        if (row) {
          parts.push(`ряд ${row}`);
        }
        if (section) {
          parts.push(`сек ${section}`);
        }
        if (tier) {
          parts.push(`ярус ${tier}`);
        }
        if (cell) {
          parts.push(`яч ${cell}`);
        }
        return parts.join(' ');
      };

      const openContextMenu = (event, boxCode) => {
        if (!contextMenu || !boxCode) {
          return;
        }
        contextMenuBoxCode = boxCode;
        const box = getAnyBox(boxCode);
        const info = findBoxPalletInfo(boxCode);
        const pallet = info.palletCode ? getAnyPallet(info.palletCode) : null;
        const isOwnBox = isOwnBoxCode(boxCode);
        const canCopy = isOwnBox && !flowLocked && !czRequired && box && box.sealed && pallet && !pallet.sealed;
        const editBtn = contextMenu.querySelector('[data-action="edit"]');
        const deleteBtn = contextMenu.querySelector('[data-action="delete"]');
        const copyBtn = contextMenu.querySelector('[data-action="copy"]');
        const printBoxBtn = contextMenu.querySelector('[data-action="print-box"]');
        const printPalletBtn = contextMenu.querySelector('[data-action="print-pallet"]');
        if (editBtn) {
          editBtn.disabled = flowLocked || !box || !isOwnBox;
        }
        if (deleteBtn) {
          deleteBtn.disabled = flowLocked || !box || !isOwnBox;
        }
        if (copyBtn) {
          copyBtn.disabled = !canCopy;
        }
        if (printBoxBtn) {
          printBoxBtn.disabled = !box || !box.code;
        }
        if (printPalletBtn) {
          const hasPalletBoxes = pallet && Array.isArray(pallet.boxes) && pallet.boxes.length;
          printPalletBtn.disabled = !hasPalletBoxes;
        }
        const menuWidth = contextMenu.offsetWidth || 220;
        const menuHeight = contextMenu.offsetHeight || 120;
        let left = event.clientX;
        let top = event.clientY;
        if (left + menuWidth > window.innerWidth - 8) {
          left = Math.max(8, window.innerWidth - menuWidth - 8);
        }
        if (top + menuHeight > window.innerHeight - 8) {
          top = Math.max(8, window.innerHeight - menuHeight - 8);
        }
        contextMenu.style.left = `${left}px`;
        contextMenu.style.top = `${top}px`;
        contextMenu.classList.add('is-open');
        contextMenu.setAttribute('aria-hidden', 'false');
      };
      const openPalletContextMenu = (event, palletCode) => {
        if (!palletContextMenu || !palletCode) {
          return;
        }
        contextMenuPalletCode = palletCode;
        const pallet = getAnyPallet(palletCode);
        const isOwnPallet = isOwnPalletCode(palletCode);
        const openBtn = palletContextMenu.querySelector('[data-action="open"]');
        const printBtn = palletContextMenu.querySelector('[data-action="print"]');
        const locationBtn = palletContextMenu.querySelector('[data-action="location"]');
        if (openBtn) {
          openBtn.disabled = flowLocked || !pallet || !pallet.sealed || !isOwnPallet;
        }
        if (printBtn) {
          printBtn.disabled = !pallet || !pallet.code;
        }
        if (locationBtn) {
          locationBtn.disabled = flowLocked || !pallet || !pallet.sealed || !isOwnPallet;
        }
        const menuWidth = palletContextMenu.offsetWidth || 220;
        const menuHeight = palletContextMenu.offsetHeight || 120;
        let left = event.clientX;
        let top = event.clientY;
        if (left + menuWidth > window.innerWidth - 8) {
          left = Math.max(8, window.innerWidth - menuWidth - 8);
        }
        if (top + menuHeight > window.innerHeight - 8) {
          top = Math.max(8, window.innerHeight - menuHeight - 8);
        }
        palletContextMenu.style.left = `${left}px`;
        palletContextMenu.style.top = `${top}px`;
        palletContextMenu.classList.add('is-open');
        palletContextMenu.setAttribute('aria-hidden', 'false');
      };

      const buildBoxSnapshot = (boxCode, extra = {}) => {
        const box = getBox(boxCode);
        const info = findBoxPalletInfo(boxCode);
        return {
          order_id: orderId,
          box_code: boxCode,
          pallet_code: info.palletCode || '',
          pallet_index: info.palletIndex || 0,
          box_index: info.index || 0,
          total_qty: getBoxItemsCount(box),
          items: (box && Array.isArray(box.items)) ? box.items : [],
          ...extra,
        };
      };

      const logFlowBoxAction = (action, payload) => {
        if (!orderId || !csrfToken || !payload) {
          return;
        }
        fetch(`/orders/processing/${orderId}/flow/box-action/`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': csrfToken,
          },
          credentials: 'same-origin',
          body: JSON.stringify({ action, ...payload }),
        }).catch((error) => {
          console.warn('Failed to log flow box action.', error);
        });
      };

      const openBoxView = (boxCode) => {
        if (!boxViewModal || !boxViewBody || !boxViewCode) {
          return;
        }
        const box = getAnyBox(boxCode);
        const info = findBoxPalletInfo(boxCode);
        boxViewCode.textContent = boxCode || '-';
        boxViewBody.innerHTML = '';
        if (!box) {
          const row = document.createElement('div');
          row.className = 'muted';
          row.textContent = 'Короб не найден.';
          boxViewBody.appendChild(row);
        } else {
          const meta = document.createElement('div');
          meta.className = 'muted';
          const boxLabel = formatBoxDisplayNumber(info.index || 0, box);
          const palletLabel = info.palletIndex
            ? `Палета ${info.palletIndex}, короб ${boxLabel}`
            : 'Палета не задана';
          meta.textContent = `${palletLabel} · ${getBoxItemsCount(box)} шт.`;
          boxViewBody.appendChild(meta);
          if (!Array.isArray(box.items) || !box.items.length) {
            const empty = document.createElement('div');
            empty.className = 'muted';
            empty.textContent = 'Товаров в коробе нет.';
            boxViewBody.appendChild(empty);
          } else {
            box.items.forEach((item) => {
              const row = document.createElement('div');
              row.className = 'box-modal-row';
              const title = `${item.name || item.sku_code || '-'}`;
              const size = item.size || '-';
              row.innerHTML = `
                <span>${escapeHtml(title)} · ${escapeHtml(size)}</span>
                <span>${Number(item.qty || 0)} шт.</span>
              `;
              boxViewBody.appendChild(row);
            });
          }
        }
        boxViewModal.classList.add('is-open');
        boxViewModal.setAttribute('aria-hidden', 'false');
      };

      const closeBoxView = () => {
        if (!boxViewModal) {
          return;
        }
        boxViewModal.classList.remove('is-open');
        boxViewModal.setAttribute('aria-hidden', 'true');
      };

      const closePalletLocationModal = () => {
        if (!palletLocationModal) {
          return;
        }
        palletLocationModal.classList.remove('is-open');
        palletLocationModal.setAttribute('aria-hidden', 'true');
        locationModalPalletCode = '';
      };
      const closePalletViewModal = () => {
        if (!palletViewModal) {
          return;
        }
        palletViewModal.classList.remove('is-open');
        palletViewModal.setAttribute('aria-hidden', 'true');
        if (palletViewBody) {
          palletViewBody.innerHTML = '';
        }
        if (palletViewCode) {
          palletViewCode.textContent = '-';
        }
      };

      const openPalletViewModal = (palletCode) => {
        if (!palletViewModal || !palletViewBody || !palletViewCode) {
          return;
        }
        const pallet = getAnyPallet(palletCode);
        if (!pallet) {
          return;
        }
        palletViewCode.textContent = pallet.code || '-';
        palletViewBody.innerHTML = '';
        const openerLabel = resolveActorLabel(
          pallet.owner_user_label,
          pallet.owner_agent_id,
          pallet.owner_user_id,
          'Не указано',
        );
        const closerLabel = pallet.sealed
          ? resolveActorLabel(
            pallet.closed_by_user_label,
            pallet.closed_by_agent_id,
            pallet.closed_by_user_id,
            'Не указано',
          )
          : 'Палета еще не закрыта';
        const openerRow = document.createElement('div');
        openerRow.className = 'box-modal-row';
        openerRow.innerHTML = `<span>Открыл</span><span>${openerLabel}</span>`;
        palletViewBody.appendChild(openerRow);
        const closerRow = document.createElement('div');
        closerRow.className = 'box-modal-row';
        closerRow.innerHTML = `<span>Закрыл</span><span>${closerLabel}</span>`;
        palletViewBody.appendChild(closerRow);
        const boxes = (pallet.boxes || [])
          .map((code) => getAnyBox(code))
          .filter((box) => box);
        const directTotal = getBoxItemsCount({ items: pallet.items || [] });
        const boxesTotal = boxes.reduce((sum, box) => sum + getBoxItemsCount(box), 0);
        const total = directTotal + boxesTotal;
        const summaryRow = document.createElement('div');
        summaryRow.className = 'box-modal-row';
        summaryRow.innerHTML = `<strong>Всего товаров</strong><span>${total} шт.</span>`;
        palletViewBody.appendChild(summaryRow);
        const boxesRow = document.createElement('div');
        boxesRow.className = 'box-modal-row';
        boxesRow.innerHTML = `<span>Коробов</span><span>${boxes.length} шт.</span>`;
        palletViewBody.appendChild(boxesRow);
        if (!boxes.length) {
          const empty = document.createElement('div');
          empty.className = 'muted';
          empty.textContent = 'Коробов в палете нет.';
          palletViewBody.appendChild(empty);
        } else {
          boxes.forEach((box) => {
            const info = findBoxPalletInfo(box.code);
            const label = formatBoxDisplayNumber(info.index || 0, box);
            const row = document.createElement('div');
            row.className = 'box-modal-row';
            row.innerHTML = `<span>${label} · ${box.code}</span><span>${getBoxItemsCount(box)} шт.</span>`;
            palletViewBody.appendChild(row);
          });
        }
        palletViewModal.classList.add('is-open');
        palletViewModal.setAttribute('aria-hidden', 'false');
      };

      const closeBoxCopyModal = () => {
        if (!boxCopyModal) {
          return;
        }
        boxCopyModal.classList.remove('is-open');
        boxCopyModal.setAttribute('aria-hidden', 'true');
        copyModalBoxCode = '';
      };

      const openBoxCopyModal = (boxCode) => {
        if (czRequired) {
          alert('Копирование коробов недоступно при размещении по ЧЗ.');
          return;
        }
        if (!boxCopyModal || !boxCode) {
          return;
        }
        const box = getBox(boxCode);
        if (!box) {
          return;
        }
        copyModalBoxCode = boxCode;
        if (boxCopyCode) {
          boxCopyCode.textContent = boxCode;
        }
        if (boxCopyCount) {
          boxCopyCount.value = '1';
          setTimeout(() => {
            boxCopyCount.focus();
            boxCopyCount.select();
          }, 0);
        }
        boxCopyModal.classList.add('is-open');
        boxCopyModal.setAttribute('aria-hidden', 'false');
      };

      const openPalletLocationModal = (palletCode) => {
        if (!palletLocationModal || !palletCode) {
          return;
        }
        if (!isOwnPalletCode(palletCode)) {
          alert('Эта палета открыта в другом кабинете.');
          return;
        }
        const pallet = getPallet(palletCode);
        if (!pallet) {
          return;
        }
        locationModalPalletCode = palletCode;
        if (palletLocationCode) {
          palletLocationCode.textContent = pallet.code || '-';
        }
        const location = pallet.location || { zone: 'PR', row: '', section: '', tier: '', cell: '' };
        if (palletLocationZone) {
          palletLocationZone.value = location.zone || 'PR';
        }
        if (palletLocationRow) {
          palletLocationRow.value = location.row || '';
        }
        if (palletLocationSection) {
          palletLocationSection.value = location.section || '';
        }
        if (palletLocationTier) {
          palletLocationTier.value = location.tier || '';
        }
        if (palletLocationCell) {
          palletLocationCell.value = location.cell || '';
        }
        palletLocationModal.classList.add('is-open');
        palletLocationModal.setAttribute('aria-hidden', 'false');
      };

      const editBoxFromContext = (boxCode) => {
        if (flowLocked || czRequired) {
          return;
        }
        if (!isOwnBoxCode(boxCode)) {
          alert('Этот короб открыт в другом кабинете.');
          return;
        }
        const box = getBox(boxCode);
        if (!box) {
          return;
        }
        const info = findBoxPalletInfo(boxCode);
        const targetPalletCode = info.palletCode || '';
        const currentPalletCode = state.activePallet || '';
        const previousActive = state.activeBox || '';
        if (targetPalletCode && targetPalletCode !== currentPalletCode) {
          const currentPallet = getPallet(currentPalletCode);
          if (currentPallet && !currentPallet.sealed) {
            if (!closePallet(false)) {
              renderAll();
              return;
            }
          }
        } else if (previousActive && previousActive !== boxCode) {
          if (!closeBox(false, { allowPrompt: false })) {
            renderAll();
            return;
          }
        }
        if (targetPalletCode) {
          state.activePallet = targetPalletCode;
          const pallet = getPallet(targetPalletCode);
          if (pallet && pallet.sealed) {
            pallet.sealed = false;
          }
        }
        box.sealed = false;
        state.activeBox = box.code;
        markDraftDirty();
        renderAll();
        logFlowBoxAction('edit', buildBoxSnapshot(boxCode, {
          previous_active_box: previousActive,
          new_active_box: box.code,
        }));
      };
      const openClosedPallet = (palletCode) => {
        if (flowLocked) {
          return;
        }
        if (!isOwnPalletCode(palletCode)) {
          alert('Эта палета открыта в другом кабинете.');
          return;
        }
        const pallet = getPallet(palletCode);
        if (!pallet) {
          return;
        }
        if (!flowReopened) {
          const otherOpenPallets = state.pallets
            .filter((entry) => entry && entry.code && entry.code !== pallet.code && !entry.sealed)
            .map((entry) => entry.code);
          if (otherOpenPallets.length) {
            const previousActivePallet = state.activePallet;
            for (const code of otherOpenPallets) {
              state.activePallet = code;
              if (!closePallet(false, { allowPrompt: false })) {
                state.activePallet = previousActivePallet;
                renderAll();
                return;
              }
            }
            state.activePallet = previousActivePallet;
          }
        }
        pallet.sealed = false;
        pallet.closed_by_agent_id = '';
        pallet.closed_by_user_id = '';
        pallet.closed_by_user_label = '';
        state.activePallet = pallet.code;
        if (state.activeBox) {
          const activeBox = getBox(state.activeBox);
          const belongsToPallet = activeBox && (pallet.boxes || []).includes(activeBox.code);
          if (!belongsToPallet) {
            state.activeBox = '';
          }
        }
        markDraftDirty();
        renderAll();
      };

      const copyBoxToPallet = (boxCode, copies) => {
        if (flowLocked) {
          alert('Размещение закрыто.');
          return false;
        }
        if (!isOwnBoxCode(boxCode)) {
          alert('Этот короб открыт в другом кабинете.');
          return false;
        }
        if (czRequired) {
          alert('Копирование коробов недоступно при размещении по ЧЗ.');
          return false;
        }
        const box = getBox(boxCode);
        if (!box) {
          alert('Короб не найден.');
          return false;
        }
        if (!box.sealed) {
          alert('Сначала закройте короб.');
          return false;
        }
        const info = findBoxPalletInfo(boxCode);
        const pallet = info.palletCode ? getPallet(info.palletCode) : null;
        if (!pallet) {
          alert('Короб не привязан к палете.');
          return false;
        }
        if (pallet.sealed) {
          alert('Палета закрыта. Откройте палету, чтобы добавить короба.');
          return false;
        }
        const items = Array.isArray(box.items) ? box.items : [];
        if (!items.length) {
          alert('В коробе нет товаров.');
          return false;
        }
        const newCodes = [];
        for (let idx = 0; idx < copies; idx += 1) {
          const newBox = createBox();
          if (!newBox) {
            return false;
          }
          newBox.items = items.map((item) => ({ ...item }));
          newBox.sealed = true;
          newCodes.push(newBox.code);
        }
        const order = Array.isArray(pallet.boxes) ? [...pallet.boxes] : [];
        if (!order.includes(box.code)) {
          order.push(box.code);
        }
        const sourceIndex = order.indexOf(box.code);
        if (sourceIndex >= 0) {
          order.splice(sourceIndex + 1, 0, ...newCodes);
        } else {
          order.push(...newCodes);
        }
        const closedCodes = [];
        const openCodes = [];
        order.forEach((code) => {
          const entry = getBox(code);
          if (entry && !entry.sealed) {
            openCodes.push(code);
          } else {
            closedCodes.push(code);
          }
        });
        pallet.boxes = [...closedCodes, ...openCodes];
        markDraftDirty();
        renderAll();
        return true;
      };

      const deleteBoxFromContext = (boxCode) => {
        if (flowLocked) {
          return;
        }
        if (!isOwnBoxCode(boxCode)) {
          alert('Этот короб открыт в другом кабинете.');
          return;
        }
        const box = getBox(boxCode);
        if (!box) {
          return;
        }
        const shouldDelete = window.confirm(
          `Удалить короб ${boxCode} и вернуть товар в неразмещенные?`,
        );
        if (!shouldDelete) {
          return;
        }
        logFlowBoxAction('delete', buildBoxSnapshot(boxCode));
        state.boxes = state.boxes.filter((entry) => entry.code !== boxCode);
        state.pallets.forEach((pallet) => {
          pallet.boxes = (pallet.boxes || []).filter((code) => code !== boxCode);
        });
        if (state.activeBox === boxCode) {
          state.activeBox = '';
        }
        cleanupEmpty();
        markDraftDirty();
        renderAll();
      };

      const openPalletPrintPreview = (palletCode, previewWindow, onReady) => {
        const pallet = getPallet(palletCode);
        if (!pallet || !pallet.code) {
          if (previewWindow && previewWindow.document) {
            previewWindow.document.open();
            previewWindow.document.write(`<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>Этикетка палеты</title></head><body style="font-family: Arial, sans-serif; padding: 16px;">Палета не найдена.</body></html>`);
            previewWindow.document.close();
          }
          return;
        }
        const clientLabel = String("{{ client_label|escapejs }}").trim();
        const palletIndex = state.pallets.findIndex((entry) => entry && entry.code === pallet.code);
        const palletNumber = palletIndex >= 0 ? String(palletIndex + 1) : '-';
        const qrPayload = pallet.code;
        const doc = previewWindow || window.open('', '_blank', 'width=560,height=640');
        if (!doc) {
          return;
        }
        const html = `
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Этикетка палеты</title>
  <style>
    @page { size: 58mm 60mm; margin: 0; }
    html, body { width: 58mm; height: 60mm; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; color: #111; }
    .label {
      width: 58mm;
      height: 60mm;
      box-sizing: border-box;
      padding: 4mm 4mm 4mm 6mm;
      position: relative;
    }
    .code-label { font-size: 8pt; text-transform: uppercase; letter-spacing: 0.5px; }
    .code {
      margin-top: 1mm;
      font-size: 10pt;
      font-weight: 700;
      word-break: normal;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 40mm;
    }
    .qr {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 38mm;
      height: 38mm;
      transform: translate(-50%, -50%);
      z-index: 2;
    }
    .qr-box {
      position: absolute;
      inset: 0;
    }
    .qr img,
    .qr canvas,
    .qr svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .qr-placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 10pt;
      color: #6b7280;
      border: 1px dashed rgba(17, 17, 17, 0.2);
      border-radius: 8px;
    }
    .client {
      position: absolute;
      left: 2mm;
      bottom: 3mm;
      transform: rotate(-90deg);
      transform-origin: left bottom;
      font-size: 8pt;
      font-weight: 600;
      white-space: nowrap;
      max-width: 52mm;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pallet-number {
      position: absolute;
      right: 3mm;
      bottom: 3mm;
      font-size: 11pt;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="label">
    <div class="code-label">Палета</div>
    <div class="code">${escapeHtml(pallet.code)}</div>
    <div class="qr">
      <div class="qr-placeholder" id="qr-placeholder">QR...</div>
      <div class="qr-box" id="qr-box"></div>
    </div>
    <div class="client">${escapeHtml(clientLabel)}</div>
    <div class="pallet-number">${escapeHtml(palletNumber)}</div>
  </div>
</body>
</html>`;
        doc.document.open();
        doc.document.write(html);
        doc.document.close();
        if (typeof onReady === 'function') {
          onReady({ doc, qrPayload });
        }
      };

      const openBoxPrintPreviewForCode = (boxCode, previewWindow, onReady) => {
        const box = getAnyBox(boxCode);
        if (!box || !box.code) {
          if (previewWindow && previewWindow.document) {
            const isActiveBox = boxCode && boxCode === state.activeBox;
            const message = isActiveBox ? 'Нет открытого короба.' : 'Короб не найден.';
            previewWindow.document.open();
            previewWindow.document.write(`<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>Этикетка короба</title></head><body style="font-family: Arial, sans-serif; padding: 16px;">${message}</body></html>`);
            previewWindow.document.close();
          }
          return;
        }
        const clientLabel = String("{{ client_label|escapejs }}").trim();
        const info = findBoxPalletInfo(box.code);
        const boxLabel = formatBoxDisplayNumber(info.index || 0, box);
        const qrPayload = box.code;
        const doc = previewWindow || window.open('', '_blank', 'width=520,height=620');
        if (!doc) {
          return;
        }
        const html = `
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Этикетка короба</title>
  <style>
    @page { size: 58mm 60mm; margin: 0; }
    html, body { width: 58mm; height: 60mm; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; color: #111; }
    .label {
      width: 58mm;
      height: 60mm;
      box-sizing: border-box;
      padding: 4mm 4mm 4mm 8mm;
      position: relative;
    }
    .code-label { font-size: 10pt; text-transform: uppercase; letter-spacing: 0.6px; }
    .code {
      margin-top: 1.5mm;
      font-size: 12pt;
      font-weight: 700;
      word-break: normal;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .qr {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 30mm;
      height: 30mm;
      transform: translate(-50%, -40%);
      z-index: 2;
    }
    .qr-box {
      position: absolute;
      inset: 0;
    }
    .qr img,
    .qr canvas,
    .qr svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .qr-placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 9pt;
      color: #6b7280;
      border: 1px dashed rgba(17, 17, 17, 0.2);
      border-radius: 6px;
    }
    .client {
      position: absolute;
      left: 3mm;
      bottom: 3mm;
      transform: rotate(-90deg);
      transform-origin: left bottom;
      font-size: 10pt;
      font-weight: 600;
      white-space: nowrap;
    }
    .box-number {
      position: absolute;
      right: 3mm;
      bottom: 3mm;
      font-size: 12pt;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="label">
    <div class="code-label">Короб</div>
    <div class="code">${escapeHtml(box.code)}</div>
    <div class="qr">
      <div class="qr-placeholder" id="qr-placeholder">QR...</div>
      <div class="qr-box" id="qr-box"></div>
    </div>
    <div class="client">${escapeHtml(clientLabel)}</div>
    <div class="box-number">${escapeHtml(boxLabel)}</div>
  </div>
</body>
</html>`;
        doc.document.open();
        doc.document.write(html);
        doc.document.close();
        if (typeof onReady === 'function') {
          onReady({ doc, qrPayload });
        }
      };

      const openBoxPrintPreview = (previewWindow, onReady) => {
        openBoxPrintPreviewForCode(state.activeBox, previewWindow, onReady);
      };

      const openPalletBoxesPrintPreview = (palletCode, previewWindow) => {
        const pallet = getAnyPallet(palletCode);
        const doc = previewWindow || window.open('', '_blank', 'width=520,height=620');
        if (!doc) {
          return;
        }
        const boxes = pallet && Array.isArray(pallet.boxes)
          ? pallet.boxes.map((code) => getAnyBox(code)).filter((box) => box && box.code)
          : [];
        if (!pallet || !boxes.length) {
          doc.document.open();
          doc.document.write(`<!doctype html><html lang="ru"><head><meta charset="utf-8"><title>Этикетки коробов</title></head><body style="font-family: Arial, sans-serif; padding: 16px;">Короба не найдены.</body></html>`);
          doc.document.close();
          return;
        }
        const clientLabel = String("{{ client_label|escapejs }}").trim();
        const labels = boxes.map((box, index) => {
          const boxLabel = formatBoxDisplayNumber(index + 1, box);
          return `
  <div class="label">
    <div class="code-label">Короб</div>
    <div class="code">${escapeHtml(box.code)}</div>
    <div class="qr">
      <div class="qr-placeholder" id="qr-placeholder-${index}">QR...</div>
      <div class="qr-box" id="qr-box-${index}"></div>
    </div>
    <div class="client">${escapeHtml(clientLabel)}</div>
    <div class="box-number">${escapeHtml(boxLabel)}</div>
  </div>`;
        }).join('');
        const html = `
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title>Этикетки коробов</title>
  <style>
    @page { size: 58mm 60mm; margin: 0; }
    html, body { width: 58mm; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; color: #111; }
    .label {
      width: 58mm;
      height: 60mm;
      box-sizing: border-box;
      padding: 4mm 4mm 4mm 8mm;
      position: relative;
      page-break-after: always;
    }
    .label:last-child { page-break-after: auto; }
    .code-label { font-size: 10pt; text-transform: uppercase; letter-spacing: 0.6px; }
    .code {
      margin-top: 1.5mm;
      font-size: 12pt;
      font-weight: 700;
      word-break: normal;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .qr {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 30mm;
      height: 30mm;
      transform: translate(-50%, -40%);
      z-index: 2;
    }
    .qr-box {
      position: absolute;
      inset: 0;
    }
    .qr img,
    .qr canvas,
    .qr svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .qr-placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 9pt;
      color: #6b7280;
      border: 1px dashed rgba(17, 17, 17, 0.2);
      border-radius: 6px;
    }
    .client {
      position: absolute;
      left: 3mm;
      bottom: 3mm;
      transform: rotate(-90deg);
      transform-origin: left bottom;
      font-size: 10pt;
      font-weight: 600;
      white-space: nowrap;
    }
    .box-number {
      position: absolute;
      right: 3mm;
      bottom: 3mm;
      font-size: 12pt;
      font-weight: 700;
    }
  </style>
</head>
<body>
${labels}
</body>
</html>`;
        doc.document.open();
        doc.document.write(html);
        doc.document.close();
        loadQrBatchInPreview(doc, boxes.map((box) => box.code));
      };

      let czScanBusy = false;
      const handleCzScan = async (rawValue) => {
        if (flowLocked) {
          setScannerStatus('Размещение закрыто', true);
          return;
        }
        if (!flowSessionReady) {
          setScannerStatus('Контекст упаковки не готов', true);
          return;
        }
        const value = String(rawValue || '').trim();
        if (!value) {
          return;
        }
        ensureOpenContainers(true);
        const box = getBox(state.activeBox);
        if (!box || box.sealed) {
          setScannerStatus('Нет открытого короба', true);
          return;
        }
        if (czScanBusy) {
          return;
        }
        czScanBusy = true;
        setScannerStatus('Проверяю ЧЗ...', false);
        try {
          const resp = await fetch(czScanUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRFToken': csrfToken,
            },
            body: JSON.stringify({
              code: value,
              box_barcode: box.code,
              agent_id: agentId,
            }),
          });
          let data = null;
          try {
            data = await resp.json();
          } catch (err) {
            data = null;
          }
          if (!resp.ok || !data || !data.ok) {
            const message = (data && data.error) ? data.error : 'Ошибка проверки ЧЗ.';
            setScannerStatus(message, true);
            return;
          }
          const mapped = {
            sku_code: data.sku_code || '',
            name: data.name || '',
            size: data.size || '',
          };
          let planned = plannedByKey.get(makeKey(mapped));
          if (!planned) {
            planned = ensurePlannedItem(mapped);
          }
          if (!planned) {
            setScannerStatus('Позиция не найдена в заявке.', true);
            return;
          }
          const plannedKey = makeKey(planned);
          const added = addToBox({ ...planned, key: plannedKey }, 1);
          if (!added) {
            setScannerStatus('Нет открытого короба', true);
            return;
          }
          const title = planned.name || planned.sku_code || value;
          setScannerStatus(`ЧЗ учтен: ${title}`, false);
          flashScan(plannedKey);
          manualInputByKey.set(plannedKey, '');
          suppressBlurApply = true;
          pendingFocusKey = plannedKey;
          renderAll();
        } catch (err) {
          setScannerStatus('Ошибка проверки ЧЗ.', true);
        } finally {
          czScanBusy = false;
        }
      };

      const handleBarcode = (rawValue) => {
        if (flowLocked) {
          setScannerStatus('Размещение закрыто', true);
          return;
        }
        if (!flowSessionReady) {
          setScannerStatus('Контекст упаковки не готов', true);
          return;
        }
        const value = String(rawValue || '').trim();
        if (!value) {
          return;
        }
        if (czRequired) {
          handleCzScan(value);
          return;
        }
        const mapped = barcodeMap[value];
        if (!mapped) {
          setScannerStatus(`ШК ${value} не найден в номенклатуре клиента`, true);
          return;
        }
        let planned = plannedByKey.get(makeKey(mapped));
        const skuKey = (mapped.sku_code || mapped.sku || '').toLowerCase();
        if (!planned && skuKey) {
          planned = plannedBySku.get(skuKey);
        }
        const addedFromCatalog = !planned;
        if (!planned) {
          planned = ensurePlannedItem(mapped);
        }
        if (!planned) {
          setScannerStatus(`ШК ${value} не найден в номенклатуре клиента`, true);
          return;
        }
        ensureOpenContainers(true);
        const plannedKey = makeKey(planned);
        const added = addToBox({ ...planned, key: plannedKey }, 1);
        if (!added) {
          setScannerStatus('Нет открытого короба', true);
          return;
        }
        const title = planned.name || planned.sku_code || mapped.name || mapped.sku_code || value;
        setScannerStatus(
          addedFromCatalog ? `Добавлено из номенклатуры: ${title}` : `Добавлено: ${title}`,
          false
        );
        flashScan(plannedKey);
        manualInputByKey.set(plannedKey, '');
        suppressBlurApply = true;
        pendingFocusKey = plannedKey;
        renderAll();
      };

        if (barcodeInput) {
          let barcodeInputTimer = null;
          let lastHandled = '';
        const triggerHandle = (value, source) => {
          const trimmed = String(value || '').trim();
          if (!trimmed) {
            return;
          }
          updateScanTest(trimmed, source || 'input', true);
          lastHandled = trimmed;
          handleBarcode(trimmed);
          barcodeInput.value = '';
        };
        barcodeInput.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            if (barcodeInputTimer) {
              clearTimeout(barcodeInputTimer);
              barcodeInputTimer = null;
            }
            triggerHandle(barcodeInput.value, 'enter');
          }
        });
        barcodeInput.addEventListener('input', () => {
          const value = String(barcodeInput.value || '').trim();
          if (!value) {
            return;
          }
          if (barcodeInputTimer) {
            clearTimeout(barcodeInputTimer);
          }
          const snapshot = value;
          barcodeInputTimer = setTimeout(() => {
            if (String(barcodeInput.value || '').trim() !== snapshot) {
              return;
            }
            if (snapshot === lastHandled) {
              return;
            }
            triggerHandle(snapshot, 'input');
          }, 120);
        });
          barcodeInput.addEventListener('blur', () => {
            setTimeout(() => {
              if (Date.now() < barcodeFocusLockUntil) {
                return;
              }
              const active = document.activeElement;
              if (!active || active === document.body) {
                barcodeInput.focus();
                return;
            }
            const tag = (active.tagName || '').toLowerCase();
            if (active.classList && active.classList.contains('qty-input')) {
              return;
            }
            if (tag === 'input' || tag === 'textarea' || tag === 'select') {
              return;
            }
            barcodeInput.focus();
          }, 0);
        });
        setTimeout(() => barcodeInput.focus(), 0);
      }

      const scanConfig = {
        maxGap: 220,
        idleGap: 120,
        minLength: 6,
        maxTotal: 3000,
        avgMax: 85,
      };
      let scanBuffer = '';
      let scanStart = 0;
      let scanLast = 0;
      let scanTimer = null;
      let scanIdleTimer = null;
      let scanSourceEl = null;
      let scanSourceValue = '';
      let scanSourceKey = '';
      let scanSourceManualValue = null;
      let scanSourceAdjustKey = '';
      let scanSourceAdjustValue = null;

      const resetScanBuffer = () => {
        scanBuffer = '';
        scanStart = 0;
        scanLast = 0;
        scanSourceEl = null;
        scanSourceValue = '';
        scanSourceKey = '';
        scanSourceManualValue = null;
        scanSourceAdjustKey = '';
        scanSourceAdjustValue = null;
        if (scanTimer) {
          clearTimeout(scanTimer);
          scanTimer = null;
        }
        if (scanIdleTimer) {
          clearTimeout(scanIdleTimer);
          scanIdleTimer = null;
        }
      };

      const isQtyInput = (el) => !!(el && el.classList && el.classList.contains('qty-input'));
      const getRowKeyFromInput = (el) => {
        if (!isQtyInput(el)) {
          return '';
        }
        const row = el.closest('tr');
        return row && row.dataset ? row.dataset.key || '' : '';
      };

      const computeScan = () => {
        if (!scanBuffer) {
          return { isScan: false, total: 0, avg: 0 };
        }
        const total = scanLast && scanStart ? scanLast - scanStart : 0;
        const avg = scanBuffer.length ? total / scanBuffer.length : total;
        let isScan =
          scanBuffer.length >= scanConfig.minLength &&
          total <= scanConfig.maxTotal &&
          avg <= scanConfig.avgMax;
        if (!isScan && isQtyInput(scanSourceEl)) {
          isScan = scanBuffer.length >= scanConfig.minLength && total <= scanConfig.maxTotal;
        }
        return { isScan, total, avg };
      };

      const finalizeScan = (source) => {
        const result = computeScan();
        if (scanBuffer) {
          updateScanTest(scanBuffer, source || 'idle', result.isScan);
        }
        if (result.isScan) {
          if (scanSourceKey) {
            if (scanSourceManualValue == null) {
              manualInputByKey.delete(scanSourceKey);
            } else {
              manualInputByKey.set(scanSourceKey, scanSourceManualValue);
            }
          }
          if (scanSourceAdjustKey) {
            if (scanSourceAdjustValue == null) {
              boxAdjustByKey.delete(scanSourceAdjustKey);
            } else {
              boxAdjustByKey.set(scanSourceAdjustKey, scanSourceAdjustValue);
            }
          }
          if (scanSourceEl && scanSourceEl !== barcodeInput && typeof scanSourceEl.value === 'string') {
            scanSourceEl.value = scanSourceValue;
          }
          handleBarcode(scanBuffer);
        }
        resetScanBuffer();
        return result.isScan;
      };

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.defaultPrevented) {
            resetScanBuffer();
            return;
          }
          if (event.ctrlKey || event.altKey || event.metaKey) {
            resetScanBuffer();
            return;
          }
          const target = event.target;
          if (barcodeInput && target === barcodeInput) {
            return;
          }
          const key = event.key;
          const isChar = key.length === 1;
          const isTerminator = key === 'Enter' || key === 'Tab';
          if (!isChar && !isTerminator) {
            if (!scanBuffer) {
              resetScanBuffer();
            }
            return;
          }
          const now = Date.now();
          if (!scanStart || target !== scanSourceEl || now - scanLast > scanConfig.maxGap) {
            scanBuffer = '';
            scanStart = now;
            scanSourceEl = target;
            scanSourceValue = target && typeof target.value === 'string' ? target.value : '';
            scanSourceKey = getRowKeyFromInput(target);
            if (scanSourceKey) {
              scanSourceManualValue = manualInputByKey.has(scanSourceKey)
                ? manualInputByKey.get(scanSourceKey)
                : null;
            } else {
              scanSourceManualValue = null;
            }
            scanSourceAdjustKey = target && target.dataset ? target.dataset.adjustKey || '' : '';
            if (scanSourceAdjustKey) {
              scanSourceAdjustValue = boxAdjustByKey.has(scanSourceAdjustKey)
                ? boxAdjustByKey.get(scanSourceAdjustKey)
                : null;
            } else {
              scanSourceAdjustValue = null;
            }
          }
          scanLast = now;
          if (isChar) {
            scanBuffer += key;
            if (scanTimer) {
              clearTimeout(scanTimer);
            }
            scanTimer = setTimeout(resetScanBuffer, scanConfig.maxTotal);
            if (scanIdleTimer) {
              clearTimeout(scanIdleTimer);
            }
            scanIdleTimer = setTimeout(() => {
              finalizeScan('idle');
            }, scanConfig.idleGap);
            return;
          }
          if (isTerminator) {
            const isScan = finalizeScan(key === 'Tab' ? 'tab' : 'enter');
            if (isScan) {
              event.preventDefault();
            }
          }
        },
        true,
      );

      const serialIdleMs = 200;
      let serialPort = null;
      let serialReader = null;
      let serialBuffer = '';
      let serialTimer = null;
      let lastSerialPort = null;
      const serialRawLines = [];
      const maxSerialRawLines = 30;

      const appendSerialRaw = (label, chunk) => {
        if (!serialRaw) {
          return;
        }
        const text = formatControlChars(chunk || '');
        if (!text) {
          return;
        }
        const stamp = new Date().toLocaleTimeString('ru-RU');
        serialRawLines.push(`[${stamp}] ${label}: ${text}`);
        if (serialRawLines.length > maxSerialRawLines) {
          serialRawLines.splice(0, serialRawLines.length - maxSerialRawLines);
        }
        serialRaw.textContent = serialRawLines.join('\n');
        serialRaw.scrollTop = serialRaw.scrollHeight;
      };

      const updateSerialUi = (state, isError) => {
        if (!serialStatus) {
          return;
        }
        serialStatus.textContent = state || 'не подключено';
        serialStatus.style.color = isError ? 'var(--danger)' : '';
      };
        const updateSerialHint = (text, isError) => {
          if (!serialHint) {
            return;
          }
          serialHint.textContent = text || '';
          serialHint.style.color = isError ? 'var(--danger)' : '';
        };
        const agentDevicesMap = (() => {
          const el = document.getElementById('scanner-agent-devices');
          if (!el) {
            return {};
          }
          const raw = ('value' in el ? el.value : el.textContent) || '{}';
          try {
            return JSON.parse(raw) || {};
          } catch (err) {
            return {};
          }
        })();
        const getAgentDevices = () => {
          if (!agentId) {
            return [];
          }
          const list = agentDevicesMap[agentId];
          return Array.isArray(list) ? list : [];
        };
        const updateAgentDeviceDetails = () => {
          const portValue = (agentPort?.value || '').trim().toLowerCase();
          const devices = getAgentDevices();
          const device = devices.find((item) => {
            if (!item || typeof item !== 'object') {
              return false;
            }
            const devicePort = String(item.port || '').trim().toLowerCase();
            return devicePort && devicePort === portValue;
          });
          if (agentDeviceName) {
            agentDeviceName.textContent = device
              ? (device.name || device.caption || device.description || '-')
              : '-';
          }
          if (agentDeviceStatus) {
            agentDeviceStatus.textContent = device ? (device.status || '-') : '-';
          }
          if (agentDeviceError) {
            const code = device && device.error_code !== undefined ? String(device.error_code) : '';
            agentDeviceError.textContent = code || '-';
          }
          if (agentDeviceDriver) {
            agentDeviceDriver.textContent = device ? (device.service || '-') : '-';
          }
          if (agentDevicePnp) {
            agentDevicePnp.textContent = device ? (device.pnp_id || device.device_id || '-') : '-';
          }
          if (agentDeviceSource) {
            agentDeviceSource.textContent = device ? (device.source || '-') : '-';
          }
        };
        const setSerialConnected = (connected, portLabel) => {
          if (serialDisconnect) {
            serialDisconnect.disabled = !connected;
          }
          if (serialConnect) {
            serialConnect.disabled = !!connected;
          }
          if (serialPortStatus) {
            serialPortStatus.textContent = connected ? (portLabel || 'подключен') : '-';
          }
        };

        const disableAgentForWebSerial = async () => {
          if (!agentId) {
            return;
          }
          try {
            const settings = typeof readAgentSettings === 'function'
              ? readAgentSettings()
              : { default: { enabled: false } };
            if (settings && settings.default) {
              settings.default.enabled = false;
            }
            const resp = await postJson(agentSettingsApplyUrl, {
              settings,
              agent_id: agentId,
              reconnect: true,
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok || data.ok === false) {
              setAgentHint(`Не удалось отключить агент: ${data.error || resp.status}`, true);
              return;
            }
            if (agentEnabled) {
              agentEnabled.checked = false;
            }
            updateSelectedAgentDataset({
              enabled: false,
              connected: false,
              error: '',
              errorType: '',
              errorCode: '',
            });
            const portValue = (agentPort?.value || '').trim();
            if (portValue) {
              updatePortRowStatus(portValue, `${getSelectedAgentLabel()} · выключен (локально)`);
            }
            setAgentHint('Web Serial включен, агент отключен.', false);
          } catch (err) {
            setAgentHint('Не удалось отключить агент при включении Web Serial.', true);
          }
        };

        const switchToWebSerial = async () => {
          if (scannerModeValue !== 'webserial') {
            scannerModeValue = applyScannerMode('webserial');
          }
          await disableAgentForWebSerial();
        };

        const switchToAgentMode = async () => {
          if (scannerModeValue !== 'agent') {
            scannerModeValue = applyScannerMode('agent');
          }
          await closeSerial();
        };

      const formatControlChars = (value) => {
        if (!value) {
          return value;
        }
        return value
          .replace(/\x1D/g, '<GS>')
          .replace(/\r/g, '<CR>')
          .replace(/\n/g, '<LF>')
          .replace(/\t/g, '<TAB>');
      };

        const getSerialDelimiter = () => {
          const mode = serialEol ? serialEol.value : 'crlf';
          if (mode === 'crlf') {
            return '\r\n';
          }
        if (mode === 'cr') {
          return '\r';
        }
        if (mode === 'lf') {
          return '\n';
        }
        if (mode === 'tab') {
          return '\t';
        }
        return '';
      };

      const flushSerial = (suffix) => {
        const trimmed = serialBuffer.trim();
        const displayValue = formatControlChars(trimmed);
        if (displayValue) {
          if (serialValue) {
            serialValue.textContent = displayValue;
          }
          updateScanTest(displayValue, suffix || 'COM', true);
          handleBarcode(trimmed);
        }
        if (serialBuffer) {
          appendSerialRaw('flush', serialBuffer);
        }
        serialBuffer = '';
      };

      const scheduleSerialFlush = () => {
        if (serialTimer) {
          clearTimeout(serialTimer);
        }
        serialTimer = setTimeout(() => {
          if (serialBuffer) {
            flushSerial('COM (pause)');
          }
        }, serialIdleMs);
      };

        const closeSerial = async () => {
          if (serialTimer) {
            clearTimeout(serialTimer);
            serialTimer = null;
        }
        if (serialReader) {
          try {
            await serialReader.cancel();
          } catch (e) {
            // ignore cancel errors
          }
          serialReader.releaseLock();
          serialReader = null;
        }
        if (serialPort) {
          try {
            await serialPort.close();
          } catch (e) {
            // ignore close errors
          }
          lastSerialPort = lastSerialPort || serialPort;
          serialPort = null;
        }
          setSerialConnected(false);
          updateSerialUi('не подключено');
          updateSerialHint('Работает в Chrome/Edge.', false);
        };
        const preserveScrollPosition = () => {
          const top = window.scrollY;
          requestAnimationFrame(() => {
            if (Math.abs(window.scrollY - top) > 1) {
              window.scrollTo({ top });
            }
          });
        };

        const requestSerialPort = async () => {
          if (!('serial' in navigator)) {
            updateSerialUi('Web Serial не поддерживается', true);
            updateSerialHint('Откройте страницу в Chrome/Edge или используйте агента.', true);
            return null;
          }
          if (!window.isSecureContext) {
            updateSerialUi('Нужен HTTPS', true);
            updateSerialHint('Web Serial работает только на HTTPS страницах.', true);
            return null;
          }
          try {
            return await navigator.serial.requestPort();
          } catch (err) {
            const message = err && err.name === 'SecurityError'
              ? 'Нет доступа к COM (проверьте права браузера)'
              : 'порт не выбран';
            updateSerialUi(message, true);
            updateSerialHint(message, true);
            return null;
          }
        };
        const resolveSerialPort = async () => {
          if (!('serial' in navigator)) {
            return null;
          }
          if (lastSerialPort) {
            return lastSerialPort;
          }
          try {
            const ports = await navigator.serial.getPorts();
            return ports && ports.length ? ports[0] : null;
          } catch (err) {
            return null;
          }
        };

      const openSerial = async (port) => {
        if (!port) {
          return false;
        }
        serialPort = port;
        lastSerialPort = port;
        await serialPort.open({
          baudRate: parseInt(serialBaud ? serialBaud.value : '9600', 10) || 9600,
          dataBits: 8,
          stopBits: 1,
          parity: 'none',
        });
          serialReader = serialPort.readable.getReader();
          updateSerialUi('подключено');
          updateSerialHint('Порт открыт. Ожидаю данные...', false);
          setSerialConnected(true, 'подключен');
          appendSerialRaw('status', 'подключено');
          readSerialLoop();
          return true;
        };

      const readSerialLoop = async () => {
        const decoder = new TextDecoder();
        while (serialPort && serialPort.readable) {
          try {
            const result = await serialReader.read();
            if (result.done) {
              break;
            }
            if (result.value) {
              const chunk = decoder.decode(result.value, { stream: true });
              serialBuffer += chunk;
              appendSerialRaw('chunk', chunk);
              const delimiter = getSerialDelimiter();
              if (delimiter) {
                let idx = serialBuffer.indexOf(delimiter);
                while (idx >= 0) {
                  const part = serialBuffer.slice(0, idx);
                  serialBuffer = serialBuffer.slice(idx + delimiter.length);
                  const trimmed = part.trim();
                  const displayValue = formatControlChars(trimmed);
                  if (displayValue) {
                    if (serialValue) {
                      serialValue.textContent = displayValue;
                    }
                    updateScanTest(displayValue, 'COM', true);
                    handleBarcode(trimmed);
                  }
                  idx = serialBuffer.indexOf(delimiter);
                }
              }
              scheduleSerialFlush();
            }
          } catch (err) {
            updateSerialUi('ошибка: ' + err.message, true);
            updateSerialHint('Ошибка чтения COM. Проверьте подключение.', true);
            break;
          }
        }
        await closeSerial();
      };

        const connectSerial = async () => {
          try {
            await switchToWebSerial();
            updateSerialUi('запрос порта...', false);
            updateSerialHint('Ожидаю выбор порта...', false);
            const port = await requestSerialPort();
            if (!port) {
              return;
            }
            await openSerial(port);
          } catch (err) {
          updateSerialUi('ошибка: ' + err.message, true);
          updateSerialHint('Не удалось открыть COM. Проверьте порт.', true);
          await closeSerial();
        }
      };

        const reconnectSerial = async () => {
          try {
            await switchToWebSerial();
            await closeSerial();
            updateSerialUi('переподключение...', false);
            updateSerialHint('Ищу доступный порт...', false);
            let port = await resolveSerialPort();
            if (!port) {
              port = await requestSerialPort();
            }
            if (!port) {
              return;
            }
          await openSerial(port);
          appendSerialRaw('status', 'переподключено');
        } catch (err) {
          updateSerialUi('ошибка: ' + err.message, true);
          updateSerialHint('Переподключение не удалось.', true);
          await closeSerial();
        }
      };

      if (serialConnect) {
          serialConnect.setAttribute('type', 'button');
          serialConnect.addEventListener('click', (event) => {
            if (event) {
              event.preventDefault();
              event.stopPropagation();
              event.stopImmediatePropagation();
            }
            preserveScrollPosition();
            connectSerial();
          });
        }
      if (serialDisconnect) {
        serialDisconnect.addEventListener('click', closeSerial);
      }
      if (serialReconnect) {
        serialReconnect.addEventListener('click', reconnectSerial);
      }
      if (serialClear) {
        serialClear.addEventListener('click', () => {
          serialRawLines.length = 0;
          if (serialRaw) {
            serialRaw.textContent = '-';
          }
        });
      }
      if (!('serial' in navigator)) {
        if (serialConnect) {
          serialConnect.disabled = true;
        }
        if (serialReconnect) {
          serialReconnect.disabled = true;
        }
        updateSerialUi('Web Serial не поддерживается', true);
        updateSerialHint('Откройте страницу в Chrome/Edge или используйте агента.', true);
      }

        let agentPollTimer = null;
        let agentSinceId = 0;
        agentId = localStorage.getItem('fullbox_agent_id') || '';
        let agentContextId = '';
        let agentContextTimer = null;
        let agentStatusTimer = null;
        let agentRealtimeClient = null;
        let localAgentRefreshTimer = null;
        let localAgentRefreshPending = false;
        let scannerModeValue = localStorage.getItem('fullbox_scanner_mode') || '';
        const applyAgentOptionData = (option, agent) => {
          const normalizedAgentId = String(agent?.agent_id || agent?.agentId || '').trim();
          if (!option || !normalizedAgentId) {
            return null;
          }
          const title = String(
            agent?.title
              || agent?.name
              || agent?.host
              || agent?.agent_id
              || agent?.agentId
              || normalizedAgentId
          ).trim() || normalizedAgentId;
          const ports = Array.isArray(agent?.ports)
            ? agent.ports.map((value) => String(value || '').trim()).filter(Boolean)
            : [];
          option.value = normalizedAgentId;
          option.textContent = `${title} · ${normalizedAgentId}`;
          option.dataset.title = title;
          option.dataset.status = String(agent?.status || '').trim();
          option.dataset.online = agent?.is_online ? '1' : '0';
          option.dataset.host = String(agent?.host || '').trim();
          option.dataset.version = String(agent?.version || '').trim();
          option.dataset.lastSeen = String(agent?.last_seen || '').trim();
          option.dataset.ports = ports.join(',');
          option.dataset.comPort = String(agent?.com_port || '').trim();
          option.dataset.comEnabled = agent?.com_enabled ? '1' : '0';
          option.dataset.comConnected = agent?.com_connected ? '1' : '0';
          option.dataset.comError = String(agent?.com_error || '').trim();
          option.dataset.comErrorType = String(agent?.com_error_type || '').trim();
          option.dataset.comErrorCode =
            agent?.com_error_code !== undefined && agent?.com_error_code !== null
              ? String(agent.com_error_code)
              : '';
          option.dataset.comBaud =
            agent?.com_baud !== undefined && agent?.com_baud !== null
              ? String(agent.com_baud)
              : '';
          option.dataset.comEol = String(agent?.com_eol || '').trim();
          option.dataset.comIdle =
            agent?.com_idle !== undefined && agent?.com_idle !== null
              ? String(agent.com_idle)
              : '';
          return option;
        };
        const populateAgentSelect = () => {
          if (!agentSelect || !Array.isArray(scannerAgentsData)) {
            return;
          }
          const optionsByValue = new Map(
            Array.from(agentSelect.options || [])
              .filter((option) => option.value)
              .map((option) => [option.value, option])
          );
          scannerAgentsData.forEach((agent) => {
            const normalizedAgentId = String(agent?.agent_id || '').trim();
            if (!normalizedAgentId) {
              return;
            }
            let option = optionsByValue.get(normalizedAgentId);
            if (!option) {
              option = document.createElement('option');
              agentSelect.appendChild(option);
              optionsByValue.set(normalizedAgentId, option);
            }
            applyAgentOptionData(option, agent);
          });
        };
        const upsertScannerAgentOption = (agentInfo) => {
          const normalizedAgentId = String(agentInfo?.agentId || '').trim();
          if (!normalizedAgentId) {
            return;
          }
          const normalized = {
            agent_id: normalizedAgentId,
            title: String(agentInfo?.name || agentInfo?.host || normalizedAgentId).trim() || normalizedAgentId,
            host: String(agentInfo?.host || '').trim(),
            version: '',
            status: 'онлайн',
            is_online: true,
            last_seen: '',
            ports: [],
            com_port: '',
            com_enabled: false,
            com_connected: false,
            com_error: '',
            com_error_type: '',
            com_error_code: '',
            com_baud: '',
            com_eol: '',
            com_idle: '',
          };
          const existing = Array.isArray(scannerAgentsData)
            ? scannerAgentsData.find((agent) => agent && String(agent.agent_id || '').trim() === normalizedAgentId)
            : null;
          if (existing) {
            Object.assign(existing, normalized);
          } else if (Array.isArray(scannerAgentsData)) {
            scannerAgentsData.unshift(normalized);
          }
          if (!agentSelect) {
            return;
          }
          let option = Array.from(agentSelect.options || []).find((item) => item.value === normalizedAgentId);
          if (!option) {
            option = document.createElement('option');
            agentSelect.appendChild(option);
          }
          applyAgentOptionData(option, normalized);
        };
        const resolveDefaultAgentId = () => {
          if (agentId) {
            return agentId;
          }
          if (agentSelect) {
            const options = Array.from(agentSelect.options).filter((opt) => opt.value);
            if (options.length === 1) {
              return options[0].value;
            }
            const online = options.filter((opt) => opt.dataset.online === '1');
            if (online.length === 1) {
              return online[0].value;
            }
          }
          if (Array.isArray(scannerAgentsData) && scannerAgentsData.length) {
            if (scannerAgentsData.length === 1) {
              return scannerAgentsData[0].agent_id || agentId;
            }
            const online = scannerAgentsData.filter((agent) => agent && agent.is_online);
            if (online.length === 1) {
              return online[0].agent_id || agentId;
            }
          }
          return agentId;
        };
        const ensureLocalAgentSelection = async () => {
          const payload = await detectLocalAgentBridge();
          if (!payload || !payload.agentId) {
            return false;
          }
          upsertScannerAgentOption(payload);
          applyAgentId(payload.agentId);
          const label = payload.name || payload.host || payload.agentId;
          setAgentHint(`Локальный агент: ${label}.`, false);
          return true;
        };
        const refreshLocalAgentSelection = async () => {
          if (localAgentRefreshPending) {
            return false;
          }
          localAgentRefreshPending = true;
          try {
            return await ensureLocalAgentSelection();
          } finally {
            localAgentRefreshPending = false;
          }
        };
        const scheduleLocalAgentSelectionRefresh = (delay = 0) => {
          if (localAgentRefreshTimer) {
            clearTimeout(localAgentRefreshTimer);
          }
          localAgentRefreshTimer = setTimeout(() => {
            refreshLocalAgentSelection().catch(() => {});
          }, Math.max(0, Number(delay) || 0));
        };
        populateAgentSelect();
        agentId = resolveDefaultAgentId();
        const applyScannerMode = (value) => {
          const mode = value === 'webserial' ? 'webserial' : 'agent';
          if (scannerMode) {
            scannerMode.value = mode;
          }
          if (scannerAgentPanel) {
            scannerAgentPanel.classList.toggle('is-hidden', mode !== 'agent');
          }
          if (scannerSerialPanel) {
            scannerSerialPanel.classList.toggle('is-hidden', mode !== 'webserial');
          }
          localStorage.setItem('fullbox_scanner_mode', mode);
          return mode;
        };
      const setAgentStatus = (text, isError) => {
        if (!agentStatus) {
          return;
        }
        agentStatus.textContent = text || 'не выбран';
        agentStatus.style.color = isError ? 'var(--danger)' : '';
      };
      const setAgentContextStatus = (text, isError) => {
        if (!agentContextStatus) {
          return;
        }
        agentContextStatus.textContent = text || '-';
        agentContextStatus.style.color = isError ? 'var(--danger)' : '';
      };
      const setAgentIndicator = (state, text) => {
        if (!agentIndicator) {
          return;
        }
        const indicatorText = agentIndicator.querySelector('.text');
        if (indicatorText) {
          indicatorText.textContent = text || '-';
        }
        agentIndicator.classList.remove('ok', 'warn', 'error', 'muted');
        agentIndicator.classList.add(state || 'muted');
      };
      const setAgentHint = (text, isError) => {
        if (!agentHint) {
          return;
        }
        agentHint.textContent = text || '';
        agentHint.style.color = isError ? 'var(--danger)' : '';
      };
        const setAgentLast = (value, eventAgentId) => {
          if (!agentLast) {
            return;
          }
          const stamp = new Date().toLocaleTimeString('ru-RU');
          const shortValue = value && value.length > 36 ? `${value.slice(0, 36)}...` : value;
          const suffix = eventAgentId ? ` · ${eventAgentId}` : '';
          agentLast.textContent = `${stamp} · ${shortValue || '-'}${suffix}`;
        };
        const handleAgentScanEvent = (evt) => {
          if (evt && evt.id) {
            agentSinceId = Math.max(agentSinceId, Number(evt.id) || 0);
          }
          const eventAgentId = evt && evt.agent_id ? String(evt.agent_id).trim() : '';
          const value = evt && evt.payload ? String(evt.payload.value || '').trim() : '';
          if (!value) {
            return;
          }
          updateScanTest(value, 'agent', true);
          handleBarcode(value);
          setAgentStatus(eventAgentId ? `Р°РєС‚РёРІРµРЅ: ${eventAgentId}` : 'Р°РєС‚РёРІРµРЅ', false);
          setAgentIndicator('ok', 'Р°РєС‚РёРІРµРЅ');
          setAgentLast(value, eventAgentId);
        };
        const isAgentRealtimeConnected = () => !!(agentRealtimeClient && agentRealtimeClient.isConnected());
        const closeAgentRealtime = () => {
          if (agentRealtimeClient) {
            agentRealtimeClient.close();
            agentRealtimeClient = null;
          }
        };
        const connectAgentRealtime = () => {
          if (!window.FullboxAgentRealtime || !agentContextId || !agentId) {
            return;
          }
          if (!agentRealtimeClient) {
            agentRealtimeClient = window.FullboxAgentRealtime.createContextClient({
              onEvent: (evt) => {
                if (evt && evt.event_type === 'scan') {
                  handleAgentScanEvent(evt);
                }
              },
            });
          }
          agentRealtimeClient.connect(agentContextId);
        };
        const defaultAgentPorts = agentPort
          ? Array.from(agentPort.options).map((opt) => opt.value).filter((value) => value)
          : [];
        const normalizePortList = (ports) => {
          if (!Array.isArray(ports)) {
            return [];
          }
          const seen = new Set();
          const result = [];
          ports.forEach((port) => {
            const value = String(port || '').trim();
            if (!value) {
              return;
            }
            const key = value.toLowerCase();
            if (seen.has(key)) {
              return;
            }
            seen.add(key);
            result.push(value);
          });
          return result;
        };
        const setAgentPortOptions = (ports) => {
          if (!agentPort) {
            return normalizePortList(ports);
          }
          const normalized = normalizePortList(ports);
          const current = agentPort.value || '';
          agentPort.innerHTML = '';
          const emptyOption = document.createElement('option');
          emptyOption.value = '';
          emptyOption.textContent = '—';
          agentPort.appendChild(emptyOption);
          normalized.forEach((port) => {
            const option = document.createElement('option');
            option.value = port;
            option.textContent = port;
            agentPort.appendChild(option);
          });
          if (current && normalized.includes(current)) {
            agentPort.value = current;
          }
          return normalized;
        };
        const getSelectedAgentPorts = () => {
          const selected = agentSelect ? agentSelect.selectedOptions[0] : null;
          const raw = selected ? selected.dataset.ports || '' : '';
          const list = raw ? raw.split(',') : [];
          return normalizePortList(list);
        };
        const updateAgentPorts = () => {
          const agentPorts = getSelectedAgentPorts();
          const ports = agentPorts.length ? agentPorts : defaultAgentPorts;
          const normalized = setAgentPortOptions(ports);
          if (agentPort) {
            const current = (agentPort.value || '').trim();
            if (normalized.length && (!current || !normalized.includes(current))) {
              agentPort.value = normalized[0];
            }
          }
          if (agentPortHint) {
            if (agentPorts.length) {
              agentPortHint.textContent = `Порты агента: ${agentPorts.join(', ')}`;
            } else if (defaultAgentPorts.length) {
              agentPortHint.textContent = `Порты по данным сервера: ${defaultAgentPorts.join(', ')}`;
            } else {
              agentPortHint.textContent = 'Порты не найдены.';
            }
          }
        };
        const syncAgentFields = () => {
          if (agentIdInput) {
            agentIdInput.value = agentId;
          }
          if (agentSelect) {
          const option = Array.from(agentSelect.options).find((opt) => opt.value === agentId);
          agentSelect.value = option ? agentId : '';
        }
      };
        const updateAgentMeta = () => {
          const selected = agentSelect ? agentSelect.selectedOptions[0] : null;
          if (selected && selected.value) {
          const statusText = selected.dataset.status || 'выбран';
          const title = selected.dataset.title || '';
          const isOnline = selected.dataset.online === '1';
          const connected = selected.dataset.comConnected === '1';
          const enabled = selected.dataset.comEnabled === '1';
          const label = title ? `${title} · ${statusText}` : statusText;
          setAgentStatus(label, !isOnline);
          setAgentHint(isOnline ? 'Слушаю события агента.' : 'Агент не в сети.');
          if (!isOnline) {
            setAgentIndicator('error', 'нет связи');
          } else if (connected) {
            setAgentIndicator('ok', 'подключен');
          } else if (enabled) {
            setAgentIndicator('warn', 'включен');
          } else {
            setAgentIndicator('muted', 'выключен');
          }
          if (agentInfoTitle) {
              const host = selected.dataset.host || '';
              const version = selected.dataset.version || '';
              const infoParts = [title || selected.value];
              if (host) {
                infoParts.push(host);
              }
              if (version) {
                infoParts.push(`v${version}`);
              }
              agentInfoTitle.textContent = infoParts.join(' · ');
            }
            if (agentInfoLastSeen) {
              const lastSeenRaw = selected.dataset.lastSeen || '';
              const lastSeenDate = lastSeenRaw ? new Date(lastSeenRaw) : null;
              agentInfoLastSeen.textContent = lastSeenDate && !Number.isNaN(lastSeenDate.getTime())
                ? lastSeenDate.toLocaleString('ru-RU')
                : '-';
            }
            if (agentInfoCom) {
              const port = selected.dataset.comPort || '-';
              const enabled = selected.dataset.comEnabled === '1';
              const connected = selected.dataset.comConnected === '1';
              const baud = selected.dataset.comBaud || '';
              const eol = selected.dataset.comEol || '';
              const idle = selected.dataset.comIdle || '';
              let state = connected ? 'подключен' : (enabled ? 'включен' : 'выключен');
              const parts = [state];
              if (port && port !== '-') {
                parts.push(port);
              }
              if (baud) {
                parts.push(`baud ${baud}`);
              }
              if (eol) {
                parts.push(`eol ${eol}`);
              }
              if (idle) {
                parts.push(`idle ${idle}мс`);
              }
              agentInfoCom.textContent = parts.join(' · ');
            }
              if (agentInfoError) {
                const err = selected.dataset.comError || '';
                const errType = selected.dataset.comErrorType || '';
                const errCode = selected.dataset.comErrorCode || '';
                if (err) {
                let text = err;
                if (errType) {
                  text += ` (${errType})`;
                }
                if (errCode) {
                  text += ` [${errCode}]`;
                }
                agentInfoError.textContent = text;
                } else {
                  agentInfoError.textContent = '-';
                }
              }
              updateAgentDeviceDetails();
              updateAgentPorts();
              return;
            }
        if (agentId) {
          setAgentStatus(`ID: ${agentId}`, false);
          setAgentHint('Слушаю события агента.', false);
          setAgentIndicator('warn', 'ID задан');
          if (agentInfoTitle) {
            agentInfoTitle.textContent = agentId;
          }
            if (agentInfoLastSeen) {
              agentInfoLastSeen.textContent = '-';
            }
            if (agentInfoCom) {
              agentInfoCom.textContent = '-';
            }
              if (agentInfoError) {
                agentInfoError.textContent = '-';
              }
              updateAgentDeviceDetails();
              updateAgentPorts();
              return;
            }
        setAgentStatus('не выбран', true);
        setAgentHint('Выберите агента или введите его ID.', true);
        setAgentIndicator('muted', 'не выбран');
        if (agentInfoTitle) {
          agentInfoTitle.textContent = '-';
        }
          if (agentInfoLastSeen) {
            agentInfoLastSeen.textContent = '-';
          }
          if (agentInfoCom) {
            agentInfoCom.textContent = '-';
          }
            if (agentInfoError) {
              agentInfoError.textContent = '-';
            }
            updateAgentDeviceDetails();
            updateAgentPorts();
          };
        const updateSelectedAgentDataset = (patch) => {
          const selected = agentSelect ? agentSelect.selectedOptions[0] : null;
          if (!selected || !patch) {
            return;
          }
            if (patch.enabled !== undefined) {
              selected.dataset.comEnabled = patch.enabled ? '1' : '0';
            }
            if (patch.connected !== undefined) {
              selected.dataset.comConnected = patch.connected ? '1' : '0';
            }
            if (patch.port !== undefined) {
              selected.dataset.comPort = patch.port || '';
            }
            if (patch.baud !== undefined) {
              selected.dataset.comBaud = patch.baud ? String(patch.baud) : '';
            }
            if (patch.eol !== undefined) {
              selected.dataset.comEol = patch.eol || '';
            }
            if (patch.idle !== undefined) {
              selected.dataset.comIdle = patch.idle ? String(patch.idle) : '';
            }
            if (patch.error !== undefined) {
              selected.dataset.comError = patch.error || '';
            }
            if (patch.errorType !== undefined) {
              selected.dataset.comErrorType = patch.errorType || '';
            }
            if (patch.errorCode !== undefined) {
              selected.dataset.comErrorCode = patch.errorCode || '';
            }
            if (patch.online !== undefined) {
              selected.dataset.online = patch.online ? '1' : '0';
            }
            if (patch.status !== undefined) {
              selected.dataset.status = patch.status || '';
            }
            if (patch.lastSeen !== undefined) {
              selected.dataset.lastSeen = patch.lastSeen || '';
            }
          updateAgentMeta();
        };
        const setAgentTestResult = (text, isError) => {
          if (!agentTestResult) {
            return;
          }
          agentTestResult.textContent = text || '-';
          agentTestResult.style.color = isError ? 'var(--danger)' : '';
        };
        const runAgentTest = async () => {
          if (!ensureAgentSelected()) {
            return;
          }
          setAgentTestResult('тест...', false);
          try {
            const resp = await postJson(agentTestUrl, {
              settings: readAgentSettings(),
              agent_id: agentId,
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok || data.ok === false) {
              setAgentTestResult(`ошибка: ${data.error || resp.status}`, true);
              return;
            }
            const commandId = data.command_id;
            if (!commandId) {
              setAgentTestResult('ошибка: нет command_id', true);
              return;
            }
            const statusUrl = `${agentTestStatusBaseUrl}${commandId}/`;
            for (let i = 0; i < 12; i += 1) {
              await new Promise((resolve) => setTimeout(resolve, 500));
              const statusResp = await fetch(statusUrl, { credentials: 'same-origin' });
              if (!statusResp.ok) {
                continue;
              }
              const statusData = await statusResp.json().catch(() => ({}));
              if (statusData.status === 'done' || statusData.status === 'failed') {
                const result = statusData.result || {};
                if (statusData.status === 'done' && result.ok) {
                  const note = result.note ? ` (${result.note})` : '';
                  setAgentTestResult(`OK${note}`, false);
                  updateSelectedAgentDataset({
                    error: '',
                    errorType: '',
                    errorCode: '',
                  });
                } else {
                  const err = result.error || statusData.error || 'ошибка';
                  const errType = result.error_type || '';
                  const errCode = result.error_code !== undefined ? ` [${result.error_code}]` : '';
                  setAgentTestResult(`${err}${errType ? ` (${errType})` : ''}${errCode}`, true);
                }
                return;
              }
            }
            setAgentTestResult('таймаут', true);
          } catch (err) {
            setAgentTestResult('ошибка соединения', true);
          }
        };
          const getSelectedAgentLabel = () => {
            const selected = agentSelect ? agentSelect.selectedOptions[0] : null;
            if (!selected) {
              return agentId || 'агент';
            }
            return selected.dataset.title || selected.value || agentId || 'агент';
          };
          const updatePortRowStatus = (port, status) => {
            const key = (port || '').toLowerCase();
            if (!key) {
              return;
            }
            const row = document.querySelector(`.scanner-port-row[data-port="${key}"]`);
            if (!row) {
              return;
            }
            const valueEl = row.querySelector('.scanner-test-value');
            if (valueEl) {
              valueEl.textContent = status;
            }
          };
        const applyAgentId = (value) => {
          agentId = String(value || '').trim();
          if (agentId) {
            localStorage.setItem('fullbox_agent_id', agentId);
          } else {
            localStorage.removeItem('fullbox_agent_id');
          }
          if (agentIdHidden) {
            agentIdHidden.value = agentId;
          }
          scannerModeValue = applyScannerMode(agentId ? 'agent' : (scannerModeValue || 'webserial'));
          if (agentId) {
            switchToAgentMode().catch(() => {});
            setAgentContextStatus('ожидаю', false);
          } else {
            setAgentContextStatus('не назначен', true);
          }
          agentSinceId = 0;
          syncAgentFields();
          updateAgentMeta();
          agentContextId = '';
          closeAgentRealtime();
          loadFlowSession().then(() => {
            claimAgentContext().catch(() => {});
            scheduleAgentStatusPoll(500);
            scheduleAgentPoll(200);
            loadSharedFlowState();
          });
        };
        const readAgentSettings = () => {
          const baudValue = Number.parseInt(agentBaud?.value || '', 10);
          const idleValue = Number.parseInt(agentIdle?.value || '', 10);
          return {
            default: {
              enabled: !!agentEnabled?.checked,
              port: (agentPort?.value || '').trim(),
              baud: Number.isFinite(baudValue) && baudValue > 0 ? baudValue : 9600,
              eol: (agentEol?.value || 'CrLf').trim() || 'CrLf',
              idle_ms: Number.isFinite(idleValue) && idleValue >= 0 ? idleValue : 200,
            },
          };
        };
        const ensureAgentSelected = () => {
          if (agentId) {
            return true;
          }
          setAgentHint('Выберите агента или введите его ID.', true);
          return false;
        };
        const postJson = async (url, payload) => {
          return fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRFToken': csrfToken,
            },
            credentials: 'same-origin',
            body: JSON.stringify(payload || {}),
          });
        };
        const scheduleAgentContextKeepalive = (delay) => {
          if (agentContextTimer) {
            clearTimeout(agentContextTimer);
          }
          agentContextTimer = setTimeout(() => {
            claimAgentContext().catch(() => {});
          }, delay);
        };
        const claimAgentContext = async (force) => {
          if (!agentId) {
            setAgentStatus('нет ID агента', true);
            setAgentIndicator('muted', 'нет ID');
            setAgentHint('Выберите агента или введите его ID.', true);
            setAgentContextStatus('не назначен', true);
            agentContextId = '';
            closeAgentRealtime();
            scheduleAgentContextKeepalive(5000);
            return false;
          }
          const orderValue = Number.parseInt(orderId || '', 10);
          const payload = {
            agent_id: agentId,
            order_id: Number.isFinite(orderValue) ? orderValue : null,
            box_id: state.activeBox || '',
            force: !!force,
          };
          if (agentContextId) {
            payload.context_id = agentContextId;
          }
          try {
            const prevContextId = agentContextId;
            const resp = await postJson(agentContextUrl, payload);
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok || data.ok === false) {
              if (data && data.error === 'busy') {
                const owner = data.owner || {};
                const ownerLabel = owner.user ? `Занят: ${owner.user}` : 'Занят другим пользователем';
                setAgentStatus('занят', true);
                setAgentIndicator('warn', 'занят');
                setAgentHint(ownerLabel, true);
                setAgentContextStatus(ownerLabel, true);
              } else {
                setAgentStatus('ошибка', true);
                setAgentIndicator('error', 'ошибка');
                setAgentHint('Контекст агента: ошибка.', true);
                setAgentContextStatus('ошибка', true);
              }
              agentContextId = '';
              closeAgentRealtime();
              scheduleAgentContextKeepalive(5000);
              return false;
            }
            agentContextId = data.context_id || agentContextId;
            setAgentContextStatus('активен', false);
            if (agentContextId && agentContextId !== prevContextId) {
              agentSinceId = 0;
            }
            const agentOnline = data && data.agent_online !== undefined ? !!data.agent_online : true;
            const lastScanEventId = Number(data && data.last_scan_event_id) || 0;
            if (lastScanEventId > agentSinceId) {
              agentSinceId = lastScanEventId;
            }
            if (data && data.realtime_enabled) {
              connectAgentRealtime();
            } else {
              closeAgentRealtime();
            }
            if (agentOnline) {
              setAgentHint('Слушаю события агента.', false);
            } else {
              setAgentHint('Агент не в сети.', true);
            }
            applyScannerState(data, agentOnline);
            scheduleAgentContextKeepalive(10000);
            return true;
          } catch (err) {
            setAgentStatus('ошибка', true);
            setAgentIndicator('error', 'ошибка');
            setAgentHint('Контекст агента: ошибка соединения.', true);
            setAgentContextStatus('ошибка', true);
            agentContextId = '';
            closeAgentRealtime();
            scheduleAgentContextKeepalive(5000);
            return false;
          }
        };
        const scheduleAgentStatusPoll = (delay) => {
          if (agentStatusTimer) {
            clearTimeout(agentStatusTimer);
          }
          agentStatusTimer = setTimeout(pollAgentStatus, delay);
        };
        const pollAgentStatus = async () => {
          if (!agentId) {
            scheduleAgentStatusPoll(5000);
            return;
          }
          try {
            const resp = await fetch(`${agentStatusUrl}?agent_id=${encodeURIComponent(agentId)}`, {
              credentials: 'same-origin',
            });
            if (resp.ok) {
              const data = await resp.json();
              const agentOnline = data && data.agent_online !== undefined ? !!data.agent_online : true;
              applyScannerState(data, agentOnline);
            }
          } catch (err) {
            // ignore
          } finally {
            scheduleAgentStatusPoll(5000);
          }
        };
        if (agentSelect) {
          agentSelect.addEventListener('change', () => {
            const value = agentSelect.value || '';
            if (agentIdInput) {
              agentIdInput.value = value;
            }
            applyAgentId(value);
          });
          agentSelect.addEventListener('pointerdown', () => {
            scheduleLocalAgentSelectionRefresh(0);
          });
        }
        if (agentPort) {
          agentPort.addEventListener('change', () => {
            updateAgentDeviceDetails();
          });
        }
        if (agentApply) {
          agentApply.addEventListener('click', () => {
            applyAgentId(agentIdInput ? agentIdInput.value : '');
          });
        }
        if (agentDisable) {
          agentDisable.addEventListener('click', async () => {
            if (!ensureAgentSelected()) {
              return;
            }
            setAgentHint('Отключаю сканер в агенте...', false);
            try {
              const settings = readAgentSettings();
              if (settings && settings.default) {
                settings.default.enabled = false;
              }
              const resp = await postJson(agentSettingsApplyUrl, {
                settings,
                agent_id: agentId,
                reconnect: false,
              });
              const data = await resp.json().catch(() => ({}));
              if (!resp.ok || data.ok === false) {
                setAgentHint(`Ошибка отключения: ${data.error || resp.status}`, true);
                return;
              }
                if (agentEnabled) {
                  agentEnabled.checked = false;
                }
                updateSelectedAgentDataset({
                  enabled: false,
                  connected: false,
                  error: '',
                  errorType: '',
                  errorCode: '',
                });
                const portValue = (agentPort?.value || '').trim();
                if (portValue) {
                  updatePortRowStatus(portValue, `${getSelectedAgentLabel()} · выключен (локально)`);
                }
                setAgentHint('Сканер отключен.', false);
            } catch (err) {
              setAgentHint('Ошибка соединения при отключении сканера.', true);
            }
          });
        }
        if (agentClear) {
          agentClear.addEventListener('click', () => {
            if (agentIdInput) {
              agentIdInput.value = '';
            }
            if (agentSelect) {
              agentSelect.value = '';
            }
            applyAgentId('');
          });
        }
        if (agentApplySettings) {
          agentApplySettings.addEventListener('click', async () => {
            if (!ensureAgentSelected()) {
              return;
            }
            await switchToAgentMode();
            setAgentHint('Отправляю настройки агенту...', false);
            try {
              const resp = await postJson(agentSettingsApplyUrl, {
                settings: readAgentSettings(),
                agent_id: agentId,
                reconnect: true,
              });
              const data = await resp.json().catch(() => ({}));
              if (!resp.ok || data.ok === false) {
                setAgentHint(`Ошибка применения: ${data.error || resp.status}`, true);
                return;
              }
              updateSelectedAgentDataset({
                enabled: !!agentEnabled?.checked,
                port: (agentPort?.value || '').trim(),
                baud: Number.parseInt(agentBaud?.value || '', 10) || 9600,
                eol: (agentEol?.value || 'CrLf').trim() || 'CrLf',
                idle: Number.parseInt(agentIdle?.value || '', 10) || 200,
              });
              const portValue = (agentPort?.value || '').trim();
              if (portValue) {
                const label = getSelectedAgentLabel();
                const stateLabel = agentEnabled?.checked ? 'включен (локально)' : 'выключен (локально)';
                updatePortRowStatus(portValue, `${label} · ${stateLabel}`);
              }
              setAgentHint('Настройки отправлены агенту.', false);
            } catch (err) {
              setAgentHint('Ошибка соединения при применении настроек.', true);
            }
          });
        }
        if (agentSaveSettings) {
          agentSaveSettings.addEventListener('click', async () => {
            setAgentHint('Сохраняю настройки по умолчанию...', false);
            try {
              const resp = await postJson(agentSettingsSaveUrl, {
                settings: readAgentSettings(),
              });
              const data = await resp.json().catch(() => ({}));
              if (!resp.ok || data.ok === false) {
                setAgentHint(`Ошибка сохранения: ${data.error || resp.status}`, true);
                return;
              }
              setAgentHint('Настройки сохранены по умолчанию.', false);
            } catch (err) {
              setAgentHint('Ошибка соединения при сохранении настроек.', true);
            }
          });
        }
        if (agentReconnect) {
          agentReconnect.addEventListener('click', async () => {
            if (!ensureAgentSelected()) {
              return;
            }
            await switchToAgentMode();
            setAgentHint('Переподключаю сканер...', false);
            try {
              const resp = await postJson(agentSettingsApplyUrl, {
                agent_id: agentId,
                reconnect_only: true,
              });
              const data = await resp.json().catch(() => ({}));
              if (!resp.ok || data.ok === false) {
                setAgentHint(`Ошибка переподключения: ${data.error || resp.status}`, true);
                return;
              }
              setAgentHint('Команда переподключения отправлена.', false);
            } catch (err) {
              setAgentHint('Ошибка соединения при переподключении.', true);
            }
          });
        }
        if (agentTest) {
          agentTest.addEventListener('click', async () => {
            await switchToAgentMode();
            await runAgentTest();
          });
        }
        if (agentClaimForce) {
          agentClaimForce.addEventListener('click', async () => {
            const ok = window.confirm('Перехватить сканер у другого пользователя?');
            if (!ok) {
              return;
            }
            await claimAgentContext(true);
          });
        }
        syncAgentFields();
        updateAgentMeta();
        applyAgentId(agentId);
        refreshLocalAgentSelection().catch(() => {});
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) {
            scheduleLocalAgentSelectionRefresh(200);
          }
        });
        window.addEventListener('focus', () => {
          scheduleLocalAgentSelectionRefresh(200);
        });
        if (scannerMode) {
          scannerMode.addEventListener('change', async () => {
            scannerModeValue = applyScannerMode(scannerMode.value);
            if (scannerModeValue === 'agent') {
              await closeSerial();
            } else {
              await disableAgentForWebSerial();
            }
          });
        }
      const scheduleAgentPoll = (delay) => {
        if (agentPollTimer) {
          clearTimeout(agentPollTimer);
        }
        agentPollTimer = setTimeout(pollAgentEvents, delay);
      };
      const pollAgentEvents = async () => {
        if (document.hidden) {
          scheduleAgentPoll(1500);
          return;
        }
        const params = new URLSearchParams();
        params.set('since', String(agentSinceId || 0));
        params.set('type', 'scan');
        if (agentContextId) {
          params.set('context_id', agentContextId);
        } else {
          scheduleAgentPoll(1200);
          return;
        }
        try {
          const resp = await fetch(`${agentEventsUrl}?${params.toString()}`, {
            credentials: 'same-origin',
          });
          if (resp.ok) {
            const data = await resp.json();
            if (data && Array.isArray(data.events) && data.events.length) {
              data.events.forEach((evt) => {
                if (evt && evt.id) {
                  agentSinceId = Math.max(agentSinceId, Number(evt.id) || 0);
                }
                const eventAgentId = evt && evt.agent_id ? String(evt.agent_id).trim() : '';
                const value = evt && evt.payload ? String(evt.payload.value || '').trim() : '';
                if (value) {
                  updateScanTest(value, 'agent', true);
                  handleBarcode(value);
                  setAgentStatus(eventAgentId ? `активен: ${eventAgentId}` : 'активен', false);
                  setAgentIndicator('ok', 'активен');
                  setAgentLast(value, eventAgentId);
                }
              });
            }
          }
        } catch (err) {
          // ignore poll errors
        } finally {
          scheduleAgentPoll(isAgentRealtimeConnected() ? 15000 : 1000);
        }
      };
      scheduleAgentPoll(1200);
      const handleBoxContextMenu = (event) => {
        const target = event.target.closest('[data-box-code]');
        if (!target) {
          return;
        }
        event.preventDefault();
        event.stopImmediatePropagation();
        openContextMenu(event, target.dataset.boxCode || '');
      };
      const handlePalletContextMenu = (event) => {
        const boxTarget = event.target.closest('[data-box-code]');
        if (boxTarget) {
          return;
        }
        const target = event.target.closest('[data-pallet-code]');
        if (!target) {
          return;
        }
        event.preventDefault();
        openPalletContextMenu(event, target.dataset.palletCode || '');
      };
      if (palletBoard) {
        palletBoard.addEventListener('contextmenu', handleBoxContextMenu);
        palletBoard.addEventListener('contextmenu', handlePalletContextMenu);
      }
      if (closedBoxesEl) {
        closedBoxesEl.addEventListener('contextmenu', handleBoxContextMenu);
      }
      if (remainingBody) {
        remainingBody.addEventListener('click', (event) => {
          const cell = event.target.closest('td.direction-cell[data-direction][data-item-key]');
          if (!cell || !remainingBody.contains(cell)) {
            return;
          }
          const itemKey = String(cell.dataset.itemKey || '').trim().toLowerCase();
          const directionName = String(cell.dataset.direction || '').trim();
          if (!itemKey || !directionName) {
            return;
          }
          const item = remainingItemByKey.get(itemKey);
          if (!item) {
            return;
          }
          focusCellDirectionBox(item, directionName);
        });
      }
      if (contextMenu) {
        contextMenu.addEventListener('click', (event) => {
          const button = event.target.closest('button[data-action]');
          if (!button || !contextMenuBoxCode) {
            return;
          }
          const action = button.dataset.action;
          if (action === 'view') {
            openBoxView(contextMenuBoxCode);
          } else if (action === 'copy') {
            openBoxCopyModal(contextMenuBoxCode);
          } else if (action === 'edit') {
            editBoxFromContext(contextMenuBoxCode);
          } else if (action === 'print-box') {
            const previewWindow = window.open('', '_blank', 'width=520,height=620');
            if (!previewWindow) {
              alert('Разрешите всплывающие окна для печати.');
              return;
            }
            openBoxPrintPreviewForCode(contextMenuBoxCode, previewWindow, ({ doc, qrPayload }) => {
              loadQrInPreview(doc, qrPayload);
            });
          } else if (action === 'print-pallet') {
            const info = findBoxPalletInfo(contextMenuBoxCode);
            if (!info.palletCode) {
              alert('Короб не привязан к палете.');
              return;
            }
            const previewWindow = window.open('', '_blank', 'width=520,height=620');
            if (!previewWindow) {
              alert('Разрешите всплывающие окна для печати.');
              return;
            }
            openPalletBoxesPrintPreview(info.palletCode, previewWindow);
          } else if (action === 'delete') {
            deleteBoxFromContext(contextMenuBoxCode);
          }
          closeContextMenu();
        });
      }
      if (palletContextMenu) {
          palletContextMenu.addEventListener('click', (event) => {
            const button = event.target.closest('button[data-action]');
            if (!button || !contextMenuPalletCode) {
              return;
            }
            const action = button.dataset.action;
            if (action === 'open') {
              openClosedPallet(contextMenuPalletCode);
            } else if (action === 'print') {
              const previewWindow = window.open('', '_blank', 'width=520,height=720');
              if (!previewWindow) {
                alert('Разрешите всплывающие окна для печати.');
                return;
              }
              openPalletPrintPreview(contextMenuPalletCode, previewWindow, ({ doc, qrPayload }) => {
                loadQrInPreview(doc, qrPayload);
              });
            } else if (action === 'location') {
              openPalletLocationModal(contextMenuPalletCode);
            }
            closePalletContextMenu();
          });
        }
      document.addEventListener('click', (event) => {
        if (contextMenu && contextMenu.classList.contains('is-open') && !contextMenu.contains(event.target)) {
          closeContextMenu();
        }
        if (palletContextMenu && palletContextMenu.classList.contains('is-open') && !palletContextMenu.contains(event.target)) {
          closePalletContextMenu();
        }
      });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            closeContextMenu();
            closePalletContextMenu();
            closePalletCloseModal();
            closeBoxView();
            closeBoxCopyModal();
            closePalletLocationModal();
            closePalletViewModal();
          }
        });
      if (boxViewModal) {
        boxViewModal.addEventListener('click', (event) => {
          if (event.target === boxViewModal) {
            closeBoxView();
          }
        });
      }
        if (boxViewClose) {
          boxViewClose.addEventListener('click', closeBoxView);
        }
        if (palletViewModal) {
          palletViewModal.addEventListener('click', (event) => {
            if (event.target === palletViewModal) {
              closePalletViewModal();
            }
          });
        }
        if (palletViewClose) {
          palletViewClose.addEventListener('click', closePalletViewModal);
        }
        if (boxCopyModal) {
          boxCopyModal.addEventListener('click', (event) => {
            if (event.target === boxCopyModal) {
              closeBoxCopyModal();
            }
          });
        }
        if (boxCopyClose) {
          boxCopyClose.addEventListener('click', closeBoxCopyModal);
        }
        if (boxCopyCancel) {
          boxCopyCancel.addEventListener('click', closeBoxCopyModal);
        }
        if (boxCopyForm) {
          boxCopyForm.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!copyModalBoxCode) {
              return;
            }
            const rawValue = String(boxCopyCount?.value || '').replace(/[^\d]/g, '');
            const copies = Number.parseInt(rawValue, 10);
            if (!Number.isFinite(copies) || copies <= 0) {
              alert('Введите количество копий.');
              return;
            }
            if (copyBoxToPallet(copyModalBoxCode, copies)) {
              closeBoxCopyModal();
            }
          });
        }
        if (palletLocationModal) {
          palletLocationModal.addEventListener('click', (event) => {
            if (event.target === palletLocationModal) {
              closePalletLocationModal();
            }
          });
        }
        if (palletLocationClose) {
          palletLocationClose.addEventListener('click', closePalletLocationModal);
        }
        if (palletLocationCancel) {
          palletLocationCancel.addEventListener('click', closePalletLocationModal);
        }
        if (palletLocationForm) {
          palletLocationForm.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!locationModalPalletCode) {
              return;
            }
            const pallet = getPallet(locationModalPalletCode);
            if (!pallet) {
              return;
            }
            const location = {
              zone: (palletLocationZone?.value || 'PR').trim().toUpperCase(),
              row: (palletLocationRow?.value || '').trim(),
              section: (palletLocationSection?.value || '').trim(),
              tier: (palletLocationTier?.value || '').trim(),
              cell: (palletLocationCell?.value || '').trim(),
            };
            pallet.location = location;
            markDraftDirty();
            renderAll();
            closePalletLocationModal();
          });
        }
      if (closeBoxBtn) {
        closeBoxBtn.addEventListener('click', () => {
          if (lastFocusedRowKey) {
            pendingFocusKey = lastFocusedRowKey;
            pendingFocusEl = null;
          }
          closeBox(true);
        });
      }
      if (closePalletBtn) {
        closePalletBtn.addEventListener('click', () => {
          openPalletCloseConfirm();
        });
      }
      palletCloseForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        confirmPalletClose();
      });
      palletCloseCancel?.addEventListener('click', closePalletCloseModal);
      palletCloseModal?.addEventListener('click', (event) => {
        if (event.target === palletCloseModal) {
          closePalletCloseModal();
        }
      });
      boxMetricsForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        saveBoxMetricsFromModal();
      });
      boxMetricsClose?.addEventListener('click', () => {
        if (boxMetricsForm && typeof boxMetricsForm.reportValidity === 'function' && !boxMetricsForm.reportValidity()) {
          return;
        }
        saveBoxMetricsFromModal();
      });
      boxMetricsCancel?.addEventListener('click', cancelBoxMetricsPrompt);
      boxMetricsModal?.addEventListener('click', (event) => {
        if (event.target === boxMetricsModal) {
          cancelBoxMetricsPrompt();
        }
      });

      if (formEl) {
          const submitFlowWithBoxMetrics = () => {
            const ensureReadyAndSubmit = () => {
              const openBoxes = state.boxes.filter((box) => box && !box.sealed && getBoxItemsCount(box) > 0);
              for (let index = 0; index < openBoxes.length; index += 1) {
                const box = openBoxes[index];
                const boxIndex = findBoxPalletInfo(box.code).index || 0;
                const ready = ensureBoxCharacteristics(box, {
                  allowPrompt: true,
                  boxIndex,
                  onReady: () => {
                    sealReadyBox(box, { boxIndex });
                    ensureReadyAndSubmit();
                  },
                  onAbort: () => {
                    isSubmitting = false;
                    renderAll();
                  },
                });
                if (!ready) {
                  state.activeBox = box.code;
                  renderAll();
                  return;
                }
                sealReadyBox(box, { boxIndex });
              }
              finalizeContainers();
              updateHidden();
              formEl.submit();
            };
            ensureReadyAndSubmit();
          };
          formEl.addEventListener('submit', (event) => {
            event.preventDefault();
            if (!canFinishFlow) {
              event.preventDefault();
              alert('Завершить размещение может только обработчик.');
              return;
            }
            if (allowMismatchInput) {
              allowMismatchInput.value = '0';
            }
            if (directionalMode) {
              const issues = [];
              const allPallets = getSortedPallets();
              allPallets.forEach((pallet) => {
                const palletBoxes = (pallet?.boxes || [])
                  .map((code) => getAnyBox(code))
                  .filter((box) => box && getBoxItemsCount(box) > 0);
                if (!palletBoxes.length) {
                  return;
                }
                const directionName = getPalletDirection(pallet);
                if (!directionName) {
                  issues.push(`Палета ${pallet.code || '-'} без направления.`);
                  return;
                }
                palletBoxes.forEach((box) => {
                  const boxDirection = getBoxDirection(box);
                  if (!boxDirection) {
                    issues.push(`Короб ${box.code || '-'} без направления.`);
                    return;
                  }
                  if (boxDirection !== directionName) {
                    issues.push(
                      `Короб ${box.code || '-'} (${boxDirection}) не совпадает с палетой ${pallet.code || '-'} (${directionName}).`,
                    );
                  }
                });
              });
              if (issues.length) {
                event.preventDefault();
                alert(`Раскоробовка по направлениям: ${issues[0]}`);
                playDirectionSignal('alarm');
                return;
              }
            }
            const remaining = getRemaining();
            const totalPlaced = remaining.reduce((sum, item) => sum + Number(item.placed || 0), 0);
            const missingTotal = remaining.reduce(
              (sum, item) => sum + Math.max(0, Number(item.remaining || 0)),
              0,
            );
            const overTotal = remaining.reduce(
              (sum, item) => sum + Math.max(0, -Number(item.remaining || 0)),
              0,
            );
          if (totalPlaced <= 0) {
            event.preventDefault();
            return;
          }
            if (missingTotal > 0 || overTotal > 0) {
            if (!canFinishFlowMismatch) {
              event.preventDefault();
              alert('Есть расхождения. Завершить размещение с расхождениями может только руководитель обработки.');
              return;
            }
            let message = '';
            if (missingTotal > 0 && overTotal > 0) {
              message = `Недостача ${missingTotal} шт., излишек ${overTotal} шт. Завершить размещение с расхождениями?`;
            } else if (missingTotal > 0) {
              message = `Осталось ${missingTotal} шт. по заявке. Завершить размещение с расхождениями?`;
            } else {
              message = `Излишек ${overTotal} шт. по заявке. Завершить размещение с расхождениями?`;
            }
            const shouldFinish = window.confirm(message);
            if (!shouldFinish) {
              event.preventDefault();
              return;
            }
            if (allowMismatchInput) {
              allowMismatchInput.value = '1';
            }
          }
          isSubmitting = true;
          submitFlowWithBoxMetrics();
        });
      }

      if (flowSessionReady && !state.pallets.length && itemsData.length) {
        if (directionalMode) {
          const initialDirection = getActiveDirectionName() || chooseNextPalletDirection() || (directionNames[0] || '');
          if (initialDirection) {
            setActiveDirection(initialDirection, false);
          } else {
            openNewPallet();
          }
        } else {
          openNewPallet();
        }
      }
      renderAll();
    })();
  </script>
</body>
</html>

